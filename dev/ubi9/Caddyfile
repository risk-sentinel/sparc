# Local-validation TLS proxy for the UBI9 image (#742).
# Terminates TLS (self-signed internal CA), forwards X-Forwarded-Proto so Rails'
# assume_ssl is satisfied (Secure session cookie), and stubs the static path the
# browser auto-requests that the app still doesn't ship — production infra
# serves it, so serving it here keeps the "loads-clean" console-error smoke
# tests apples-to-apples with the deployment.
#
# #936 REMOVED the /favicon.ico stub. It answered 204 because the app shipped no
# favicon; now that it does, the stub SHADOWED the real file — the icon was
# present in the image and the browser still got no content, which is a
# masked-feature failure rather than a missing one. Caught by the ui-smoke check
# that fetches each icon over HTTP instead of trusting it exists on disk.
localhost:3443 {
	tls internal

	handle /manifest.json {
		header Content-Type application/manifest+json
		respond `{"name":"SPARC","short_name":"SPARC","icons":[],"start_url":"/","display":"standalone"}` 200
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}
