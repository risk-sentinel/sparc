# Nix users: `direnv allow` once and the devshell loads on cd.
# nix-direnv caches the shell, so cd is instant until one of the watched files changes.
if ! has nix_direnv_version || ! nix_direnv_version 3.0.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.2/direnvrc" "sha256-Di03ad3a0ueGi6CGrfhrQzyGdQIg9APXIPCAMNQgWYM="
fi

# Reload when the shell's definition changes. `use flake` watches flake.nix and flake.lock itself.
# Every module, and each directory so an added or removed module is noticed too:
watch_file $(find nix -name '*.nix')
while IFS= read -r d; do watch_dir "$d"; done < <(find nix -type d)
# Files the flake reads that are not Nix:
watch_file Dockerfile       # ARG HDF_LIBS_VERSION -> packages.hdf (nix/modules/hdf.nix)
watch_file .ruby-version    # checked against the shell's Ruby on entry
watch_file nix/brand/mark.ansi nix/brand/mark.txt  # the banner's mark (nix/modules/brand.nix)

# The shell's hook prints the banner each time direnv loads it (cd in, or a reload).
# Quiet it with `export SPARC_NO_BANNER=1` in your own shell profile.
use flake
