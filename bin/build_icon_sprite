#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds app/views/shared/_icon_sprite.html.erb from the vendored Lucide icons
# (lib/data/lucide, 1.18.0-rf #1289).
#
#   bin/build_icon_sprite           write the sprite
#   bin/build_icon_sprite --check   exit 1 if the committed sprite is out of date
#
# Each icon becomes a <symbol id="i-NAME"> holding the icon's own drawing
# elements, unchanged. The stroke settings that Lucide puts on each <svg> move to
# each symbol, so `icon("house")` draws exactly what lucide-static draws. The
# sprite is rendered once per page by the layouts; IconHelper#icon refers to a
# symbol with <use href="#i-NAME">, which needs no CDN, font or CSP change.

require "json"
require "pathname"

ROOT = Pathname(__dir__).parent
SOURCE = ROOT.join("lib/data/lucide")
TARGET = ROOT.join("app/views/shared/_icon_sprite.html.erb")

# Lucide's stroke settings, on every symbol: a <use> clones the symbol, not the
# sprite <svg> around it, so settings on the sprite would not reach the icon.
STROKE = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"'.freeze

def symbol_for(name, svg)
  body = svg[%r{<svg[^>]*>(.*)</svg>}m, 1] or abort "#{name}.svg: no <svg> element"
  inner = body.lines.map(&:strip).reject(&:empty?).join
  %(  <symbol id="i-#{name}" viewBox="0 0 24 24" #{STROKE}>#{inner}</symbol>)
end

def sprite
  provenance = JSON.parse(SOURCE.join("provenance.json").read)
  symbols = provenance.fetch("icons").map { |i| i.fetch("name") }.sort.map do |name|
    symbol_for(name, SOURCE.join("icons", "#{name}.svg").read)
  end

  <<~ERB
    <%# GENERATED by bin/build_icon_sprite from lib/data/lucide — do not edit by hand.
        Icons: Lucide #{provenance.fetch('version')} (ISC; some icons derived from Feather, MIT).
        Licence: lib/data/lucide/LICENSE. Rendered once per page by the layouts;
        IconHelper#icon draws one with <use href="#i-NAME">. %>
    <svg xmlns="http://www.w3.org/2000/svg" class="sparc-icon-sprite" aria-hidden="true" focusable="false">
    #{symbols.join("\n")}
    </svg>
  ERB
end

if ARGV.include?("--check")
  if TARGET.exist? && TARGET.read == sprite
    puts "icon sprite is current"
  else
    warn "app/views/shared/_icon_sprite.html.erb is out of date: run bin/build_icon_sprite"
    exit 1
  end
else
  TARGET.write(sprite)
  puts "wrote #{TARGET.relative_path_from(ROOT)}"
end
