#!/usr/bin/env bash
set -euo pipefail

# Custom/private-CA trust (#774), runtime mechanism: fold any operator-supplied
# CAs (SPARC_EXTRA_CA_CERTS, or a /rails/certs mount) into a combined bundle and
# export SSL_CERT_FILE. Runs before anything makes an outbound TLS call, and for
# every command (web/console/jobs), not just the server. Non-root-safe.
# shellcheck source=bin/lib/ca-trust.sh
source "$(dirname "$0")/lib/ca-trust.sh"
sparc_setup_ca_trust

# Verify jemalloc is active (set via Dockerfile ENV, see issue #380)
if [ -n "${LD_PRELOAD:-}" ]; then
    echo "jemalloc: active (LD_PRELOAD=$LD_PRELOAD)"
else
    echo "WARNING: jemalloc not active — memory fragmentation may occur"
fi

# Wait for PostgreSQL (safe for all services)

# Resolve host/port in the SAME precedence order Rails uses (#834):
# DB_CREDENTIALS > DATABASE_URL > SPARC_DB_*. This probe runs in the SHELL, long
# before Rails boots and applies that precedence itself, so if the two disagree
# the container waits on one database and then connects to another. Reads host
# and port only; the password is never read or printed.
DB_HOST=""
DB_PORT=""

if [ -n "${DB_CREDENTIALS:-}" ]; then
    DB_HOST=$(ruby -rjson -e 'c = (JSON.parse(ENV["DB_CREDENTIALS"]) rescue {}); print c.is_a?(Hash) ? c["host"].to_s : ""' 2>/dev/null || true)
    DB_PORT=$(ruby -rjson -e 'c = (JSON.parse(ENV["DB_CREDENTIALS"]) rescue {}); print c.is_a?(Hash) ? c["port"].to_s : ""' 2>/dev/null || true)
fi

if [ -z "${DB_HOST}" ] && [ -n "${DATABASE_URL:-}" ]; then
    DB_HOST=$(echo "${DATABASE_URL}" | sed 's|.*@\(.*\):.*|\1|')
    DB_PORT=$(echo "${DATABASE_URL}" | sed 's|.*:\([0-9]*\)/.*|\1|')
fi

# The SPARC_DB_* block is a fully supported route — and the recommended one when
# only the username and password should be secret references — so it has to be
# understood here too, or the readiness probe falls back to the compose default
# and waits forever on a database that is not there.
if [ -z "${DB_HOST}" ]; then
    DB_HOST="${SPARC_DB_HOST:-}"
    DB_PORT="${SPARC_DB_PORT:-}"
fi

echo "Waiting for PostgreSQL at ${DB_HOST:-db}:${DB_PORT:-5432}..."
until pg_isready -h "${DB_HOST:-db}" -p "${DB_PORT:-5432}" -t 1 >/dev/null 2>&1; do
    echo "Postgres is not ready yet - sleeping..."
    sleep 2
done
echo "PostgreSQL is ready!"

# Only run db:prepare + seeds when starting the Rails server (web container)
# This prevents concurrent migration errors from sidekiq/console/etc.
# CMD is ["./bin/rails", "server"] — Puma runs directly (thruster removed, #639).
if [[ "$*" == *"rails"*"server"* ]]; then
    echo "Running database preparation (create/migrate all databases)..."
    bundle exec rails db:prepare

    # #1151 — the schema gate. `db:prepare` reporting nothing pending is NOT
    # evidence the schema is current: a migration archived by a squash is never
    # run, which is how v1.16.2 booted green over seven missing columns and
    # served 500s (#1147). So, before this container binds its port:
    #   1. reconcile — create whatever schema.rb declares and the database lacks,
    #      additively, in one transaction; it refuses (changing nothing) on drift
    #      it cannot add its way out of. Every run is an audit event.
    #   2. verify — fail on any STRUCTURAL drift left over.
    # Either failing stops the container here, so the orchestrator keeps the old
    # tasks serving and the DEPLOY fails, instead of the application. There is
    # deliberately no bypass variable: a mismatched schema is what the gate is
    # for. Definitional drift (defaults, nullability) is printed, not fatal.
    # NIST SP 800-53 Rev 5: SI-7, CM-3.
    echo "Reconciling and verifying the database schema against db/schema.rb..."
    if ! bundle exec rails db:reconcile_schema db:verify_schema; then
        echo "FATAL: the database schema does not match this image, and could not be reconciled." >&2
        echo "FATAL: refusing to start the web server. See the report above, and docs: wiki/Upgrading." >&2
        exit 1
    fi

    # Enable Solid Queue in Puma for single-container deployments (ECS)
    export SOLID_QUEUE_IN_PUMA="${SOLID_QUEUE_IN_PUMA:-true}"

    # Admin bootstrap runs independently of seeds — always ensures admin exists.
    # Idempotent: creates if missing, fixes admin flag if unset, never resets passwords.
    echo "Bootstrapping admin account..."
    bundle exec rails sparc:bootstrap_admin || echo "WARNING: Admin bootstrap failed (non-fatal)"

    # Always run seeds — SeedRunner tracks completion and skips already-done sections.
    # Failed sections from previous deploys will automatically retry.
    echo "Running seed completeness check..."
    bundle exec rails db:seed
fi

# Explicit seed trigger for non-web containers or re-seeding
if [ "${SPARC_RUN_SEEDS:-false}" = "true" ]; then
    echo "SPARC_RUN_SEEDS=true — running database seeds..."
    bundle exec rails db:seed
fi

# Hand over to the actual command
echo "Starting: $@"
exec "$@"