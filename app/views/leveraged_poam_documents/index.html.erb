<div class="card">
  <div class="card-body">
    <h2>Leveraged POA&amp;Ms</h2>
    <p class="text-body-secondary">
      POA&amp;Ms owned by leveraged-system boundaries that any of your
      leveraging-side authorization boundaries depend on. Read-only.
    </p>

    <%= render "shared/collection_toolbar",
          label: "leveraged POA&Ms", placeholder: "Search leveraged POA&Ms…",
          view_mode: (@leveraged_poams.any? ? @view_mode : nil) %>

    <% if @leveraged_poams.empty? %>
      <div class="alert alert-info mb-0">
        No leveraged POA&amp;Ms in scope. This list populates from
        <code>LeveragedAuthorization</code> records linking your boundaries to
        leveraged ones.
      </div>
    <% elsif @view_mode == :card %>
      <div class="sparc-card-grid">
        <% @leveraged_poams.each do |poam| %>
          <%= render "shared/item_card",
                title: poam.name,
                url: leveraged_poam_document_path(poam),
                badges: [ { text: poam.lifecycle_status.to_s.titleize, class: "badge bg-light text-dark" } ],
                subtitle: poam.authorization_boundary&.name,
                description: poam.description,
                metrics: [ { value: poam.poam_items.count, label: "items" } ],
                empty_note: "Read-only — owned by a leveraged boundary.",
                actions: render("leveraged_poam_documents/item_actions", poam: poam) %>
        <% end %>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
          <thead>
            <tr>
              <th>POA&amp;M</th>
              <th>Leveraged boundary</th>
              <th>Lifecycle</th>
              <th>Items</th>
              <th class="text-end">&nbsp;</th>
            </tr>
          </thead>
          <tbody>
            <% @leveraged_poams.each do |poam| %>
              <tr>
                <td><strong><%= poam.name %></strong></td>
                <td><%= poam.authorization_boundary&.name %></td>
                <td><%= poam.lifecycle_status %></td>
                <td><%= poam.poam_items.count %></td>
                <td class="text-end">
                  <%= render "leveraged_poam_documents/item_actions", poam: poam %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <%= render "shared/collection_pagination", pagy: @pagy, label: "leveraged POA&Ms" %>
  </div>
</div>
