<%# ── PROCESSING STATE BANNER ─────────────────────────────────────── %>
<% unless @control_catalog.completed? %>
  <%= render "shared/processing_banner",
       document:     @control_catalog,
       title:        "Importing Catalog",
       failed_title: "Import Failed",
       back_label:   "Back to Catalogs",
       back_path:    control_catalogs_path %>

<% else %>

<%# ── IMPORT QUALITY WARNINGS MODAL ──────────────────────────────── %>
<% import_warnings = @control_catalog.metadata_extra&.dig("import_warnings") %>
<% warnings_acknowledged = @control_catalog.metadata_extra&.dig("import_warnings_acknowledged") %>
<% if import_warnings.present? && !warnings_acknowledged %>
  <%= render "shared/import_warnings_modal",
       document: @control_catalog,
       warnings: import_warnings,
       acknowledge_path: acknowledge_warnings_control_catalog_path(@control_catalog) %>
<% end %>

<%# 1.18.0-rf #1304 — under SPARC_NAV_SHELL the shared document header
    (shared/_document_header): the format and pre-release badges beside the
    name; Edit Catalog as the main action, Import / Refresh and Add Family
    beside it. The pre-release note and the review panel stay under it. %>
<% if shell_nav? %>
  <% catalog_badges = capture do %>
    <% if @control_catalog.original_filename.present? %>
      <% ext = File.extname(@control_catalog.original_filename).delete(".").upcase %>
      <span class="badge sparc-status--<%= { "JSON" => "info", "XML" => "success", "YAML" => "purple", "YML" => "purple" }[ext] || "neutral" %>"><%= ext %></span>
    <% end %>
    <% if @control_catalog.nist_pre_release? %>
      <span class="badge sparc-status--warning" data-testid="nist-pre-release-badge">Pre-release</span>
    <% end %>
  <% end %>
  <% catalog_after = capture do %>
    <% if @control_catalog.nist_pre_release? %>
      <% source = NistCatalogSource.provenance %>
      <p class="text-body-secondary small mt-2" data-testid="nist-pre-release-note">
        This catalog includes NIST corrections to SA-15(13), SA-24 and SI-02(07) that NIST has not released yet.
        It was built from the <code><%= source["source_branch"] %></code> branch of
        <%= link_to "usnistgov/oscal-content", source["source_repository"], target: "_blank", rel: "noopener" %>
        at commit <code><%= source["source_commit"].to_s.first(8) %></code>, and will be replaced by NIST's release when it ships.
      </p>
    <% end %>
    <% if @control_catalog.description.present? %>
      <p class="text-body-secondary small mt-2 mb-0"><%= @control_catalog.description %></p>
    <% end %>
    <%= render "shared/document_review", doc: @control_catalog, may_write: can_write_catalogs?,
          submit_path: submit_for_review_control_catalog_path(@control_catalog),
          approve_path: approve_control_catalog_path(@control_catalog),
          reject_path: reject_control_catalog_path(@control_catalog) %>
  <% end %>
  <%= render "shared/document_header", document: @control_catalog, type: :catalog,
        version: @control_catalog.version, title_extra: catalog_badges,
        meta: [ (safe_join([ "Source: ", tag.strong(@control_catalog.source) ]) if @control_catalog.source.present?),
                pluralize(@control_families.size, "family", plural: "families"),
                pluralize(@control_catalog.total_controls, "control") ],
        after: catalog_after,
        primary: ({ label: "Edit Catalog", path: edit_control_catalog_path(@control_catalog) } if can_write_catalogs?),
        secondary: (can_write_catalogs? ? [ { label: "Import / Refresh", path: import_control_catalogs_path },
                                            { label: "＋ Add Family", path: new_control_catalog_control_family_path(@control_catalog) } ] : []),
        export: ("Catalog" if signed_in?), publish: signed_in? && @control_catalog.draft?,
        sections: [ [ "Families", "#catalog-families" ], [ "Metadata", "#oscal-metadata" ], [ "Back matter", "#oscal-back-matter" ] ] %>
<% end %>

<div class="card" id="catalog-families">
  <div class="card-body">
  <% unless shell_nav? %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2>
        <%= @control_catalog.name %>
        <% if @control_catalog.original_filename.present? %>
          <% ext = File.extname(@control_catalog.original_filename).delete(".").upcase %>
          <% ext_variant = { "JSON" => "info", "XML" => "success", "YAML" => "purple", "YML" => "purple" }[ext] || "neutral" %>
          <span class="badge sparc-status--<%= ext_variant %>" style="font-size: 0.55rem; vertical-align: middle;"><%= ext %></span>
        <% end %>
        <% if @control_catalog.nist_pre_release? %>
          <span class="badge sparc-status--warning" style="font-size: 0.55rem; vertical-align: middle;" data-testid="nist-pre-release-badge">Pre-release</span>
        <% end %>
      </h2>
      <% if @control_catalog.nist_pre_release? %>
        <% source = NistCatalogSource.provenance %>
        <p class="text-body-secondary" style="margin-top: 0.5rem;" data-testid="nist-pre-release-note">
          This catalog includes NIST corrections to SA-15(13), SA-24 and SI-02(07) that NIST has not released yet.
          It was built from the <code><%= source["source_branch"] %></code> branch of
          <%= link_to "usnistgov/oscal-content", source["source_repository"], target: "_blank", rel: "noopener" %>
          at commit <code><%= source["source_commit"].to_s.first(8) %></code>, and will be replaced by NIST's release when it ships.
        </p>
      <% end %>
      <p class="text-body-secondary" style="margin-top: 0.5rem;">
        <% if @control_catalog.version.present? %>
          Version: <strong><%= @control_catalog.version %></strong> &nbsp;|&nbsp;
        <% end %>
        <% if @control_catalog.source.present? %>
          Source: <strong><%= @control_catalog.source %></strong> &nbsp;|&nbsp;
        <% end %>
        Families: <strong><%= @control_families.size %></strong> &nbsp;|&nbsp;
        Total Controls: <strong><%= @control_catalog.total_controls %></strong>
      </p>
      <% if @control_catalog.description.present? %>
        <p class="text-body-secondary" style="margin-top: 0.5rem;"><%= @control_catalog.description %></p>
      <% end %>
      <%= render "shared/document_review", doc: @control_catalog, may_write: can_write_catalogs?,
            submit_path: submit_for_review_control_catalog_path(@control_catalog),
            approve_path: approve_control_catalog_path(@control_catalog),
            reject_path: reject_control_catalog_path(@control_catalog) %>
    </div>
    <div class="d-flex gap-2">
      <% if can_write_catalogs? %>
        <%= link_to "↑ Import / Refresh", import_control_catalogs_path,
              class: "sparc-action sparc-action--info sparc-action--solid fw-semibold", style: "font-size: 0.875rem;" %>
        <%= link_to "Edit Catalog", edit_control_catalog_path(@control_catalog), class: "sparc-action sparc-action--primary sparc-action--outline" %>
        <%= link_to "＋ Add Family", new_control_catalog_control_family_path(@control_catalog), class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <% end %>
      <% if signed_in? && @control_catalog.draft? %>
        <%= render "shared/publish_button", document: @control_catalog,
              publish_path: publish_control_catalog_path(@control_catalog),
              check_path: publish_check_control_catalog_path(@control_catalog) %>
      <% end %>
      <% if signed_in? %>
        <%= render "shared/oscal_export_dropdown",
              validate_path: validate_oscal_export_control_catalog_path(@control_catalog),
              download_json_path: download_oscal_validated_control_catalog_path(@control_catalog),
              download_yaml_path: download_yaml_control_catalog_path(@control_catalog),
              download_xml_path: download_xml_control_catalog_path(@control_catalog),
              fallback_json_path: download_oscal_unvalidated_control_catalog_path(@control_catalog),
              document_type: "Catalog" %>
      <% end %>
      <%= link_to "← All Catalogs", control_catalogs_path, class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>
  </div>

  <% end %>
  <% if @control_families.any? %>
    <table class="table table-hover">
      <thead>
        <tr>
          <th style="width: 80px;">Code</th>
          <th>Family Name</th>
          <th>Description</th>
          <th class="text-center">Controls</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @control_families.each do |family| %>
          <tr>
            <td>
              <span class="fw-bold bg-body-secondary rounded" style="font-family: monospace; font-size: 1rem; padding: 0.25rem 0.6rem;">
                <%= family.code %>
              </span>
              <%# #1115 — no longer published by the catalog's source; kept for the
                  assessments recorded against it. %>
              <% if family.retired? %>
                <span class="badge sparc-status--neutral ms-1">Retired</span>
              <% end %>
            </td>
            <td><strong><%= link_to family.name, family, class: "text-primary", style: "text-decoration: none;" %></strong></td>
            <td class="text-body-secondary small"><%= truncate(family.description, length: 80) %></td>
            <% retired_count = family.catalog_controls.to_a.count(&:retired?) %>
            <td class="text-center">
              <%= family.catalog_controls.size - retired_count %>
              <% if retired_count.positive? %><div class="small text-body-secondary">+<%= retired_count %> retired</div><% end %>
            </td>
            <td>
              <div class="d-flex gap-2">
                <%= link_to "View", family, class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm" %>
                <% if can_write_catalogs? %>
                  <%= link_to "Edit", edit_control_family_path(family), class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm" %>
                  <%= button_to "Delete", family, method: :delete,
                      form: { data: { turbo_confirm: "Delete family #{family.code}? This removes all its controls." } },
                      class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="text-center text-body-secondary p-4">
      <p>No families yet.
        <% if can_write_catalogs? %>
          <%= link_to "Add the first family", new_control_catalog_control_family_path(@control_catalog), class: "text-primary" %>
        <% end %>
      </p>
    </div>
  <% end %>
  </div>
</div>

<%# ── DATA QUALITY CARD (#237) ──────────────────────────────── %>
<%= render "shared/data_quality_card",
           warnings: @control_catalog.metadata_extra&.dig("import_warnings") || [],
           summary: @control_catalog.metadata_extra&.dig("import_warnings_summary") || {},
           revalidate_path: revalidate_control_catalog_path(@control_catalog),
           catalog: @control_catalog %>

<%= render "shared/uuid_replaced_warning", document: @control_catalog %>

<%= render "shared/oscal_metadata_section",
           document: @control_catalog,
           update_path: update_metadata_control_catalog_path(@control_catalog),
           param_key: :control_catalog,
           version_field: :version %>

<%= render "shared/oscal_back_matter_section",
           document: @control_catalog,
           resources_path: control_catalog_back_matter_resources_path(@control_catalog) %>
<% end %>
