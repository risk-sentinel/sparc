<%= render "shared/section_summary", tiles: [
  [@total_count, "Baselines"],
  [@controls_count, "Total Controls"],
  [@completed_count, "Completed"]
] %>

<% if @profile_documents.any? { |d| d.processing? || d.pending? } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="10000" hidden></div>
<% end %>

<div class="card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Baselines / Profiles</h2>
    <% if signed_in? %>
      <div class="sparc-d-inline-flex sparc-gap-05">
        <%= link_to "Upload New", new_profile_document_path, class: "sparc-action sparc-action--info sparc-action--solid" %>
        <%= link_to "Create from Catalog", select_catalog_profile_documents_path, class: "sparc-action sparc-action--positive sparc-action--solid" %>
        <%= link_to "Create from Profile", select_profile_profile_documents_path, class: "sparc-action sparc-action--positive sparc-action--solid" %>
      </div>
    <% end %>
  </div>

  <%= render "shared/collection_toolbar",
        label: "profiles", placeholder: "Search baselines / profiles…",
        filter_fields: @filter_fields, facets: @facets, clear_params: @clear_facets,
        view_mode: (@profile_documents.any? ? @view_mode : nil) %>

  <% if @profile_documents.any? && @view_mode == :card %>
    <div class="sparc-card-grid">
      <% @profile_documents.each do |doc| %>
        <%= render "shared/item_card", **document_card_slots(
              doc, count: doc.profile_controls.count, count_label: "controls").merge(
              url: profile_document_path(doc),
              actions: render("profile_documents/item_actions", doc: doc)) %>
      <% end %>
    </div>
  <% elsif @profile_documents.any? %>
    <table class="table table-hover sparc-table-layout-fixed sparc-w-100pct">
      <thead>
        <tr>
          <th class="sparc-w-22pct">Name</th>
          <th class="sparc-w-9pct">Baseline</th>
          <th class="sparc-w-8pct sparc-ws-nowrap">Version</th>
          <th class="sparc-w-10pct sparc-ws-nowrap">Status</th>
          <th class="sparc-w-18pct sparc-ws-nowrap">Source Catalog</th>
          <th class="sparc-w-7pct sparc-ws-nowrap">Controls</th>
          <th class="sparc-w-9pct sparc-ws-nowrap">Created</th>
          <th class="text-end sparc-w-17pct">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @profile_documents.each do |doc| %>
          <tr>
            <td><strong><%= link_to doc.name, profile_document_path(doc), class: "text-primary sparc-td-none" %></strong></td>
            <td>
              <% level_variants = { "LOW" => "success", "MODERATE" => "warning", "HIGH" => "danger" } %>
              <span class="sparc-status sparc-status--<%= level_variants[doc.baseline_level] || 'neutral' %>">
                <%= doc.baseline_level || "Custom" %>
              </span>
            </td>
            <td class="small text-body-secondary sparc-ws-nowrap"><%= doc.profile_version.presence || "—" %></td>
            <td class="sparc-ws-nowrap">
              <% if doc.pending? || doc.processing? || doc.failed? %>
                <span class="<%= doc.failed? ? 'badge-fail' : 'badge-warn' %> rounded fw-semibold sparc-p-02-06 sparc-fs-078">
                  <%= doc.status.titleize %>
                </span>
                <% if doc.processing? && doc.metadata_extra&.dig("processing_message").present? %>
                  <br><span class="text-body-secondary sparc-fs-072"><%= doc.metadata_extra["processing_message"] %></span>
                <% end %>
              <% else %>
                <span class="<%= doc.lifecycle_badge_class %> rounded fw-semibold sparc-p-02-06 sparc-fs-078 sparc-ws-nowrap">
                  <%= doc.lifecycle_label %>
                </span>
              <% end %>
            </td>
            <td class="sparc-text-ellipsis" title="<%= doc.control_catalog&.name %>">
              <% if doc.control_catalog.present? %>
                <%= doc.control_catalog.name %>
                <% if doc.control_catalog.short_digest.present? %>
                  <br><span class="text-body-secondary sparc-fs-072"><%= doc.control_catalog.short_digest %></span>
                <% end %>
              <% else %>
                <span class="text-body-tertiary">&mdash;</span>
              <% end %>
            </td>
            <td><%= doc.profile_controls.count %></td>
            <td class="sparc-ws-nowrap sparc-fs-085"><%= doc.created_at.strftime("%Y-%m-%d") %></td>
            <td class="text-end sparc-ws-nowrap">
              <%= render "profile_documents/item_actions", doc: doc %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center p-4 text-body-secondary">No profiles found. Upload your first OSCAL Profile (Baseline) to get started.</p>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "profiles" %>
</div>
