<%# ── PROCESSING STATE BANNER ─────────────────────────────────────── %>
<% unless @profile_document.completed? %>
  <%= render "shared/processing_banner",
       document:     @profile_document,
       title:        "Processing Your Profile",
       back_label:   "Back to Profiles",
       back_path:    profile_documents_path %>

<% else %>
<%
  priority_total = @priority_counts.values.sum
  p1_count = @priority_counts["P1"].to_i
  p2_count = @priority_counts["P2"].to_i
  p3_count = @priority_counts["P3"].to_i
  none_count = @priority_counts[nil].to_i + (@priority_counts.reject { |k, _| %w[P1 P2 P3].include?(k) || k.nil? }.values.sum)

  level_colors = { "LOW" => ApplicationHelper::COLOR_GREEN, "MODERATE" => ApplicationHelper::COLOR_ORANGE,
                   "HIGH" => ApplicationHelper::COLOR_RED }
  level_color  = level_colors[@profile_document.baseline_level] || ApplicationHelper::COLOR_GRAY_DARK
%>

<div data-controller="doc-meta family-toggle heatmap-chip"
     data-family-toggle-selector-value="#controlsContainer > details.sparc-family-group">

<%# ── #911: catalog lineage. Discovered by looking, not by being
     refused mid-edit. Renders nothing when reconciled. %>
<%= render "shared/reconciliation_banner", document: @profile_document %>

<%# ── #928: the source catalog, changeable ───────────────────────────
     The banner above carries a picker only while the document is BLOCKED,
     which leaves two reachable states with no way to link a catalog at all:
     an imported profile that references no controls yet (nothing to
     reconcile, so no banner) and a profile already linked to the wrong
     catalog (reconciled, so the banner is gone). Both dead-end, because
     "Manage Controls" and the publish button are themselves hidden until a
     catalog exists — the profile becomes permanently unpublishable.

     Rendered only where the banner is NOT already offering the same control,
     so the two never appear together. %>
<% if signed_in? && can_write_profiles? &&
     !@profile_document.published_lifecycle? &&
     !@profile_document.reconciliation_blocks_update? %>
  <div class="card mt-2 mb-0 <%= "border-warning" if @profile_document.control_catalog.blank? %>">
    <div class="card-body py-2">
      <% if @profile_document.control_catalog.blank? %>
        <p class="mb-2">
          <strong>No source catalog is linked.</strong>
          A profile selects controls from a catalog, so until one is set this
          profile cannot be published and its controls cannot be managed.
        </p>
      <% end %>
      <%= render "shared/baseline_picker",
            document: @profile_document,
            submit_label: @profile_document.control_catalog.present? ? "Change catalog" : "Link catalog" %>
    </div>
  </div>
<% end %>

<%# #1234 — imports that matched no loaded catalog: their controls carry no
    title or source until the catalog is loaded and the baseline re-imported. %>
<% unlinked_imports = Array(@profile_document.import_metadata&.dig("unlinked_imports")) %>
<% if unlinked_imports.any? %>
  <div class="alert alert-warning mt-2 mb-0" data-testid="unlinked-imports">
    <strong>
      <%= pluralize(unlinked_imports.size, "import") %> matched no loaded catalog.
    </strong>
    Their controls have no title and no source catalog. Load the catalog (or give
    it a name no other catalog has) and import this baseline again.
    <ul class="mb-0 mt-1">
      <% unlinked_imports.each do |imp| %>
        <li>
          <%= imp["title"].presence || imp["href"] %>:
          <%= Array(imp["control_ids"]).first(10).join(", ") %><%= " …" if Array(imp["control_ids"]).size > 10 %>
          <%# #1252 — these select from the catalog itself, so without it they select nothing. %>
          <% if Array(imp["unresolved_selectors"]).any? %>
            <div data-testid="unresolved-selectors">
              Not applied until the catalog is loaded: <%= Array(imp["unresolved_selectors"]).join(", ") %>.
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# #1252 — ids a profile names that its catalog does not hold. A profile can
    tailor a control but cannot add one, so these select nothing. %>
<% unknown_imports = Array(@profile_document.import_metadata&.dig("imports")).select { |imp| Array(imp["unknown_ids"]).any? } %>
<% if unknown_imports.any? %>
  <div class="alert alert-warning mt-2 mb-0" data-testid="unknown-control-ids">
    <strong>This baseline names controls its catalog does not have.</strong>
    <ul class="mb-0 mt-1">
      <% unknown_imports.each do |imp| %>
        <li>
          <%= imp["title"].presence || imp["href"] %>:
          <%= Array(imp["unknown_ids"]).first(10).join(", ") %><%= " …" if Array(imp["unknown_ids"]).size > 10 %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# ── HEADER DASHBOARD ──────────────────────────────────────────── %>
<div class="sparc-dashboard-header">

  <div class="d-flex justify-content-between align-items-start mb-4 gap-3 flex-wrap">
    <div>
      <div class="sparc-header-subtitle">OSCAL Profile / Baseline</div>

      <%# ── View mode ── %>
      <div id="doc-meta-view" data-doc-meta-target="view">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h2 class="sparc-header-title"><%= @profile_document.name %></h2>
          <% if @profile_document.profile_version.present? %>
            <span class="sparc-version-badge">v<%= @profile_document.profile_version %></span>
          <% end %>
          <% if signed_in? && !@profile_document.published_lifecycle? %>
            <button type="button" data-action="doc-meta#toggle" class="sparc-action sparc-action--primary sparc-action--outline">Edit</button>
          <% end %>
        </div>
        <%# #1180 — the document's own UUID, under the name, in the same
            treatment every other screen uses. Copyable: this is the
            identifier the federation key grammar keys objects on. %>
        <div class="mt-1">
          <%= render "shared/uuid_badge", uuid: @profile_document.uuid, name: "document UUID" %>
        </div>
      </div>

      <% if signed_in? && !@profile_document.published_lifecycle? %>
        <%# ── Edit mode (hidden) ── %>
        <div id="doc-meta-edit" data-doc-meta-target="edit" class="sparc-d-none">
          <%= render "shared/document_name_form", document: @profile_document,
                update_path: update_metadata_profile_document_path(@profile_document),
                version_field: :profile_version %>
        </div>
      <% end %>

      <div class="sparc-header-meta">
        <%= @profile_document.original_filename %>
        &nbsp;&bull;&nbsp;
        <span class="fw-semibold sparc-accent-text <%= accent_class(level_color) %>"><%= @profile_document.baseline_level || "Custom" %></span>
        &nbsp;&bull;&nbsp; <%= @total_controls %> controls
        &nbsp;&bull;&nbsp;
        <% if @profile_document.control_catalog.present? %>
          Source: <span class="fw-semibold"><%= @profile_document.control_catalog.name %></span>
          <% if @profile_document.control_catalog.short_digest.present? %>
            <code class="sparc-fs-075 sparc-color-white-50 sparc-ml-02"><%= @profile_document.control_catalog.short_digest %></code>
          <% end %>
        <% else %>
          <%# #928 — an unlinked profile said nothing at all here, so the state
              that blocks publishing was invisible until the publish button
              failed to appear. Name it where the source normally goes. %>
          <span class="fw-semibold sparc-accent-text sparc-accent--orange">No source catalog</span>
        <% end %>
        <% if @profile_document.source_profile.present? %>
          &nbsp;&bull;&nbsp;
          Derived from: <%= link_to @profile_document.source_profile.name,
                                    profile_document_path(@profile_document.source_profile),
                                    class: "sparc-header-link" %>
        <% end %>
        &nbsp;&bull;&nbsp;
        <span class="<%= @profile_document.lifecycle_badge_class %> rounded fw-semibold sparc-p-015-05 sparc-fs-078">
          <%= @profile_document.lifecycle_label %>
        </span>
      </div>
      <% if @profile_document.description.present? %>
        <div class="sparc-fs-082 sparc-color-white-45 sparc-mt-04 sparc-maxw-600"><%= truncate(@profile_document.description, length: 200) %></div>
      <% end %>
    </div>
    <div class="d-flex gap-2 flex-shrink-0 flex-wrap">
      <% if signed_in? %>
        <% if @profile_document.published_lifecycle? %>
          <%= button_to "Create Editable Copy", copy_profile_document_path(@profile_document), method: :post,
                class: "sparc-action sparc-action--positive sparc-action--solid", form: { data: { turbo_confirm: "Create an editable copy of this published profile?" } } %>
        <% else %>
          <%= button_to "Copy", copy_profile_document_path(@profile_document), method: :post,
                class: "sparc-action sparc-action--info sparc-action--outline", form: { data: { turbo_confirm: "Duplicate this profile?" } } %>
          <%= link_to "+ Add Control", new_profile_document_profile_control_path(@profile_document),
                class: "sparc-action sparc-action--positive sparc-action--solid" %>
          <% if @profile_document.control_catalog.present? %>
            <%= link_to "Manage Controls", manage_controls_profile_document_path(@profile_document),
                  class: "sparc-action sparc-action--neutral sparc-action--outline" %>
          <% end %>
          <% if @profile_document.control_catalog.present? %>
            <%= render "shared/publish_button", document: @profile_document,
                  publish_path: publish_profile_document_path(@profile_document),
                  check_path: publish_check_profile_document_path(@profile_document) %>
          <% end %>
        <% end %>
      <% end %>
      <% resolved_catalog_item = capture do %>
        <% if @profile_document.resolved_catalog_json.present? %>
          <li><h6 class="dropdown-header">Resolved Catalog</h6></li>
          <li><%= link_to "JSON (Resolved)", download_resolved_catalog_profile_document_path(@profile_document), class: "dropdown-item" %></li>
        <% end %>
      <% end %>
      <%= render "shared/oscal_export_dropdown",
            validate_path: validate_oscal_export_profile_document_path(@profile_document),
            download_json_path: download_oscal_validated_profile_document_path(@profile_document),
            download_yaml_path: download_yaml_profile_document_path(@profile_document),
            download_xml_path: download_xml_profile_document_path(@profile_document),
            fallback_json_path: download_oscal_unvalidated_profile_document_path(@profile_document),
            document_type: "Profile",
            extra_items: resolved_catalog_item %>
      <%= link_to "&#8592; Back".html_safe, profile_documents_path,
            class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>
  </div>

  <div class="d-flex align-items-center gap-4 flex-wrap">
    <div class="text-center flex-shrink-0 sparc-minw-80px">
      <div class="sparc-score sparc-color-white"><%= @total_controls %></div>
      <div class="sparc-score-label">Selected Controls</div>
    </div>

    <div class="sparc-divider-v"></div>

    <div class="d-flex flex-wrap gap-2 sparc-flex-1">
      <%# #1270 — the "not set" chip filtered on "None" while each control card
          carries LABEL_NONE ("(None)"), so it hid every control. The filter
          value is now the card's own label. %>
      <% [["P1", "P1", p1_count, "#e74c3c"], ["P2", "P2", p2_count, "#f39c12"], ["P3", "P3", p3_count, "#3498db"],
          ["Not set", ApplicationHelper::LABEL_NONE, none_count, "#95a5a6"]].each do |pri, filter, count, color| %>
        <% next if count == 0 %>
        <div class="summary-chip sparc-summary-chip sparc-border-l-3 <%= accent_class(color) %>"
             data-filter-value="<%= filter %>"
             data-action="click->heatmap-chip#apply keydown.enter->heatmap-chip#apply keydown.space->heatmap-chip#apply"
             data-heatmap-chip-filter-param="<%= filter %>"
             role="button"
             tabindex="0"
             title="Click to filter: <%= pri %>">
          <div class="sparc-chip-count"><%= count %></div>
          <div class="sparc-chip-label"><%= pri %></div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-3">
    <div class="sparc-progress-bar">
      <% [["P1", p1_count, "#e74c3c"], ["P2", p2_count, "#f39c12"], ["P3", p3_count, "#3498db"], ["None", none_count, "#95a5a6"]].each do |pri, count, color| %>
        <% next if count == 0 %>
        <div class="sparc-bar-fill sparc-accent-bg <%= accent_class(color) %>"
             data-controller="bar"
             data-bar-pct-value="<%= (count * 100.0 / [priority_total, 1].max).round(3) %>"
             title="<%= pri %>: <%= count %>"></div>
      <% end %>
    </div>
  </div>
</div>

<%# ── PRIORITY HEATMAP BY CONTROL FAMILY ─────────────────────────── %>
<%= render "shared/heatmap",
     heatmap_data: @heatmap_data,
     heatmap_families: @heatmap_families,
     heatmap_statuses: @heatmap_priorities,
     title: "Priority by Control Family",
     variant_helper: :profile_priority_variant,
     filter_key: "priority",
     show_percentage: false,
     legend_items: [["P1 (High)", "#e74c3c"], ["P2 (Medium)", "#f39c12"], ["P3 (Low)", "#3498db"], ["None", "#95a5a6"]] %>

<%# ── FAMILY-GROUPED CONTROL LIST ──────────────────────────────── %>
<%# #1270 — on a profile the user may tailor, each control's priority is set
    in place, and controls can be selected and changed together from the bulk
    bar. Both write through ProfileControlBulkEditService, as the API does. %>
<% can_tailor = signed_in? && can_write_profiles? && !@profile_document.published_lifecycle? %>
<% priority_accents = (ProfileControl::PRIORITIES + [ "" ]).to_h { |p|
     [ p, accent_class({ "P1" => ApplicationHelper::COLOR_RED, "P2" => ApplicationHelper::COLOR_ORANGE,
                         "P3" => ApplicationHelper::COLOR_BLUE }[p] || ApplicationHelper::COLOR_GRAY) ] } %>
<div id="controlsContainer"<% if can_tailor %> data-controller="bulk-select"<% end %>>
  <% if can_tailor %>
    <%= form_with url: bulk_profile_document_profile_controls_path(@profile_document), method: :patch, local: true,
          id: "profile-bulk-form",
          html: { class: "sparc-bulk-bar", hidden: true, data: { bulk_select_target: "bar", testid: "bulk-bar" },
                  aria: { label: "Change the selected controls" } } do %>
      <span class="fw-semibold" role="status"><span data-bulk-select-target="count">0</span> selected</span>
      <span class="d-flex align-items-center gap-1">
        <%= select_tag "priority",
              options_for_select(ProfileControl::PRIORITIES.map { [ _1, _1 ] } + [ [ "Clear priority", "" ] ]),
              id: "bulk-priority", class: "form-select form-select-sm", aria: { label: "Priority for the selected controls" } %>
        <%= button_tag "Set priority", name: "bulk_action", value: "priority",
              class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm" %>
      </span>
      <% if @bulk_resources&.any? %>
        <span class="d-flex align-items-center gap-1">
          <%= select_tag "resource_id", options_from_collection_for_select(@bulk_resources, :id, :title),
                id: "bulk-resource", class: "form-select form-select-sm",
                aria: { label: "Back-matter resource for the selected controls" } %>
          <%= button_tag "Link resource", name: "bulk_action", value: "link",
                class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm" %>
          <%= button_tag "Unlink resource", name: "bulk_action", value: "unlink",
                class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm" %>
        </span>
      <% end %>
      <button type="button" data-action="bulk-select#clear"
              class="sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm">Clear selection</button>
    <% end %>
  <% end %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <span class="form-label fw-semibold mb-0"><%= @total_controls %> controls in this profile</span>
    <div class="d-flex gap-1">
      <button type="button" class="sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" data-action="family-toggle#expandAll">Expand All</button>
      <button type="button" class="sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" data-action="family-toggle#collapseAll">Collapse All</button>
    </div>
  </div>

  <% @sorted_families.each do |family_code| %>
    <% family_controls = @controls_by_family[family_code] %>
    <% next if family_controls.blank? %>

    <details class="sparc-family-group">
      <summary>
        <strong><%= family_code %></strong> &mdash; <%= @family_names[family_code] || family_code %>
        <span class="badge bg-secondary" data-heatmap-count="<%= family_controls.size %>"><%= family_controls.size %></span>
      </summary>

      <div class="mt-2">
        <% if can_tailor %>
          <label class="form-check sparc-fs-078 mb-2">
            <input type="checkbox" class="form-check-input" data-group="<%= family_code %>"
                   data-action="change->bulk-select#toggleGroup">
            <span class="form-check-label">Select all <%= family_code %> controls shown</span>
          </label>
        <% end %>
        <% family_controls.sort_by { |c| @sort_id_map[c.control_id] || c.control_id.gsub(/\d+/) { |n| n.rjust(3, "0") } }.each do |control| %>
          <%
            field_map    = control.profile_control_fields.index_by(&:field_name)
            pri_val      = control.priority.presence || "(None)"
            pri_colors_map = { "P1" => ApplicationHelper::COLOR_RED, "P2" => ApplicationHelper::COLOR_ORANGE,
                               "P3" => ApplicationHelper::COLOR_BLUE }
            pri_color    = pri_colors_map[pri_val] || ApplicationHelper::COLOR_GRAY
            pri_variant  = profile_priority_variant(pri_val)
          %>
          <div class="control-card sparc-border-l-4 <%= accent_class(pri_color) %>"
               data-family="<%= family_code %>"
               data-priority="<%= pri_val %>">

            <%# ── Card header ── %>
            <div class="d-flex justify-content-between align-items-start sparc-gap-1r">
              <div class="sparc-minw-0 sparc-flex-1">
                <div class="d-flex align-items-center gap-2 flex-wrap sparc-mb-02">
                  <% if can_tailor %>
                    <input type="checkbox" class="form-check-input mt-0" name="control_ids[]"
                           value="<%= control.control_id %>" form="profile-bulk-form"
                           aria-label="Select <%= control.display_id %>"
                           data-bulk-select-target="row" data-group="<%= family_code %>"
                           data-action="change->bulk-select#toggle">
                  <% end %>
                  <span class="sparc-ctrl-id">
                    <%= control.display_id.presence || "&mdash;".html_safe %>
                  </span>
                  <% if can_tailor %>
                    <%# An imported value outside P1–P3 stays selectable, so the
                        selector never shows a priority the control does not have. %>
                    <% choices = [ [ "Priority not set", "" ] ] + ProfileControl::PRIORITIES.map { [ _1, _1 ] } %>
                    <% choices << [ control.priority, control.priority ] if control.priority.present? && ProfileControl::PRIORITIES.exclude?(control.priority) %>
                    <span class="d-inline-flex align-items-center gap-1"
                          data-controller="priority-select"
                          data-priority-select-url-value="<%= bulk_profile_document_profile_controls_path(@profile_document) %>"
                          data-priority-select-control-id-value="<%= control.control_id %>"
                          data-priority-select-accents-value="<%= priority_accents.to_json %>">
                      <%= select_tag "priority", options_for_select(choices, control.priority.to_s),
                            id: "priority-#{control.id}",
                            class: "sparc-priority-select#{' sparc-priority-select--unset' if control.priority.blank?}",
                            aria: { label: "Priority for #{control.display_id}" },
                            data: { priority_select_target: "select", action: "change->priority-select#save" } %>
                      <span class="sparc-fs-072" role="status" data-priority-select-target="status"></span>
                    </span>
                  <% else %>
                    <span class="sparc-status-pill sparc-status--<%= pri_variant %>">
                      <%= pri_val %>
                    </span>
                  <% end %>
                </div>
                <% if control.title.present? %>
                  <div class="sparc-ctrl-title"><%= control.title %></div>
                <% end %>
              </div>
              <% if signed_in? && !@profile_document.published_lifecycle? %>
                <div class="d-flex flex-shrink-0 sparc-gap-035">
                  <%= link_to "Edit", edit_profile_document_profile_control_path(@profile_document, control),
                        class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm" %>
                  <%= button_to "Delete", profile_document_profile_control_path(@profile_document, control),
                        method: :delete,
                        form: { data: { turbo_confirm: "Remove #{control.display_id} from this profile?" } },
                        class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm" %>
                </div>
              <% end %>
            </div>

            <%# ── What the baseline requires (collapsed by default) ── %>
            <%# #997 — the control language, its parameters WITH this profile's
                values substituted, its priority, guidance and related controls.
                Assembled by BaselineControlDetail and rendered by the same
                partial the SSP screen uses, so the two cannot drift. %>
            <% catalog_ctrl = @catalog_controls_by_id[control.control_id] %>
            <% param_values = field_map.filter_map { |k, v|
                 [ k.delete_prefix("parameter:"), v.field_value ] if k.start_with?("parameter:") && !k.start_with?("parameter_label:")
               }.to_h %>
            <% sub_parts    = @catalog_sub_parts[control.control_id] %>
            <% detail = catalog_ctrl && BaselineControlDetail.new(catalog_ctrl,
                          values: param_values, priority: control.priority,
                          sub_parts: sub_parts) %>
            <% prop_fields  = field_map.select { |k, _| k.start_with?("prop:") } %>
            <% alters       = Array(control.alters) %>
            <% has_details  = detail&.any? || prop_fields.any? || sub_parts&.any? || alters.any? %>
            <% if has_details %>
              <details class="card-details sparc-mt-035">
                <%# #997 — the toggle used to be a bare arrow, so nothing said
                    there was anything behind it. It is now labelled with what
                    it opens, which is the difference between a screen that
                    holds the baseline and one that shows it. %>
                <summary class="sparc-card-detail-toggle d-flex align-items-center gap-1">
                  <span class="card-arrow sparc-card-arrow">&#9658;</span>
                  <span class="sparc-fs-078">
                    <%= detail&.any? ? "What this baseline requires" : "Details" %>
                    <% if detail&.parameters&.any? %>
                      <span class="badge rounded-pill text-bg-info sparc-fs-066">
                        <%= detail.parameters.size %> param<%= "s" unless detail.parameters.size == 1 %>
                      </span>
                    <% end %>
                  </span>
                  <span class="sparc-card-detail-separator"></span>
                </summary>

                <div class="mt-2">
                  <% if detail&.any? %>
                    <%= render "shared/baseline_control_detail",
                          detail: detail,
                          editable: signed_in? && can_write_profiles? && !@profile_document.published_lifecycle?,
                          form_url: parameters_profile_document_profile_control_path(@profile_document, control),
                          anchor_id: "control-#{control.id}" %>
                  <% end %>

                  <%# #1252 — what this baseline removes from and adds to the
                      catalog's control. The resolved catalog, requirement text
                      and SSP generation all apply it (ProfileAlterations). %>
                  <% if alters.any? %>
                    <%= render "profile_documents/control_alters", alters: alters %>
                  <% end %>

                  <% if prop_fields.any? %>
                    <table class="sparc-field-table">
                      <% prop_fields.each do |fname, field| %>
                        <tr>
                          <th scope="row" class="sparc-field-label sparc-w-30pct">
                            <%= fname.delete_prefix("prop:").tr("_", " ") %>
                          </th>
                          <td class="sparc-field-value">
                            <%= field.field_value %>
                          </td>
                        </tr>
                      <% end %>
                    </table>
                  <% end %>

                  <%# #1002 — the sub-parts block used to live HERE, outside the
                      shared partial. That is why it rendered raw
                      `{{ insert: param, ... }}` and why the SSP screen showed no
                      implementation statements at all. It now renders from
                      shared/_baseline_control_detail via detail.sub_parts. %>
                </div>
              </details>
            <% end %>

          </div><%# end .control-card %>
        <% end %>
      </div>
    </details>
  <% end %>
</div>

<%= render "shared/uuid_replaced_warning", document: @profile_document %>

<%= render "shared/oscal_metadata_section",
           document: @profile_document,
           update_path: update_metadata_profile_document_path(@profile_document),
           param_key: :profile_document,
           version_field: :profile_version %>

<%= render "shared/oscal_back_matter_section",
           document: @profile_document,
           resources_path: profile_document_back_matter_resources_path(@profile_document) %>

</div><%# end data-controller wrapper %>

