<%= render "shared/section_summary", tiles: [
  [@total_count, "Evidence Records"],
  [@link_count, "Control Links"]
] %>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2>Evidence Repository</h2>
        <p class="text-body-secondary mb-0">
          <%= @evidences.size %> evidence record<%= @evidences.size == 1 ? "" : "s" %>
        </p>
      </div>
      <div class="d-flex gap-2">
        <%= link_to "Add Evidence", new_evidence_path, class: "sparc-action sparc-action--positive sparc-action--solid" %>
      </div>
    </div>

    <%# #908 — the filters were a hand-written form here that re-emitted `q` and
        `view` but dropped `per_page`, so filtering silently reset the page
        size. They come through the shared toolbar now, like every other
        collection screen. %>
    <%= render "shared/collection_toolbar",
          label: "evidence records", placeholder: "Search evidence…",
          filter_fields: @filter_fields, facets: @facets, clear_params: @clear_facets,
          view_mode: (@evidences.any? ? @view_mode : nil) %>

    <% if @evidences.any? && @tiering&.tiered? %>
      <%# #948 — tiering is AUTOMATIC, not a view mode: it appears only when the
          user can actually see more than one boundary, so a single-boundary
          user never pays for a tree with one branch. Card/list still applies
          inside each tier. %>
      <%= render "shared/collection_tiers",
            tiering: @tiering,
            records_partial: "evidences/collection",
            records_local: :records,
            view_mode: @view_mode,
            screen: "evidences" %>
    <% elsif @evidences.any? %>
      <%= render "evidences/collection", records: @evidences, view_mode: @view_mode %>
    <% else %>
      <div class="text-center text-body-secondary p-4">
        <p>No evidence records found. <%= link_to "Add evidence", new_evidence_path, class: "text-primary" %> to get started.</p>
      </div>
    <% end %>
  </div>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "evidence records" %>
</div>
