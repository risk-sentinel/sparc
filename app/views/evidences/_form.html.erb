<div class="card">
  <div class="card-body">
    <h2 class="mb-4"><%= @evidence.persisted? ? "Edit Evidence" : "Upload Evidence" %></h2>

    <%# #947 — the form adapts to the evidence type: an attestation asks for a
        statement and an attester and treats a file as optional; every other
        type asks for the file. Server-side validation enforces both, so this
        is convenience, not the constraint. %>
    <%= form_with model: @evidence, local: true, html: { multipart: true },
          data: { controller: "evidence-type-fields",
                  evidence_type_fields_attestation_types_value: Evidence::ATTESTATION_TYPES.to_json } do |f| %>
      <% if @evidence.errors.any? %>
        <div class="alert alert-danger">
          <h6 class="fw-semibold"><%= pluralize(@evidence.errors.count, "error") %> prevented saving:</h6>
          <ul class="mb-0">
            <% @evidence.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :title, class: "form-label fw-semibold" do %>Title <span class="text-danger">*</span><% end %>
          <%= f.text_field :title, class: "form-control", placeholder: "e.g. AC-1 Policy Document Screenshot" %>
        </div>
        <div class="col-md-3">
          <%= f.label :evidence_type, class: "form-label fw-semibold" do %>Evidence Type <span class="text-danger">*</span><% end %><%= field_help "What this evidence IS — most types describe a file, such as a screenshot or scan output. Attestation is the exception: the statement itself is the evidence and no file is required." %>
          <%= f.select :evidence_type,
              options_for_select(Evidence::EVIDENCE_TYPE_LABELS.map { |k, v| [ v, k ] }, @evidence.evidence_type),
              {}, class: "form-select",
              data: { evidence_type_fields_target: "type",
                      action: "change->evidence-type-fields#refresh" } %>
        </div>
        <div class="col-md-3">
          <%= f.label :status, "Status", class: "form-label fw-semibold" %><%= field_help "How far this has got in review, not whether the control passes. Only Attested means someone has formally signed off; Expired keeps it on record without counting as current." %>
          <%= f.select :status,
              options_for_select(Evidence::STATUS_LABELS.map { |k, v| [ v, k ] }, @evidence.status),
              {}, class: "form-select" %>
        </div>
      </div>

      <div class="mb-3">
        <%= f.label :description, "Description", class: "form-label fw-semibold" %><%= field_help "What an assessor needs in order to accept this without coming back to ask: what it shows, and why it satisfies the control." %>
        <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "Describe the evidence and its relevance to the control(s)..." %>
      </div>

      <%# #903 — Collected By and Collection Date are provenance, not input.
          The server stamps both on create (#738, NIST AU-10 non-repudiation)
          and neither is a permitted parameter, so the editable fields that used
          to sit here were purely misleading: a user could type a name, or pick
          a date in the future, and watch the server discard it. They are shown
          read-only instead — the value is still worth seeing, it is just not
          the user's to set. %>
      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <span class="form-label fw-semibold d-block" id="evidence_collected_by_label">Collected By</span>
          <p class="form-control-plaintext mb-0" aria-labelledby="evidence_collected_by_label">
            <%= @evidence.collected_by.presence || content_tag(:span, "Recorded on save", class: "text-body-secondary fst-italic") %>
          </p>
        </div>
        <div class="col-md-4">
          <span class="form-label fw-semibold d-block" id="evidence_collected_at_label">Collection Date</span>
          <p class="form-control-plaintext mb-0" aria-labelledby="evidence_collected_at_label">
            <%= @evidence.collected_at&.utc&.strftime("%Y-%m-%d %H:%M UTC") || content_tag(:span, "Recorded on save", class: "text-body-secondary fst-italic") %>
          </p>
        </div>
        <div class="col-md-4">
          <%= f.label :source, "Source", class: "form-label fw-semibold" %><%= field_help "Where it came from — the scanner, system or person that produced it. This is the provenance an assessor checks first." %>
          <%= f.text_field :source, class: "form-control", placeholder: "e.g. InSpec, Vulcan, Manual" %>
        </div>
      </div>
      <div class="form-text mb-3">
        Collected By and Collection Date are recorded automatically by SPARC when
        the evidence is saved, in UTC. They cannot be edited.
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :authorization_boundary_id, "Authorization Boundary", class: "form-label fw-semibold" %><%= field_help "Which system this belongs to, and who can see it. Left blank, the evidence is visible to every signed-in user." %>
          <%# #981 — changing this used to leave the attester and role options
              behind, so the form offered a role the server would then refuse
              (`policy_manager` is instance-scoped and valid only for
              instance-wide evidence). The change is announced; the attester
              picker refetches the eligible set for the new boundary. %>
          <%= f.select :authorization_boundary_id,
              options_for_select(AuthorizationBoundary.order(:name).pluck(:name, :id), @evidence.authorization_boundary_id),
              { include_blank: "None" },
              class: "form-select",
              data: { action: "change->evidence-type-fields#boundaryChanged" } %>
        </div>
        <%# #902 follow-up — this was a free-text box, and free text is what got
            stored. A typo linked evidence to a control in no catalog, and
            copying the padded id SPARC displays (AC-02) never matched the
            canonical one catalogs store (ac-2) — every seeded link was dead
            that way. Now the user searches real controls and picks from them,
            so what is submitted is always an identifier that exists. %>
        <div class="col-md-6">
          <% linked = @evidence.evidence_control_links.pluck(:control_id) %>
          <%# Every existing link becomes a chip, INCLUDING one whose identifier
              no longer resolves. Dropping unresolvable ids here would silently
              delete the link on the next save — turning a visible data problem
              into data loss. They render with the raw stored value so the user
              can see which link is broken and re-pick it. %>
          <% linked_controls = linked.map do |cid|
               control = ControlLookupService.resolve(cid)
               if control
                 ControlLookupService.serialize(control)
               else
                 { control_id: cid, display_id: "#{ControlId.padded(cid)} (unrecognised)",
                   title: "", unresolved: true }
               end
             end %>
          <span class="form-label fw-semibold d-block" id="evidence_control_ids_label">Controls</span>

          <div data-controller="control-picker"
               data-control-picker-url-value="<%= control_lookup_path %>"
               data-control-picker-boundary-id-value="<%= @evidence.authorization_boundary_id %>"
               data-control-picker-selected-value="<%= linked_controls.to_json %>"
               class="sparc-control-picker">

            <div class="sparc-control-picker__chips" data-control-picker-target="chips"></div>

            <input type="text"
                   class="form-control"
                   id="evidence_control_search"
                   autocomplete="off"
                   aria-labelledby="evidence_control_ids_label"
                   aria-describedby="evidence_control_help"
                   placeholder="Search by identifier or title, e.g. AC-2 or &quot;account management&quot;"
                   data-control-picker-target="search"
                   data-action="input->control-picker#search keydown->control-picker#keydown">

            <div class="sparc-control-picker__results"
                 role="listbox"
                 hidden
                 data-control-picker-target="results"></div>

            <%# Canonical ids only — this is what the form actually posts. %>
            <%= hidden_field_tag "evidence[control_ids]", linked.join(","),
                  id: "evidence_control_ids",
                  data: { control_picker_target: "hidden" } %>

            <div class="form-text" id="evidence_control_help">
              Pick controls from a loaded catalog. Enhancements (AC-2(1)) are
              selectable in their own right.
            </div>
            <div class="form-text" role="status" aria-live="polite"
                 data-control-picker-target="status"></div>
          </div>
        </div>
      </div>

      <%# ── Attestation (attestation-type evidence only) ── %>
      <%# #947 — an attestation IS evidence, so it is recorded HERE, with the
          record it belongs to. It used to be reachable only after the evidence
          existed, which forced attestation-type evidence through a state where
          it asserted nothing. Re-review still happens on the attestation screen;
          only origination moved. %>
      <div class="<%= "d-none" unless @evidence.attestation_type? %> mb-4"
           data-evidence-type-fields-target="attestation">
        <div class="card border-primary">
          <div class="card-body">
            <h5 class="card-title mb-1">Attestation</h5>
            <p class="text-body-secondary small mb-3">
              The assertion itself. SPARC checks the attester holds the role they
              are attesting under, on this system — so what is recorded here can
              be relied on rather than merely read.
            </p>
            <%= f.fields_for :attestations, (@evidence.attestations.first || @evidence.attestations.build) do |af| %>
              <%= render "attestations/fields",
                    f: af,
                    boundary_id: @evidence.authorization_boundary_id %>
            <% end %>
          </div>
        </div>
      </div>

      <%# ── File Upload ── %>
      <div class="mb-4">
        <%# #868 — `accept` comes from the same constant the server enforces, so
            the advertised list and the accepted list cannot drift. Archives are
            not accepted: a container hides what is inside it from every check. %>
        <%# #947 — `required:` is deliberately NOT passed.
            The dropzone's real <input type="file"> is `d-none`, and a browser
            cannot focus a hidden required field to report a message: the form
            simply refused to submit with nothing shown, which made an
            attestation unrecordable for a reason the screen never gave. The
            rule now lives on the model (`file_required_for_artefact_types`),
            where a failure renders in the error summary above like every other.
            #902's intent is preserved there: required on create, not on edit. %>
        <%# `required:` is passed EXPLICITLY, and must be.
            The partial defaults it to TRUE when the local is absent, and
            `dropzone_controller` enforces that with its own capture-phase
            submit guard (#902) — not with the HTML attribute. So simply
            dropping the local did not relax the rule, it re-armed it in
            JavaScript: the submit was cancelled before any request was made,
            which is the same silent refusal #947 is about, through a different
            door. The type controller flips this as the user changes type. %>
        <%= render "shared/dropzone",
          form: f,
          field: :file,
          required: !@evidence.attestation_type?,
          accept: EvidenceUploadPolicy.accept_attribute,
          label: @evidence.attestation_type? ? "Supporting File (optional)" : "Evidence File",
          hint: @evidence.attestation_type? ?
            "An attestation is the statement itself — a file is optional. Attach one only if it supports the assertion." :
            "Screenshots, logs, config exports, scan results, or policy documents. Archives (.zip) are not accepted." %>
        <% if @evidence.persisted? && @evidence.file.attached? %>
          <div class="mt-2">
            <span class="text-success small">Current file: <strong><%= @evidence.original_filename || @evidence.file.filename %></strong></span>
            <% if @evidence.file_hash.present? %>
              <br><span class="text-body-secondary small">SHA-256: <code><%= @evidence.file_hash.first(16) %>...</code></span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit(@evidence.persisted? ? "Update Evidence" : "Upload Evidence", class: "btn btn-primary") %>
        <%# #868 — collecting evidence is inherently repetitive: a control often
            needs several screenshots or exports. Landing on the show page after
            every save meant a full round-trip back to this form each time. This
            keeps the user here, carrying the boundary and type forward. %>
        <% unless @evidence.persisted? %>
          <%= f.submit "Save and add another", name: "commit_and_new", class: "btn btn-outline-primary" %>
        <% end %>
        <% if @evidence.persisted? %>
          <%= link_to "Cancel", evidence_path(@evidence), class: "btn btn-outline-secondary" %>
        <% else %>
          <%= link_to "Cancel", evidences_path, class: "btn btn-outline-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
