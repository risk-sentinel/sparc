<%#
  Actions on one evidence record, shared by the table row and the card (#888 §4)
  so an action cannot exist in one view and not the other.

  Locals: evidence — the record
%>
<% evidence = local_assigns[:evidence] %>

<div class="d-flex flex-wrap gap-1 align-items-center">
  <%= link_to "View", evidence, class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm" %>
  <%= link_to "Edit", edit_evidence_path(evidence), class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm" %>
  <%= button_to "Delete", evidence, method: :delete,
      form: { data: { turbo_confirm: "Delete evidence '#{evidence.title}'?" } },
      class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm" %>
</div>
