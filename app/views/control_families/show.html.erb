<% can_edit_baselines = can_write_catalogs? && !@control_catalog.published_lifecycle? %>

<div class="card"
     <% if can_edit_baselines %>
       data-controller="baseline-editor"
       data-baseline-editor-update-url-value="<%= update_baseline_control_catalog_path(@control_catalog) %>"
       data-baseline-editor-bulk-url-value="<%= bulk_update_baselines_control_catalog_path(@control_catalog) %>"
     <% end %>>
  <div class="card-body">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <div class="d-flex align-items-center gap-3 sparc-mb-05">
        <span class="fw-bold bg-body-secondary rounded sparc-mono sparc-fs-15r sparc-p-03-08">
          <%= @control_family.code %>
        </span>
        <h2 class="sparc-m-0"><%= @control_family.name %></h2>
      </div>
      <p class="text-body-secondary">
        Catalog: <%= link_to @control_catalog.name, @control_catalog, class: "text-primary" %> &nbsp;|&nbsp;
        Controls: <strong><%= @catalog_controls.size %></strong>
      </p>
      <% if @control_family.description.present? %>
        <p class="text-body-secondary sparc-mt-05"><%= @control_family.description %></p>
      <% end %>
    </div>
    <div class="d-flex gap-2">
      <% if can_edit_baselines %>
        <button type="button" class="sparc-action sparc-action--neutral sparc-action--outline fw-semibold sparc-fs-0875"
                data-action="click->baseline-editor#toggleEdit"
                data-baseline-editor-target="editToggle">Manage Baselines</button>
      <% end %>
      <% if can_write_catalogs? %>
        <%= link_to "Edit Family", edit_control_family_path(@control_family), class: "sparc-action sparc-action--primary sparc-action--outline" %>
        <%= link_to "＋ Add Control", new_control_family_catalog_control_path(@control_family), class: "sparc-action sparc-action--positive sparc-action--solid" %>
        <%= link_to "＋ Batch Add", batch_new_control_family_catalog_controls_path(@control_family), class: "sparc-action sparc-action--positive sparc-action--solid fw-semibold", style: "font-size: 0.875rem;" %>
      <% end %>
      <%= link_to "← Back to Catalog", @control_catalog, class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>
  </div>

  <%# ── Bulk toolbar (hidden by default, shown in edit mode) ── %>
  <% if can_edit_baselines %>
    <div class="sparc-d-none sparc-bulk-toolbar" data-baseline-editor-target="bulkToolbar">
      <div class="d-flex align-items-center gap-3 flex-wrap">
        <label class="form-check mb-0">
          <input type="checkbox" class="form-check-input" data-baseline-editor-target="selectAll" data-action="change->baseline-editor#toggleSelectAll">
          <span class="form-check-label fw-semibold sparc-fs-085">Select All</span>
        </label>
        <span class="text-body-secondary sparc-fs-085" data-baseline-editor-target="bulkCount">0 selected</span>
        <div class="vr"></div>
        <select class="form-select form-select-sm sparc-w-auto" data-baseline-editor-target="bulkLevel" aria-label="Baseline level">
          <option value="">Level...</option>
          <option value="LOW">LOW</option>
          <option value="MODERATE">MODERATE</option>
          <option value="HIGH">HIGH</option>
        </select>
        <select class="form-select form-select-sm sparc-w-auto" data-baseline-editor-target="bulkAction" aria-label="Bulk action">
          <option value="add">Add Level</option>
          <option value="remove">Remove Level</option>
          <option value="set">Set to Only This Level</option>
        </select>
        <button type="button" class="sparc-action sparc-action--primary sparc-action--solid sparc-action--sm" data-action="click->baseline-editor#bulkApply">Apply</button>
        <button type="button" class="sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" data-action="click->baseline-editor#bulkClear">Clear Baselines</button>
      </div>
    </div>
  <% end %>

  <% if @catalog_controls.any? %>
    <%
      # Depth from control_id suffix after the "xx-N" base:
      #   "ac-1"          → 0   (base control)
      #   "ac-1a"         → 1   (letter part)
      #   "ac-1a.1"       → 2   (number sub-part)
      #   "ac-1a.1.(a)"   → 3   (paren sub-part)
      #   "ac-2.1"        → 0   (enhancement — treated as top-level)
      ctrl_depth = ->(id) {
        suffix = id.to_s.sub(/\A[a-z]+-\d+(\.\d+)?/i, "")
        suffix.blank? ? 0 : suffix.scan(/[a-z]|\.\d+|\.\([^)]+\)/).size
      }
    %>
    <table class="table table-hover">
      <thead>
        <tr>
          <% if can_edit_baselines %>
            <th class="sparc-d-none sparc-w-40px" data-baseline-checkbox-cell></th>
          <% end %>
          <th class="sparc-w-150px">Control ID</th>
          <th>Title / Statement</th>
          <th class="text-center sparc-w-60px">Priority</th>
          <th class="sparc-w-200px">Baseline Impact</th>
          <% if can_write_catalogs? %><th class="sparc-w-130px">Actions</th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @catalog_controls.sort_by { |c| CatalogControl.control_sort_key(c.control_id) }.each do |control| %>
          <% depth      = ctrl_depth.call(control.control_id) %>
          <% stmt_text  = control.guidance_data["statement"].presence %>
          <tr class="<%= "sparc-row-nested" if depth > 0 %>" data-control-db-id="<%= control.id %>">

            <%# ── Checkbox column (edit mode only) ── %>
            <% if can_edit_baselines %>
              <td class="sparc-d-none sparc-tree-cell" data-baseline-checkbox-cell>
                <% if depth == 0 %>
                  <input type="checkbox" class="form-check-input" value="<%= control.id %>"
                         aria-label="Select control <%= control.control_id %>"
                         data-baseline-editor-target="checkbox"
                         data-action="change->baseline-editor#checkboxChanged">
                <% end %>
              </td>
            <% end %>

            <%# ── Control ID column ── %>
            <td class="sparc-tree-cell sparc-tree-d<%= [depth, 7].min %>">
              <% if depth > 0 %>
                <span class="sparc-color-border sparc-fs-075 sparc-mr-025">&#x2514;</span>
              <% end %>
              <span class="sparc-control-name <%= "sparc-control-name--nested" if depth > 0 %>">
                <%# #881 — the control id links to the control's own page, which
                    is also how a sub-part becomes addressable at all. %>
                <%= link_to control.display_id,
                      control_catalog_control_path(@control_family.control_catalog.url_id, control),
                      class: "text-decoration-none" %>
              </span>
            </td>

            <%# ── Title / Statement column ── %>
            <td class="sparc-va-top">
              <% if depth == 0 %>
                <%# Base control: show title prominently, then statement below %>
                <div class="fw-semibold small">
                  <%= control.title.presence || "<em style='color:#aaa; font-weight:400;'>No title</em>".html_safe %>
                  <% if control.params_present? %>
                    <span class="badge rounded-pill text-bg-info sparc-fs-068 sparc-fw-500 sparc-ml-04 sparc-va-middle"
                          title="<%= control.params_list.size %> parameter(s) requiring organization-defined values">
                      <%= control.params_list.size %> param<%= control.params_list.size == 1 ? "" : "s" %>
                    </span>
                  <% end %>
                </div>
                <% if stmt_text.present? %>
                  <div class="text-body-secondary sparc-fs-08 sparc-lh-14 sparc-mt-03">
                    <%= truncate(stmt_text, length: 200) %>
                  </div>
                <% end %>
                <% if control.params_present? %>
                  <details class="sparc-mt-04">
                    <summary class="text-primary sparc-items-center sparc-cursor-pointer sparc-d-inline-flex sparc-fs-078 sparc-gap-03 sparc-list-none">
                      <span class="card-arrow sparc-fs-06">&#9658;</span> View parameters
                    </summary>
                    <table class="table table-sm mb-0 sparc-bg-transparent sparc-fs-078 sparc-mt-03">
                      <thead>
                        <tr>
                          <th class="sparc-bbw-1 sparc-p-02-04 sparc-w-25pct">Param ID</th>
                          <th class="sparc-bbw-1 sparc-p-02-04 sparc-w-40pct">Label</th>
                          <th class="sparc-bbw-1 sparc-p-02-04">Constraint / Choices</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% control.params_list.each do |param| %>
                          <tr>
                            <td class="sparc-color-bs-primary sparc-mono sparc-p-02-04"><%= param["id"] %></td>
                            <td class="sparc-p-02-04"><%= param["label"] %></td>
                            <td class="sparc-p-02-04">
                              <% if param.dig("select", "choice").present? %>
                                <span class="text-body-secondary">Select <%= param.dig("select", "how-many") || "one" %>:</span>
                                <%= param["select"]["choice"].join("; ") %>
                              <% elsif param.dig("guidelines").present? %>
                                <span class="text-body-tertiary"><%= param["guidelines"].map { |g| g["prose"] }.compact.join("; ").truncate(120) %></span>
                              <% else %>
                                <span class="text-body-tertiary">Organization-defined</span>
                              <% end %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </details>
                <% end %>
              <% else %>
                <%# Sub-part: show statement prose as the primary content %>
                <% if stmt_text.present? %>
                  <span class="text-body-secondary sparc-fs-0875"><%= truncate(stmt_text, length: 150) %></span>
                <% else %>
                  <span class="text-body-tertiary sparc-fs-085 sparc-fst-italic"><%= control.title.presence || "No statement" %></span>
                <% end %>
              <% end %>

              <%# #393: Read-only catalog parts (statement / guidance / etc.) %>
              <%= render "control_catalogs/parts_tree", control: control %>
            </td>

            <%# ── Priority column ── %>
            <td class="text-center sparc-tree-cell">
              <% if control.priority.present? %>
                <span class="bg-body-secondary rounded fw-semibold sparc-fs-082 sparc-p-02-05">
                  <%= control.priority %>
                </span>
              <% else %>
                <span class="sparc-color-tertiary">—</span>
              <% end %>
            </td>

            <%# ── Baseline Impact column ── %>
            <td class="sparc-tree-cell">
              <%# View mode: badges %>
              <span data-baseline-view data-baseline-badges>
                <%= render "shared/baseline_badges", baseline_impact: control.baseline_impact %>
              </span>

              <%# Edit mode: inline checkboxes (top-level only) %>
              <% if can_edit_baselines && depth == 0 %>
                <span class="sparc-d-none" data-baseline-edit>
                  <% %w[LOW MODERATE HIGH].each do |level| %>
                    <label class="form-check form-check-inline mb-0 sparc-fs-078">
                      <input type="checkbox" class="form-check-input sparc-mt-015"
                             data-baseline-level="<%= level %>"
                             data-action="change->baseline-editor#inlineToggle"
                             <%= "checked" if control.has_baseline_level?(level) %>>
                      <span class="form-check-label"><%= level %></span>
                    </label>
                  <% end %>
                </span>
              <% end %>
            </td>

            <%# ── Actions column ── %>
            <% if can_write_catalogs? %>
              <td class="sparc-pt-045 sparc-va-top">
                <div class="d-flex flex-wrap gap-1">
                  <%# #881 — readable, catalog-scoped URLs; `control` renders as its
                      canonical id (ac-19.4.b.1) via CatalogControl#to_param. %>
                  <%= link_to "Edit", control_catalog_edit_control_path(@control_family.control_catalog.url_id, control), class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm" %>
                  <% if depth == 0 %>
                    <%= button_to "Delete", control_catalog_control_path(@control_family.control_catalog.url_id, control), method: :delete,
                        form: { data: { turbo_confirm: "Delete #{control.control_id}? This also removes all its sub-parts." } },
                        class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm" %>
                  <% end %>
                </div>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="text-center text-body-secondary p-4">
      <p>No controls in this family yet.
        <% if can_write_catalogs? %>
          <%= link_to "Add the first control", new_control_family_catalog_control_path(@control_family), class: "text-primary" %>
        <% end %>
      </p>
    </div>
  <% end %>
  </div>
</div>
