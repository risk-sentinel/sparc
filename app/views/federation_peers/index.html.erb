<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h2>Federation Peers</h2>
        <p class="text-body-secondary mb-0">Configured remote SPARC instances for cross-instance
          authoritative source sharing.</p>
      </div>
      <%= link_to "＋ New Peer", new_federation_peer_path, class: "btn btn-success" %>
    </div>

    <%= render "shared/collection_toolbar",
          label: "federation peers", placeholder: "Search peers by name or URL…",
          view_mode: (@peers.any? ? @view_mode : nil) %>

    <% if @peers.empty? %>
      <div class="alert alert-info mb-0">No federation peers configured.</div>
    <% elsif @view_mode == :card %>
      <div class="sparc-card-grid">
        <% @peers.each do |peer| %>
          <%= render "shared/item_card",
                title: peer.name,
                url: federation_peer_path(peer),
                badges: [ { text: peer.enabled? ? "enabled" : "disabled",
                            class: peer.enabled? ? "badge text-bg-success" : "badge text-bg-secondary" } ],
                description: peer.base_url,
                footer: "Last sync #{peer.last_synced_at&.strftime('%Y-%m-%d %H:%M') || 'never'}#{peer.last_sync_status.present? ? " · #{peer.last_sync_status}" : ''}",
                actions: render("federation_peers/item_actions", peer: peer) %>
        <% end %>
      </div>
    <% else %>
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Name</th>
            <th>Base URL</th>
            <th>Enabled</th>
            <th>Last sync</th>
            <th>Status</th>
            <th class="text-end">&nbsp;</th>
          </tr>
        </thead>
        <tbody>
          <% @peers.each do |p| %>
            <tr>
              <td><strong><%= p.name %></strong></td>
              <td><code><%= p.base_url %></code></td>
              <td>
                <% if p.enabled? %>
                  <span class="badge text-bg-success">enabled</span>
                <% else %>
                  <span class="badge text-bg-secondary">disabled</span>
                <% end %>
              </td>
              <td class="small"><%= p.last_synced_at&.iso8601 || "—" %></td>
              <td class="small"><%= p.last_sync_status || "—" %></td>
              <td class="text-end">
                <%= render "federation_peers/item_actions", peer: p %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "federation peers" %>
</div>
