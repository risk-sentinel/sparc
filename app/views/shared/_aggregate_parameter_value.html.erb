<%# An aggregate parameter (NIST Rev 5's `ac-1_prm_1`) combines others and has
    no value of its own: its reading is theirs, and it is set by setting them.
    Locals: param — a BaselineControlDetail::Parameter with aggregate? true. %>
<div data-aggregate-param="<%= param.id %>">
  <% if param.aggregate_answered %>
    <span><%= param.display %></span>
  <% else %>
    <span class="text-body-tertiary fst-italic">Not set</span>
  <% end %>
  <div class="text-body-tertiary sparc-fs-072 sparc-mt-02">
    <% if param.value.present? %>
      Set on this aggregate itself; NIST sets it through <%= param.aggregates.to_sentence %>.
    <% else %>
      Combines <%= param.aggregates.to_sentence %>; set those to change it.
    <% end %>
  </div>
</div>
