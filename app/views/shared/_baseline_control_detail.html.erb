<%#
  What the baseline requires of one control (#997) — shared by the Profile
  screen (editable, gated on profiles.write) and the SSP screen (read-only).

  Locals:
    detail    — BaselineControlDetail; every string on it is already resolved,
                so `{{ insert: param, … }}` never reaches this template.
                That now includes the statement sub-parts (#1002): they used to
                be rendered by the Profile view OUTSIDE this partial, which is
                how they reached the screen raw AND how the SSP screen came to
                omit them entirely — half the policy language, missing, with
                nothing to say so.
    editable  — true to offer the parameter form
    form_url  — where the parameter form PATCHes to (required when editable)
    anchor_id — optional DOM id so a redirect can return to this control

  Nothing renders when the control carries no statement, parameters, guidance
  or related controls: an empty panel that invites a click and shows nothing is
  worse than no panel.
%>
<% editable  = false unless defined?(editable) %>
<% form_url  = nil   unless defined?(form_url) %>
<% anchor_id = nil   unless defined?(anchor_id) %>

<% if detail.any? %>
  <%# `tag.attributes` builds an ESCAPED attribute string. Interpolating into
      an html_safe literal would disable escaping for the interpolated value,
      which spec/security/view_output_escaping_spec.rb refuses on sight. %>
  <div class="sparc-baseline-detail" <%= tag.attributes(id: anchor_id) if anchor_id.present? %>>

    <%# ── Control statement ─────────────────────────────────────────── %>
    <% if detail.statement.present? %>
      <div class="sparc-statement-block">
        <div class="sparc-statement-label sparc-color-bs-primary">
          Control Statement
          <% if detail.priority.present? %>
            <span class="badge rounded-pill text-bg-secondary sparc-fs-068 sparc-ml-04">
              <%= detail.priority %>
            </span>
          <% end %>
        </div>
        <div class="text-body-secondary sparc-fs-085 sparc-lh-15 sparc-prewrap"><%= detail.statement %></div>
      </div>
    <% end %>

    <%# ── Parameters ────────────────────────────────────────────────── %>
    <% if detail.parameters.any? %>
      <div class="sparc-statement-block">
        <div class="sparc-statement-label sparc-color-bs-primary">
          Parameters
          <span class="text-body-tertiary sparc-fw-400 sparc-fs-072">
            organization-defined values for this baseline
          </span>
        </div>

        <% if editable && form_url.present? %>
          <%= form_with url: form_url, method: :patch, local: true, class: "sparc-param-form" do %>
            <table class="sparc-field-table">
              <% detail.parameters.each do |param| %>
                <tr>
                  <th scope="row" class="sparc-field-label sparc-w-28pct">
                    <div class="sparc-mono sparc-fs-078"><%= param.id %></div>
                    <% if param.label.present? %>
                      <div class="text-body-secondary sparc-fw-400 sparc-fs-078"><%= param.label %></div>
                    <% end %>
                  </th>
                  <td class="sparc-field-value">
                    <% if param.select? %>
                      <%# An empty entry so an operator can clear every choice;
                          without it the field vanishes from the payload and the
                          old answer silently stands. %>
                      <%= hidden_field_tag "param_values[#{param.id}][]", "", id: nil %>
                      <div class="d-flex flex-wrap gap-3">
                        <% param.choices.each_with_index do |choice, i| %>
                          <%# `for` explicitly, not just by wrapping. Both are
                              valid HTML, but an explicit association is what
                              assistive technology handles most reliably and it
                              survives the markup being restructured later. %>
                          <% choice_id = "param-#{param.id.parameterize}-#{i}" %>
                          <label class="form-check sparc-fs-082" for="<%= choice_id %>">
                            <%= check_box_tag "param_values[#{param.id}][]", choice,
                                  ParameterValueList.split(param.value).include?(choice),
                                  id: choice_id, class: "form-check-input" %>
                            <span class="form-check-label"><%= choice %></span>
                          </label>
                        <% end %>
                      </div>
                      <div class="text-body-tertiary sparc-fs-072 sparc-mt-02">
                        Select <%= param.how_many == "one-or-more" ? "one or more" : "one" %>
                      </div>
                    <% else %>
                      <%# The parameter's name lives in the row header, which a
                          screen reader reads for a table cell — but a form
                          control still needs its own accessible name, so it is
                          stated rather than inferred. %>
                      <%= text_field_tag "param_values[#{param.id}]", param.value,
                            id: "param-#{param.id.parameterize}",
                            class: "form-control form-control-sm",
                            "aria-label": "#{param.label.presence || param.id} (#{param.id})",
                            placeholder: param.label.presence || "Organization-defined value" %>
                      <% if param.description.present? %>
                        <div class="text-body-tertiary sparc-fs-072 sparc-mt-02"><%= param.description %></div>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </table>
            <div class="d-flex justify-content-end mt-2">
              <%= submit_tag "Save parameters", class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm", data: { disable_with: "Saving…" } %>
            </div>
          <% end %>
        <% else %>
          <table class="sparc-field-table">
            <% detail.parameters.each do |param| %>
              <tr>
                <th scope="row" class="sparc-field-label sparc-w-28pct">
                  <div class="sparc-mono sparc-fs-078"><%= param.id %></div>
                  <% if param.label.present? %>
                    <div class="text-body-secondary sparc-fw-400 sparc-fs-078"><%= param.label %></div>
                  <% end %>
                </th>
                <td class="sparc-field-value">
                  <% if param.answered? %>
                    <%# The resolved reading, not the stored value: a selection
                        stores WHICH branches were chosen, which is not the text
                        the control ends up asserting. %>
                    <span><%= param.display.presence || param.value %></span>
                  <% else %>
                    <span class="text-body-tertiary fst-italic">Not set — the baseline default applies</span>
                  <% end %>
                  <% if param.select? && param.choices.any? %>
                    <div class="text-body-tertiary sparc-fs-072 sparc-mt-02">
                      Options: <%= param.choices.join("; ") %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </table>
        <% end %>
      </div>
    <% end %>

    <%# ── Guidance ──────────────────────────────────────────────────── %>
    <% if detail.guidance.present? %>
      <div class="sparc-statement-block">
        <div class="sparc-statement-label">Guidance</div>
        <div class="text-body-secondary sparc-fs-082 sparc-lh-15 sparc-prewrap"><%= detail.guidance %></div>
      </div>
    <% end %>

    <%# ── Related controls ──────────────────────────────────────────── %>
    <% if detail.related_controls.any? %>
      <div class="sparc-statement-block">
        <div class="sparc-statement-label">Related Controls</div>
        <div class="d-flex flex-wrap gap-1">
          <% detail.related_controls.each do |ref| %>
            <span class="badge text-bg-light sparc-mono sparc-fs-072"><%= ref.upcase %></span>
          <% end %>
        </div>
      </div>
    <% end %>

  

  <%# ── Catalog sub-parts / implementation statements (#1002) ──
      Moved here from profile_documents/show.html.erb so the SSP screen shows
      them too, and so neither screen can render them unresolved again. %>
  <% if detail.sub_parts.any? %>
    <div class="sparc-sub-parts-section">
      <div class="sparc-statement-label">Implementation Statements</div>
      <% detail.sub_parts.each do |sp| %>
        <div class="sparc-sub-part-item">
          <span class="sparc-sub-part-id"><%= sp.display_id %></span>
          <% if sp.title.present? %>
            <span class="sparc-sub-part-title"><%= sp.title %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  </div>
<% end %>
