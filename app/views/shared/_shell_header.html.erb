<%# 1.18.0-rf #1295 — the shell header (rendered by
    shared/_main_nav, so the application and login layouts switch together).

    One row, SPARC navy in both themes: brand and version, where you are
    (organization / boundary, #1291), then Create, Library, the review queue,
    Help, the theme toggle and the account menu. Every entry is shown exactly
    when its screen admits the viewer (ShellHeaderHelper, through the
    predicates today's menus use). Below 768px the menu names hide and the
    icons stay, each still named for assistive technology.

    The layer dropdowns, Home, About, Resources and OSCAL are not here: the
    document types are the tab bar's (shared/_shell_tabs), the shared library is
    the Library menu, and About, Resources and OSCAL are in Help. %>
<% member = !SparcConfig.any_auth_enabled? || signed_in? %>
<% create_items = member ? shell_create_items(shell_nav? ? shell_boundary : nil) : [] %>
<% library_items = shell_library_items %>
<% review_count = signed_in? ? shell_review_queue_count : nil %>
<%# navbar-expand is load-bearing: Bootstrap positions a navbar's dropdowns
    absolutely only inside an expanded navbar. Without it every menu opened
    in the flow and stretched the header (owner, walking phase 3). %>
<nav class="navbar navbar-expand navbar-dark bg-dark sticky-top sparc-shell-header" aria-label="Main" data-testid="shell-header">
  <div class="container-fluid flex-nowrap">
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
      <a href="#" class="navbar-brand d-flex align-items-center me-0" data-action="click->video-easter-egg#play">
        <%= image_tag "sparc_logo.png", alt: "SPARC", class: "sparc-navbar-logo" %>
      </a>
      <span class="badge text-bg-dark d-none d-sm-inline-block sparc-fs-065">v<%= SparcConfig::VERSION %></span>
    </div>

    <% if shell_nav? %>
      <%= render "shared/shell_crumbs" %>
    <% end %>

    <ul class="navbar-nav flex-row align-items-center ms-auto flex-shrink-0 sparc-shell-header__actions">
      <% if create_items.any? %>
        <li class="nav-item dropdown" data-testid="shell-create">
          <button type="button" class="nav-link dropdown-toggle sparc-nav-btn sparc-shell-header__menu"
                  data-bs-toggle="dropdown" aria-expanded="false" aria-label="Create">
            <%= icon("plus") %><span class="sparc-shell-header__label">Create</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end sparc-dropdown-menu">
            <li class="sparc-dropdown-header">
              <%= shell_nav? && shell_boundary ? "Create in #{shell_boundary.name}" : "Create" %>
            </li>
            <% create_items.each do |item| %>
              <li><%= link_to item.path, class: "dropdown-item", data: { testid: "shell-create-item", item: item.key } do %>
                <span class="sparc-dropdown-icon"><%= icon(item.icon) %></span> <%= item.label %>
              <% end %></li>
            <% end %>
          </ul>
        </li>
      <% end %>

      <% if library_items.any? %>
        <li class="nav-item dropdown" data-testid="shell-library">
          <button type="button" class="nav-link dropdown-toggle sparc-nav-btn sparc-shell-header__menu"
                  data-bs-toggle="dropdown" aria-expanded="false" aria-label="Library">
            <%= icon("library") %><span class="sparc-shell-header__label">Library</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end sparc-dropdown-menu">
            <li class="sparc-dropdown-header">Shared library</li>
            <% library_items.each do |item| %>
              <li><%= link_to item.path, class: "dropdown-item", data: { testid: "shell-library-item", item: item.key } do %>
                <span class="sparc-dropdown-icon"><%= icon(item.icon) %></span> <%= item.label %>
              <% end %></li>
            <% end %>
          </ul>
        </li>
      <% end %>

      <% unless review_count.nil? %>
        <li class="nav-item">
          <%= link_to review_queue_index_path, class: "nav-link sparc-nav-btn sparc-shell-header__menu",
                title: "Review queue",
                aria: { label: "Review queue, #{pluralize(review_count, 'document')} waiting" },
                data: { testid: "shell-review-queue", count: review_count } do %>
            <%= icon("inbox") %><span class="sparc-counter"><%= review_count %></span>
          <% end %>
        </li>
      <% end %>

      <li class="nav-item dropdown" data-testid="shell-help">
        <button type="button" class="nav-link dropdown-toggle sparc-nav-btn sparc-shell-header__menu"
                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Help">
          <%= icon("circle-question-mark") %><span class="sparc-shell-header__label">Help</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end sparc-dropdown-menu sparc-shell-header__help">
          <% if member %>
            <%# #870 / #880 — opens the guide for this screen in the drawer; if
                Stimulus never connects it is still a link to the guide in a new
                tab, never a navigation away from a part-filled form. %>
            <li><%= link_to contextual_help_path, class: "dropdown-item",
                      target: "_blank", rel: "noopener noreferrer",
                      data: { action: "click->help-drawer#open", testid: "shell-help-page" } do %>
              <span class="sparc-dropdown-icon"><%= icon("circle-question-mark") %></span> Help for this page
            <% end %></li>
            <li><hr class="dropdown-divider"></li>
            <li class="sparc-dropdown-header">Guides</li>
            <li><%= link_to help_guide_path("getting-oriented"), class: "dropdown-item",
                      target: "_blank", rel: "noopener noreferrer",
                      aria: { label: "Getting Oriented guide, opens in a new tab" } do %>Getting Oriented<% end %></li>
            <li><%= link_to "Help Center", help_path, class: "dropdown-item" %></li>
            <% shell_help_guides.each do |guide| %>
              <li><%= link_to guide.title, help_guide_path(guide.slug), class: "dropdown-item",
                        target: "_blank", rel: "noopener noreferrer",
                        aria: { label: "#{guide.title} guide, opens in a new tab" } %></li>
            <% end %>
            <li><hr class="dropdown-divider"></li>
          <% end %>
          <li class="sparc-dropdown-header">About SPARC</li>
          <li><%= link_to "About", about_path, class: "dropdown-item" %></li>
          <li><%= link_to "Resources", about_resources_path, class: "dropdown-item" %></li>
          <% if member %>
            <li><%= link_to "OSCAL overview", oscal_overview_path, class: "dropdown-item" %></li>
            <% resources = Array(SparcConfig.resources) %>
            <% if resources.any? %>
              <li><hr class="dropdown-divider"></li>
              <li class="sparc-dropdown-header">Reference links</li>
              <% resources.each do |resource| %>
                <li><a href="<%= resource["href"] %>" target="_blank" rel="noopener noreferrer" class="dropdown-item">
                  <%= resource["display_text"] %> <%= icon("external-link", css_class: "sparc-icon-sm") %>
                </a></li>
              <% end %>
            <% end %>
          <% end %>
        </ul>
      </li>

      <%# ── Theme toggle ── %>
      <li class="nav-item" data-controller="theme">
        <button type="button" class="nav-link sparc-nav-btn sparc-nav-theme-btn"
                data-theme-target="icon"
                data-action="theme#toggle"
                title="Toggle light/dark mode"><%# #1289 — both glyphs render; the theme decides which shows (CSS), so
                the right one is there on first paint, before Stimulus connects. %><%= icon("moon", css_class: "sparc-theme-icon-moon") %><%= icon("sun", css_class: "sparc-theme-icon-sun") %></button>
      </li>
      <%# ── Account menu, or Login ── %>
      <% if SparcConfig.any_auth_enabled? %>
        <% if signed_in? %>
          <li class="nav-item dropdown">
            <button type="button" class="nav-link dropdown-toggle d-flex align-items-center gap-2 sparc-nav-user" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="sparc-avatar">
                <%= safe_avatar_tag(current_user, alt: current_user.initials) %>
              </span>
              <span class="d-none d-xl-inline"><%= current_user.display_label %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end sparc-dropdown-menu">
              <li class="px-3 py-2">
                <div class="d-flex align-items-center gap-2">
                  <span class="sparc-avatar sparc-avatar-md">
                    <%= safe_avatar_tag(current_user, alt: current_user.initials) %>
                  </span>
                  <div>
                    <div class="fw-semibold small"><%= current_user.display_label %></div>
                    <div class="text-body-secondary" style="font-size: 0.75rem;"><%= current_user.email %></div>
                  </div>
                </div>
              </li>
              <li><hr class="dropdown-divider"></li>
              <% if current_user.instance_administrator? %>
                <li><h6 class="dropdown-header">Administration</h6></li>
                <li><%= link_to "Users", admin_users_path, class: "dropdown-item" %></li>
                <li><%= link_to "Roles", admin_roles_path, class: "dropdown-item" %></li>
                <li><%= link_to "Service Accounts", admin_service_accounts_path, class: "dropdown-item" %></li>
                <li><%= link_to "Auth Boundaries", admin_authorization_boundaries_path, class: "dropdown-item" %></li>
                <li><%= link_to "Organizations", admin_organizations_path, class: "dropdown-item" %></li>
                <li><%= link_to "Remediation Timelines", admin_remediation_timelines_path, class: "dropdown-item" %></li>
                <li><%= link_to "IdP Grants", admin_idp_grants_path, class: "dropdown-item" %></li>
                <li><%= link_to "Audit Log", admin_audit_logs_path, class: "dropdown-item" %></li>
                <li><hr class="dropdown-divider"></li>
              <% end %>
              <li><%= link_to "Profile", edit_profile_path, class: "dropdown-item" %></li>
              <li><%= link_to "Change Password", edit_password_path, class: "dropdown-item" %></li>
              <% if SparcConfig.fido2_enabled? %>
                <li><%= link_to "Security Keys", webauthn_credentials_path, class: "dropdown-item" %></li>
              <% end %>
              <li><hr class="dropdown-divider"></li>
              <li><%= button_to "Sign Out", logout_path, method: :delete, class: "dropdown-item" %></li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Login", login_path, class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm fw-semibold" %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>
</nav>
