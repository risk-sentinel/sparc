<%# Shared header partial rendered on every document show page (#395 P3).
    Surfaces the boundary-level context (boundary name + system title) and
    offers a "link to a boundary" affordance when the document is orphaned.

    Locals:
      document - the document being shown (SSP/SAP/SAR/POAM/Profile/CDEF)
%>
<% ab = document.try(:authorization_boundary) %>
<% if ab %>
  <div class="sparc-card" style="margin-bottom: 1rem; padding: 0.65rem 1rem; background: rgba(52,152,219,0.04); border-left: 3px solid rgba(52,152,219,0.4);">
    <div style="font-size: 0.78rem; color: var(--bs-secondary-color);">Boundary</div>
    <div style="font-size: 0.95rem; font-weight: 500;">
      <%= link_to ab.name, authorization_boundary_path(ab), class: "text-decoration-none" %>
      <% if (title = ab.system_title).present? %>
        <span class="text-body-secondary" style="font-weight: 400; font-size: 0.85rem;">&middot; System: <%= title %></span>
      <% end %>
      <% if (impact = ab.impact_level).present? %>
        <span class="badge bg-secondary" style="font-weight: 500; font-size: 0.7rem; margin-left: 0.5rem;"><%= impact %></span>
      <% end %>
    </div>
  </div>
<% elsif document.respond_to?(:authorization_boundary_id) %>
  <div class="sparc-card" style="margin-bottom: 1rem; padding: 0.65rem 1rem; background: rgba(243,156,18,0.06); border-left: 3px solid rgba(243,156,18,0.5);">
    <div style="font-size: 0.88rem;">
      <strong class="sparc-heading-assessment">No boundary linked.</strong>
      <span class="text-body-secondary">
        This document isn't associated with an AuthorizationBoundary &mdash;
        cross-document metadata and sibling FK auto-resolution won't apply
        until you link it.
      </span>
    </div>
    <%# The repair, on the page that reports the problem. Production has no
        shell, so this is the only way to fix it, and the metadata form cannot:
        it is gated until the baseline is set, and an SSP without a boundary
        could not have its baseline set either. Posts to the ungated
        attach_boundary action (#929), which authorizes the TARGET boundary.
        Each option names what is already linked to that boundary, so a
        duplicate or a mis-link is visible before choosing. %>
    <% choices = signed_in? ? assignable_boundaries(current_user).to_a : [] %>
    <% if choices.any? %>
      <% linked = document.class.where(authorization_boundary_id: choices.map(&:id))
                          .where.not(id: document.id).pluck(:authorization_boundary_id, :name)
                          .group_by(&:first).transform_values { |rows| rows.map(&:last) } %>
      <%= form_with url: url_for([ :attach_boundary, document ]), method: :patch, local: true,
                    class: "d-flex align-items-center gap-2 flex-wrap mt-2" do %>
        <label class="fw-semibold small mb-0" for="attach_<%= document.model_name.param_key %>_boundary">Link to a boundary</label>
        <%= select_tag "#{document.model_name.param_key}[authorization_boundary_id]",
              options_for_select([ [ "Choose a boundary…", "" ] ] + choices.map { |b|
                label = linked[b.id].present? ? "#{b.name} — already linked to: #{linked[b.id].join(', ')}" : b.name
                [ label, b.id ]
              }),
              id: "attach_#{document.model_name.param_key}_boundary", required: true,
              class: "form-select form-select-sm w-auto" %>
        <%= submit_tag "Link boundary", class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm" %>
      <% end %>
    <% end %>
  </div>
<% end %>
