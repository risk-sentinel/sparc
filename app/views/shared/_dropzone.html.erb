<%# Drag-and-drop file upload component (dropzone_controller.js). %>
<%# Supports single-file (default) and multi-file upload modes. %>
<%
  field    ||= :file
  accept   ||= ""
  hint     ||= nil
  label    ||= nil
  multiple = false unless defined?(multiple) && multiple == true
  required = true unless defined?(required) && required == false
%>

<% if label.present? %>
  <span class="form-label fw-semibold d-block"><%= label %></span>
<% end %>

<%# #902 — `required` is enforced by dropzone_controller on submit, NOT by the
    native attribute. The input is `d-none`, and Chrome refuses to submit a form
    containing a required control it cannot focus: it blocks the submit and logs
    "An invalid form control ... is not focusable" to the console with nothing
    shown to the user. Clicking "Upload Evidence" with no file did nothing at
    all, which is one of the silent failures reported in #902. %>
<div data-controller="dropzone"
     data-dropzone-accept-value="<%= accept %>"
     data-dropzone-multiple-value="<%= multiple %>"
     data-dropzone-required-value="<%= required %>">

  <div class="sparc-dropzone"
       data-dropzone-target="zone"
       data-action="dragover->dropzone#dragover
                    dragenter->dropzone#dragenter
                    dragleave->dropzone#dragleave
                    drop->dropzone#drop
                    click->dropzone#browse">

    <span class="sparc-dropzone__icon" data-dropzone-target="icon">&#128194;</span>

    <p class="sparc-dropzone__prompt" data-dropzone-target="prompt">
      <strong>Click to browse</strong> or drag &amp; drop file<%= "s" if multiple %> here
    </p>

    <div class="sparc-dropzone__file-list" data-dropzone-target="fileList" style="display: none;"></div>
    <p class="sparc-dropzone__filename" data-dropzone-target="filename"></p>
    <p class="sparc-dropzone__filesize" data-dropzone-target="filesize"></p>
    <%# role="alert" so a rejected file or a missing-file submit is announced,
        not just drawn (#902). %>
    <p class="sparc-dropzone__error" data-dropzone-target="error" role="alert"></p>

    <% if accept.present? %>
      <span class="sparc-dropzone__hint">
        Accepted: <code><%= accept.gsub(",", ", ") %></code>
      </span>
    <% end %>
  </div>

  <%= form.file_field (multiple ? :files : field),
        accept: accept,
        multiple: multiple,
        class: "d-none",
        data: {
          dropzone_target: "input",
          action: "change->dropzone#change"
        } %>

  <% if hint.present? %>
    <small class="text-body-secondary d-block mt-2"><%= hint %></small>
  <% end %>
</div>
