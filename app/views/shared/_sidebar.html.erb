<%# Persistent left sidebar — visible on all authenticated pages %>
<nav class="sparc-sidebar" data-controller="sidebar">
  <div class="sparc-sidebar-header">
    <span class="fw-bold text-body-secondary text-uppercase sparc-fs-07 sparc-ls-008">
      Navigation
    </span>
  </div>

  <div class="sparc-sidebar-body">

    <%# ── Organizations ── %>
    <div class="sparc-sidebar-section">
      <button class="sparc-sidebar-toggle" data-bs-toggle="collapse" data-bs-target="#sidebarOrgs" aria-expanded="true">
        <span class="sparc-sidebar-icon">&#128193;</span> Organizations
      </button>
      <div class="collapse show" id="sidebarOrgs">
        <% sidebar_organizations.each do |org| %>
          <div class="sparc-sidebar-org">
            <button class="sparc-sidebar-toggle sparc-sidebar-indent-1"
                    data-bs-toggle="collapse" data-bs-target="#sidebarOrg<%= org.id %>" aria-expanded="false">
              <span class="sparc-sidebar-icon">&#128205;</span> <%= org.name %>
            </button>
            <div class="collapse" id="sidebarOrg<%= org.id %>">
              <%#
                #951 — boundaries paginate at 10 within an organization.
                Each boundary contributes seven document links, so a ten-boundary
                organization is already seventy leaves before the next section
                starts. The first ten render; the rest sit behind a disclosure,
                which reuses the collapse idiom the rest of this sidebar uses so
                `sidebar_controller.js` persists its state like every other
                section, with no new JavaScript and no inline handler.
              %>
              <% boundaries = org.authorization_boundaries.order(:name).to_a %>
              <% shown, overflow = boundaries.first(ApplicationHelper::SIDEBAR_BOUNDARY_PAGE_SIZE), boundaries.drop(ApplicationHelper::SIDEBAR_BOUNDARY_PAGE_SIZE) %>
              <% shown.each do |ab| %>
                <%= render "shared/sidebar_boundary", ab: ab %>
              <% end %>
              <% if overflow.any? %>
                <div class="collapse" id="sidebarOrgMore<%= org.id %>">
                  <% overflow.each do |ab| %>
                    <%= render "shared/sidebar_boundary", ab: ab %>
                  <% end %>
                </div>
                <button class="sparc-sidebar-toggle sparc-sidebar-indent-2 sparc-sidebar-more"
                        data-bs-toggle="collapse"
                        data-bs-target="#sidebarOrgMore<%= org.id %>"
                        aria-expanded="false">
                  <%= overflow.size %> more <%= "boundary".pluralize(overflow.size) %>
                </button>
              <% end %>
              <% if org.authorization_boundaries.empty? %>
                <div class="sparc-sidebar-indent-2 text-body-tertiary small py-1 ps-4">No boundaries</div>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if sidebar_organizations.empty? %>
          <div class="sparc-sidebar-indent-1 text-body-tertiary small py-2 ps-3">No organizations</div>
        <% end %>
      </div>
    </div>

    <%# ── Resources ── %>
    <%# ── Compliance Library (#372) ── %>
    <div class="sparc-sidebar-section border-top border-secondary">
      <button class="sparc-sidebar-toggle" data-bs-toggle="collapse" data-bs-target="#sidebarLibrary" aria-expanded="false">
        <span class="sparc-sidebar-icon">&#128218;</span> Compliance Library
      </button>
      <div class="collapse" id="sidebarLibrary">
        <ul class="sparc-sidebar-leaves">
          <li>
            <%= link_to authoritative_sources_path, class: "sparc-sidebar-leaf" do %>
              <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--teal"></span> Authoritative Sources
            <% end %>
          </li>
          <li>
            <%= link_to promotion_queue_index_path, class: "sparc-sidebar-leaf" do %>
              <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--orange"></span> Promotion Queue
            <% end %>
          </li>
          <li>
            <%= link_to leveraged_poam_documents_path, class: "sparc-sidebar-leaf" do %>
              <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--violet"></span> Leveraged POA&amp;Ms
            <% end %>
          </li>
          <% if current_user&.admin? %>
            <li>
              <%= link_to federation_peers_path, class: "sparc-sidebar-leaf" do %>
                <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--ocean"></span> Federation Peers
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="sparc-sidebar-section border-top border-secondary">
      <button class="sparc-sidebar-toggle" data-bs-toggle="collapse" data-bs-target="#sidebarResources" aria-expanded="false">
        <span class="sparc-sidebar-icon">&#128279;</span> Resources
      </button>
      <div class="collapse" id="sidebarResources">
        <%# #951 — the NIST OSCAL reference links nest, so this section is a few
            rows rather than nine and Help & Guides stays reachable. %>
        <% groups = sidebar_resource_groups %>
        <ul class="sparc-sidebar-leaves">
          <% groups[:top_level].each do |resource| %>
            <li>
              <a href="<%= resource["href"] %>" target="_blank" rel="noopener noreferrer"
                 class="sparc-sidebar-leaf">
                <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--purple"></span>
                <%= resource["display_text"] %> <span class="sparc-fs-065">&#8599;</span>
              </a>
            </li>
          <% end %>
        </ul>
        <% if groups[:nested].any? %>
          <button class="sparc-sidebar-toggle sparc-sidebar-indent-1"
                  data-bs-toggle="collapse" data-bs-target="#sidebarOscalRef" aria-expanded="false">
            <span class="sparc-sidebar-icon">&#128218;</span> OSCAL Reference
          </button>
          <div class="collapse" id="sidebarOscalRef">
            <ul class="sparc-sidebar-leaves">
              <% groups[:nested].each do |resource| %>
                <li>
                  <a href="<%= resource["href"] %>" target="_blank" rel="noopener noreferrer"
                     class="sparc-sidebar-leaf sparc-sidebar-indent-2">
                    <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--purple"></span>
                    <%= resource["display_text"] %> <span class="sparc-fs-065">&#8599;</span>
                  </a>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Help & Guides (#784) ── %>
    <div class="sparc-sidebar-section border-top border-secondary">
      <button class="sparc-sidebar-toggle" data-bs-toggle="collapse" data-bs-target="#sidebarHelp" aria-expanded="false">
        <span class="sparc-sidebar-icon">&#10067;</span> Help &amp; Guides
      </button>
      <div class="collapse" id="sidebarHelp">
        <ul class="sparc-sidebar-leaves">
          <%# #796 — Getting Oriented pinned first, then the Help Center index, %>
          <%# then every guide for fast navigation (sourced from wiki/User-Guide-*). %>
          <%# #870 — guides open in a new tab so consulting one never discards
              work in progress on the screen underneath. The Help Center index is
              a destination rather than a reference, so it navigates normally. %>
          <li>
            <%= link_to help_guide_path("getting-oriented"), class: "sparc-sidebar-leaf",
                  target: "_blank", rel: "noopener noreferrer",
                  aria: { label: "Getting Oriented guide, opens in a new tab" } do %>
              <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--green"></span> Getting Oriented
            <% end %>
          </li>
          <li>
            <%= link_to help_path, class: "sparc-sidebar-leaf" do %>
              <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--blue"></span> Help Center
            <% end %>
          </li>
          <% sidebar_help_guides.each do |guide| %>
            <% next if guide.slug == "getting-oriented" %>
            <li>
              <%= link_to help_guide_path(guide.slug), class: "sparc-sidebar-leaf",
                    target: "_blank", rel: "noopener noreferrer",
                    aria: { label: "#{guide.title} guide, opens in a new tab" } do %>
                <span class="sparc-sidebar-dot sparc-accent-bg sparc-accent--purple"></span> <%= guide.title %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

  </div>
</nav>
