<%# #1390 — what an incident records (FedrampIncident): its evaluation and
    what its Incident Reports carry. Times are UTC.
    Locals: boundary, incident, url, method. %>
<% field = ->(name) { "fedramp_incident_#{incident.uuid || 'new'}_#{name}" } %>
<% area = lambda do |f, name, label, value: incident[name], rows: 2| %>
  <%= f.label name, label, for: field.(name), class: "form-label small fw-semibold" %>
  <%= f.text_area name, value: value, rows: rows, id: field.(name), class: "form-control form-control-sm" %>
<% end %>
<% time = lambda do |f, name, label| %>
  <%= f.label name, "#{label} (UTC)", for: field.(name), class: "form-label small fw-semibold" %>
  <%= f.datetime_local_field name, id: field.(name), class: "form-control form-control-sm" %>
<% end %>
<%= form_with model: incident, scope: :fedramp_incident, url: url, method: method, local: true,
      data: { testid: "fedramp-incident-form" } do |f| %>
  <div class="row g-3">
    <div class="col-md-4">
      <%= f.label :tracking_id, "Your tracking ID", for: field.("tracking_id"), class: "form-label small fw-semibold" %>
      <%= f.text_field :tracking_id, id: field.("tracking_id"), class: "form-control form-control-sm", required: true %>
    </div>
    <div class="col-md-8 d-flex align-items-end">
      <div class="form-check">
        <%= f.check_box :reportable, id: field.("reportable"), class: "form-check-input" %>
        <%= f.label :reportable, "FedRAMP Reportable Incident: affects, or is likely to affect, the confidentiality or integrity of federal customer data (IEC-CSO-EFR)",
              for: field.("reportable"), class: "form-check-label small" %>
      </div>
    </div>
    <div class="col-md-6"><% area.(f, "description", "Description") %></div>
    <div class="col-md-6">
      <%= f.label :coordinator, "Federal incident response coordinator (contact)", for: field.("coordinator"), class: "form-label small fw-semibold" %>
      <%= f.text_field :coordinator, id: field.("coordinator"), class: "form-control form-control-sm" %>
    </div>

    <div class="col-12"><hr class="my-1"><span class="small fw-semibold">Timeline</span></div>
    <div class="col-md-3"><% time.(f, "started_at", "Started") %></div>
    <div class="col-md-3"><% time.(f, "detected_at", "Detected") %></div>
    <div class="col-md-3">
      <%= f.label :detection_source, "Detection source", for: field.("detection_source"), class: "form-label small fw-semibold" %>
      <%= f.text_field :detection_source, id: field.("detection_source"), class: "form-control form-control-sm" %>
    </div>
    <div class="col-md-3"><% time.(f, "evaluation_completed_at", "Reportable evaluation completed") %></div>
    <div class="col-12">
      <%= hidden_field_tag :milestones_listed, "1", id: nil %>
      <div data-controller="oscal-repeater">
        <span class="form-label small fw-semibold d-block">Milestones</span>
        <template data-oscal-repeater-target="template"><%= render "fedramp_incidents/milestone_row", item: {} %></template>
        <div data-oscal-repeater-target="rows">
          <% Array(incident.milestones).each do |item| %><%= render "fedramp_incidents/milestone_row", item: item %><% end %>
        </div>
        <button type="button" data-action="click->oscal-repeater#add" data-testid="fedramp-incident-add-milestone"
                class="sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm">Add milestone</button>
      </div>
    </div>

    <div class="col-12"><hr class="my-1"><span class="small fw-semibold">Impact</span></div>
    <div class="col-md-3">
      <%= f.label :current_rating, "Potential Agency Impact N-rating", for: field.("current_rating"), class: "form-label small fw-semibold" %>
      <%= f.select :current_rating, FedrampIncident.n_ratings.map { |n| [ "N#{n}", n ] },
            { include_blank: "Not rated (treated as N5)", selected: incident.current_rating },
            id: field.("current_rating"), class: "form-select form-select-sm" %>
      <div class="form-text">A new rating is added to the history.</div>
    </div>
    <div class="col-md-9"><% area.(f, "evaluation_notes", "How the rating was estimated (IEC-CSO-EFI)") %></div>
    <div class="col-md-6"><% area.(f, "functional_impact", "Functional impact on federal customers (confidentiality, integrity, data types)") %></div>
    <div class="col-md-6"><% area.(f, "affected_agencies", "Likely affected customer agencies (one per line)", value: Array(incident.affected_agencies).join("\n")) %></div>
    <div class="col-md-6"><% area.(f, "recovery_plan", "Recovery plan, milestones and timelines") %></div>

    <div class="col-12"><hr class="my-1"><span class="small fw-semibold">Response</span></div>
    <div class="col-md-6"><% area.(f, "observed_activity", "Observed incident activity") %></div>
    <div class="col-md-6"><% area.(f, "indicators", "Indicators of compromise (one per line)", value: Array(incident.indicators).join("\n")) %></div>
    <div class="col-md-6"><% area.(f, "related_cve_ids", "Related CVE identifiers", value: Array(incident.related_cve_ids).join("\n"), rows: 1) %></div>
    <div class="col-md-6"><% area.(f, "root_cause", "Root cause") %></div>
    <div class="col-md-6"><% area.(f, "response_activities", "Response and recovery activities") %></div>
    <div class="col-md-3"><% time.(f, "resolved_at", "Resolved and recovered") %></div>
    <div class="col-12"><% area.(f, "lessons_learned", "Lessons learned and changes made as a result (one per line; for the Ongoing Certification Report)", value: Array(incident.lessons_learned).join("\n")) %></div>
  </div>
  <div class="mt-3">
    <%= f.submit incident.new_record? ? "Record incident" : "Save incident",
          class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm", data: { testid: "fedramp-incident-save" } %>
  </div>
<% end %>
