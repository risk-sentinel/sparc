<%= form_with model: [ poam_document, poam_risk ], local: true do |f| %>
  <% if poam_risk.errors.any? %>
    <div class="alert alert-danger small">
      <%= poam_risk.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%# #832 — title, description, statement and status are OSCAL-required on a
      risk; deadline is a SPARC rule (a POA&M item with no time commitment is
      not a plan, and hdf-cli refuses to convert one). Marked here so the
      requirement is visible while filling the form, rather than arriving as a
      validation error on submit — or, as before, as a schema failure at export. %>
  <div class="form-group">
    <%= f.label :title, class: "fw-semibold" do %>Title <span class="text-danger">*</span><% end %>
    <%= f.text_field :title, class: "form-control", required: true,
                     placeholder: "e.g., Hard-coded credentials in admin panel" %>
  </div>

  <div class="form-group mt-3">
    <%= f.label :description, class: "fw-semibold" do %>Description <span class="text-danger">*</span><% end %>
    <%= f.text_area :description, class: "form-control", rows: 3, required: true,
                    placeholder: "What the risk is and why it matters" %>
  </div>

  <div class="form-group mt-3">
    <%= f.label :statement, class: "fw-semibold" do %>Risk statement <span class="text-danger">*</span><% end %>
    <%= f.text_area :statement, class: "form-control", rows: 2, required: true,
                    placeholder: "Formal risk statement (asset, threat, vulnerability, impact)" %>
  </div>

  <div class="row row-cols-1 row-cols-md-3 g-3 mt-1">
    <%# #1154 — "Remediating" was missing, so a `remediating` risk (a valid
        PoamRisk::STATUSES value) opened with a blank required select and the
        browser silently refused to submit any edit to it. %>
    <div class="col">
      <%= f.label :status, class: "fw-semibold" do %>Status <span class="text-danger">*</span><% end %>
      <%= f.select :status,
            options_for_select([
              [ "Open", "open" ], [ "Investigating", "investigating" ],
              [ "Remediating", "remediating" ],
              [ "Deviation Requested", "deviation-requested" ],
              [ "Deviation Approved", "deviation-approved" ],
              [ "Closed", "closed" ]
            ], poam_risk.status),
            { include_blank: "— Select —" }, class: "form-control", required: true %>
    </div>
    <div class="col">
      <%= f.label :impact, class: "fw-semibold" %>
      <%= f.select :impact,
            options_for_select(RiskRating::LEVEL_OPTIONS,
                               poam_risk.impact),
            { include_blank: "— Select —" }, class: "form-control" %>
    </div>
    <div class="col">
      <%= f.label :likelihood, class: "fw-semibold" %>
      <%= f.select :likelihood,
            options_for_select(RiskRating::LEVEL_OPTIONS,
                               poam_risk.likelihood),
            { include_blank: "— Select —" }, class: "form-control" %>
    </div>
  </div>

  <div class="form-group mt-3">
    <%= f.label :deadline, class: "fw-semibold" do %>Deadline <span class="text-danger">*</span><% end %>
    <%= f.date_field :deadline, class: "form-control", required: true %>
    <div class="form-text">
      The date this risk is committed to be resolved by. Required: a POA&amp;M
      item with no time commitment is not a plan of action, and it cannot be
      converted to HDF amendments.
    </div>
  </div>

  <%# #1154 — the authorizing official's decision on this risk. Exported as the
      SPARC-namespace props blocks-ato, condition-expires and trigger. All three
      are optional: an undecided risk is left blank, never defaulted to "No". %>
  <div class="row row-cols-1 row-cols-md-3 g-3 mt-1">
    <div class="col">
      <%= f.label :blocks_ato, "Blocks the ATO?", class: "fw-semibold" %>
      <%= f.select :blocks_ato,
            options_for_select([
              [ "Yes — blocks the ATO", "true" ],
              [ "No — does not block the ATO", "false" ]
            ], poam_risk.blocks_ato.nil? ? nil : poam_risk.blocks_ato.to_s),
            { include_blank: "— Not decided —" }, class: "form-control" %>
    </div>
    <div class="col">
      <%= f.label :condition_expires, "Condition expires", class: "fw-semibold" %>
      <%= f.date_field :condition_expires, class: "form-control" %>
    </div>
    <div class="col">
      <%= f.label :reopen_trigger, "Reopen trigger", class: "fw-semibold" %>
      <%= f.text_field :reopen_trigger, class: "form-control",
                       placeholder: "e.g., score<0.85 or blockers>=1" %>
    </div>
  </div>
  <div class="form-text">
    If the authorization was granted with a condition on this risk: when that
    condition lapses, and the measure that reopens the decision —
    <code>score</code> or <code>blockers</code>, a comparison, and a number.
  </div>

  <div class="form-group mt-3">
    <%= f.label :remarks, class: "fw-semibold" %>
    <%= f.text_area :remarks, class: "form-control", rows: 2,
                    placeholder: "Additional context, links to assessments, etc." %>
  </div>

  <%# OSCAL extensibility arrays — shared partials (slice 0). %>
  <hr class="border-top" style="border: none; margin: 1.5rem 0;">

  <%= render "shared/oscal_props_array",
             param_key: "poam_risk", record: poam_risk %>
  <%= render "shared/oscal_links_array",
             param_key: "poam_risk", record: poam_risk %>
  <%= render "shared/oscal_origins_array",
             param_key: "poam_risk", record: poam_risk,
             parties: poam_document.oscal_parties %>

  <div class="d-flex gap-3 mt-3">
    <%= f.submit poam_risk.persisted? ? "Update Risk" : "Add Risk", class: "btn btn-success" %>
    <%= link_to "Cancel", poam_document_path(poam_document), class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
  </div>
<% end %>
