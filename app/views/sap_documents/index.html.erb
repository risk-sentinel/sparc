<% summary = [
  [@total_count, "Assessment Plans"],
  [@controls_count, "Total Controls"],
  [@completed_count, "Completed"]
] %>

<% if @sap_documents.any? { |d| d.processing? || d.pending? } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="10000" hidden></div>
<% end %>

<div class="card sparc-list-card" style="overflow-x: auto;">
  <%# 1.18.0-rf #1299/#1298 — the shared page header. %>
  <% header = nil %>
    <% header = capture do %><%= render "shared/page_header", summary: summary, title: "Assessment Plans (SAP)",
            primary: { label: "Create New", look: "positive solid", path: new_sap_document_path },
            secondary: [ { label: "Upload File", look: "info solid", path: new_sap_document_path(anchor: "upload-sap") } ] %><% end %>

  <%# 1.18.0-rf #1292 — the Boundary filter beside the list (BoundaryListFilter). %>
  <%= render layout: "shared/boundary_filter_layout", locals: { header: header } do %>
  <%= render "shared/collection_toolbar",
        label: "security assessment plans", placeholder: "Search SAPs…",
        status_tabs: @status_tabs, facets: @facets, clear_params: @clear_facets,
        view_mode: (@view_mode if @sap_documents.any?) %>

  <% if @sap_documents.any? && @tiering&.tiered? %>
    <%# #948 — tiering is AUTOMATIC, appearing only when more than one
        boundary is visible, so a single-system user never meets a tree
        with one branch. Card/list still applies inside each tier. %>
    <%= render "shared/collection_tiers",
          tiering: @tiering,
          records_partial: "sap_documents/collection",
          records_local: :records,
          view_mode: @view_mode,
          screen: "sap_documents" %>
  <% elsif @sap_documents.any? %>
    <%= render "sap_documents/collection", records: @sap_documents, view_mode: @view_mode %>
  <% else %>
    <p class="text-center p-4 text-body-secondary">No assessment plans found. Create your first Security Assessment Plan to get started.</p>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "security assessment plans" %>
  <% end %>
</div>
