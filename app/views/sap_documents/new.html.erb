<div class="card">
  <h2>Create Security Assessment Plan (SAP)</h2>
  <p class="text-body-secondary mb-4">
    Generate an OSCAL-compliant Security Assessment Plan from your existing SSP and Profile data.
    Select controls, choose assessment methods, and assign assessors.
  </p>

  <%= form_with model: @sap_document, local: true do |f| %>

    <%# ── Step 1: Plan Metadata ── %>
    <div class="bg-body-secondary rounded-3 mb-4 sparc-choice-card sparc-accent--blue">
      <h3 class="mb-3 sparc-heading-controls sparc-fs-1r">Step 1: Plan Details</h3>

      <div class="form-group">
        <label for="sap_document_name">Plan Name</label>
        <%= f.text_field :name, placeholder: "e.g., FY26 Annual Assessment - System XYZ", class: "form-control" %>
      </div>

      <div class="row row-cols-1 row-cols-md-2 g-3">
        <div class="col">
          <div class="form-group">
            <label for="sap_document_assessment_type">Assessment Type</label>
            <%= f.select :assessment_type,
                  options_for_select(SapDocument::ASSESSMENT_TYPES.map { |t| [t.titleize, t] }, "initial"),
                  {}, class: "form-control" %>
          </div>
        </div>
        <div class="col">
          <div class="form-group">
            <label for="sap_document_description">Description</label>
            <%= f.text_area :description, rows: 2, placeholder: "Brief description of the assessment scope and objectives", class: "form-control sparc-minh-60px" %>
          </div>
        </div>
      </div>

      <div class="row row-cols-1 row-cols-md-2 g-3">
        <div class="col">
          <div class="form-group">
            <label for="sap_document_assessment_start">Assessment Start Date</label>
            <%= f.date_field :assessment_start, class: "form-control" %>
          </div>
        </div>
        <div class="col">
          <div class="form-group">
            <label for="sap_document_assessment_end">Assessment End Date</label>
            <%= f.date_field :assessment_end, class: "form-control" %>
          </div>
        </div>
      </div>
    </div>

    <%# ── Step 2: Source Documents ── %>
    <div class="bg-body-secondary rounded-3 mb-4 sparc-choice-card sparc-accent--green">
      <h3 class="mb-3 sparc-heading-implementation sparc-fs-1r">Step 2: Select Source Documents</h3>
      <p class="text-body-secondary mb-3 sparc-fs-085">
        Controls will be pulled from the selected SSP. If no SSP is selected, controls will be pulled from the selected Profile/Baseline.
      </p>

      <%# Build SSP-to-Profile mapping for auto-population %>
      <% ssp_profile_map = @ssp_documents.each_with_object({}) { |s, h| h[s.id] = s.profile_document_id if s.profile_document_id } %>

      <div class="row row-cols-1 row-cols-md-2 g-3" data-controller="ssp-profile-sync">
        <div class="col">
          <div class="form-group">
            <label for="sap_document_ssp_document_id">System Security Plan (SSP)</label><%= field_help "The system being assessed — links this plan to the SSP whose controls it will test." %>
            <%# #946 — preselect on render, so a form arriving with an SSP
                already chosen shows it rather than resetting to blank. %>
            <%= f.select :ssp_document_id,
                  options_for_select(
                    @ssp_documents.map { |s| ["#{s.name} (#{s.ssp_controls.count} controls)", s.id] },
                    @sap_document.ssp_document_id
                  ),
                  { include_blank: "— Select SSP (optional) —" },
                  class: "form-control", id: "ssp-select",
                  data: { ssp_profile_map: ssp_profile_map.to_json,
                          action: "change->ssp-profile-sync#populate" } %>
          </div>
        </div>
        <div class="col">
          <div class="form-group">
            <label for="sap_document_profile_document_id">Baseline Profile</label><%= field_help "The baseline that decides which controls are in scope for this assessment." %>
            <%# #946 — the baseline the selected SSP records, filled server-side.
                The Stimulus sync still handles later changes. %>
            <%= f.select :profile_document_id,
                  options_for_select(
                    @profile_documents.map { |p| ["#{p.name} (#{p.baseline_level || 'Custom'}, #{p.profile_controls.count} controls)", p.id] },
                    @sap_document.profile_document_id
                  ),
                  { include_blank: "— Select Profile (optional) —" },
                  class: "form-control", id: "profile-select",
                  data: { ssp_profile_sync_target: "profile" } %>
          </div>
        </div>
      </div>

    </div>

    <%# ── Step 3: Assessment Methods ── %>
    <div class="bg-body-secondary rounded-3 mb-4 sparc-choice-card sparc-accent--violet">
      <h3 class="mb-3 sparc-heading-enterprise sparc-fs-1r">Step 3: Default Assessment Methods</h3>
      <p class="text-body-secondary mb-3 sparc-fs-085">
        Methods are auto-assigned based on control family heuristics (technical controls default to <strong>Test</strong>,
        personnel/physical to <strong>Interview</strong>, policy to <strong>Examine</strong>).
        You can override individual controls after the plan is created.
      </p>

      <div class="row row-cols-1 row-cols-md-3 g-3">
        <div class="col">
          <div class="bg-body border rounded-3 p-3 text-center">
            <div class="sparc-fs-15r sparc-mb-05">&#128269;</div>
            <div class="fw-bold sparc-mb-025">Examine</div>
            <div class="text-body-secondary sparc-fs-078">Review documentation, policies, procedures, and artifacts</div>
          </div>
        </div>
        <div class="col">
          <div class="bg-body border rounded-3 p-3 text-center">
            <div class="sparc-fs-15r sparc-mb-05">&#128483;</div>
            <div class="fw-bold sparc-mb-025">Interview</div>
            <div class="text-body-secondary sparc-fs-078">Discuss with personnel responsible for control implementation</div>
          </div>
        </div>
        <div class="col">
          <div class="bg-body border rounded-3 p-3 text-center">
            <div class="sparc-fs-15r sparc-mb-05">&#9881;</div>
            <div class="fw-bold sparc-mb-025">Test</div>
            <div class="text-body-secondary sparc-fs-078">Execute automated or manual procedures to validate implementation</div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-3">
      <%= f.submit "Generate Assessment Plan", class: "sparc-action sparc-action--info sparc-action--outline" %>
      <%= link_to "Cancel", sap_documents_path, class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>
  <% end %>
</div>

<%# ── OR: Upload existing SAP file ── %>
<div class="card" id="upload-sap">
  <h3>Or Upload Existing SAP</h3>
  <p class="text-body-secondary mb-3">
    Already have an OSCAL Assessment Plan? Upload the JSON file directly.
  </p>

  <%= form_with model: SapDocument.new, local: true, multipart: true do |f| %>
    <%= render "shared/dropzone",
      form: f,
      field: :file,
      accept: ".json,.xml,.yaml,.yml",
      multiple: true,
      hint: "Upload an OSCAL Assessment Plan in JSON, XML, or YAML format." %>
    <%= render "shared/boundary_picker", param_key: :sap_document %>
    <div class="d-flex gap-3">
      <%= f.submit "Upload and Process", class: "sparc-action sparc-action--info sparc-action--solid" %>
    </div>
  <% end %>
</div>
