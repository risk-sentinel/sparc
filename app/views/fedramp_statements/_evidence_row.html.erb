<%# #1390 — one KSI evidence entry (FedrampStatement::EVIDENCE_KEYS). %>
<div class="repeater-row row g-2 mb-2 align-items-center" data-testid="fedramp-evidence-row">
  <div class="col-md-2">
    <%= select_tag "fedramp_statement[evidence][][evidence_type]",
          options_for_select(FedrampStatement.evidence_types, item["evidence_type"]), include_blank: "Type",
          id: nil, class: "form-select form-select-sm", "aria-label": "Evidence type" %>
  </div>
  <div class="col-md-3">
    <%= text_field_tag "fedramp_statement[evidence][][description]", item["description"], id: nil,
          class: "form-control form-control-sm", placeholder: "Description", "aria-label": "Evidence description" %>
  </div>
  <div class="col-md-3">
    <%= url_field_tag "fedramp_statement[evidence][][location]", item["location"], id: nil,
          class: "form-control form-control-sm", placeholder: "https://", "aria-label": "Evidence location" %>
  </div>
  <div class="col-md-2">
    <%= date_field_tag "fedramp_statement[evidence][][last_updated]", item["last_updated"], id: nil,
          class: "form-control form-control-sm", "aria-label": "Evidence last updated" %>
  </div>
  <div class="col-md-1">
    <%= hidden_field_tag "fedramp_statement[evidence][][text]", item["text"], id: nil %>
    <button type="button" data-action="click->oscal-repeater#remove"
            class="btn btn-sm btn-outline-danger" aria-label="Remove evidence">×</button>
  </div>
</div>
