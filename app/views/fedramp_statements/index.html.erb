<%# #1390 — the boundary's FedRAMP page: the FedRAMP rules that apply to its
    certification profile and the Key Security Indicators, each with the
    boundary's answer, which its Security Decision Record carries.
    FedrampStatementsController; the same service as the API. %>
<% content_for :title, "FedRAMP — #{@boundary.name}" %>
<% type, path, klass = @boundary.fedramp_profile %>
<% status_badge = { "Implemented" => "bg-success", "Partially Implemented" => "bg-warning text-dark",
                    "Not Implemented" => "bg-danger" } %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0">FedRAMP</h1>
    <p class="text-muted mb-0"><%= @boundary.name %></p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Back to Boundary", authorization_boundary_path(@boundary),
          class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" %>
  </div>
</div>

<div class="card mb-3" data-testid="fedramp-profile">
  <div class="card-body d-flex flex-wrap gap-4 align-items-center">
    <div><span class="text-muted small d-block">Certification type</span><strong><%= type.presence || "—" %></strong></div>
    <div><span class="text-muted small d-block">Path</span><strong><%= path.presence || "—" %></strong></div>
    <div><span class="text-muted small d-block">Class</span><strong><%= klass.presence || "—" %></strong></div>
    <div><span class="text-muted small d-block">Security Decision Record version</span>
      <strong data-testid="fedramp-sdr-version"><%= @boundary.fedramp_sdr_version %></strong></div>
    <div class="text-muted small">Rules: FedRAMP Consolidated Rules <%= FedrampRules.version %></div>
  </div>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
  <% { FedrampRules::FRR => "FedRAMP rules", FedrampRules::KSI => "Key Security Indicators" }.each do |kind, label| %>
    <li class="nav-item">
      <%= link_to "#{label} (#{@counts[kind]})", fedramp_authorization_boundary_path(@boundary, kind: kind),
            class: "nav-link#{' active' if @kind == kind}", "aria-current": (@kind == kind ? "page" : nil),
            data: { testid: "fedramp-tab-#{kind}" } %>
    </li>
  <% end %>
</ul>

<% if @kind == FedrampRules::FRR && !@boundary.fedramp_profile_complete? %>
  <div class="card mb-3" data-testid="fedramp-profile-incomplete">
    <div class="card-body text-muted">
      Which FedRAMP rules apply depends on the certification type, path and class. Set them in the
      boundary's FedRAMP section (<%= link_to "Edit boundary", edit_authorization_boundary_path(@boundary) %>).
    </div>
  </div>
<% else %>
  <p class="small text-muted" data-testid="fedramp-summary">
    <% answered = @entries.count(&:statement) %>
    <%= answered %> of <%= @entries.size %> answered
    <% FedrampStatement.statuses.each do |s| %>
      · <span class="badge <%= status_badge[s] %>"><%= s %></span> <%= @summary[s].to_i %>
    <% end %>
    <% if @kind == FedrampRules::KSI %>
      · <%= type == "20x" ? "Required in a 20x Security Decision Record (SDR-CSX-KSI)." : "Optional for #{type.presence || 'this certification'}; recorded KSIs are included." %>
    <% end %>
  </p>

  <% groups = @entries.group_by { |e| @kind == FedrampRules::FRR ? [ e.rule.family, e.rule.family_name ] : [ e.rule.theme, e.rule.theme_name ] } %>
  <% groups.each do |(code, name), entries| %>
    <div class="card mb-3" data-testid="fedramp-group-<%= code %>">
      <div class="card-header"><%= name %> <span class="text-muted small">(<%= code %>, <%= entries.size %>)</span></div>
      <div class="list-group list-group-flush">
        <% entries.each do |entry| %>
          <%= render "fedramp_statements/entry", boundary: @boundary, kind: @kind, entry: entry,
                     may_edit: @may_edit, status_badge: status_badge %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
