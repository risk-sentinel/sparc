<%# CDEF scope picker (#395 P1, third tier #980).
    Three mutually exclusive choices:
      - Boundary-specific: attached to the picked AuthorizationBoundary's
        sub-Boundary records via boundary_cdef_documents.
      - Organization-wide: usable by any boundary's SSP composition flow
        within the current user's organization.
      - Instance-wide: usable by EVERY organization on this instance.
        Admin-only — it publishes across organization boundaries, which is
        instance authority. `CdefDocumentsController#update_scope` refuses it
        for a non-admin, so hiding the radio here is presentation, not the
        guard.

    Required local: param_key (e.g. :cdef_document).
%>
<%
  param_key = local_assigns.fetch(:param_key, :cdef_document)
  # Element ids, so the picker can render twice on one page (#1258: the
  # authoring form has its own). Field names stay under `param_key`.
  id_prefix = local_assigns.fetch(:id_prefix, param_key)
  # #929 — shared with shared/_boundary_picker so the two cannot drift. The
  # legacy roster join this replaced returned an empty set for every user.
  # #1258 — a boundary-only writer may choose only boundaries they hold
  # cdef.write on, and not the organization-wide tier (CdefWriteAccess).
  instance_writer = CdefWriteAccess.instance_writer?(current_user)
  boundaries = instance_writer ? assignable_boundaries(current_user) : CdefWriteAccess.writable_boundaries(current_user)
  selected_boundary_id = local_assigns.fetch(:selected, nil).presence
  selected_scope = local_assigns.fetch(:scope, "boundary").to_s
  # The instance tier needs CdefScopeService.may_scope_instance? — see
  # update_scope. Anyone else looking at a CDEF that is ALREADY instance-wide
  # still sees the option, disabled, rather than a picker that silently
  # misreports the state.
  may_scope_instance = CdefScopeService.may_scope_instance?(current_user)
  instance_selected  = selected_scope == "instance"
%>

<div data-controller="cdef-scope">
<div class="form-group mb-3">
  <span class="fw-semibold d-block mb-2">CDEF Scope</span>

  <div class="form-check">
    <%= radio_button_tag "#{param_key}[scope]", "boundary", selected_scope != "global",
          class: "form-check-input",
          id:    "#{id_prefix}_scope_boundary",
          data:  { action: "change->cdef-scope#toggle", cdef_scope_target: "boundaryRadio" } %>
    <label class="form-check-label" for="<%= id_prefix %>_scope_boundary">
      <strong>Boundary-specific</strong> — attach this CDEF to a specific
      authorization boundary's environments.
    </label>
  </div>

  <div class="form-check">
    <%= radio_button_tag "#{param_key}[scope]", "global", selected_scope == "global",
          class: "form-check-input",
          disabled: !instance_writer,
          id:    "#{id_prefix}_scope_global",
          data:  { action: "change->cdef-scope#toggle", cdef_scope_target: "globalRadio" } %>
    <label class="form-check-label" for="<%= id_prefix %>_scope_global">
      <strong>Organization-wide</strong> — any boundary's SSP within your
      organization can compose this CDEF.
      <% unless instance_writer %>
        <span class="text-body-secondary">(needs cdef.write across the instance)</span>
      <% end %>
    </label>
  </div>

  <%# #980 — the third tier. The model always described it; only two were ever
      offered, so a CDEF meant for every organization had nowhere to say so. %>
  <% if may_scope_instance || instance_selected %>
    <div class="form-check">
      <%= radio_button_tag "#{param_key}[scope]", "instance", instance_selected,
            class: "form-check-input",
            disabled: !may_scope_instance,
            id:    "#{id_prefix}_scope_instance",
            data:  { action: "change->cdef-scope#toggle", cdef_scope_target: "instanceRadio" } %>
      <label class="form-check-label" for="<%= id_prefix %>_scope_instance">
        <strong>Instance-wide</strong> — every organization on this instance can
        compose this CDEF.
        <% unless may_scope_instance %>
          <span class="text-body-secondary">(Policy Managers and instance administrators)</span>
        <% end %>
      </label>
    </div>
  <% end %>
</div>

<%# Boundary picker (only relevant when scope = boundary). The TODO below
    tracks the org-admin permission check for global publishing per #395 P2. %>
<div class="form-group mb-3" id="<%= id_prefix %>_boundary_picker_wrapper" data-cdef-scope-target="wrapper">
  <label for="<%= id_prefix %>_authorization_boundary_id" class="fw-semibold">
    Authorization Boundary
  </label>
  <% if boundaries.any? %>
    <%= select_tag "#{param_key}[authorization_boundary_id]",
          options_for_select([ [ "— Select a boundary —", "" ] ] +
                             boundaries.map { |b| [ b.name, b.id ] },
                             selected_boundary_id.to_s),
          class: "form-control",
          id:    "#{id_prefix}_authorization_boundary_id" %>
    <small class="text-body-secondary d-block mt-1">
      Required when scope is "Boundary-specific". Ignored for the organization-wide and instance-wide tiers.
    </small>
  <% else %>
    <%# #929 — the field used to vanish when the list was empty, leaving
        "Boundary-specific" selected with nothing to select. %>
    <p class="text-body-secondary small mb-0" id="<%= id_prefix %>_authorization_boundary_id">
      You are not on the roster of any authorization boundary. Choose
      "Globally available" above, or ask to be added to a boundary first.
    </p>
  <% end %>
</div>

</div><%# end data-controller="cdef-scope" %>
