<%= render "shared/section_summary", tiles: [
  [@total_count, "Component Defs"],
  [@controls_count, "Total Controls"],
  [@completed_count, "Completed"]
] %>

<% if @cdef_documents.any? { |d| d.processing? || d.pending? } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="10000" hidden></div>
<% end %>

<div class="card sparc-ofx-auto">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Component Definitions</h2>
    <% if signed_in? %>
      <div class="d-flex gap-2 sparc-btn-action-row">
        <%# #488: manual trigger for AwsLabsCdefRefreshJob, gated on the
            converters.write permission (same RBAC bucket as the DISA CCI
            "Refresh Now" button). Button + modal are hidden entirely when
            the feature flag is off — no point teasing operators with a
            button that would just flash an error. %>
        <% if can_write_converters? && SparcConfig.aws_labs_cdef_enabled? %>
          <button type="button" class="sparc-action sparc-action--caution sparc-action--solid"
                  data-bs-toggle="modal" data-bs-target="#refreshAwsLabsModal">
            Refresh from AWS Labs
          </button>
        <% end %>
        <%# #904 — the other direction into the coverage wizard. Its primary home
            is the boundary screen (that is where the question is asked), but
            someone standing in the CDEF library asking "what are we missing?"
            should not have to go find a boundary first. %>
        <%# The wizard role (#950). The label used to wrap onto two lines via a
            <span><br></span> because it is far longer than its neighbours —
            but `.sparc-action` is `white-space: nowrap`, and a wrapped button
            stretched the whole row to 52px. One line, shorter label. %>
        <%= link_to "Terraform Wizard", new_cdef_coverage_path,
              class: "sparc-action sparc-action--accent sparc-action--outline" %>
        <%= link_to "Create New", select_profile_cdef_documents_path, class: "sparc-action sparc-action--positive sparc-action--solid" %>
        <%= link_to "Upload File", new_cdef_document_path, class: "sparc-action sparc-action--info sparc-action--solid" %>
      </div>
    <% end %>
  </div>


  <%# #488 — Refresh from AWS Labs confirmation modal (matches the DISA
      CCI confirmation modal pattern from app/views/converters/show.html.erb). %>
  <% if signed_in? && can_write_converters? && SparcConfig.aws_labs_cdef_enabled? %>
    <div class="modal fade" id="refreshAwsLabsModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Refresh from AWS Labs</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p>This will fetch the latest OSCAL Component Definitions from
              <a href="https://github.com/awslabs/oscal-content-for-aws-services" target="_blank" rel="noopener">
              awslabs/oscal-content-for-aws-services</a> and import any new or
              updated entries.</p>
            <p class="mb-0 small text-body-secondary">Imports are idempotent — existing rows
              with matching SHA are left unchanged. Refreshes typically take a few seconds.
              The job runs asynchronously; new rows appear once the worker processes them.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" data-bs-dismiss="modal">Cancel</button>
            <%= button_to "Refresh Now", refresh_aws_labs_cdef_documents_path,
                  method: :post, class: "sparc-action sparc-action--caution sparc-action--solid sparc-action--sm fw-semibold",
                  form: { class: "sparc-d-inline" } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div data-controller="bulk-select">
  <%# #629 — admin-only bulk delete bar; appears when ≥1 row is selected. %>
  <% if can_bulk_delete? && @cdef_documents.any? %>
    <div class="mb-2" data-bulk-select-target="bar" hidden>
      <%= form_with url: bulk_destroy_cdef_documents_path, method: :delete, id: "cdefBulkForm" do %>
        <button type="submit" class="sparc-action sparc-action--danger sparc-action--outline sparc-action--sm" data-bulk-select-target="submit"
                data-turbo-confirm="Delete the selected component definitions? This cannot be undone.">
          Delete (<span data-bulk-select-target="count">0</span> selected)
        </button>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/collection_toolbar",
        label: "component definitions",
        placeholder: "Search component definitions…",
        view_mode: (@view_mode if @cdef_documents.any?),
        facets: @facets, clear_params: @clear_facets,
        extra: (render("cdef_documents/select_all") if can_bulk_delete? && @cdef_documents.any? && @view_mode == :card) %>

  <% if @cdef_documents.any? && @view_mode == :card %>
    <div class="sparc-card-grid">
      <% @cdef_documents.each do |doc| %>
        <% summary = (@component_summaries || {})[doc.id] || CdefComponent.empty_summary %>
        <%= render "shared/item_card",
              title: cdef_display_name(doc),
              url: cdef_document_path(doc),
              badges: [
                cdef_source_badge(doc),
                { text: "OSCAL #{doc.oscal_version.presence || "—"}", class: "badge bg-light text-dark" }
              ],
              subtitle: cdef_service_summary(summary),
              description: summary[:primary_description].presence || doc.description,
              metrics: cdef_card_metrics(doc, summary),
              chips: cdef_card_chips(summary),
              empty_note: [ cdef_partition_caveat(summary), cdef_coverage_note(summary) ].compact.join(" "),
              footer: [ doc.cdef_type.presence, cdef_mapping_note(summary),
                        "#{summary[:region_count]} regions" ].compact.join(" · "),
              select: (render("cdef_documents/bulk_checkbox", doc: doc) if can_bulk_delete?),
              actions: render("cdef_documents/item_actions", doc: doc, compact: true) %>
      <% end %>
    </div>
  <% elsif @cdef_documents.any? %>
    <table class="table table-hover">
      <thead>
        <tr>
          <% if can_bulk_delete? %>
            <th class="sparc-w-1pct"><input type="checkbox" data-bulk-select-target="selectAll" data-action="bulk-select#toggleAll" aria-label="Select all"></th>
          <% end %>
          <th class="sparc-ws-nowrap">Name</th>
          <th class="sparc-ws-nowrap">Type</th>
          <th class="sparc-ws-nowrap">Version</th>
          <th class="sparc-ws-nowrap">Status</th>
          <th class="sparc-ws-nowrap">Controls</th>
          <th class="sparc-ws-nowrap">Created</th>
          <th class="sparc-ws-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @cdef_documents.each do |doc| %>
          <tr>
            <% if can_bulk_delete? %>
              <td><%= render "cdef_documents/bulk_checkbox", doc: doc %></td>
            <% end %>
            <td><strong><%= link_to cdef_display_name(doc), cdef_document_path(doc), class: "text-primary sparc-td-none" %></strong></td>
            <td>
              <% type_variants = { "disa_stig" => "danger", "scap" => "info", "cis" => "warning", "custom" => "neutral" } %>
              <span class="sparc-status sparc-status--<%= type_variants[doc.cdef_type] || 'neutral' %>">
                <%= doc.cdef_type&.upcase&.tr("_", " ") || "Unknown" %>
              </span>
            </td>
            <td class="small text-body-secondary"><%= doc.cdef_version.presence || "—" %></td>
            <td class="sparc-ws-nowrap">
              <% if doc.processing? || doc.pending? || doc.failed? %>
                <span class="<%= doc.completed? ? 'badge-ok' : doc.failed? ? 'badge-fail' : 'badge-warn' %> rounded fw-semibold sparc-p-02-06 sparc-fs-085">
                  <%= doc.status %>
                </span>
                <% if doc.processing? && doc.metadata_extra&.dig("processing_message").present? %>
                  <br><span class="text-body-secondary sparc-fs-072 sparc-ws-normal"><%= doc.metadata_extra["processing_message"] %></span>
                <% end %>
              <% else %>
                <span class="<%= doc.lifecycle_badge_class %> rounded fw-semibold sparc-p-02-06 sparc-fs-085">
                  <%= doc.lifecycle_label %>
                </span>
                <%# #628 — flag content-incomplete drafts (distinct from parse status). %>
                <% if !doc.published_lifecycle? && !doc.content_complete? %>
                  <span class="badge-warn rounded fw-semibold sparc-p-02-06 sparc-fs-085"
                        title="<%= doc.content_completeness_gaps.join('; ') %>">
                    Incomplete
                  </span>
                <% end %>
                <%# #968 item 3 — visible in the LIST as well, so a degraded row is
                    spotted without opening each document. %>
                <% if doc.component_index_degraded? %>
                  <span class="badge-warn rounded fw-semibold sparc-p-02-06 sparc-fs-085"
                        data-testid="cdef-index-degraded"
                        title="Component index failed during import; controls are intact.">
                    Index degraded
                  </span>
                <% end %>
              <% end %>
            </td>
            <td><%= doc.cdef_controls.count %></td>
            <td class="sparc-ws-nowrap"><%= doc.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <div class="sparc-maxw-280px">
                <%= render "cdef_documents/item_actions", doc: doc %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center p-4 text-body-secondary">No component definitions found. Upload your first CDEF to get started.</p>
  <% end %>
  <%= render "shared/collection_pagination", pagy: @pagy, label: "component definitions" %>

  </div>
</div>
