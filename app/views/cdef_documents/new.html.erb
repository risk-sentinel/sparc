<%# Three independent ways to add a component definition, one shown at a time.
    Each has its own form and button; nothing carries between them, so the page
    asks which one first. The chooser is tabs (cdef_new_chooser_controller.js):
    a choice can be linked directly (#upload, #author, #profile), and without
    JavaScript the chooser stays hidden and all three forms show. A rejected
    authored CDEF re-renders on Author (@cdef_new_choice).

    ?only=upload is the import page on its own — what the CDEF list's Upload
    File button opens: drop files, set availability, upload. No chooser. %>
<% if params[:only] == "upload" %>
  <div class="card" data-testid="cdef-upload-only">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
      <h2>Upload Component Definition</h2>
      <%= link_to "Other ways to add one", new_cdef_document_path,
            class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm" %>
    </div>
    <p class="text-body-secondary sparc-fs-088">
      Import a component definition someone else authored: OSCAL, XCCDF, InSpec or a STIG Viewer export.
    </p>
    <%= render "cdef_documents/upload_form", upload_only: true %>
  </div>
<% else %>
<% choices = [
     { key: "upload", accent: "sparc-accent--blue", icon: "&#128194;", title: "Upload files",
       desc: "Import an OSCAL, XCCDF, InSpec or STIG Viewer file." },
     { key: "author", accent: "sparc-accent--green", icon: "&#9999;&#65039;", title: "Author from scratch",
       desc: "Describe a component yourself, then add controls." },
     { key: "profile", accent: "sparc-accent--purple", icon: "&#128203;", title: "From a published profile",
       desc: "Start from a profile's controls and parameters." }
   ] %>

<div data-controller="cdef-new-chooser"
     data-cdef-new-chooser-default-value="<%= @cdef_new_choice || "upload" %>">
  <div class="mb-3">
    <h2 class="mb-1">New Component Definition</h2>
    <p class="text-body-secondary mb-0">
      Choose how to add it. Each way has its own form; switching starts a new one.
    </p>
  </div>

  <div class="row row-cols-1 row-cols-md-3 g-2 mb-3" role="tablist"
       aria-label="How to add a component definition"
       data-cdef-new-chooser-target="chooser" hidden>
    <% choices.each do |c| %>
      <div class="col">
        <button type="button" role="tab" id="cdef-new-tab-<%= c[:key] %>"
                aria-controls="cdef-new-panel-<%= c[:key] %>" aria-selected="false" tabindex="-1"
                class="card sparc-section-card sparc-section-card--accented sparc-cdef-choice h-100 w-100 text-start <%= c[:accent] %>"
                data-cdef-new-chooser-target="tab" data-choice="<%= c[:key] %>"
                data-action="click->cdef-new-chooser#select keydown->cdef-new-chooser#navigate">
          <span class="card-body d-flex align-items-start gap-3">
            <span class="sparc-fs-22r" aria-hidden="true"><%= c[:icon].html_safe %></span>
            <span class="flex-grow-1">
              <span class="d-block fw-semibold sparc-fs-095"><%= c[:title] %></span>
              <span class="d-block text-body-secondary sparc-fs-075"><%= c[:desc] %></span>
            </span>
            <span class="sparc-cdef-choice-check" aria-hidden="true">&#10003;</span>
          </span>
        </button>
      </div>
    <% end %>
  </div>

  <div class="card" role="tabpanel" id="cdef-new-panel-upload" aria-labelledby="cdef-new-tab-upload"
       data-cdef-new-chooser-target="panel" data-choice="upload">
    <h2>Upload files</h2>

    <%= render "cdef_documents/upload_form" %>
  </div>

  <%# #944 — authoring from scratch. This form carries no file field, which is
      exactly how the controller tells it from an upload. %>
  <div class="card" role="tabpanel" id="cdef-new-panel-author" aria-labelledby="cdef-new-tab-author"
       data-cdef-new-chooser-target="panel" data-choice="author">
    <h2>Author from scratch</h2>
    <p class="text-body-secondary sparc-fs-088">
      Describe a component yourself, rather than importing one. You can give it a
      control basis afterwards — from a published profile, or by adding controls
      directly.
    </p>

    <%= form_with model: @cdef_document, local: true do |f| %>
      <%= render "component_fields", f: f %>
      <%# #1258 — an authored CDEF is scoped at create, as an upload is. %>
      <%= render "cdef_documents/scope_picker", param_key: :cdef_document, id_prefix: :cdef_author %>

      <div class="d-flex gap-3 mt-4">
        <%= f.submit "Create Component Definition", class: "sparc-action sparc-action--positive sparc-action--solid",
              data: { testid: "author-cdef-submit" } %>
        <%= link_to "Cancel", cdef_documents_path, class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
      </div>
    <% end %>
  </div>

  <div class="card" role="tabpanel" id="cdef-new-panel-profile" aria-labelledby="cdef-new-tab-profile"
       data-cdef-new-chooser-target="panel" data-choice="profile">
    <h2>Generate from a published profile</h2>
    <p class="text-body-secondary mb-3">
      Generate a Component Definition from a published OSCAL Profile's resolved catalog.
      Controls, parameters, and guidance will be pre-populated. Implementation narratives
      and notes can be added after creation.
    </p>
    <div>
      <%= link_to "Select a Profile", select_profile_cdef_documents_path, class: "sparc-action sparc-action--info sparc-action--solid" %>
    </div>
  </div>
</div>

<% end %>

<div class="card">
  <h3>Export Capabilities</h3>
  <p class="text-body-secondary mb-3">After processing, component definitions can be exported in the following formats:</p>

  <div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col">
      <div class="bg-body-secondary p-3 rounded sparc-cdef-export sparc-accent--purple">
        <div class="fw-bold sparc-heading-enterprise sparc-mb-035">OSCAL Component Definition</div>
        <div class="text-body-secondary sparc-fs-088">
          NIST OSCAL v<%= OscalSchema::DEFAULT_VERSION %> Component Definition JSON. Maps controls to implemented-requirements with severity, CCI references, and implementation narratives.
        </div>
      </div>
    </div>
    <div class="col">
      <div class="bg-body-secondary p-3 rounded sparc-cdef-export sparc-accent--green">
        <div class="fw-bold sparc-mb-035 sparc-cdef-export-title--success">SPARC JSON</div>
        <div class="text-body-secondary sparc-fs-088">
          Standard SPARC JSON export with document metadata, controls, and all associated fields.
        </div>
      </div>
    </div>
  </div>
</div>
