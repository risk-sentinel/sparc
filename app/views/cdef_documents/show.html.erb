<%# ── PROCESSING STATE BANNER ─────────────────────────────────────── %>
<% unless @cdef_document.completed? %>
  <%= render "shared/processing_banner",
       document:     @cdef_document,
       title:        "Processing Your Component Definition",
       back_label:   "Back to Component Definitions",
       back_path:    cdef_documents_path %>

<% else %>
<%
  severity_total = @severity_counts.values.sum
  high_count   = @severity_counts["high"].to_i
  medium_count = @severity_counts["medium"].to_i
  low_count    = @severity_counts["low"].to_i
  info_count   = @severity_counts["info"].to_i

  type_colors = { "disa_stig" => "#e74c3c", "scap" => "#3498db", "cis" => "#f39c12", "custom" => "#95a5a6" }
  type_color  = type_colors[@cdef_document.cdef_type] || "#7f8c8d"
%>

<div data-controller="doc-meta heatmap-chip cdef-control"
     data-cdef-control-update-field-url-value="<%= update_field_cdef_document_path(@cdef_document) %>"
     data-cdef-control-create-url-value="<%= create_control_resource_cdef_document_path(@cdef_document) %>"
     data-cdef-control-unlink-url-value="<%= unlink_control_resource_cdef_document_path(@cdef_document) %>">

<%# ── HEADER DASHBOARD ──────────────────────────────────────────── %>
<div class="sparc-dashboard-header">

  <div class="d-flex justify-content-between align-items-start mb-4 gap-3 flex-wrap">
    <div>
      <div class="sparc-header-subtitle">Component Definition</div>

      <div id="doc-meta-view" data-doc-meta-target="view">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h2 class="sparc-header-title"><%= cdef_display_name(@cdef_document) %></h2>
          <% if @cdef_document.cdef_version.present? %>
            <span class="sparc-version-badge">v<%= @cdef_document.cdef_version %></span>
          <% end %>
          <% if @cdef_document.aws_labs_source? %>
            <span class="badge bg-warning text-dark" title="Read-only — imported from AWS Labs">
              AWS Labs (read-only)
            </span>
          <% end %>
          <%# #627/#628 — content-completeness is distinct from the parse status. %>
          <% unless @cdef_document.content_complete? %>
            <span class="badge bg-warning text-dark"
                  title="<%= @cdef_document.content_completeness_gaps.join('; ') %>">
              Incomplete — needs content
            </span>
          <% end %>
          <%# #968 item 3 — a degraded component index is swallowed by design so a
              parsed document is not lost, but it must not read as a clean import.
              Distinct from "Incomplete": the content IS there, the component
              index that summarises it is not. %>
          <% if @cdef_document.component_index_degraded? %>
            <span class="badge bg-warning text-dark"
                  data-testid="cdef-index-degraded"
                  title="The component index failed during import on <%= @cdef_document.component_index_failed_at %>. Controls are intact; component-derived views may understate this document. Re-import to rebuild it.">
              Component index degraded
            </span>
          <% end %>
          <% if signed_in? && !@cdef_document.aws_labs_source? %>
            <button type="button" data-action="doc-meta#toggle" class="sparc-action sparc-action--primary sparc-action--outline">Edit</button>
          <% end %>
        </div>
      </div>

      <%# ── #911: lineage + unmapped STIG rules, in one place ──
          This replaced a bespoke unmapped-rules banner. Unmapped rules now
          arrive through `additional_reconciliation_issues`, so the shared
          partial reports them alongside missing lineage instead of the reader
          meeting two differently-worded warnings about the same document. %>
      <%= render "shared/reconciliation_banner", document: @cdef_document %>

      <% if @cdef_document.aws_labs_source? %>
        <div class="alert alert-warning d-flex justify-content-between align-items-center mt-2 mb-0" role="alert">
          <div>
            <strong>Imported from AWS Labs.</strong>
            This component definition is maintained upstream and is read-only here.
            <% if @cdef_document.source_url.present? %>
              <a href="<%= @cdef_document.source_url %>" target="_blank" rel="noopener" class="alert-link">View source</a>.
            <% end %>
            To make edits, create a copy.
          </div>
          <% if signed_in? %>
            <%= button_to "Copy for editing",
                  copy_cdef_document_path(@cdef_document),
                  method: :post,
                  class: "sparc-action sparc-action--info sparc-action--outline sparc-action--sm ms-3",
                  form: { class: "mb-0" } %>
          <% end %>
        </div>
      <% end %>

      <% if signed_in? %>
        <div class="sparc-d-none" id="doc-meta-edit" data-doc-meta-target="edit">
          <%= form_with url: update_metadata_cdef_document_path(@cdef_document), method: :patch, local: true do |f| %>
            <div class="d-flex gap-2 align-items-center flex-wrap">
              <%= f.text_field :name, value: @cdef_document.name,
                    class: "sparc-input-dark sparc-input-dark-lg" %>
              <%= f.text_field :cdef_version, value: @cdef_document.cdef_version, placeholder: "Version",
                    class: "sparc-input-dark sparc-input-dark-sm" %>
              <%= f.submit "Save", class: "sparc-action sparc-action--primary sparc-action--solid" %>
              <button type="button" data-action="doc-meta#toggle" class="sparc-action sparc-action--neutral sparc-action--ghost">Cancel</button>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="sparc-header-meta">
        <%= @cdef_document.original_filename %>
        &nbsp;&bull;&nbsp;
        <span class="fw-semibold sparc-accent-text <%= accent_class(type_color) %>"><%= @cdef_document.cdef_type&.upcase&.tr("_", " ") || "Unknown" %></span>
        &nbsp;&bull;&nbsp; <%= @total_controls %> controls
      </div>
      <% if @cdef_document.description.present? %>
        <div class="sparc-color-white-45 sparc-fs-082 sparc-mt-04 sparc-maxw-600"><%= truncate(@cdef_document.description, length: 200) %></div>
      <% end %>
    </div>
    <div class="d-flex gap-2 flex-shrink-0 flex-wrap">
      <%# #944 — there was no way to edit a component definition at all. Shown
          only where a mutation would actually be permitted, so the button does
          not lead to a guard that immediately bounces the user back. %>
      <% if signed_in? && !@cdef_document.aws_labs_source? &&
            !@cdef_document.published_lifecycle? &&
            (current_user.admin? || current_user.has_permission?("cdef.write")) %>
        <%= link_to "Edit", edit_cdef_document_path(@cdef_document),
              class: "sparc-action sparc-action--primary sparc-action--outline", data: { testid: "edit-cdef" } %>
      <% end %>
      <% if signed_in? %>
        <% if @cdef_document.published_lifecycle? %>
          <%= button_to "Create Editable Copy", copy_cdef_document_path(@cdef_document), method: :post,
                class: "sparc-action sparc-action--positive sparc-action--solid", form: { data: { turbo_confirm: "Create an editable copy of this published component definition?" } } %>
        <% else %>
          <%= button_to "Copy", copy_cdef_document_path(@cdef_document), method: :post,
                class: "sparc-action sparc-action--info sparc-action--outline", form: { data: { turbo_confirm: "Duplicate this component definition?" } } %>
        <% end %>
      <% end %>
      <%# #499 slice 5 — bulk-apply Converter (editable clones only). %>
      <% if signed_in? && !@cdef_document.aws_labs_source? &&
            (current_user.admin? || current_user.has_permission?("converters.write")) %>
        <%# `update`, not `overwrite`: bulk_apply_preview stands between this and
            any change, so it applies reviewed edits rather than replacing rows
            unseen. The verb is mid-label, which is why the sweep missed it. %>
        <%= link_to "Bulk Apply Converter", bulk_apply_cdef_document_path(@cdef_document),
              class: "sparc-action sparc-action--primary sparc-action--solid" %>
      <% end %>
      <% if signed_in? && @cdef_document.draft? %>
        <%= render "shared/publish_button", document: @cdef_document,
              publish_path: publish_cdef_document_path(@cdef_document),
              check_path: publish_check_cdef_document_path(@cdef_document) %>
      <% end %>
      <%= render "shared/oscal_export_dropdown",
            validate_path: validate_oscal_export_cdef_document_path(@cdef_document),
            download_json_path: download_oscal_validated_cdef_document_path(@cdef_document),
            download_yaml_path: download_yaml_cdef_document_path(@cdef_document),
            download_xml_path: download_xml_cdef_document_path(@cdef_document),
            fallback_json_path: download_oscal_unvalidated_cdef_document_path(@cdef_document),
            document_type: "Component Definition" %>
      <%= link_to "&#8592; Back".html_safe, cdef_documents_path,
            class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>
  </div>

  <div class="d-flex align-items-center gap-4 flex-wrap">
    <div class="text-center flex-shrink-0 sparc-minw-80px">
      <div class="sparc-score sparc-color-white"><%= @total_controls %></div>
      <div class="sparc-score-label">Total Controls</div>
    </div>

    <div class="sparc-divider-v"></div>

    <div class="d-flex flex-wrap gap-2 sparc-flex-1">
      <% [["high", high_count], ["medium", medium_count], ["low", low_count], ["info", info_count]].each do |sev, count| %>
        <% next if count == 0 %>
        <div class="summary-chip sparc-summary-chip sparc-border-l-3 <%= accent_class(cdef_severity_color(sev)) %>"
             data-filter-value="<%= sev %>"
             data-action="click->heatmap-chip#apply keydown.enter->heatmap-chip#apply keydown.space->heatmap-chip#apply"
             data-heatmap-chip-filter-param="<%= sev %>"
             role="button"
             tabindex="0"
             title="Click to filter: <%= sev %>"
             >
          <div class="sparc-chip-count"><%= count %></div>
          <div class="sparc-chip-label sparc-tt-capitalize"><%= sev %></div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-3">
    <div class="sparc-progress-bar">
      <% [["high", high_count], ["medium", medium_count], ["low", low_count], ["info", info_count]].each do |sev, count| %>
        <% next if count == 0 %>
        <div class="sparc-bar-fill sparc-accent-bg <%= accent_class(cdef_severity_color(sev)) %>"
             data-controller="bar"
             data-bar-pct-value="<%= (count * 100.0 / [severity_total, 1].max).round(3) %>"
             title="<%= sev.capitalize %>: <%= count %>"></div>
      <% end %>
    </div>
  </div>
</div>

<%# ── #887: COMPONENTS, APPLICABILITY AND PROVENANCE ──────────────────
    Placed above the control sections deliberately: for the 163 of 230
    upstream CDEFs that assert no controls, this is the only content on the
    page, and it must not sit below an empty heatmap. %>
<%= render "cdef_documents/components_panel",
      document: @cdef_document,
      components: @components || [] %>

<%# ── SEVERITY HEATMAP BY CONTROL FAMILY ─────────────────────────── %>
<%= render "shared/heatmap",
     heatmap_data: @heatmap_data,
     heatmap_families: @heatmap_families,
     heatmap_statuses: @heatmap_severities,
     title: "Severity by Control Family",
     variant_helper: :cdef_severity_variant,
     filter_key: "severity",
     show_percentage: false,
     legend_items: %w[high medium low info].map { |s| [s.capitalize, cdef_severity_color(s)] } %>

<%# ── BASELINE COVERAGE (if linked to profile) ──────────────────── %>
<% if @gap_analysis.present? %>
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="fw-bold mb-3" id="baseline-coverage-heading">Baseline Coverage</h5>
      <div class="d-flex align-items-center gap-3 mb-2">
        <div class="progress flex-grow-1 sparc-h-12r">
          <%# role="progressbar" takes no accessible name from its contents, so the
              percentage rendered inside it is invisible to a screen reader — the
              control announced as "progress bar" with no name and no value. Named
              from the heading it sits under, and given the value attributes so the
              figure is announced rather than only drawn (WCAG 2.1 A/AA,
              axe rule `aria-progressbar-name`). %>
          <div class="progress-bar sparc-bar-fill <%= @gap_analysis[:coverage_pct] == 100.0 ? 'bg-success' : @gap_analysis[:coverage_pct] >= 80 ? 'bg-warning' : 'bg-danger' %>"
               data-controller="bar"
               data-bar-pct-value="<%= @gap_analysis[:coverage_pct] %>"
               role="progressbar"
               aria-labelledby="baseline-coverage-heading"
               aria-valuenow="<%= @gap_analysis[:coverage_pct] %>"
               aria-valuemin="0"
               aria-valuemax="100">
            <%= @gap_analysis[:coverage_pct] %>%
          </div>
        </div>
      </div>
      <div class="d-flex gap-4 sparc-fs-085">
        <span class="text-success fw-semibold"><%= @gap_analysis[:covered].size %> covered</span>
        <% if @gap_analysis[:missing].any? %>
          <span class="text-danger fw-semibold"><%= @gap_analysis[:missing].size %> missing</span>
        <% end %>
        <% if @gap_analysis[:extra].any? %>
          <span class="text-body-secondary"><%= @gap_analysis[:extra].size %> extra (beyond baseline)</span>
        <% end %>
        <span class="text-body-secondary">Baseline: <%= @gap_analysis[:total_baseline] %> controls</span>
      </div>

      <% if @missing_controls&.any? %>
        <details class="mt-2">
          <summary class="text-danger sparc-cursor-pointer sparc-fs-085">
            Show <%= @missing_controls.size %> missing control(s)
          </summary>
          <div class="mt-2 sparc-fs-082">
            <% @missing_controls.each do |mc| %>
              <div class="d-flex align-items-center gap-2 py-1 border-bottom">
                <code class="fw-bold"><%= mc[:id] %></code>
                <span class="text-body-secondary"><%= mc[:title] %></span>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </div>
<% end %>

<%# ── EMPTY-STATE: populate from profile (#628) ───────────────────── %>
<% if !@cdef_document.cdef_controls.exists? && @cdef_document.editable? %>
  <div class="card border-warning mb-3">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h5 class="card-title mb-1">This component definition has no controls yet</h5>
        <p class="card-text text-body-secondary mb-0">
          A CDEF needs a control basis before it can be published. Populate it from a
          published profile to import controls, parameters, and guidance.
        </p>
      </div>
      <% if signed_in? %>
        <%= link_to "Populate from Profile",
              select_profile_source_cdef_document_path(@cdef_document),
              class: "sparc-action sparc-action--primary sparc-action--solid" %>
      <% end %>
    </div>
  </div>
<% end %>

<%# ── CONTROL CARDS ───────────────────────────────────────────────── %>
<div id="controlsContainer">
  <% @controls.sort_by { |c| CdefControl.control_sort_key(c.control_id) }.each do |control| %>
    <%
      field_map    = control.cdef_control_fields.index_by(&:field_name)
      sev_val      = control.severity.presence || "(Unknown)"
      sev_color    = cdef_severity_color(sev_val)
      sev_variant  = cdef_severity_variant(sev_val)
      # #911 — `"".split("-").first` is nil, so the unguarded `.upcase` that was
      # here raised NoMethodError and 500'd this whole page for any CDEF holding
      # an unmapped STIG rule — which, as of this commit, legitimately has no
      # control_id and no derived family. The same idiom is unguarded in seven
      # other places; consolidating them is tracked as #913.
      family_code  = control.control_family.presence ||
                     control.control_id.to_s.split("-").first&.upcase.presence
      description  = field_map["description"]&.field_value.presence
      cci_refs     = field_map["cci_refs"]&.field_value.presence
    %>
    <div class="control-card sparc-border-l-4 <%= accent_class(sev_color) %>"
         data-family="<%= family_code %>"
         data-severity="<%= sev_val %>">

      <%# ── Card header ── %>
      <div class="d-flex justify-content-between align-items-start sparc-gap-1r">
        <div class="sparc-flex-1 sparc-minw-0">
          <div class="d-flex align-items-center gap-2 flex-wrap sparc-mb-02">
            <%# #911 — an unmapped STIG rule leads with its own identifier and
                says so, rather than showing a bare dash where a control would be. %>
            <span class="sparc-ctrl-id">
              <%= control.control_id.presence || control.provenance_id.presence || "&mdash;".html_safe %>
            </span>
            <% if control.unmapped_stig_rule? %>
              <span class="sparc-tag-outline fw-semibold sparc-cdef-callout sparc-accent--orange"
                    title="This STIG rule resolved to no NIST control through its CCI references.">
                Unmapped
              </span>
            <% end %>
            <span class="sparc-status-pill sparc-status--<%= sev_variant %> sparc-tt-capitalize">
              <%= sev_val %>
            </span>
            <% if control.stig_id.present? && control.stig_id != control.control_id && !control.unmapped_stig_rule? %>
              <span class="sparc-tag-outline fw-semibold text-body-secondary sparc-cdef-tint-soft sparc-accent--purple">
                <%= control.stig_id %>
              </span>
            <% end %>
            <% if control.group_id.present? && control.group_id != control.control_id && control.group_id != control.stig_id %>
              <span class="sparc-tag-outline bg-body-secondary border fw-semibold text-body-secondary">
                <%= control.group_id %>
              </span>
            <% end %>
            <% if cci_refs.present? %>
              <span class="sparc-tag-outline fw-semibold text-body-secondary sparc-cdef-tint-soft sparc-accent--green sparc-color-secondary">
                CCI (<%= cci_refs.split(",").map(&:strip).size %>)
              </span>
            <% end %>
            <span class="sparc-ctrl-family sparc-ml-01"><%= family_code %></span>
          </div>
          <% if control.title.present? %>
            <div class="sparc-ctrl-title"><%= control.title %></div>
          <% end %>
        </div>
      </div>

      <%# ── Card body: collapsed by default ── %>
      <details class="card-details sparc-mt-035">
        <summary class="sparc-card-detail-toggle d-flex align-items-center gap-1">
          <span class="card-arrow sparc-card-arrow">&#9658;</span>
          <span class="sparc-card-detail-separator"></span>
        </summary>

        <div class="mt-2">
          <%# Description block %>
          <% if description.present? %>
            <div class="sparc-statement-block">
              <div class="sparc-statement-label sparc-color-bs-primary">Description</div>
              <div class="sparc-color-body sparc-fs-084 sparc-lh-15"><%= description %></div>
            </div>
          <% end %>

          <%# Field table %>
          <%
            ordered_fields = CdefControlField::FIELD_DISPLAY_ORDER.map { |fn| field_map[fn] }.compact
            extras = field_map.values.reject { |f|
              f.field_name == "description" ||
              CdefControlField::FIELD_DISPLAY_ORDER.include?(f.field_name)
            }
            display_fields = ordered_fields + extras
          %>
          <% if display_fields.any? %>
            <table class="sparc-field-table">
              <% display_fields.each do |field| %>
                <% next if field.field_value.blank? && !field.editable %>
                <% next if field.field_name == "description" %>
                <tr class="<%= 'sparc-field-editable' if field.editable %>">
                  <%# scope="row" — this is a key/value table, so the field
                      name is the row header. Web:S5256 %>
                  <th scope="row" class="sparc-field-label">
                    <%= field.field_name.tr("_", " ") %>
                    <% if field.editable %>
                      <span class="sparc-editable-indicator" data-action="cdef-control#toggleFieldEdit" data-cdef-control-control-id-param="<%= control.control_id %>" data-cdef-control-field-name-param="<%= field.field_name %>" title="Click to edit">&#x270E;</span>
                    <% end %>
                  </th>
                  <td class="sparc-field-value">
                    <%# Display mode %>
                    <div id="field-display-<%= control.control_id %>-<%= field.field_name %>">
                      <% if field.field_name == "severity" %>
                        <span class="sparc-status-pill sparc-status--<%= cdef_severity_variant(field.field_value) %> sparc-fs-075 sparc-fw-600 sparc-tt-capitalize"><%= field.field_value %></span>
                      <% elsif field.field_name == "cci_refs" %>
                        <div class="d-flex flex-wrap sparc-gap-03">
                          <% field.field_value.to_s.split(",").map(&:strip).each do |cci| %>
                            <span class="rounded fw-semibold sparc-cdef-tint sparc-accent--green sparc-accent-text sparc-mono sparc-fs-072 sparc-p-01-045"><%= cci %></span>
                          <% end %>
                        </div>
                      <% elsif field.field_value.present? %>
                        <div class="sparc-prewrap"><%= field.field_value %></div>
                      <% else %>
                        <span class="text-body-tertiary fst-italic sparc-fs-082">Click &#x270E; to add</span>
                      <% end %>
                    </div>

                    <%# Edit mode (hidden by default) %>
                    <% if field.editable && !@cdef_document.published_lifecycle? %>
                      <div class="sparc-d-none" id="field-edit-<%= control.control_id %>-<%= field.field_name %>">
                        <% if field.select_field? %>
                          <select id="field-input-<%= control.control_id %>-<%= field.field_name %>" class="form-select form-select-sm sparc-fs-082">
                            <option value="">-- Select --</option>
                            <% field.select_options&.each do |label, value| %>
                              <option value="<%= value %>" <%= 'selected' if field.field_value == value %>><%= label %></option>
                            <% end %>
                          </select>
                        <% elsif %w[implementation_narrative notes].include?(field.field_name) %>
                          <textarea id="field-input-<%= control.control_id %>-<%= field.field_name %>" class="form-control form-control-sm sparc-fs-082" rows="3"><%= field.field_value %></textarea>
                        <% else %>
                          <input type="text" id="field-input-<%= control.control_id %>-<%= field.field_name %>" class="form-control form-control-sm sparc-fs-082" value="<%= field.field_value %>">
                        <% end %>
                        <div class="mt-1 d-flex gap-1">
                          <button type="button" class="sparc-action sparc-action--primary sparc-action--solid sparc-action--sm sparc-fs-075 sparc-p-015-05" data-action="cdef-control#saveField" data-cdef-control-control-id-param="<%= control.control_id %>" data-cdef-control-field-name-param="<%= field.field_name %>">Save</button>
                          <button type="button" class="sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm sparc-fs-075 sparc-p-015-05" data-action="cdef-control#toggleFieldEdit" data-cdef-control-control-id-param="<%= control.control_id %>" data-cdef-control-field-name-param="<%= field.field_name %>">Cancel</button>
                        </div>
                      </div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </table>
          <% end %>

          <%# ── #393: Component implementation statements ── %>
          <%= render "cdef_documents/statements_table", control: control, cdef_document: @cdef_document %>

          <%# ── Back-Matter References ── %>
          <% ctrl_resources = control.back_matter_resources.order(:title) %>
          <div class="mt-3" id="control-refs-<%= control.control_id %>">
            <h6 class="fw-semibold small">
              References
              <span class="badge bg-secondary sparc-fs-065"><%= ctrl_resources.size %></span>
            </h6>
            <% if ctrl_resources.any? %>
              <div class="d-flex flex-wrap gap-2 mb-2" id="refs-list-<%= control.control_id %>">
                <% ctrl_resources.each do |resource| %>
                  <% link_record = control.control_back_matter_links.find_by(back_matter_resource: resource) %>
                  <span class="badge bg-body-secondary text-body d-inline-flex align-items-center gap-1 sparc-fs-078 sparc-fw-500">
                    <%# #897 — safe_external_url, not .href (a stored javascript: scheme survives ERB escaping). %>
                    <% if (safe_href = safe_external_url(resource.href)) %>
                      <a href="<%= safe_href %>" target="_blank" rel="noopener noreferrer" class="text-decoration-none"><%= resource.title %></a>
                    <% else %>
                      <%= resource.title %>
                    <% end %>
                    <code class="small text-body-tertiary ms-1">#<%= resource.uuid.truncate(12) %></code>
                    <% if !@cdef_document.published_lifecycle? && link_record %>
                      <button type="button" class="btn-close btn-close-sm ms-1 sparc-fs-05"
                              data-action="cdef-control#unlink" data-cdef-control-control-id-param="<%= control.control_id %>" data-cdef-control-link-id-param="<%= link_record.id %>"
                              title="Unlink"></button>
                    <% end %>
                  </span>
                <% end %>
              </div>
            <% end %>
            <% if !@cdef_document.published_lifecycle? %>
              <div id="add-ref-<%= control.control_id %>" class="mb-2 sparc-d-none">
                <div class="row g-2 align-items-end">
                  <div class="col-md-3">
                    <input type="text" id="ref-title-<%= control.control_id %>" class="form-control form-control-sm" placeholder="Title *">
                  </div>
                  <div class="col-md-3">
                    <input type="text" id="ref-href-<%= control.control_id %>" class="form-control form-control-sm" placeholder="https://...">
                  </div>
                  <div class="col-md-2">
                    <input type="text" id="ref-media-<%= control.control_id %>" class="form-control form-control-sm" placeholder="application/pdf">
                  </div>
                  <div class="col-md-4 d-flex gap-1">
                    <button type="button" class="sparc-action sparc-action--positive sparc-action--solid sparc-action--sm" data-action="cdef-control#create" data-cdef-control-control-id-param="<%= control.control_id %>">Create & Link</button>
                    <button type="button" class="sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" data-action="cdef-control#toggleAddRef" data-cdef-control-id-param="<%= control.control_id %>">Cancel</button>
                  </div>
                </div>
              </div>
              <button type="button" class="sparc-action sparc-action--positive sparc-action--solid sparc-action--sm sparc-fs-075" id="add-ref-btn-<%= control.control_id %>" data-action="cdef-control#toggleAddRef" data-cdef-control-id-param="<%= control.control_id %>">
                + Add Reference
              </button>
            <% end %>
          </div>
        </div>
      </details>

    </div><%# end .control-card %>
  <% end %>
</div>

<%# ── #393: CDEF statement edit modal (deep-linked via ?statement_id=N) ── %>
<% if @editing_statement %>
  <% stmt = @editing_statement %>
  <div class="sparc-modal-overlay" id="editStatementModal">
    <div class="bg-body rounded-3 sparc-modal-dialog">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <div class="text-body-tertiary sparc-modal-eyebrow">
            Component Implementation Statement (read-only references from catalog)
          </div>
          <h3 class="sparc-m-0"><%= stmt.label.presence || stmt.statement_id %></h3>
          <code class="text-body-secondary sparc-fs-078"><%= stmt.statement_id %></code>
        </div>
        <%= link_to "&times;".html_safe, cdef_document_path(@cdef_document),
              class: "text-body-secondary sparc-modal-close" %>
      </div>

      <%= form_with url: update_statement_cdef_document_path(@cdef_document), method: :patch, local: true do |f| %>
        <%= hidden_field_tag :statement_id, stmt.id %>

        <div class="form-group mb-3">
          <%= label_tag "cdef_control_statement[implementation_prose]", "Implementation Prose", class: "fw-semibold" %>
          <%= text_area_tag "cdef_control_statement[implementation_prose]",
                stmt.implementation_prose, rows: 6, class: "form-control",
                placeholder: "Describe how this component implements the catalog statement..." %>
        </div>

        <div class="form-group mb-3">
          <%= label_tag "cdef_control_statement[remarks]", "Remarks", class: "fw-semibold" %>
          <%= text_area_tag "cdef_control_statement[remarks]", stmt.remarks, rows: 2, class: "form-control" %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit "Save Statement", class: "sparc-action sparc-action--primary sparc-action--solid" %>
          <%= link_to "Cancel", cdef_document_path(@cdef_document), class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%= render "shared/uuid_replaced_warning", document: @cdef_document %>

<%# #929 — CDEF scope, re-pointable after upload. A component definition has no
    `authorization_boundary_id`: it reaches a boundary through its environments
    (boundary_cdef_documents) or is globally available. That was applied only at
    create, and no route changed it afterwards. %>
<% if signed_in? %>
  <% current_scope_boundary = CdefScopeService.current_boundary_id(@cdef_document) %>
  <div class="card mt-4">
    <div class="card-body">
      <h5 class="fw-bold mb-3">Scope</h5>
      <p class="text-body-secondary small">
        <% if @cdef_document.globally_available? %>
          Globally available — any boundary's SSP can compose this component definition.
        <% elsif current_scope_boundary.present? %>
          Boundary-specific —
          <%= AuthorizationBoundary.find_by(id: current_scope_boundary)&.name || "boundary ##{current_scope_boundary}" %>.
        <% else %>
          This component definition is not scoped to a boundary and is not marked globally available.
        <% end %>
      </p>

      <%= form_with url: update_scope_cdef_document_path(@cdef_document),
                    method: :patch, local: true do %>
        <%= render "cdef_documents/scope_picker",
              param_key: :cdef_document,
              selected:  current_scope_boundary,
              scope:     @cdef_document.globally_available? ? "global" : "boundary" %>
        <%# The picker submits under cdef_document[...]; this action reads the
            flat names, so mirror them across. %>
        <button type="submit" class="sparc-action sparc-action--primary sparc-action--solid sparc-action--sm">Update Scope</button>
      <% end %>
    </div>
  </div>
<% end %>

<%= render "shared/oscal_metadata_section",
           document: @cdef_document,
           update_path: update_metadata_cdef_document_path(@cdef_document),
           param_key: :cdef_document,
           version_field: :cdef_version %>

<%= render "shared/oscal_back_matter_section",
           document: @cdef_document,
           resources_path: cdef_document_back_matter_resources_path(@cdef_document) %>

</div><%# end data-controller wrapper %>

<% end %><%# end unless completed %>
