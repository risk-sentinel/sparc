<%#
  Bulk-select checkbox for one component definition (#629), shared by the table
  row and the card so admin bulk delete works in either view (#888 §4).

  `form:` points at the bulk form by id rather than nesting inside it, which is
  what lets the same control live in a table cell or a card head.
%>
<% doc = local_assigns[:doc] %>
<input type="checkbox" name="ids[]" value="<%= doc.id %>" form="cdefBulkForm"
       data-bulk-select-target="row" data-action="bulk-select#toggle"
       aria-label="Select <%= doc.name %>">
