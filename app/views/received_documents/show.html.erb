<%# #1354 — one received version: what it is, whether it passed validation
    (errors and warnings shown: owner, 2026-11-20), and its review. The review
    controls are offered only to an exchange.review holder who may decide it:
    never to the person who uploaded it, unless they are the break-glass
    administrator (AC-5, mirroring ReceivedDocumentReviewService.may_decide?).

    #1390 part G (owner, 2026-11-23): the document viewer. The reviewer reads
    what was sent, laid out for its type, against the version it is compared
    with (the recorded comparison by default, or any other version of the same
    document), asks the provider about any place in it, and exports the
    review to send out of band. %>
<% doc = @document %>
<% viewer = @viewer %>
<% content_for :title, "Received document — #{@boundary.name}" %>
<% counts = viewer.counts %>

<div class="d-flex justify-content-between align-items-start my-4 gap-3 flex-wrap">
  <div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <h1 class="h3 fw-bold mb-0">
        <% if doc.certification_material? %>
          <%= ExchangeConnection::CLASS_A_MATERIALS.fetch(doc.document_type, doc.document_type) %>
        <% else %>
          <%= exchange_format_label(doc.format) %> <%= doc.document_type %>
        <% end %>
      </h1>
      <%= received_state_badge(doc.state) %>
      <%= unconfirmed_push_badge(doc) %>
    </div>
    <p class="text-body-secondary mb-0 small">
      <%= link_to @boundary.name, authorization_boundary_path(@boundary) %> ·
      <%= received_stream_label(doc) %> ·
      Version <%= viewer.version_number(doc) %>, received <%= exchange_time(doc.received_at) %>
    </p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <%= link_to "Download", file_authorization_boundary_received_document_path(@boundary, doc),
          class: "sparc-action sparc-action--info sparc-action--outline sparc-action--sm",
          data: { turbo: false, testid: "received-download" } %>
    <%= link_to "Back to Received documents", authorization_boundary_received_documents_path(@boundary),
          class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" %>
  </div>
</div>

<% unless doc.certification_material? %>
  <div class="sparc-viewer-summary mb-4" data-testid="viewer-summary">
    <div class="sparc-viewer-stat"><span class="sparc-viewer-stat__n"><%= counts["regression"] %></span><span>regressions</span></div>
    <div class="sparc-viewer-stat"><span class="sparc-viewer-stat__n"><%= counts["improvement"] %></span><span>improvements</span></div>
    <div class="sparc-viewer-stat"><span class="sparc-viewer-stat__n"><%= counts["neutral"] %></span><span>neutral changes</span></div>
    <div class="sparc-viewer-stat"><span class="sparc-viewer-stat__n"><%= @guidance.size %> / <%= [ doc.validation["warnings_total"].to_i, doc.validation_warnings.size ].max %></span><span>errors / warnings</span></div>
  </div>
<% end %>

<div data-controller="review-questions" data-review-questions-key-value="received-document-<%= doc.id %>">
<div class="row g-4">
  <div class="col-xl-8">
    <% if doc.certification_material? %>
      <div class="card">
        <div class="card-body">
          <p class="mb-0" data-testid="material-not-checked">
            A Class A certification material (FedRAMP FRC-CLA-EAM). FedRAMP publishes no schema for these files, so SPARC
            keeps the exact bytes by SHA-256 and leaves the content to the reviewer: download it to read it.
          </p>
          <p class="mb-0 mt-2 text-body-secondary">Not compared: a Class A material is a file, reviewed as a whole.</p>
        </div>
      </div>
    <% else %>
      <%= render "received_documents/viewer", doc: doc, viewer: viewer %>
    <% end %>
  </div>

  <div class="col-xl-4">
    <%= render "received_documents/review", doc: doc, viewer: viewer %>
  </div>
</div>

<div class="row g-4 mt-0">
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header"><h5 class="mb-0">Version</h5></div>
      <div class="card-body">
        <table class="table table-sm mb-0" data-testid="received-metadata">
          <tr><th>State</th><td><%= received_state_badge(doc.state) %></td></tr>
          <tr><th>Source</th><td><%= received_source_label(doc) %></td></tr>
          <% unless doc.push_confirmed.nil? %>
            <tr><th>Push</th><td data-testid="received-push">
              <% if doc.push_confirmed %>
                Confirmed: the registered address returned these exact bytes.
              <% else %>
                <span class="text-warning-emphasis">Unconfirmed: the registered address did not return these bytes when SPARC pulled it. Check with the provider before accepting.</span>
              <% end %>
            </td></tr>
          <% end %>
          <% if doc.exchange_document_source %>
            <tr><th>Address</th><td class="text-break"><code><%= doc.exchange_document_source.url %></code></td></tr>
          <% end %>
          <% if doc.fedramp_id.present? %>
            <tr><th>FedRAMP ID</th><td><code><%= doc.fedramp_id %></code></td></tr>
          <% end %>
          <tr><th>Received</th><td><%= exchange_time(doc.received_at) %><% if doc.received_by %> by <%= doc.received_by.display_label %><% end %></td></tr>
          <tr><th>File</th><td><%= doc.filename.presence || "—" %> · <%= number_to_human_size(doc.byte_size) %> (<%= number_with_delimiter(doc.byte_size) %> bytes)</td></tr>
          <tr><th>SHA-256</th><td><code class="text-break" data-testid="received-sha256"><%= doc.sha256 %></code></td></tr>
          <tr><th>In effect for this stream</th><td>
            <% if doc.in_effect? %>
              This version
            <% elsif @in_effect %>
              <%= link_to "Version #{viewer.version_number(@in_effect)}, received #{exchange_time(@in_effect.received_at)}", authorization_boundary_received_document_path(@boundary, @in_effect) %>
            <% else %>
              <span class="text-body-secondary">None yet</span>
            <% end %>
          </td></tr>
          <% if doc.scan_run_id %>
            <tr><th>Findings</th><td><%= link_to "Added to the boundary's findings", triage_authorization_boundary_path(@boundary) %></td></tr>
          <% end %>
        </table>
      </div>
    </div>
  </div>
  <div class="<%= @guidance.any? ? 'col-12' : 'col-lg-6' %>">
    <%= render "received_documents/validation", doc: doc %>
  </div>
</div>
</div>

<div class="card mt-4" data-testid="received-history">
  <div class="card-header"><h5 class="mb-0">History</h5></div>
  <div class="card-body">
    <% if @history.any? %>
      <table class="table table-sm mb-0">
        <thead><tr><th>When</th><th>What</th><th>Who</th><th>Note</th></tr></thead>
        <tbody>
          <% @history.each do |event| %>
            <tr>
              <td><%= exchange_time(event.created_at) %></td>
              <td><%= event.action.delete_prefix("received_document_").humanize %></td>
              <td><%= event.user&.display_label || "SPARC" %></td>
              <td class="small">
                <%= event.metadata.is_a?(Hash) ? event.metadata["note"] : nil %>
                <% questions = event.metadata.is_a?(Hash) ? Array(event.metadata["questions"]) : [] %>
                <% if questions.any? %><span class="text-body-secondary"><%= pluralize(questions.size, "question") %></span><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-body-secondary mb-0">No history recorded.</p>
    <% end %>
  </div>
</div>
