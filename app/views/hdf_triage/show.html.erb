<% content_for :title, "HDF Triage — #{@authorization_boundary&.name || @boundary.name}" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0">HDF Amendment Triage</h1>
    <p class="text-muted mb-0"><%= @boundary.name %></p>
  </div>
  <div class="d-flex gap-2">
    <%= button_to "Aggregate into documents", triage_aggregate_authorization_boundary_path(@boundary),
          method: :post, class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm",
          form: { data: { turbo_confirm: "Aggregate current findings into this boundary's SSP, SAP, SAR and POA&M?" } } %>
    <%= link_to "Download Package", triage_package_authorization_boundary_path(@boundary),
          class: "sparc-action sparc-action--info sparc-action--outline sparc-action--sm", data: { turbo: false } %>
    <%= link_to "Download Amendments", triage_amendments_authorization_boundary_path(@boundary),
          class: "sparc-action sparc-action--info sparc-action--outline sparc-action--sm", data: { turbo: false } %>
    <%= link_to "Back to Boundary", authorization_boundary_path(@boundary),
          class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" %>
  </div>
</div>

<% if @re_failed_count.positive? %>
  <div class="alert alert-danger py-2" role="alert" id="re-failed-alert">
    <strong><%= @re_failed_count %></strong> finding<%= "s" if @re_failed_count != 1 %>
    <strong>re-failed</strong> at a worse severity since the prior scan — review before amending.
  </div>
<% end %>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Ingest scanner output (HDF)</div>
      <div class="card-body">
        <%= form_with url: triage_ingest_authorization_boundary_path(@boundary), method: :post,
              multipart: true, data: { turbo: false } do |f| %>
          <div class="mb-2">
            <%= f.file_field :file, accept: "application/json,.json", class: "form-control", required: true %>
          </div>
          <div class="row g-2 mb-2">
            <div class="col">
              <%= label_tag :cdef_document_id, "Target / CDEF", class: "form-label small mb-0" %>
              <%= select_tag :cdef_document_id,
                    options_for_select([ [ "Boundary-wide (no CDEF)", "" ] ] +
                      @cdef_documents.map { |c| [ c.name, c.id ] }),
                    class: "form-select form-select-sm" %>
            </div>
            <div class="col">
              <%= label_tag :scanner_scope, "Scope", class: "form-label small mb-0" %>
              <%= select_tag :scanner_scope,
                    options_for_select(@scanner_scopes.map { |s| [ s.titleize, s ] }, "target"),
                    class: "form-select form-select-sm" %>
            </div>
          </div>
          <%= f.submit "Upload & Ingest", class: "sparc-action sparc-action--info sparc-action--solid sparc-action--sm" %>
          <span class="text-muted small ms-2">HDF results JSON or a saf-convert bundle.</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Recent scan runs</div>
      <div class="card-body p-0">
        <% if @scan_runs.any? %>
          <table class="table table-sm mb-0">
            <thead><tr><th>Scanner</th><th>Target/CDEF</th><th>Scope</th><th>Ingested</th><th>Failed</th></tr></thead>
            <tbody>
              <% @scan_runs.each do |run| %>
                <tr>
                  <td><%= run.scanner %></td>
                  <td><%= run.cdef_document&.name || "—" %></td>
                  <td><span class="badge bg-secondary"><%= run.scanner_scope %></span></td>
                  <td><%= run.ingested_at&.strftime("%Y-%m-%d %H:%M") %></td>
                  <td><span class="badge bg-<%= run.failed_count.positive? ? "danger" : "secondary" %>"><%= run.failed_count %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted p-3 mb-0">No scans ingested yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= form_with url: triage_authorization_boundary_path(@boundary), method: :get,
      data: { turbo: false }, class: "row g-2 align-items-end mb-3" do |f| %>
  <div class="col-auto">
    <%= label_tag :status, "Status", class: "form-label small mb-0" %>
    <%= select_tag :status,
          options_for_select([ [ "All", "" ] ] + ScannerFinding::STATUSES.map { |s| [ s, s ] }, params[:status]),
          class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto">
    <%= label_tag :severity, "Severity", class: "form-label small mb-0" %>
    <%= select_tag :severity,
          options_for_select([ [ "All", "" ] ] + ScannerFinding::SEVERITIES.map { |s| [ s, s ] }, params[:severity]),
          class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto">
    <%= label_tag :lifecycle, "Lifecycle", class: "form-label small mb-0" %>
    <%= select_tag :lifecycle,
          options_for_select([ [ "All", "" ] ] + @lifecycle_statuses.map { |s| [ s.titleize, s ] }, params[:lifecycle]),
          class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto">
    <%= label_tag :cdef_document_id, "Target/CDEF", class: "form-label small mb-0" %>
    <%= select_tag :cdef_document_id,
          options_for_select([ [ "All", "" ] ] + @cdef_documents.map { |c| [ c.name, c.id ] }, params[:cdef_document_id]),
          class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto form-check mb-1 ms-2">
    <%= check_box_tag :include_history, "true", @include_history, class: "form-check-input" %>
    <%= label_tag :include_history, "Include history", class: "form-check-label small" %>
  </div>
  <div class="col-auto">
    <%= f.submit "Filter", class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" %>
  </div>
<% end %>

<div class="card">
  <div class="card-header d-flex justify-content-between">
    <span>Findings</span>
    <span class="text-muted small"><%= @findings.count %> shown<%= " (incl. history)" if @include_history %></span>
  </div>
  <div class="table-responsive">
    <table class="table table-sm align-middle mb-0" id="hdf-findings-table">
      <thead>
        <tr><th>Control</th><th>Component</th><th>Severity</th><th>Status</th><th>Lifecycle</th><th>Disposition</th><th>Triage</th></tr>
      </thead>
      <tbody>
        <% if @findings.none? %>
          <tr><td colspan="7" class="text-muted p-3">No findings match the current filter.</td></tr>
        <% end %>
        <% @findings.each do |finding| %>
          <% disp = @dispositions_by_control[finding.control_id] %>
          <tr class="<%= "text-muted" unless finding.current %>">
            <td><code><%= finding.control_id %></code><div class="small text-muted"><%= truncate(finding.title, length: 60) %></div></td>
            <td>
              <% if finding.component_ref.present? %>
                <span class="small"><%= finding.component_ref %></span>
              <% else %>
                <span class="text-muted small">—</span>
              <% end %>
              <% if finding.cdef_document_id.present? %>
                <div class="small text-muted"><%= finding.cdef_document&.name %></div>
              <% end %>
            </td>
            <td><span class="badge bg-secondary"><%= finding.severity %></span></td>
            <td><span class="badge bg-<%= finding.status == "failed" ? "danger" : "success" %>"><%= finding.status %></span></td>
            <td><span class="badge bg-<%= lifecycle_badge_class(finding.lifecycle_status) %>"><%= finding.lifecycle_status.titleize %></span></td>
            <td>
              <% if disp %>
                <span class="badge bg-info text-dark"><%= disp.kind %></span>
                <span class="badge bg-<%= approval_badge_class(disp.approval_status) %>"><%= disp.approval_status %></span>
                <% if disp.valid_until.present? %>
                  <div class="small text-muted">valid to <%= disp.valid_until.to_date %></div>
                <% end %>
                <div class="mt-1">
                  <% if @can_approve && disp.approval_status == "draft" %>
                    <%= button_to "Approve", triage_approve_disposition_authorization_boundary_path(@boundary, disposition_uuid: disp.uuid),
                          method: :post, class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm py-0", form: { data: { turbo: false }, class: "d-inline" } %>
                    <%= button_to "Reject", triage_reject_disposition_authorization_boundary_path(@boundary, disposition_uuid: disp.uuid),
                          method: :post, class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm py-0", form: { data: { turbo: false }, class: "d-inline" } %>
                  <% end %>
                  <%= button_to "Clear", triage_clear_disposition_authorization_boundary_path(@boundary, control_id: finding.control_id),
                        method: :delete, class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm p-0 ms-1", data: { turbo: false } %>
                </div>
              <% else %>
                <span class="text-muted small">—</span>
              <% end %>
            </td>
            <td>
              <details data-controller="hdf-triage">
                <summary class="btn btn-outline-secondary btn-sm">Disposition</summary>
                <%= form_with url: triage_disposition_authorization_boundary_path(@boundary), method: :post,
                      data: { turbo: false }, class: "mt-2" do |f| %>
                  <%= hidden_field_tag :finding_uuid, finding.uuid %>
                  <div class="mb-2">
                    <%= label_tag "kind_#{finding.id}", "Override kind", class: "form-label small mb-0" %>
                    <%= select_tag :kind, options_for_select(@kinds, disp&.kind),
                          id: "kind_#{finding.id}", class: "form-select form-select-sm",
                          data: { hdf_triage_target: "kind", action: "change->hdf-triage#showLinkage" } %>
                  </div>
                  <p class="small text-muted mb-1" data-hdf-triage-target="hint">
                    Links a: <%= @linkage[disp&.kind || @kinds.first] %>
                  </p>
                  <div class="row g-2 mb-2">
                    <div class="col">
                      <%= text_field_tag :linked_subject_type, disp&.linked_subject_type,
                            placeholder: "Linked type (e.g. Evidence)", class: "form-control form-control-sm" %>
                    </div>
                    <div class="col">
                      <%= text_field_tag :linked_subject_id, disp&.linked_subject_id,
                            placeholder: "Linked id", class: "form-control form-control-sm" %>
                    </div>
                  </div>
                  <div class="mb-2">
                    <%= text_area_tag :reason, disp&.reason, rows: 2, class: "form-control form-control-sm",
                          placeholder: "Justification", required: true %>
                  </div>
                  <div class="mb-2">
                    <%= label_tag :expiration, "Expiration (waiver / operational)", class: "form-label small mb-0" %>
                    <%= date_field_tag :expiration, disp&.expiration&.to_date, class: "form-control form-control-sm" %>
                  </div>
                  <%= f.submit "Save disposition", class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm" %>
                <% end %>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-3 text-muted small" data-hdf-triage-linkage="<%= @linkage.to_json %>">
  Dispositions export to an HDF Amendments document your CI applies with
  <code>hdf amend apply</code>. Amendments must be <strong>approved</strong> and within
  their ODP validity window to suppress a finding during aggregation. Waivers and
  operational requirements require an expiration and an Authorizing Official attestation.
</div>
