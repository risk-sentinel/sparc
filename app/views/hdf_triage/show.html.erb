<% content_for :title, "HDF Triage — #{@authorization_boundary&.name || @boundary.name}" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="h3 mb-0">HDF Amendment Triage</h1>
    <p class="text-muted mb-0"><%= @boundary.name %></p>
  </div>
  <div>
    <%= link_to "Download Amendments", triage_amendments_authorization_boundary_path(@boundary),
          class: "btn btn-outline-success btn-sm", data: { turbo: false } %>
    <%= link_to "Back to Boundary", authorization_boundary_path(@boundary),
          class: "btn btn-outline-primary btn-sm" %>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Ingest scanner output (HDF)</div>
      <div class="card-body">
        <%= form_with url: triage_ingest_authorization_boundary_path(@boundary), method: :post,
              multipart: true, data: { turbo: false } do |f| %>
          <div class="mb-2">
            <%= f.file_field :file, accept: "application/json,.json", class: "form-control", required: true %>
          </div>
          <%= f.submit "Upload & Ingest", class: "btn btn-primary btn-sm" %>
          <span class="text-muted small ms-2">HDF results JSON or a saf-convert bundle.</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Recent scan runs</div>
      <div class="card-body p-0">
        <% if @scan_runs.any? %>
          <table class="table table-sm mb-0">
            <thead><tr><th>Scanner</th><th>Ingested</th><th>Findings</th><th>Failed</th></tr></thead>
            <tbody>
              <% @scan_runs.each do |run| %>
                <tr>
                  <td><%= run.scanner %></td>
                  <td><%= run.ingested_at&.strftime("%Y-%m-%d %H:%M") %></td>
                  <td><%= run.finding_count %></td>
                  <td><span class="badge bg-<%= run.failed_count.positive? ? "danger" : "secondary" %>"><%= run.failed_count %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted p-3 mb-0">No scans ingested yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= form_with url: triage_authorization_boundary_path(@boundary), method: :get,
      data: { turbo: false }, class: "row g-2 align-items-end mb-3" do |f| %>
  <div class="col-auto">
    <%= label_tag :status, "Status", class: "form-label small mb-0" %>
    <%= select_tag :status,
          options_for_select([ [ "All", "" ] ] + ScannerFinding::STATUSES.map { |s| [ s, s ] }, params[:status]),
          class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto">
    <%= label_tag :severity, "Severity", class: "form-label small mb-0" %>
    <%= select_tag :severity,
          options_for_select([ [ "All", "" ] ] + ScannerFinding::SEVERITIES.map { |s| [ s, s ] }, params[:severity]),
          class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto">
    <%= f.submit "Filter", class: "btn btn-outline-secondary btn-sm" %>
  </div>
<% end %>

<div class="card">
  <div class="card-header d-flex justify-content-between">
    <span>Findings</span>
    <span class="text-muted small"><%= @findings.count %> shown</span>
  </div>
  <div class="table-responsive">
    <table class="table table-sm align-middle mb-0" id="hdf-findings-table">
      <thead>
        <tr><th>Control</th><th>Severity</th><th>Status</th><th>Disposition</th><th>Triage</th></tr>
      </thead>
      <tbody>
        <% if @findings.none? %>
          <tr><td colspan="5" class="text-muted p-3">No findings match the current filter.</td></tr>
        <% end %>
        <% @findings.each do |finding| %>
          <% disp = @dispositions_by_control[finding.control_id] %>
          <tr>
            <td><code><%= finding.control_id %></code><div class="small text-muted"><%= truncate(finding.title, length: 60) %></div></td>
            <td><span class="badge bg-secondary"><%= finding.severity %></span></td>
            <td><span class="badge bg-<%= finding.status == "failed" ? "danger" : "success" %>"><%= finding.status %></span></td>
            <td>
              <% if disp %>
                <span class="badge bg-info text-dark"><%= disp.kind %></span>
                <%= button_to "Clear", triage_clear_disposition_authorization_boundary_path(@boundary, control_id: finding.control_id),
                      method: :delete, class: "btn btn-link btn-sm p-0 ms-1", data: { turbo: false } %>
              <% else %>
                <span class="text-muted small">—</span>
              <% end %>
            </td>
            <td>
              <details data-controller="hdf-triage">
                <summary class="btn btn-outline-secondary btn-sm">Disposition</summary>
                <%= form_with url: triage_disposition_authorization_boundary_path(@boundary), method: :post,
                      data: { turbo: false }, class: "mt-2" do |f| %>
                  <%= hidden_field_tag :finding_uuid, finding.uuid %>
                  <div class="mb-2">
                    <%= label_tag "kind_#{finding.id}", "Override kind", class: "form-label small mb-0" %>
                    <%= select_tag :kind, options_for_select(@kinds, disp&.kind),
                          id: "kind_#{finding.id}", class: "form-select form-select-sm",
                          data: { hdf_triage_target: "kind", action: "change->hdf-triage#showLinkage" } %>
                  </div>
                  <p class="small text-muted mb-1" data-hdf-triage-target="hint">
                    Links a: <%= @linkage[disp&.kind || @kinds.first] %>
                  </p>
                  <div class="row g-2 mb-2">
                    <div class="col">
                      <%= text_field_tag :linked_subject_type, disp&.linked_subject_type,
                            placeholder: "Linked type (e.g. Evidence)", class: "form-control form-control-sm" %>
                    </div>
                    <div class="col">
                      <%= text_field_tag :linked_subject_id, disp&.linked_subject_id,
                            placeholder: "Linked id", class: "form-control form-control-sm" %>
                    </div>
                  </div>
                  <div class="mb-2">
                    <%= text_area_tag :reason, disp&.reason, rows: 2, class: "form-control form-control-sm",
                          placeholder: "Justification", required: true %>
                  </div>
                  <div class="mb-2">
                    <%= label_tag :expiration, "Expiration (waiver / operational)", class: "form-label small mb-0" %>
                    <%= date_field_tag :expiration, disp&.expiration&.to_date, class: "form-control form-control-sm" %>
                  </div>
                  <%= f.submit "Save disposition", class: "btn btn-primary btn-sm" %>
                <% end %>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-3 text-muted small" data-hdf-triage-linkage="<%= @linkage.to_json %>">
  Dispositions export to an HDF Amendments document your CI applies with
  <code>hdf amend apply</code>. Waivers and operational requirements require an
  expiration and an Authorizing Official attestation.
</div>
