<%# ── Section navigation grid grouped by OSCAL layers ── %>
<%# #1243 — the scoreboard that sat above these cards is gone: it repeated the
    same nouns in the same order, its tiles looked clickable and were not, and
    it counted the whole instance. Each card now carries its own count as a
    badge that opens the same page as View, and the count is the one that page
    shows THIS user (HomeController#index). "New" appears only to someone the
    create action would let through. %>
<%
  layer_groups = [
    {
      label: "Controls Layer",
      color: ApplicationHelper::COLOR_BLUE,
      cls: "sparc-heading-controls",
      cards: [
        { key: :control_catalogs, title: "Control Catalogs", path: control_catalogs_path,
          new_path: new_control_catalog_path, can_create: can_write_catalogs?, icon: "&#128218;",
          secondary: "#{number_with_delimiter(@family_count)} families · #{number_with_delimiter(@control_count)} controls" },
        { key: :profile_documents, title: "Baselines / Profiles", path: profile_documents_path,
          new_path: new_profile_document_path, can_create: can_write_profiles?, icon: "&#128203;" },
        { key: :control_mappings, title: "Control Mapping", path: control_mappings_path,
          new_path: new_control_mapping_path, can_create: can_write_mappings?, icon: "&#128279;" },
      ]
    },
    {
      label: "Implementation Layer",
      color: ApplicationHelper::COLOR_GREEN,
      cls: "sparc-heading-implementation",
      cards: [
        { key: :ssp_documents, title: "SSPs", path: ssp_documents_path,
          new_path: new_ssp_document_path, can_create: can_create_boundary_document?(SspDocumentsController), icon: "&#128196;" },
        { key: :cdef_documents, title: "CDEFs", path: cdef_documents_path,
          new_path: new_cdef_document_path, can_create: can_write_cdefs?, icon: "&#128737;" },
        { key: :converters, title: "Converters", path: converters_path,
          new_path: new_converter_path, can_create: can_write_converters?, icon: "&#128260;" },
      ]
    },
    {
      label: "Assessment Layer",
      color: ApplicationHelper::COLOR_CARROT,
      cls: "sparc-heading-assessment",
      cards: [
        { key: :sap_documents, title: "SAPs", path: sap_documents_path,
          new_path: new_sap_document_path, can_create: can_create_boundary_document?(SapDocumentsController), icon: "&#128221;" },
        { key: :evidences, title: "Evidence", path: evidences_path,
          new_path: new_evidence_path, can_create: can_create_boundary_document?(EvidencesController), icon: "&#128274;" },
        { key: :sar_documents, title: "SARs", path: sar_documents_path,
          new_path: new_sar_document_path, can_create: can_create_boundary_document?(SarDocumentsController), icon: "&#128203;" },
        { key: :poam_documents, title: "POA&Ms", path: poam_documents_path,
          new_path: new_poam_document_path, can_create: can_create_boundary_document?(PoamDocumentsController), icon: "&#128270;" },
      ]
    },
    {
      label: "Enterprise",
      color: ApplicationHelper::COLOR_PURPLE,
      cls: "sparc-heading-enterprise",
      cards: [
        # An administrator screen: the card shows only where it would admit the user.
        ({ key: :organizations, title: "Organizations", path: admin_organizations_path,
           new_path: new_admin_organization_path, can_create: admin_access?, icon: "&#127970;" } if admin_access?),
        { key: :authorization_boundaries, title: "Auth Boundaries", path: authorization_boundaries_path,
          new_path: new_authorization_boundary_path, can_create: can_create_boundary?, icon: "&#128188;" },
      ].compact
    }
  ]
%>

<% layer_groups.each do |group| %>
  <div class="mb-2">
    <div class="d-flex align-items-center gap-2 mb-2">
      <span class="sparc-group-bar <%= accent_class(group[:color]) %>"></span>
      <h6 class="mb-0 fw-bold sparc-fs-085 <%= group[:cls] %>"><%= group[:label] %></h6>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
      <% group[:cards].each do |s| %>
        <div class="col">
          <div class="card sparc-section-card sparc-section-card--accented h-100 <%= accent_class(group[:color]) %>">
            <div class="card-body d-flex flex-row align-items-center gap-3 sparc-p-035-085">
              <div class="sparc-fs-22r sparc-flex-shrink-0"><%= s[:icon].html_safe %></div>
              <div class="flex-grow-1 sparc-minw-0">
                <h5 class="mb-0 sparc-fs-095 d-flex align-items-center gap-2">
                  <span><%= s[:title] %></span>
                  <% count = @counts.fetch(s[:key]) %>
                  <%= link_to number_with_delimiter(count), s[:path],
                        class: "sparc-count-badge",
                        data: { home_count: s[:key] },
                        title: "Open #{s[:title]}",
                        "aria-label": "#{number_with_delimiter(count)} #{s[:title]}: open the list" %>
                </h5>
                <% if s[:secondary] %>
                  <div class="text-body-secondary sparc-fs-075" data-home-secondary="<%= s[:key] %>"><%= s[:secondary] %></div>
                <% end %>
              </div>
              <div class="d-flex gap-2 flex-shrink-0">
                <%= link_to "View", s[:path], class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm px-3" %>
                <% if s[:can_create] %>
                  <%= link_to "New", s[:new_path], class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm px-3" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if SparcConfig.support_email.present? %>
  <div class="text-center mt-4 small text-body-tertiary">
    Need help?
    <%= mail_to SparcConfig.support_email, "Support", class: "text-primary text-decoration-none fw-semibold" %>
  </div>
<% end %>
