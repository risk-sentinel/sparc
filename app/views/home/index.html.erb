<%# ── Stat tiles grouped by OSCAL layer ── %>
<div class="card sparc-gradient-header mb-3 sparc-p-085-1r sparc-br-05r">
  <div class="d-flex flex-wrap justify-content-center gap-3">

    <%# ── Controls Layer ── %>
    <div class="sparc-home-group sparc-accent--blue">
      <div class="text-center sparc-mb-035">
        <span class="badge sparc-status--info sparc-fs-075 sparc-ls-005">CONTROLS</span>
      </div>
      <div class="d-flex gap-2">
        <% [[@catalog_count, "Catalogs"], [@family_count, "Families"], [@control_count, "Controls"], [@profile_count, "Baselines"], [@mapping_count, "Mappings"]].each do |count, label| %>
          <div class="sparc-hero-tile text-center sparc-minw-68px">
            <div class="sparc-hero-tile-count"><%= count %></div>
            <div class="sparc-hero-tile-label"><%= label %></div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Implementation Layer ── %>
    <div class="sparc-home-group sparc-accent--green">
      <div class="text-center sparc-mb-035">
        <span class="badge sparc-status--success sparc-fs-075 sparc-ls-005">IMPLEMENTATION</span>
      </div>
      <div class="d-flex gap-2">
        <% [[@ssp_count, "SSPs"], [@cdef_count, "CDEFs"], [@converter_count, "Converters"]].each do |count, label| %>
          <div class="sparc-hero-tile text-center sparc-minw-68px">
            <div class="sparc-hero-tile-count"><%= count %></div>
            <div class="sparc-hero-tile-label"><%= label %></div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Assessment Layer ── %>
    <div class="sparc-home-group sparc-accent--carrot">
      <div class="text-center sparc-mb-035">
        <span class="badge sparc-status--orange sparc-fs-075 sparc-ls-005">ASSESSMENT</span>
      </div>
      <div class="d-flex gap-2">
        <% [[@sap_count, "SAPs"], [@evidence_count, "Evidence"], [@sar_count, "SARs"], [@poam_count, "POA&Ms"]].each do |count, label| %>
          <div class="sparc-hero-tile text-center sparc-minw-68px">
            <div class="sparc-hero-tile-count"><%= count %></div>
            <div class="sparc-hero-tile-label"><%= label %></div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Enterprise ── %>
    <div class="sparc-home-group sparc-accent--purple">
      <div class="text-center sparc-mb-035">
        <span class="badge sparc-status--purple sparc-fs-075 sparc-ls-005">ENTERPRISE</span>
      </div>
      <div class="d-flex gap-2">
        <% [[@organization_count, "Organizations"], [@authorization_boundary_count, "Auth Boundaries"]].each do |count, label| %>
          <div class="sparc-hero-tile text-center sparc-minw-68px">
            <div class="sparc-hero-tile-count"><%= count %></div>
            <div class="sparc-hero-tile-label"><%= label %></div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>

<%# ── Section navigation grid grouped by OSCAL layers ── %>
<%
  layer_groups = [
    {
      label: "Controls Layer",
      color: ApplicationHelper::COLOR_BLUE,
      cls: "sparc-heading-controls",
      cards: [
        { title: "Control Catalogs",     path: control_catalogs_path,   new_path: new_control_catalog_path,   icon: "&#128218;" },
        { title: "Baselines / Profiles", path: profile_documents_path,  new_path: new_profile_document_path,  icon: "&#128203;" },
        { title: "Control Mapping",      path: control_mappings_path,   new_path: new_control_mapping_path,   icon: "&#128279;" },
      ]
    },
    {
      label: "Implementation Layer",
      color: ApplicationHelper::COLOR_GREEN,
      cls: "sparc-heading-implementation",
      cards: [
        { title: "SSPs",        path: ssp_documents_path,   new_path: new_ssp_document_path,   icon: "&#128196;" },
        { title: "CDEFs",       path: cdef_documents_path,  new_path: new_cdef_document_path,  icon: "&#128737;" },
        { title: "Converters",  path: converters_path,      new_path: new_converter_path,      icon: "&#128260;" },
      ]
    },
    {
      label: "Assessment Layer",
      color: "#e67e22",   # carrot — accent-token only, no COLOR_* constant
      cls: "sparc-heading-assessment",
      cards: [
        { title: "SAPs",      path: sap_documents_path,  new_path: new_sap_document_path,  icon: "&#128221;" },
        { title: "Evidence",   path: evidences_path,       new_path: new_evidence_path,      icon: "&#128274;" },
        { title: "SARs",      path: sar_documents_path,   new_path: new_sar_document_path,  icon: "&#128203;" },
        { title: "POA&Ms",    path: poam_documents_path,  new_path: new_poam_document_path, icon: "&#128270;" },
      ]
    },
    {
      label: "Enterprise",
      color: ApplicationHelper::COLOR_PURPLE,
      cls: "sparc-heading-enterprise",
      cards: [
        { title: "Organizations",    path: admin_organizations_path,     new_path: new_admin_organization_path,     icon: "&#127970;" },
        { title: "Auth Boundaries",  path: authorization_boundaries_path, new_path: new_authorization_boundary_path, icon: "&#128188;" },
      ]
    }
  ]
%>

<% layer_groups.each do |group| %>
  <div class="mb-2">
    <div class="d-flex align-items-center gap-2 mb-2">
      <span class="sparc-group-bar <%= accent_class(group[:color]) %>"></span>
      <h6 class="mb-0 fw-bold sparc-fs-085 <%= group[:cls] %>"><%= group[:label] %></h6>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
      <% group[:cards].each do |s| %>
        <div class="col">
          <div class="card sparc-section-card sparc-section-card--accented h-100 <%= accent_class(group[:color]) %>">
            <div class="card-body d-flex flex-row align-items-center gap-3 sparc-p-035-085">
              <div class="sparc-fs-22r sparc-flex-shrink-0"><%= s[:icon].html_safe %></div>
              <h5 class="mb-0 flex-grow-1 sparc-fs-095"><%= s[:title] %></h5>
              <div class="d-flex gap-2 flex-shrink-0">
                <%= link_to "View", s[:path], class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm px-3" %>
                <%= link_to "New", s[:new_path], class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm px-3" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if SparcConfig.support_email.present? %>
  <div class="text-center mt-4 small text-body-tertiary">
    Need help?
    <%= mail_to SparcConfig.support_email, "Support", class: "text-primary text-decoration-none fw-semibold" %>
  </div>
<% end %>
