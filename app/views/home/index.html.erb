<%# 1.18.0-rf — with SPARC_NAV_SHELL on, the home page is the organization
    Overview (home/_org_overview), which keeps this inventory and these cards. %>
<% if shell_nav? %>
  <%= render "home/org_overview" %>
<% else %>
<%= render "home/inventory" %>

<%# ── Section navigation grid grouped by OSCAL layers ──
    Each card carries its own count as a badge that opens the same page as
    View (#1243). "New" appears only to someone the create action would let
    through. %>
<% layer_groups = home_layer_groups %>

<% layer_groups.each do |group| %>
  <div class="mb-2">
    <div class="d-flex align-items-center gap-2 mb-2">
      <span class="sparc-group-bar <%= accent_class(group[:color]) %>"></span>
      <h6 class="mb-0 fw-bold sparc-fs-085 <%= group[:cls] %>"><%= group[:label] %></h6>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xxl-3 g-2">
      <% group[:cards].each do |s| %>
        <div class="col">
          <div class="card sparc-section-card sparc-section-card--accented h-100 <%= accent_class(group[:color]) %>">
            <div class="card-body d-flex flex-row align-items-center gap-2 sparc-p-035-085">
              <%# Every card reads the same way: icon, count, title, buttons. The
                  count sits in a fixed-width slot so titles line up down a column. %>
              <%# 1.18.0-rf #1289 — the same icon as the item's menu entry, in its layer colour. %>
              <%= icon(s[:icon], css_class: "sparc-tile-icon sparc-tile-icon--#{group[:layer]} flex-shrink-0") %>
              <% count = @counts.fetch(s[:key]) %>
              <%= link_to number_with_delimiter(count), s[:path],
                    class: "sparc-count-badge sparc-count-badge--lead flex-shrink-0",
                    data: { home_count: s[:key] },
                    title: "Open #{s[:title]}",
                    "aria-label": "#{number_with_delimiter(count)} #{s[:title]}: open the list" %>
              <h5 class="mb-0 sparc-fs-095 flex-grow-1 sparc-card-title"><%= s[:title] %></h5>
              <div class="d-flex gap-2 flex-shrink-0">
                <%= link_to "View", s[:path], class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm px-2" %>
                <% if s[:can_create] %>
                  <%= link_to "New", s[:new_path], class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm px-2" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if SparcConfig.support_email.present? %>
  <div class="text-center mt-4 small text-body-tertiary">
    Need help?
    <%= mail_to SparcConfig.support_email, "Support", class: "text-primary text-decoration-none fw-semibold" %>
  </div>
<% end %>
<% end %>
