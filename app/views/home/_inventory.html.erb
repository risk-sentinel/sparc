<%# ── Inventory: thin count tiles grouped by OSCAL layer ──
    The instance's inventory at a glance, in one row. #1243 removed it in
    v1.17.2 by mistake; it is restored as thin tiles, each a link to its list.
    Every count is the one the cards below show this user
    (HomeController#index). Families and controls live inside catalogs, so
    those tiles open the catalog list, which totals them. Organizations is
    counted only for someone the admin screen admits. %>
<%
  inventory_groups = [
    { label: "CONTROLS", accent: "sparc-accent--blue", badge: "sparc-status--info", tiles: [
        [:control_catalogs, @counts[:control_catalogs], "Catalogs", control_catalogs_path],
        [:families, @family_count, "Families", control_catalogs_path],
        [:controls, @control_count, "Controls", control_catalogs_path],
        [:profile_documents, @counts[:profile_documents], "Baselines", profile_documents_path],
        [:control_mappings, @counts[:control_mappings], "Mappings", control_mappings_path]] },
    { label: "IMPLEMENTATION", accent: "sparc-accent--green", badge: "sparc-status--success", tiles: [
        [:ssp_documents, @counts[:ssp_documents], "SSPs", ssp_documents_path],
        [:cdef_documents, @counts[:cdef_documents], "CDEFs", cdef_documents_path],
        [:converters, @counts[:converters], "Converters", converters_path]] },
    { label: "ASSESSMENT", accent: "sparc-accent--carrot", badge: "sparc-status--orange", tiles: [
        [:sap_documents, @counts[:sap_documents], "SAPs", sap_documents_path],
        [:evidences, @counts[:evidences], "Evidence", evidences_path],
        [:sar_documents, @counts[:sar_documents], "SARs", sar_documents_path],
        [:poam_documents, @counts[:poam_documents], "POA&Ms", poam_documents_path]] },
    { label: "ENTERPRISE", accent: "sparc-accent--purple", badge: "sparc-status--purple", tiles: [
        ([:organizations, @counts[:organizations], "Organizations", admin_organizations_path] if @counts.key?(:organizations)),
        [:authorization_boundaries, @counts[:authorization_boundaries], "Auth Boundaries", authorization_boundaries_path]].compact }
  ]
%>
<nav class="card sparc-gradient-header sparc-inventory mb-3 sparc-br-05r" data-home-inventory aria-label="Inventory">
  <div class="d-flex flex-wrap justify-content-center gap-2">
    <% inventory_groups.each do |g| %>
      <div class="sparc-home-group sparc-inventory-group <%= g[:accent] %>">
        <div class="text-center sparc-inventory-heading">
          <span class="badge <%= g[:badge] %> sparc-ls-005"><%= g[:label] %></span>
        </div>
        <%# Wraps rather than overflowing: five Controls tiles are 324px, wider
            than a 320px phone (measured, 1.18.0-rf #1295). %>
        <div class="d-flex flex-wrap justify-content-center gap-1">
          <% g[:tiles].each do |key, count, label, path| %>
            <%= link_to path, class: "sparc-inventory-tile", data: { home_tile: key },
                  title: "Open #{label}", "aria-label": "#{number_with_delimiter(count)} #{label}: open the list" do %>
              <span class="sparc-inventory-count"><%= number_with_delimiter(count) %></span>
              <span class="sparc-inventory-name"><%= label %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</nav>
