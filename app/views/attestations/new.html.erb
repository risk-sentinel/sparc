<div class="card">
  <div class="card-body">
    <h2 class="mb-2">Record Attestation</h2>
    <p class="text-body-secondary mb-4">
      Attesting to evidence: <strong><%= @evidence.title %></strong>
    </p>

    <%# #947 — this screen records a RE-REVIEW against evidence that already
        exists. Originating an attestation happens on the evidence form itself,
        because an attestation IS evidence: it is created with the record it
        belongs to rather than bolted on afterwards. Re-attestation stays here,
        since periodic review is genuinely a second event against the same
        record and is what drives the freshness deltas (#685). %>
    <% if @evidence.attestations.any? %>
      <div class="alert alert-info small">
        This evidence was last attested
        <strong><%= @evidence.attestations.maximum(:attested_at)&.strftime("%Y-%m-%d") %></strong>.
        Recording another keeps the earlier one — the history of who asserted
        what, and when, is never overwritten.
      </div>
    <% end %>

    <%= form_with model: [ @evidence, @attestation ], local: true do |f| %>
      <% if @attestation.errors.any? %>
        <div class="alert alert-danger">
          <h6 class="fw-semibold"><%= pluralize(@attestation.errors.count, "error") %> prevented saving:</h6>
          <ul class="mb-0">
            <% @attestation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= render "attestations/fields",
            f: f,
            boundary_id: @evidence.authorization_boundary_id %>

      <div class="alert alert-info small">
        <strong>Note:</strong> A tamper-evident digital signature hash (SHA-256) will be automatically generated
        from the attester's name, email, statement, and attestation date. This hash serves as a non-repudiation record.
      </div>

      <div class="d-flex gap-2">
        <%= f.submit "Record Attestation", class: "btn btn-success" %>
        <%= link_to "Cancel", evidence_path(@evidence), class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
      </div>
    <% end %>
  </div>
</div>
