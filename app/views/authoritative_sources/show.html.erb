<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start mb-3">
      <div>
        <h2 class="mb-1"><%= @resource.title %></h2>
        <div class="small text-body-secondary"><code><%= @resource.uuid %></code></div>
      </div>
      <div class="sparc-action-row">
        <%# #1039 — the surface used to be create-only, so a typo in an href was
            permanent. Archive rather than Delete: these resources participate in
            federation and promotion, and a hard delete strands a federated copy
            on a peer. The label says what actually happens. %>
        <% if can_write_sources? %>
          <% if @resource.archived? %>
            <%= button_to "Restore", restore_authoritative_source_path(@resource), method: :post,
                  class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm" %>
          <% else %>
            <%= link_to "Edit", edit_authoritative_source_path(@resource),
                  class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm" %>
            <%= button_to "Archive", authoritative_source_path(@resource), method: :delete,
                  class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm",
                  form: { data: { turbo_confirm: "Archive this source? It stays citable where already used, and can be restored." } } %>
          <% end %>
        <% end %>
        <%= link_to "← Back", authoritative_sources_path, class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" %>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-3"><strong>Source:</strong> <%= @resource.source %></div>
      <div class="col-md-3"><strong>Rel:</strong> <code><%= @resource.rel %></code></div>
      <div class="col-md-3"><strong>Media type:</strong> <%= @resource.media_type || "—" %></div>
      <div class="col-md-3"><strong>Promotion:</strong> <%= @resource.promotion_status %></div>
    </div>

    <%# #897 — link only when the scheme is safe; otherwise show the value as text
        so the operator can still SEE what was stored without it being clickable. %>
    <% if @resource.href.present? %>
      <p><strong>Reference URL:</strong>
        <% if (safe_href = safe_external_url(@resource.href)) %>
          <a href="<%= safe_href %>" target="_blank" rel="noopener noreferrer">
            <%= @resource.href %>
          </a>
        <% else %>
          <code><%= @resource.href %></code>
          <span class="text-danger small">(not a link — unsupported URL scheme)</span>
        <% end %>
      </p>
    <% end %>

    <% if @resource.description.present? %>
      <p><strong>Description</strong></p>
      <p><%= simple_format(@resource.description) %></p>
    <% end %>

    <%# ── Provided by, and when (#1039) ──────────────────────────────────
        `created_at` / `updated_at` were on the table and already serialized by
        the API, but never shown here — and for a source whose whole value is
        being authoritative, "is this current?" is the difference between a
        citation and a guess. %>
    <dl class="row g-2 mb-3 border-top pt-3">
      <dt class="col-sm-3">Provided by</dt>
      <dd class="col-sm-9">
        <% provider = [ @resource.organization&.name, @resource.provided_by_team ].compact_blank %>
        <%= provider.any? ? provider.join(" · ") : content_tag(:span, "Not recorded", class: "text-body-secondary") %>
      </dd>

      <dt class="col-sm-3">Contact</dt>
      <dd class="col-sm-9">
        <%= @resource.provided_by_contact.presence || content_tag(:span, "Not recorded", class: "text-body-secondary") %>
      </dd>

      <dt class="col-sm-3">Added</dt>
      <dd class="col-sm-9"><%= @resource.created_at&.to_fs(:long) || "—" %></dd>

      <dt class="col-sm-3">Last updated</dt>
      <dd class="col-sm-9"><%= @resource.updated_at&.to_fs(:long) || "—" %></dd>
    </dl>

    <% if @resource.federated? %>
      <div class="alert alert-info">
        <strong>Federated:</strong> imported from
        <code><%= @resource.federated_from_instance %></code>
        on <%= @resource.federated_at&.to_date %>.
        Original UUID: <code><%= @resource.original_uuid %></code>
      </div>
    <% end %>

    <% if @resource.archived? %>
      <div class="alert alert-warning">
        <strong>Archived</strong> on <%= @resource.archived_at&.to_date %> —
        excluded from new OSCAL exports.
      </div>
    <% end %>
  </div>
</div>

<%= render "control_references", resource: @resource %>

<div class="card">
  <div class="card-body">
    <h5 class="mb-3">Recent Changes</h5>
    <% changes = @resource.changes_log.reverse_chronological.limit(20).includes(:changed_by_user) %>
    <% if changes.empty? %>
      <p class="text-body-secondary mb-0">No changes recorded.</p>
    <% else %>
      <table class="table table-sm">
        <thead>
          <tr><th>When</th><th>Type</th><th>Field</th><th>From → To</th><th>By</th></tr>
        </thead>
        <tbody>
          <% changes.each do |c| %>
            <tr>
              <td class="small"><%= c.changed_at.iso8601 %></td>
              <td><span class="badge text-bg-secondary"><%= c.change_type %></span></td>
              <td><code><%= c.field %></code></td>
              <td class="small"><%= truncate(c.from_value.to_s, length: 30) %> →
                <%= truncate(c.to_value.to_s, length: 30) %></td>
              <td class="small"><%= c.changed_by_user&.email || "system" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
