<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h2>Authoritative Sources</h2>
        <p class="text-body-secondary mb-0">
          Browse the curated library of authoritative back-matter resources.
          Use these references when building Catalogs, Profiles, CDEFs, SSPs,
          and other OSCAL artifacts.
        </p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge text-bg-secondary"><%= @total %> total</span>
        <%= link_to "+ Add source", new_authoritative_source_path,
                    class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm text-nowrap" %>
      </div>
    </div>

    <%= form_with url: authoritative_sources_path, method: :get,
                  local: true, class: "row g-2 mb-3" do |f| %>
      <%# Carry the search term and view mode: a GET form submits only its own
          fields, so applying a filter here would otherwise drop the active
          search and reset how the list is drawn. %>
      <%= hidden_field_tag :q, params[:q], id: nil if params[:q].present? %>
      <%= hidden_field_tag :view, params[:view], id: nil if params[:view].present? %>
      <%# #888 — search moved to the shared box above, on `q`, like every other
          collection screen. Keeping a second `q` input here would have put two
          fields of the same name on one page and three controls named "Clear". %>
      <div class="col-md-4">
        <%= f.select :scope,
                     options_for_select([
                       [ "All visible", "" ],
                       [ "Authoritative only", "authoritative" ],
                       [ "Globally available", "global" ]
                     ], params[:scope]),
                     {}, class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= f.select :rel,
                     options_for_select([ [ "Any rel", "" ] ] +
                                        BackMatterResource::REL_VALUES.map { |r| [ r, r ] },
                                        params[:rel]),
                     {}, class: "form-select" %>
      </div>
      <%# Clearing is owned by the shared filter chrome ("Clear all"), which also
          drops the search — one control instead of two that did nearly the
          same thing. text-nowrap stops "Filter" wrapping at narrow widths. %>
      <div class="col-md-2 d-flex gap-2">
        <%= f.submit "Filter", class: "sparc-action sparc-action--neutral sparc-action--ghost flex-fill text-nowrap" %>
      </div>
    <% end %>

    <%= render "shared/collection_toolbar",
          label: "authoritative sources", placeholder: "Search sources by title, description or URL…",
          facets: @facets, clear_params: @clear_facets,
          view_mode: (@resources.any? ? @view_mode : nil) %>

    <% if @resources.empty? %>
      <div class="alert alert-info mb-0">No matching resources.</div>
    <% elsif @view_mode == :card %>
      <div class="sparc-card-grid">
        <% @resources.each do |r| %>
          <%= render "shared/item_card",
                title: r.title,
                url: authoritative_source_path(r),
                badges: [ { text: r.source.to_s.titleize, class: "badge bg-light text-dark" },
                          { text: r.rel.to_s, class: "badge text-bg-secondary" } ],
                description: r.description,
                chips: [ ({ text: r.globally_available? ? "Global" : "Organization", class: "" }),
                         (r.media_type.present? ? { text: r.media_type, class: "" } : nil) ].compact,
                empty_note: (card_short(r.href) if r.href.present?),
                footer: "Updated #{r.updated_at.to_date}",
                actions: render("authoritative_sources/item_actions", resource: r) %>
        <% end %>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
          <thead>
            <tr>
              <th style="min-width: 18rem;">Title</th>
              <th class="text-nowrap">Source</th>
              <th class="text-nowrap">Rel</th>
              <th class="text-nowrap">Scope</th>
              <th class="text-nowrap">Updated</th>
              <th class="text-end">&nbsp;</th>
            </tr>
          </thead>
          <tbody>
            <% @resources.each do |r| %>
              <tr>
                <td><strong><%= r.title %></strong>
                  <% if r.description.present? %>
                    <div class="small text-body-secondary"><%= truncate(r.description, length: 120) %></div>
                  <% end %>
                </td>
                <td class="text-nowrap">
                  <span class="badge text-bg-<%= r.authoritative? ? "success" : "secondary" %>">
                    <%= r.source %>
                  </span>
                  <% if r.federated? %>
                    <span class="badge text-bg-info" title="<%= r.federated_from_instance %>">federated</span>
                  <% end %>
                </td>
                <td class="text-nowrap"><code><%= r.rel %></code></td>
                <td class="text-nowrap">
                  <% if r.globally_available %>
                    <span class="badge text-bg-warning">Global</span>
                  <% elsif r.organization_id %>
                    <span class="badge text-bg-light">Org-scoped</span>
                  <% else %>
                    <span class="badge text-bg-light">Doc-scoped</span>
                  <% end %>
                </td>
                <td class="text-nowrap"><span class="small"><%= r.updated_at.to_date %></span></td>
                <td class="text-end">
                  <%= render "authoritative_sources/item_actions", resource: r %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <%= render "shared/collection_pagination", pagy: @pagy, label: "authoritative sources" %>
  </div>
</div>
