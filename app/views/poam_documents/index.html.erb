<%= render "shared/section_summary", tiles: [
  [@total_count, "POA&M Documents"],
  [@items_count, "Total Items"],
  [@completed_count, "Completed"]
] %>

<% if @poam_documents.any? { |d| d.processing? || d.pending? } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="10000" hidden></div>
<% end %>

<div class="card" style="overflow-x: auto;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Plan of Action &amp; Milestones</h2>
    <div class="d-flex gap-2">
      <%= link_to "Create New", new_poam_document_path, class: "btn btn-primary", style: "padding: 0.5rem 1rem; font-size: 0.875rem;" %>
      <%= link_to "Upload File", new_poam_document_path(anchor: "upload-poam"), class: "btn btn-success" %>
    </div>
  </div>

  <%= render "shared/collection_toolbar",
        label: "POA&M documents", placeholder: "Search POA&Ms…",
        filter_fields: @filter_fields, facets: @facets, clear_params: @clear_facets,
        view_mode: (@view_mode if @poam_documents.any?) %>

  <% if @poam_documents.any? && @tiering&.tiered? %>
    <%# #948 — tiering is AUTOMATIC, appearing only when more than one
        boundary is visible, so a single-system user never meets a tree
        with one branch. Card/list still applies inside each tier. %>
    <%= render "shared/collection_tiers",
          tiering: @tiering,
          records_partial: "poam_documents/collection",
          records_local: :records,
          view_mode: @view_mode,
          screen: "poam_documents" %>
  <% elsif @poam_documents.any? %>
    <%= render "poam_documents/collection", records: @poam_documents, view_mode: @view_mode %>
  <% else %>
    <p class="text-center p-4 text-body-secondary">No POA&M documents found. Upload your first OSCAL POA&M to get started.</p>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "POA&M documents" %>
</div>
