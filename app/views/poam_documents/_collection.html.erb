<%# #948 — how a SET of poam documents renders, extracted so the flat list and each
    boundary tier draw from one definition rather than a second copy that can
    drift.

    Locals:
      records       — the documents to draw (a page, or one tier's slice)
      view_mode     — :card or :list

    No boundary column here, unlike evidences/_collection. These types are
    per-system by definition, so the column would be either redundant (inside a
    tier, where the heading already names the system) or constant (untiered,
    which by definition means at most one boundary is in view). Evidence is
    different: it is the high-volume artefact gathered across systems, and #948
    asked for the column there specifically.
%>

<% if view_mode == :card %>
    <div class="sparc-card-grid">
      <% records.each do |doc| %>
        <%= render "shared/item_card", **document_card_slots(
              doc, count: doc.poam_items.count, count_label: "items",
              version: doc.poam_version).merge(
              url: poam_document_path(doc),
              badges: document_card_badges(doc),
              actions: render("poam_documents/item_actions", doc: doc, compact: true)) %>
      <% end %>
    </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr>
          <th class="sparc-ws-nowrap">Name</th>
          <th class="sparc-ws-nowrap">Version</th>
          <th class="sparc-ws-nowrap">Status</th>
          <th class="sparc-ws-nowrap">Items</th>
          <th class="sparc-ws-nowrap">Entities</th>
          <th class="sparc-ws-nowrap">Created</th>
          <th class="sparc-ws-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% records.each do |doc| %>
          <tr>
            <td><strong><%= link_to doc.name, poam_document_path(doc), class: "text-primary sparc-td-none" %></strong></td>
            <td class="small text-body-secondary"><%= doc.poam_version.presence || "—" %></td>
            <td class="sparc-ws-nowrap">
              <% if doc.processing? || doc.pending? || doc.failed? %>
                <span class="<%= doc.completed? ? 'badge-ok' : doc.failed? ? 'badge-fail' : 'badge-warn' %> rounded fw-semibold sparc-p-02-06 sparc-fs-085">
                  <%= doc.status %>
                </span>
                <% if doc.processing? && doc.metadata_extra&.dig("processing_message").present? %>
                  <br><span class="text-body-secondary sparc-fs-072 sparc-ws-normal"><%= doc.metadata_extra["processing_message"] %></span>
                <% end %>
              <% else %>
                <span class="<%= doc.lifecycle_badge_class %> rounded fw-semibold sparc-p-02-06 sparc-fs-085">
                  <%= doc.lifecycle_label %>
                </span>
              <% end %>
            </td>
            <td><%= doc.poam_items.count %></td>
            <td class="sparc-fs-08">
              <% if doc.completed? %>
                <span class="text-primary" title="Risks"><%= doc.poam_risks.count %>R</span>
                <span class="sparc-heading-enterprise" title="Observations"><%= doc.poam_observations.count %>O</span>
                <span class="sparc-heading-assessment" title="Findings"><%= doc.poam_findings.count %>F</span>
              <% else %>
                <span class="text-body-tertiary">—</span>
              <% end %>
            </td>
            <td class="sparc-ws-nowrap"><%= doc.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <%= render "poam_documents/item_actions", doc: doc %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
