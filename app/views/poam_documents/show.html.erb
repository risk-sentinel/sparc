<div data-controller="doc-meta inline-edit">
<%# #395 P3: boundary context header %>
<%= render "shared/boundary_header", document: @poam_document %>

<%# ── PROCESSING STATE BANNER ─────────────────────────────────────── %>
<% unless @poam_document.completed? %>
  <%= render "shared/processing_banner",
       document:     @poam_document,
       title:        "Processing Your POA&M",
       back_label:   "Back to POA&Ms",
       back_path:    poam_documents_path %>

<% else %>
<%
  open_count   = @status_counts.select { |s, _| s.to_s.downcase == "open" }.values.sum
  closed_count = @status_counts.select { |s, _| s.to_s.downcase == "closed" }.values.sum
  other_count  = @total_items - open_count - closed_count

  # #1090 — ONE scale for impact AND likelihood, five levels. Was three, keyed
  # "medium", and applied to impact only: likelihood rendered as an unstyled
  # neutral chip, so the two halves of a rating did not look like one rating.
  # `medium` is kept as a legacy key so rows that predate the data migration
  # still colour correctly instead of falling back to grey.
  level_colors = {
    "very-low" => "#5dade2", "low" => "#3498db", "moderate" => "#f39c12",
    "high" => "#e74c3c", "very-high" => "#c0392b", "medium" => "#f39c12"
  }
  status_colors = {
    "open" => "#e74c3c", "investigating" => "#e67e22", "remediating" => "#f39c12",
    "deviation-requested" => "#d35400", "deviation-approved" => "#f39c12", "closed" => "#27ae60"
  }
  # WORM (#599 Round 3): semantic variant keys for .sparc-status--<variant>
  level_variants = {
    "very-low" => "info", "low" => "info", "moderate" => "warning",
    "high" => "orange", "very-high" => "danger", "medium" => "warning"
  }
  status_variants = {
    "open" => "danger", "investigating" => "orange", "remediating" => "warning",
    "deviation-requested" => "orange", "deviation-approved" => "warning", "closed" => "success"
  }

  risk_status_options = [
    ["Open", "open"], ["Investigating", "investigating"], ["Remediating", "remediating"],
    ["Deviation Requested", "deviation-requested"], ["Deviation Approved", "deviation-approved"],
    ["Closed", "closed"]
  ]

  active_status = params[:risk_status]
  active_impact = params[:impact]
  has_filters   = [active_status, active_impact].any?(&:present?)
%>

<%# ── #911: catalog lineage. Discovered by looking, not by being
     refused mid-edit. Renders nothing when reconciled. %>
<%= render "shared/reconciliation_banner", document: @poam_document %>

<%# ── HEADER DASHBOARD ──────────────────────────────────────────── %>
<div class="sparc-gradient-header sparc-poam-hero">

  <div class="d-flex justify-content-between align-items-start mb-4 gap-3 flex-wrap">
    <div>
      <div class="sparc-header-subtitle">Plan of Action &amp; Milestones</div>

      <%# ── View mode ── %>
      <div id="doc-meta-view" data-doc-meta-target="view">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <h2 class="sparc-header-title"><%= @poam_document.name %></h2>
          <% if @poam_document.poam_version.present? %>
            <span class="sparc-version-badge">v<%= @poam_document.poam_version %></span>
          <% end %>
          <button type="button" data-action="doc-meta#toggle" class="sparc-action sparc-action--primary sparc-action--outline">Edit</button>
        </div>
      </div>

      <%# ── Edit mode (hidden) ── %>
      <div class="sparc-d-none" id="doc-meta-edit" data-doc-meta-target="edit">
        <%= form_with model: @poam_document, url: update_metadata_poam_document_path(@poam_document), method: :patch, local: true, class: "d-flex align-items-center gap-2 flex-wrap" do |f| %>
          <%= f.text_field :name, value: @poam_document.name, class: "sparc-input-dark sparc-input-dark-lg", placeholder: "Document name" %>
          <%= f.text_field :poam_version, value: @poam_document.poam_version, class: "sparc-input-dark sparc-input-dark-sm", placeholder: "Version" %>
          <%= f.submit "Save", class: "sparc-action sparc-action--primary sparc-action--solid" %>
          <button type="button" data-action="doc-meta#toggle" class="sparc-action sparc-action--neutral sparc-action--ghost">Cancel</button>
        <% end %>
      </div>
    </div>

    <%# ── Action buttons ── %>
    <div class="d-flex gap-2 flex-wrap">
      <%= link_to "+ Add Item", new_poam_document_poam_item_path(@poam_document), class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <%= link_to "+ Add Risk", new_poam_document_poam_risk_path(@poam_document), class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <%= link_to "+ Add Remediation", new_poam_document_poam_remediation_path(@poam_document), class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <%= link_to "+ Add Observation", new_poam_document_poam_observation_path(@poam_document), class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <%= link_to "+ Add Finding", new_poam_document_poam_finding_path(@poam_document), class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <%= link_to "+ Add Component", new_poam_document_poam_local_component_path(@poam_document), class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <% if signed_in? && @poam_document.draft? %>
        <%= render "shared/publish_button", document: @poam_document,
              publish_path: publish_poam_document_path(@poam_document),
              check_path: publish_check_poam_document_path(@poam_document) %>
      <% end %>
      <%= render "shared/oscal_export_dropdown",
            validate_path: validate_oscal_export_poam_document_path(@poam_document),
            download_json_path: download_oscal_validated_poam_document_path(@poam_document),
            download_yaml_path: download_yaml_poam_document_path(@poam_document),
            download_xml_path: download_xml_poam_document_path(@poam_document),
            fallback_json_path: download_oscal_unvalidated_poam_document_path(@poam_document),
            document_type: "POA&M" %>
      <%# #447 — jump to HDF Amendment triage for this POA&M's boundary. %>
      <% if @poam_document.authorization_boundary %>
        <%= link_to "Amendments",
              triage_authorization_boundary_path(@poam_document.authorization_boundary),
              class: "sparc-action sparc-action--neutral sparc-action--outline" %>
      <% end %>
      <%= link_to "&#8592; All POA&Ms".html_safe, poam_documents_path, class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>
  </div>

  <%# ── Summary stats ── %>
  <div class="sparc-poam-hero-tiles">
    <div class="sparc-hero-tile rounded-3">
      <div class="sparc-hero-tile-count"><%= @total_items %></div>
      <div class="sparc-hero-tile-label">Total Items</div>
    </div>
    <div class="sparc-hero-tile rounded-3 sparc-hero-tile--tinted sparc-accent--red">
      <div class="sparc-hero-tile-count sparc-heading-danger"><%= open_count %></div>
      <div class="sparc-hero-tile-label">Open</div>
    </div>
    <div class="sparc-hero-tile rounded-3 sparc-hero-tile--tinted sparc-accent--orange">
      <div class="sparc-hero-tile-count sparc-heading-assessment"><%= other_count %></div>
      <div class="sparc-hero-tile-label">In Progress</div>
    </div>
    <div class="sparc-hero-tile rounded-3 sparc-hero-tile--tinted sparc-accent--green">
      <div class="sparc-hero-tile-count sparc-heading-implementation"><%= closed_count %></div>
      <div class="sparc-hero-tile-label">Closed</div>
    </div>
    <div class="sparc-hero-tile rounded-3 sparc-hero-tile--tinted sparc-accent--blue">
      <div class="sparc-hero-tile-count sparc-heading-controls"><%= @risk_count %></div>
      <div class="sparc-hero-tile-label">Risks</div>
    </div>
    <div class="sparc-hero-tile rounded-3 sparc-hero-tile--tinted sparc-accent--purple">
      <div class="sparc-hero-tile-count sparc-heading-enterprise"><%= @observation_count %></div>
      <div class="sparc-hero-tile-label">Observations</div>
    </div>
    <div class="sparc-hero-tile rounded-3 sparc-hero-tile--tinted sparc-accent--carrot">
      <div class="sparc-hero-tile-count sparc-heading-assessment"><%= @finding_count %></div>
      <div class="sparc-hero-tile-label">Findings</div>
    </div>
  </div>
</div>

<%# ── HEATMAP ────────────────────────────────────────────────────── %>
<% if @heatmap_data.any? %>
<div class="card sparc-ofx-auto">
  <h3 class="mb-3">Risk Status x Impact</h3>
  <table class="table table-hover sparc-poam-table">
    <thead>
      <tr>
        <th>Status</th>
        <% @heatmap_impacts.each do |imp| %>
          <th class="text-center sparc-poam-th-narrow"><%= RiskRating.level_label(imp) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @heatmap_statuses.each do |status| %>
        <tr>
          <td class="fw-semibold">
            <% scv = status_variants[status] || "neutral" %>
            <span class="sparc-tag-outline sparc-status--<%= scv %>"><%= status %></span>
          </td>
          <% @heatmap_impacts.each do |imp| %>
            <% count = @heatmap_data.dig(status, imp) || 0 %>
            <% icv = level_variants[imp] || "neutral" %>
            <td class="text-center">
              <% if count > 0 %>
                <%= link_to count, poam_document_path(@poam_document, risk_status: status, impact: imp),
                      class: "sparc-heatmap-badge sparc-status--#{icv}",
                      role: "button",
                      "aria-label": "#{status} #{imp}: #{count} items",
                      style: "min-width: 28px;" %>
              <% else %>
                <span class="text-body-tertiary">—</span>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% end %>

<%# ── PUBLISH-READINESS WARNING (#389) ─────────────────────────────
     Surfaces an actionable warning when an in-progress POA&M has no items.
     OscalPoamExportService.validate! already enforces this at publish time
     (OSCAL schema requires poam-items to contain ≥1 entry); this banner
     prompts the user before they hit that error. %>
<% if @total_items.to_i.zero? && !@poam_document.published_lifecycle? %>
  <div class="card d-flex align-items-center gap-3 sparc-poam-banner sparc-border-l-4 sparc-accent--orange">
    <span class="sparc-fs-15r">&#9888;</span>
    <div class="flex-grow-1">
      <div class="fw-semibold sparc-heading-assessment sparc-fs-095">Add at least one POA&amp;M item before publishing</div>
      <div class="text-body-secondary sparc-fs-085">
        OSCAL schema requires the <code>poam-items</code> array to contain at least one entry.
        Publishing now will fail schema validation.
      </div>
    </div>
    <%= link_to "+ Add First Item", new_poam_document_poam_item_path(@poam_document),
                class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm" %>
  </div>
<% end %>

<%# ── ACTIVE FILTERS ─────────────────────────────────────────────── %>
<% if has_filters %>
  <div class="card d-flex align-items-center gap-3 flex-wrap sparc-poam-banner-tight">
    <span class="fw-semibold sparc-fs-085">Filters:</span>
    <% if active_status.present? %>
      <span class="sparc-tag-outline sparc-tag--warning-subtle">Status: <%= active_status %></span>
    <% end %>
    <% if active_impact.present? %>
      <span class="sparc-tag-outline sparc-tag--danger-subtle">Impact: <%= active_impact %></span>
    <% end %>
    <%= link_to "Clear Filters", poam_document_path(@poam_document), class: "text-primary", style: "font-size: 0.85rem;" %>
    <span class="text-body-secondary sparc-ml-auto sparc-fs-085">Showing <%= @filtered_count %> of <%= @total_items %> items</span>
  </div>
<% end %>

<%# ── POA&M ITEM CARDS WITH INLINE EDITING ────────────────────── %>
<% @items.each_with_index do |item, idx| %>
  <%
    sc = status_colors[item.risk_status] || "#7f8c8d"
    ic = level_colors[item.impact] || "#7f8c8d"
    scv = status_variants[item.risk_status] || "neutral"
    icv = level_variants[item.impact] || "neutral"
    risks = item.poam_risks
    observations = item.poam_observations
    findings = item.poam_findings
    related_controls = item.related_control_ids
  %>
  <div class="card sparc-poam-item-card sparc-border-l-4 <%= accent_class(sc) %>">

    <%# ── Card header ── %>
    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap sparc-mb-075">
      <div class="sparc-flex-1">
        <div class="d-flex align-items-center gap-2 flex-wrap sparc-mb-035">
          <span class="text-body-tertiary fw-semibold sparc-fs-07">#<%= idx + 1 %></span>
          <h3 class="sparc-poam-item-title"><%= item.title %></h3>
          <% related_controls.each do |cid| %>
            <span class="sparc-tag-outline sparc-status--info sparc-mono-600" title="NIST 800-53 control referenced in this item">
              <%= cid.upcase %>
            </span>
          <% end %>
        </div>
        <% if item.description.present? %>
          <p class="text-body-secondary sparc-poam-item-desc"><%= item.description %></p>
        <% end %>
        <% if item.remarks.present? %>
          <div class="bg-body-tertiary rounded sparc-poam-quote sparc-mt-04 sparc-fs-082">
            <span class="text-body-tertiary fw-semibold sparc-poam-label">Remarks</span>
            <div class="sparc-poam-quote-body"><%= item.remarks %></div>
          </div>
        <% end %>
      </div>
      <div class="d-flex flex-shrink-0 sparc-gap-035">
        <button type="button" data-action="inline-edit#toggle" data-inline-edit-id-param="<%= item.id %>" id="edit-btn-<%= item.id %>" class="sparc-action sparc-action--primary sparc-action--outline">Edit</button>
        <%= link_to "Full Edit", edit_poam_document_poam_item_path(@poam_document, item), class: "bg-body-secondary text-body-secondary rounded", style: "text-decoration: none; border: 1px solid var(--bs-border-color); padding: 0.3rem 0.7rem; font-size: 0.78rem;" %>
        <%= button_to "Delete", poam_document_poam_item_path(@poam_document, item), method: :delete, data: { turbo_confirm: "Remove \"#{item.title}\"?" }, class: "sparc-action sparc-action--danger sparc-action--outline", style: "padding: 0.3rem 0.7rem; font-size: 0.78rem;" %>
      </div>
    </div>

    <%# ── Status/risk badges ── %>
    <div class="d-flex gap-2 flex-wrap sparc-mb-075">
      <% if item.risk_status.present? %>
        <span class="sparc-tag-outline sparc-status--<%= scv %>"><%= item.risk_status %></span>
      <% end %>
      <% if item.impact.present? %>
        <span class="sparc-tag-outline sparc-status--<%= icv %>">Impact: <%= item.impact %></span>
      <% end %>
      <% if item.likelihood.present? %>
        <span class="sparc-tag-outline sparc-status--<%= level_variants[item.likelihood] || "neutral" %>">Likelihood: <%= item.likelihood %></span>
      <% end %>
      <% if item.deadline.present? %>
        <span class="sparc-tag-outline bg-body-secondary text-body-secondary sparc-border-default">Deadline: <%= item.deadline.strftime("%Y-%m-%d") %></span>
      <% end %>
      <% if risks.any? %>
        <span class="sparc-tag-outline sparc-status--info"><%= pluralize(risks.size, "risk") %></span>
      <% end %>
      <% if observations.any? %>
        <span class="sparc-tag-outline sparc-status--purple"><%= pluralize(observations.size, "observation") %></span>
      <% end %>
      <% if findings.any? %>
        <span class="sparc-tag-outline sparc-status--orange"><%= pluralize(findings.size, "finding") %></span>
      <% end %>
    </div>

    <%# ── Expandable details section ── %>
    <details id="details-<%= item.id %>" class="card-details">
      <summary class="text-primary fw-semibold sparc-poam-summary">
        Show Details
      </summary>

      <%# ══════ VIEW MODE ══════ %>
      <div id="view-<%= item.id %>">
        <%# ── Related risks ── %>
        <% if risks.any? %>
          <div class="sparc-mb-075">
            <div class="sparc-statement-label">Related Risks</div>
            <% risks.each do |risk| %>
              <div class="bg-body-secondary rounded sparc-poam-subcard sparc-mb-04">
                <div class="d-flex align-items-center gap-2 flex-wrap sparc-mb-03">
                  <% rscv = status_variants[risk.status] || "neutral" %>
                  <span class="sparc-tag-outline sparc-status--<%= rscv %>"><%= risk.status %></span>
                  <span class="fw-semibold sparc-fs-088 sparc-color-body"><%= risk.title %></span>
                </div>
                <% if risk.description.present? %>
                  <div class="text-body-secondary sparc-fs-082 sparc-mb-03"><%= truncate(risk.description, length: 300) %></div>
                <% end %>
                <% if risk.statement.present? %>
                  <div class="text-body-secondary sparc-poam-subquote"><%= truncate(risk.statement, length: 200) %></div>
                <% end %>

                <%# ── Remediations + Milestones ── %>
                <% risk.poam_remediations.each do |rem| %>
                  <div class="rounded mt-2 sparc-poam-note sparc-poam-note--roomy sparc-accent--blue">
                    <div class="sparc-statement-label sparc-heading-controls">
                      Remediation: <%= rem.lifecycle %>
                    </div>
                    <div class="fw-semibold sparc-fs-082 sparc-color-body"><%= rem.title %></div>
                    <% if rem.description.present? %>
                      <div class="text-body-secondary sparc-fs-08"><%= truncate(rem.description, length: 200) %></div>
                    <% end %>

                    <% rem.poam_milestones.each do |ms| %>
                      <div class="rounded mt-1 sparc-poam-note sparc-poam-note--tight sparc-accent--green">
                        <div class="sparc-statement-label sparc-heading-implementation">
                          Milestone
                          <% if ms.due_date.present? %>
                            <span class="text-body-secondary sparc-fw-400">&middot; Due: <%= ms.due_date.strftime("%Y-%m-%d") %></span>
                          <% end %>
                        </div>
                        <div class="sparc-fs-08 sparc-color-body"><%= ms.title %></div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# ── Related observations ── %>
        <% if observations.any? %>
          <div class="sparc-mb-075">
            <div class="sparc-statement-label">Related Observations</div>
            <% observations.each do |obs| %>
              <div class="bg-body-secondary rounded sparc-poam-subcard--tight sparc-mb-04">
                <div class="fw-semibold sparc-fs-088 sparc-color-body"><%= obs.title %></div>
                <% if obs.description.present? %>
                  <div class="text-body-secondary sparc-fs-082"><%= truncate(obs.description, length: 200) %></div>
                <% end %>
                <div class="text-body-tertiary sparc-fs-072 sparc-mt-02">
                  <% if obs.collected.present? %>Collected: <%= obs.collected.strftime("%Y-%m-%d") %><% end %>
                  <% if obs.methods_data.present? %>&middot; Methods: <%= obs.methods_data.join(", ") %><% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# ── Related findings ── %>
        <% if findings.any? %>
          <div class="sparc-mb-075">
            <div class="sparc-statement-label">Related Findings</div>
            <% findings.each do |finding| %>
              <div class="bg-body-secondary rounded sparc-poam-subcard--tight sparc-mb-04">
                <div class="fw-semibold sparc-fs-088 sparc-color-body"><%= finding.title %></div>
                <% if finding.description.present? %>
                  <div class="text-body-secondary sparc-fs-082"><%= truncate(finding.description, length: 200) %></div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# ── Internal Notes / Closure Evidence (read-only) ── %>
        <% if item.internal_notes.present? %>
          <div class="bg-body-secondary rounded sparc-poam-subcard sparc-mb-05">
            <div class="sparc-statement-label">Internal Notes</div>
            <div class="sparc-fs-085 sparc-prewrap sparc-color-body"><%= item.internal_notes %></div>
          </div>
        <% end %>
        <% if item.closure_evidence.present? %>
          <div class="bg-body-secondary rounded sparc-poam-subcard sparc-mb-05">
            <div class="sparc-statement-label">Closure Evidence</div>
            <div class="sparc-fs-085 sparc-prewrap sparc-color-body"><%= item.closure_evidence %></div>
          </div>
        <% end %>
      </div>

      <%# ══════ EDIT MODE (hidden initially) ══════ %>
      <div class="sparc-d-none" id="edit-<%= item.id %>">
        <%= form_with url: poam_document_path(@poam_document), method: :patch, local: true do |f| %>
          <%= hidden_field_tag :poam_item_id, item.id %>

          <div class="row row-cols-1 row-cols-md-2 g-3 sparc-mb-075">
            <div class="col">
              <div class="form-group sparc-mb-0">
                <label class="fw-semibold sparc-fs-082" for="fields-risk-status-<%= item.id %>">Risk Status</label>
                <%= select_tag "fields[risk_status]",
                      options_for_select(risk_status_options, item.risk_status),
                      include_blank: "— Select —",
                      id: "fields-risk-status-#{item.id}",
                      class: "form-control", style: "font-size: 0.88rem;" %>
              </div>
            </div>
          </div>

          <div class="form-group sparc-mb-075">
            <label class="fw-semibold sparc-fs-082" for="fields-internal-notes-<%= item.id %>">Internal Notes</label>
            <textarea id="fields-internal-notes-<%= item.id %>" name="fields[internal_notes]" class="form-control sparc-fs-088" rows="3" placeholder="Internal tracking notes..."><%= item.internal_notes %></textarea>
          </div>

          <div class="form-group sparc-mb-075">
            <label class="fw-semibold sparc-fs-082" for="fields-closure-evidence-<%= item.id %>">Closure Evidence</label>
            <textarea id="fields-closure-evidence-<%= item.id %>" name="fields[closure_evidence]" class="form-control sparc-fs-088" rows="3" placeholder="Evidence or documentation for closure..."><%= item.closure_evidence %></textarea>
          </div>

          <div class="d-flex gap-2">
            <%= f.submit "Save Changes", class: "sparc-action sparc-action--primary sparc-action--solid", style: "padding: 0.35rem 0.9rem; font-size: 0.82rem;" %>
            <button type="button" data-action="inline-edit#toggle" data-inline-edit-id-param="<%= item.id %>" class="sparc-action sparc-action--neutral sparc-action--ghost sparc-p-035-09 sparc-fs-082">Cancel</button>
          </div>
        <% end %>
      </div>
    </details>
  </div>
<% end %>

<% if @items.empty? && !has_filters %>
  <div class="card text-center p-4 text-body-secondary">
    No POA&amp;M items found. <%= link_to "Add your first item", new_poam_document_poam_item_path(@poam_document) %>.
  </div>
<% elsif @items.empty? && has_filters %>
  <div class="card text-center p-4 text-body-secondary">
    No items match the current filters. <%= link_to "Clear filters", poam_document_path(@poam_document) %>.
  </div>
<% end %>

<% end %>

<%= render "shared/uuid_replaced_warning", document: @poam_document %>

<%= render "shared/oscal_metadata_section",
           document: @poam_document,
           update_path: update_metadata_poam_document_path(@poam_document),
           param_key: :poam_document,
           version_field: :poam_version %>

<%= render "shared/oscal_back_matter_section",
