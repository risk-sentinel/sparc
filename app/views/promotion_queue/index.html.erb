<div class="card">
  <div class="card-body">
    <h2 class="mb-1">Promotion Queue</h2>
    <p class="text-body-secondary">Pending requests to promote a back-matter resource into the
      authoritative tier. Only items you are authorized to approve appear here.</p>

    <%= render "shared/collection_toolbar",
          label: "pending promotions", placeholder: "Search pending promotions…",
          view_mode: (@resources.any? ? @view_mode : nil) %>

    <% if @resources.empty? %>
      <div class="alert alert-info mb-0">No pending promotions. 🎉</div>
    <% elsif @view_mode == :card %>
      <div class="sparc-card-grid">
        <% @resources.each do |r| %>
          <%= render "shared/item_card",
                title: r.title,
                url: authoritative_source_path(r),
                badges: [ { text: r.rel.to_s, class: "badge text-bg-secondary" } ],
                subtitle: (r.organization ? "Org: #{r.organization.name}" : (r.resourceable ? "Doc: #{r.resourceable_type}##{r.resourceable_id}" : "Library")),
                description: r.description,
                footer: "Requested #{r.updated_at.to_date}",
                actions: render("promotion_queue/item_actions", resource: r) %>
        <% end %>
      </div>
    <% else %>
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Title</th>
            <th>Origin</th>
            <th>Requested</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @resources.each do |r| %>
            <tr>
              <td>
                <strong><%= r.title %></strong>
                <div class="small text-body-secondary">
                  <%= r.description.to_s.truncate(140) %>
                </div>
              </td>
              <td>
                <% if r.organization %>
                  Org: <%= r.organization.name %>
                <% elsif r.resourceable %>
                  Doc: <%= r.resourceable_type %>#<%= r.resourceable_id %>
                <% else %>
                  Library
                <% end %>
              </td>
              <td class="small"><%= r.updated_at.to_date %></td>
              <td class="text-end">
                <%= render "promotion_queue/item_actions", resource: r %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <%= render "shared/collection_pagination", pagy: @pagy, label: "pending promotions" %>
  </div>
</div>
