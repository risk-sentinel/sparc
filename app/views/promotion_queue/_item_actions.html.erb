<%#
  Approve / reject for one pending promotion, shared by the table row and the
  card (#888 §4). The queue is the whole point of this screen, so the actions
  have to be reachable in whichever view the user is in.

  Locals: resource — the BackMatterResource awaiting promotion
%>
<% r = local_assigns[:resource] %>

<div class="d-flex flex-wrap gap-1 align-items-center">
  <%= button_to "Approve", approve_promotion_queue_path(r),
                method: :post, class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm",
                form: { style: "display:inline-block; margin-right: 0.5rem;" } %>
  <button type="button" class="sparc-action sparc-action--danger sparc-action--outline sparc-action--sm"
          data-bs-toggle="collapse" data-bs-target="#reject-<%= r.id %>">
    Reject…
  </button>
  <div class="collapse mt-2" id="reject-<%= r.id %>">
    <%= form_with url: reject_promotion_queue_path(r), method: :post, local: true,
                  class: "d-flex gap-2" do |f| %>
      <%= f.text_field :reason, class: "form-control form-control-sm",
                       placeholder: "Reason for rejection (required)" %>
      <%= f.submit "Reject", class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm" %>
    <% end %>
  </div>
</div>
