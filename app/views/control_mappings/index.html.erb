<% summary = [
  [@total_count, "Control Mappings"],
  [@complete_count, "Complete"],
  [@draft_count, "Draft"]
] %>
<%= render "shared/section_summary", tiles: summary unless SparcConfig.nav_shell? %>

<div class="card sparc-list-card sparc-of-hidden">
  <%# 1.18.0-rf #1299/#1298 — under SPARC_NAV_SHELL, the shared page header. %>
  <% if SparcConfig.nav_shell? %>
    <%= render "shared/page_header", summary: summary, title: "Control Mappings",
            primary: ({ label: "New Mapping", path: new_control_mapping_path } if can_write_mappings?) %>
  <% else %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Control Mappings</h2>
    <% if can_write_mappings? %>
      <div class="d-flex gap-2">
        <%= link_to "New Mapping", new_control_mapping_path, class: "sparc-action sparc-action--positive sparc-action--solid" %>
      </div>
    <% end %>
  </div>
  <% end %>

  <%= render "shared/collection_toolbar",
        label: "control mappings", placeholder: "Search control mappings…",
        status_tabs: @status_tabs, facets: @facets, clear_params: @clear_facets,
        view_mode: (@control_mappings.any? ? @view_mode : nil) %>

  <% if @control_mappings.any? && collection_layout(@view_mode) != :table %>
    <div class="<%= collection_items_class(@view_mode) %>">
      <% @control_mappings.each do |mapping| %>
        <%= render collection_item_partial(@view_mode),
              title: mapping.name,
              url: control_mapping_path(mapping),
              badges: [ { text: mapping.status.to_s.titleize,
                          class: "sparc-status sparc-status--#{mapping.status == 'complete' ? 'success' : 'neutral'}" } ],
              subtitle: [ mapping.source_catalog&.name, mapping.target_catalog&.name ].compact.join(" → ").presence,
              description: mapping.description,
              metrics: [ { value: mapping.control_mapping_entries.size, label: "entries" } ],
              footer: "#{mapping.method_type.to_s.titleize} · updated #{mapping.updated_at.strftime('%Y-%m-%d')}",
              actions: render("control_mappings/item_actions", mapping: mapping) %>
      <% end %>
    </div>
  <% elsif @control_mappings.any? %>
    <table class="table table-hover sparc-table-layout-fixed">
      <colgroup>
        <col class="sparc-w-20pct">
        <col class="sparc-w-28pct">
        <col class="sparc-w-10pct">
        <col class="sparc-w-8pct">
        <col class="sparc-w-10pct">
        <col class="sparc-w-12pct">
        <col class="sparc-w-12pct">
      </colgroup>
      <thead>
        <tr>
          <th>Name</th>
          <th>Source &rarr; Target</th>
          <th>Status</th>
          <th>Entries</th>
          <th>Method</th>
          <th>Last Updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @control_mappings.each do |mapping| %>
          <tr>
            <td class="sparc-text-ellipsis" title="<%= mapping.name %>">
              <%= link_to mapping.name, control_mapping_path(mapping), class: "text-decoration-none" %>
            </td>
            <td class="small text-body-secondary sparc-text-ellipsis"
                title="<%= mapping.source_catalog.name %> → <%= mapping.target_catalog.name %>">
              <%= mapping.source_catalog.name %> &rarr; <%= mapping.target_catalog.name %>
            </td>
            <td>
              <span class="badge text-bg-<%= mapping_status_color(mapping.status) %>">
                <%= mapping.status.titleize %>
              </span>
            </td>
            <td><%= mapping.entries_count %></td>
            <td class="small text-body-secondary"><%= mapping.method_type.titleize %></td>
            <td class="small text-body-secondary"><%= mapping.updated_at.strftime("%Y-%m-%d") %></td>
            <td>
              <%= render "control_mappings/item_actions", mapping: mapping %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="text-center text-body-secondary p-4">
      <p>No control mappings found.</p>
      <% if can_write_mappings? %>
        <%= link_to "Create your first mapping", new_control_mapping_path, class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "control mappings" %>
</div>
