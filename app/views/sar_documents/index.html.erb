<%= render "shared/section_summary", tiles: [
  [@total_count, "SAR Documents"],
  [@controls_count, "Total Controls"],
  [@completed_count, "Completed"]
] %>

<% if @sar_documents.any? { |d| d.processing? || d.pending? } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="10000" hidden></div>
<% end %>

<div class="card">
  <%# 1.18.0-rf #1299/#1298 — under SPARC_NAV_SHELL, the shared page header. %>
  <% if SparcConfig.nav_shell? %>
    <%= render "shared/page_header", title: "Security Assessment Results",
            primary: { label: "Create from Wizard", path: wizard_sar_documents_path },
            secondary: [ { label: "Upload New", path: new_sar_document_path } ] %>
  <% else %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Security Assessment Results</h2>
    <div class="d-flex gap-2">
      <%= link_to "Create from Wizard", wizard_sar_documents_path, class: "sparc-action sparc-action--accent sparc-action--outline", style: "padding: 0.5rem 1rem; font-size: 0.875rem;" %>
      <%= link_to "Upload New", new_sar_document_path, class: "sparc-action sparc-action--info sparc-action--solid" %>
    </div>
  </div>
  <% end %>

  <%# 1.18.0-rf #1292 — the Boundary filter beside the list (BoundaryListFilter). %>
  <%= render layout: "shared/boundary_filter_layout" do %>
  <%= render "shared/collection_toolbar",
        label: "security assessment reports", placeholder: "Search SARs…",
        status_tabs: @status_tabs, facets: @facets, clear_params: @clear_facets,
        view_mode: (@view_mode if @sar_documents.any?) %>

  <% if @sar_documents.any? && @tiering&.tiered? %>
    <%# #948 — tiering is AUTOMATIC, appearing only when more than one
        boundary is visible, so a single-system user never meets a tree
        with one branch. Card/list still applies inside each tier. %>
    <%= render "shared/collection_tiers",
          tiering: @tiering,
          records_partial: "sar_documents/collection",
          records_local: :records,
          view_mode: @view_mode,
          screen: "sar_documents" %>
  <% elsif @sar_documents.any? %>
    <%= render "sar_documents/collection", records: @sar_documents, view_mode: @view_mode %>
  <% else %>
    <p class="text-center p-4 text-body-secondary">No Security Assessment Results found. Upload an OSCAL file or create from the wizard to get started.</p>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "security assessment reports" %>
  <% end %>
</div>
