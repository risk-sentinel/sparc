<%= render "shared/section_summary", tiles: [
  [@total_count, "SAR Documents"],
  [@controls_count, "Total Controls"],
  [@completed_count, "Completed"]
] %>

<% if @sar_documents.any? { |d| d.processing? || d.pending? } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="10000" hidden></div>
<% end %>

<div class="card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Security Assessment Results</h2>
    <div class="d-flex gap-2">
      <%= link_to "Create from Wizard", wizard_sar_documents_path, class: "btn btn-primary", style: "padding: 0.5rem 1rem; font-size: 0.875rem;" %>
      <%= link_to "Upload New", new_sar_document_path, class: "btn btn-success" %>
    </div>
  </div>

  <%= render "shared/collection_toolbar",
        label: "security assessment reports", placeholder: "Search SARs…",
        view_mode: (@view_mode if @sar_documents.any?) %>

  <% if @sar_documents.any? && @view_mode == :card %>
    <div class="sparc-card-grid">
      <% @sar_documents.each do |doc| %>
        <%= render "shared/item_card", **document_card_slots(
              doc, count: doc.sar_controls.count, count_label: "controls",
              version: doc.sar_version, enriched: doc.enriched?).merge(
              url: sar_document_path(doc),
              badges: document_card_badges(doc, enriched: doc.enriched?) + [ creation_method_badge(doc) ],
              actions: render("sar_documents/item_actions", doc: doc, compact: true)) %>
      <% end %>
    </div>
  <% elsif @sar_documents.any? %>
    <table class="table table-hover">
      <thead>
        <tr>
          <th style="white-space: nowrap;">Name</th>
          <th style="white-space: nowrap;">Source</th>
          <th style="white-space: nowrap;">Version</th>
          <th style="white-space: nowrap;">Status</th>
          <th style="white-space: nowrap;">OSCAL</th>
          <th style="white-space: nowrap;">Controls</th>
          <th style="white-space: nowrap;">Created</th>
          <th style="white-space: nowrap;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @sar_documents.each do |doc| %>
          <tr>
            <td><strong><%= link_to doc.name, sar_document_path(doc), class: "text-primary", style: "text-decoration: none;" %></strong></td>
            <td>
              <% source_label, source_class = case doc.creation_method
                               when "wizard" then ["Wizard", "sparc-source-wizard"]
                               when "oscal_import" then ["OSCAL", "sparc-source-oscal"]
                               else ["Import", "sparc-source-excel"]
                               end %>
              <span class="sparc-source-badge <%= source_class %>"><%= source_label %></span>
            </td>
            <td class="text-body-secondary" style="font-size: 0.85rem;"><%= doc.sar_version.presence || "\u2014" %></td>
            <td style="white-space: nowrap;">
              <% if doc.processing? || doc.pending? || doc.failed? %>
                <span class="<%= doc.completed? ? 'badge-ok' : doc.failed? ? 'badge-fail' : 'badge-warn' %> rounded fw-semibold" style="padding: 0.2rem 0.6rem; font-size: 0.85rem;">
                  <%= doc.status %>
                </span>
                <% if doc.processing? && doc.metadata_extra&.dig("processing_message").present? %>
                  <br><span class="text-body-secondary" style="font-size: 0.72rem; white-space: normal;"><%= doc.metadata_extra["processing_message"] %></span>
                <% end %>
              <% else %>
                <span class="<%= doc.lifecycle_badge_class %> rounded fw-semibold" style="padding: 0.2rem 0.6rem; font-size: 0.85rem;">
                  <%= doc.lifecycle_label %>
                </span>
              <% end %>
            </td>
            <td>
              <% if doc.enriched? %>
                <span class="sparc-oscal-enriched">Enriched</span>
              <% else %>
                <span class="sparc-oscal-basic">Basic</span>
              <% end %>
            </td>
            <td><%= doc.sar_controls.count %></td>
            <td style="white-space: nowrap;"><%= doc.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <%= render "sar_documents/item_actions", doc: doc %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center p-4 text-body-secondary">No Security Assessment Results found. Upload an OSCAL file or create from the wizard to get started.</p>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "security assessment reports" %>
</div>
