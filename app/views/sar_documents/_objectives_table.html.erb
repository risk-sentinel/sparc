<%# Per-control objectives table for SAR show page.
    Locals:
      control      - SarControl instance (must have sar_control_objectives loaded)
      sar_document - SarDocument instance (for routing)
%>
<%
  objectives = control.sar_control_objectives.sort_by { |o| o.row_order || 0 }
%>

<% if objectives.any? %>
  <%
    status_colors = {
      "pending"        => "#95a5a6",
      "in-progress"    => "#f39c12",
      "passing"        => "#27ae60",
      "failed"         => "#e74c3c",
      "not_applicable" => "#7f8c8d"
    }
  %>

  <div class="sparc-statement-block sparc-statement-block--info sparc-accent--blue sparc-mt-075">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 sparc-mb-04">
      <div class="sparc-statement-label sparc-heading-controls">
        Assessment Objectives
        <span class="text-body-secondary sparc-fw-400 sparc-fs-07">
          (<%= pluralize(objectives.size, "objective") %>)
        </span>
      </div>
      <span class="text-body-tertiary sparc-fs-07">
        Rollup:
        <span class="sparc-status sparc-status--<%= sar_objective_status_variant(control.objective_status_rollup) %>">
          <%= control.objective_status_rollup.to_s.humanize %>
        </span>
      </span>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-hover sparc-fs-082 sparc-mb-0">
        <thead>
          <tr class="sparc-th-eyebrow-row">
            <th class="sparc-w-11pct">Label</th>
            <th>Determination Statement</th>
            <th class="sparc-w-10pct">Status</th>
            <th class="sparc-w-14pct">Assessor</th>
            <th class="sparc-w-6pct"></th>
          </tr>
        </thead>
        <tbody>
          <% objectives.each do |obj| %>
            <%
              depth = [ obj.parent_objective_id.present? ? 1 : 0, 3 ].min
              color = status_colors[obj.status] || "#95a5a6"
            %>
            <tr id="obj-<%= obj.id %>" data-status="<%= obj.status %>" data-objective-id="<%= obj.objective_id %>">
              <td>
                <code class="sparc-fs-078 sparc-stmt-d<%= depth %>">
                  <%= obj.label.presence || obj.objective_id %>
                </code>
              </td>
              <td class="sparc-stmt-d<%= depth %>">
                <%= obj.prose.presence || content_tag(:span, "(no prose)", class: "text-body-tertiary fst-italic") %>
                <% if obj.assessor_notes.present? %>
                  <div class="text-body-secondary sparc-stmt-note">
                    <%= obj.assessor_notes %>
                  </div>
                <% end %>
              </td>
              <td>
                <span class="sparc-status-pill sparc-status--<%= sar_objective_status_variant(obj.status) %> sparc-fs-068">
                  <%= obj.status.humanize %>
                </span>
              </td>
              <td class="text-body-secondary sparc-fs-078">
                <%= obj.assessor_name.presence || "—" %>
              </td>
              <td>
                <%= link_to "Edit",
                            sar_document_path(sar_document, objective_id: obj.id, anchor: "obj-#{obj.id}"),
                            class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm sparc-fs-07 sparc-p-015-045" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
