<div class="card">
  <h2>Create New SAR from Wizard</h2>
  <p class="text-body-secondary mb-4">
    Build a Security Assessment Report by linking to an Assessment Plan (SAP), setting assessment dates,
    and optionally populating controls from the SAP. The SAR will be created with OSCAL-ready structure.
  </p>

  <%= form_with url: create_from_wizard_sar_documents_path, method: :post, local: true do |f| %>

    <%# ── Step 1: Assessment Basics ── %>
    <details open class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--info sparc-wizard-step-number">1</span>
        Assessment Basics
      </summary>
      <div class="sparc-wizard-step-body">
        <div class="form-group">
          <label for="name">Assessment Name <span class="sparc-required">*</span></label>
          <%= f.text_field :name, required: true, class: "form-control", placeholder: "e.g., FY2026 Annual Security Assessment" %>
        </div>
        <%# #952 — the system these results assess. An assessment result with no
            boundary was shown to every signed-in user. %>
        <div class="form-group">
          <label for="authorization_boundary_id">Authorization Boundary <span class="sparc-required">*</span></label>
          <%= f.select :authorization_boundary_id,
                options_for_select(assignable_boundaries(current_user).map { |b| [ b.name, b.id ] }),
                { include_blank: "— Select a boundary —" },
                { class: "form-control", required: true, id: "authorization_boundary_id" } %>
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "Brief description of the assessment scope and objectives..." %>
        </div>
      </div>
    </details>

    <%# ── Step 2: SAP Selection ── %>
    <details open class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--success sparc-wizard-step-number">2</span>
        Assessment Plan (SAP) Selection
      </summary>
      <div class="sparc-wizard-step-body">
        <% if @sap_documents.any? %>
          <div class="form-group">
            <label for="sap_document_id">Link to Assessment Plan</label>
            <%= f.select :sap_document_id,
                  @sap_documents.map { |s| ["#{s.name} (#{s.sap_controls.count} controls)", s.id] },
                  { include_blank: "-- No SAP (create empty SAR) --" },
                  { class: "form-control" } %>
            <small class="text-body-secondary d-block sparc-mt-03">
              Controls from the selected SAP will be imported into the SAR with default "Not Tested" status.
              Each control will also get a default OSCAL finding.
            </small>
          </div>
        <% else %>
          <p class="text-body-secondary sparc-fs-088">
            No completed SAP documents found. You can still create a SAR without linking to a SAP,
            or <%= link_to "upload a SAP", new_sap_document_path %> first.
          </p>
          <%= f.hidden_field :sap_document_id, value: "" %>
        <% end %>
      </div>
    </details>

    <%# ── Step 3: Assessment Period ── %>
    <details open class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--warning sparc-wizard-step-number">3</span>
        Assessment Period
      </summary>
      <div class="sparc-wizard-step-body">
        <div class="sparc-field-grid-2-roomy">
          <div class="form-group">
            <label for="assessment_start">Start Date</label>
            <%= f.datetime_local_field :assessment_start, class: "form-control", value: Time.current.beginning_of_day.strftime('%Y-%m-%dT%H:%M') %>
          </div>
          <div class="form-group">
            <label for="assessment_end">End Date</label>
            <%= f.datetime_local_field :assessment_end, class: "form-control" %>
            <small class="text-body-secondary d-block sparc-mt-03">
              Leave blank if the assessment is ongoing.
            </small>
          </div>
        </div>
      </div>
    </details>

    <%# ── Submit ── %>
    <div class="d-flex gap-3 mt-3">
      <%= f.submit "Create SAR", class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <%= link_to "Cancel", sar_documents_path, class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>

  <% end %>
</div>
