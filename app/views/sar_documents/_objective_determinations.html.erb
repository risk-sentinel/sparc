<%#
  #1312 — THE place an assessor records a control's 800-53A determinations, in
  the control's Edit form, in one Save. Each assessable objective (one with a
  statement to determine) gets its determination and notes; a container
  (ac-1_obj.a, no prose) is a heading. Beside each, read-only, the SSP item the
  objective tests and what it records, so the claim is in view while it is
  judged. The objectives table in the read view, and its per-row Edit and
  modal, were the second and third places to record the same thing.

  Locals:
    control  — SarControl, with sar_control_objectives loaded
    ssp_ctx  — this control's entry of SarDocumentsController#build_ssp_context, or nil
%>
<% objectives = control.sar_control_objectives.sort_by { |o| o.row_order || 0 } %>
<% items = (local_assigns[:ssp_ctx] || {})[:statements].to_a.index_by { _1[:statement_id] } %>
<% item_ids = items.keys.compact.to_set %>
<% assessable = objectives.reject(&:container?) %>
<% if assessable.any? %>
  <div class="sparc-statement-block sparc-statement-block--info sparc-accent--blue sparc-mb-075" data-testid="objective-determinations">
    <div class="sparc-statement-label sparc-heading-controls sparc-mb-04">
      Determinations
      <span class="text-body-secondary sparc-fw-400 sparc-fs-07">
        (<%= pluralize(assessable.size, "objective") %>; saved with Save Changes)
      </span>
    </div>
    <div class="d-flex align-items-center gap-2 sparc-mb-06">
      <%= submit_tag "Save Changes", class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm",
            data: { testid: "save-determinations-top" } %>
      <span class="sparc-fs-072 sparc-color-tertiary">Saves every determination below, and the control's fields.</span>
    </div>

    <% objectives.each do |obj| %>
      <% depth = [ obj.parent_objective_id.present? ? 1 : 0, 3 ].min %>
      <% if obj.container? %>
        <div class="fw-semibold sparc-fs-082 sparc-mb-025 sparc-stmt-d<%= depth %>" data-objective-group="<%= obj.objective_id %>">
          <code class="sparc-fs-078"><%= obj.label.presence || obj.objective_id %></code>
        </div>
        <% next %>
      <% end %>
      <% box = "objective-#{obj.id}" %>
      <% item = items[ControlRequirementText.statement_for_objective(obj.objective_id, item_ids)] %>
      <div class="form-group sparc-mb-075 sparc-stmt-d<%= depth %>" data-objective-determination="<%= obj.objective_id %>">
        <div class="sparc-fs-082">
          <code class="sparc-fs-078"><%= obj.label.presence || obj.objective_id %></code>
          <span class="sparc-color-body"><%= obj.prose %></span>
        </div>
        <% if item %>
          <div class="sparc-ctx-readonly-note sparc-mt-025" data-testid="ssp-claim">
            SSP <code><%= item[:label] %></code>:
            <%= item[:prose].presence || content_tag(:span, "(not answered)", class: "fst-italic") %>
            <%= render "sar_documents/ssp_item_facts", stmt: item %>
          </div>
        <% end %>
        <div class="row g-2 sparc-mt-025">
          <div class="col-md-4">
            <label class="sparc-edit-label" for="<%= box %>-status">Determination</label>
            <%= select_tag "objectives[#{obj.id}][status]",
                  options_for_select(SarControlObjective::OBJECTIVE_STATUSES.map { |s| [ s.tr("_-", "  ").capitalize, s ] }, obj.status),
                  class: "form-select sparc-fs-0875", id: "#{box}-status" %>
          </div>
          <div class="col-md-8">
            <label class="sparc-edit-label" for="<%= box %>-notes">Assessor notes</label>
            <%= text_area_tag "objectives[#{obj.id}][assessor_notes]", obj.assessor_notes, rows: 2,
                  class: "form-control sparc-fs-0875", id: "#{box}-notes",
                  placeholder: "Evidence examined, interviews, test results" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
