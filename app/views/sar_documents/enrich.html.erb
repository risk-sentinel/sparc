<div class="card">
  <div class="sparc-enrich-header-row">
    <div>
      <h2>Enrich SAR: <%= @sar_document.name %></h2>
      <p class="sparc-enrich-subtitle">
        Add OSCAL metadata, observations, findings, and risks to uplift this SAR for OSCAL-compliant export.
      </p>
    </div>
    <%= link_to "Back to SAR", sar_document_path(@sar_document), class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-flex-shrink-0" %>
  </div>

  <%= form_with model: @sar_document, url: update_enrich_sar_document_path(@sar_document), method: :patch, local: true, html: { data: { controller: "sar-enrich" } } do |f| %>

    <%# ── Assessment Metadata ── %>
    <details open class="sparc-enrich-section sparc-enrich-section--tight">
      <summary class="sparc-enrich-section-header sparc-enrich-section-header--alt">
        Assessment Metadata
      </summary>
      <div class="sparc-p-1r-125r">
        <div class="sparc-field-grid-2-roomy">
          <div class="form-group sparc-field-grid-span-only">
            <%= f.label :description, "Description" %>
            <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "Assessment description..." %>
          </div>
          <div class="form-group">
            <%= f.label :import_ap_href, "Import AP Reference (href)" %>
            <%= f.text_field :import_ap_href, class: "form-control", placeholder: "e.g., #assessment-plan-uuid or path/to/ap.json" %>
          </div>
          <div class="form-group">
            <%= f.label :oscal_version, "OSCAL Version" %>
            <%= f.text_field :oscal_version, class: "form-control", placeholder: "e.g., 1.1.2", value: @sar_document.oscal_version || "1.1.2" %>
          </div>
          <div class="form-group">
            <%= f.label :assessment_start, "Assessment Start Date" %>
            <%= f.datetime_local_field :assessment_start, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :assessment_end, "Assessment End Date" %>
            <%= f.datetime_local_field :assessment_end, class: "form-control" %>
          </div>
        </div>
      </div>
    </details>

    <%# ── Results ── %>
    <details class="sparc-enrich-section sparc-enrich-section--tight">
      <summary class="sparc-enrich-section-header sparc-enrich-section-header--alt">
        Assessment Results (<%= @results.count %>)
      </summary>
      <div class="sparc-p-1r-125r" id="results-container" data-sar-enrich-target="resultsContainer">
        <% if @results.empty? %>
          <p class="sparc-enrich-section-hint">
            No OSCAL results yet. Add a result to organize observations, findings, and risks.
          </p>
        <% end %>
        <% @results.each_with_index do |result, idx| %>
          <div class="result-entry sparc-enrich-item-card">
            <input type="hidden" name="sar_document[results][][id]" value="<%= result.id %>">
            <div class="sparc-field-grid-2">
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-result-<%= idx %>-title">Title</label>
                <input type="text" id="sar-result-<%= idx %>-title" name="sar_document[results][][title]" value="<%= result.title %>" class="form-control sparc-fs-085" aria-label="Result Title">
              </div>
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-result-<%= idx %>-description">Description</label>
                <input type="text" id="sar-result-<%= idx %>-description" name="sar_document[results][][description]" value="<%= result.description %>" class="form-control sparc-fs-085" aria-label="Result Description">
              </div>
              <div class="form-group sparc-mb-0">
                <label class="sparc-fs-075" for="sar-result-<%= idx %>-start-time">Start Time</label>
                <input type="datetime-local" id="sar-result-<%= idx %>-start-time" name="sar_document[results][][start_time]" value="<%= result.start_time&.strftime('%Y-%m-%dT%H:%M') %>" class="form-control sparc-fs-085" required aria-label="Result Start Time">
              </div>
              <div class="form-group sparc-mb-0">
                <label class="sparc-fs-075" for="sar-result-<%= idx %>-end-time">End Time</label>
                <input type="datetime-local" id="sar-result-<%= idx %>-end-time" name="sar_document[results][][end_time]" value="<%= result.end_time&.strftime('%Y-%m-%dT%H:%M') %>" class="form-control sparc-fs-085" aria-label="Result End Time">
              </div>
            </div>
            <div class="sparc-enrich-field-hint">
              <%= result.sar_observations.count %> observations &bull;
              <%= result.sar_findings.count %> findings &bull;
              <%= result.sar_risks.count %> risks
            </div>
          </div>
        <% end %>
        <template data-sar-enrich-target="resultTemplate">
          <div class="result-entry sparc-enrich-item-card">
            <div class="sparc-field-grid-2">
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Title</span>
                <input type="text" name="sar_document[results][][title]" class="form-control sparc-fs-085" placeholder="Assessment Result" aria-label="Result Title">
              </div>
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Description</span>
                <input type="text" name="sar_document[results][][description]" class="form-control sparc-fs-085" placeholder="Description" aria-label="Result Description">
              </div>
              <div class="form-group sparc-mb-0">
                <span class="sparc-enrich-grid-label">Start Time</span>
                <input type="datetime-local" name="sar_document[results][][start_time]" class="form-control sparc-fs-085" required aria-label="Result Start Time">
              </div>
              <div class="form-group sparc-mb-0">
                <span class="sparc-enrich-grid-label">End Time</span>
                <input type="datetime-local" name="sar_document[results][][end_time]" class="form-control sparc-fs-085" aria-label="Result End Time">
              </div>
            </div>
          </div>
        </template>
        <button type="button" data-action="sar-enrich#addResult" class="sparc-action sparc-action--positive sparc-action--solid sparc-enrich-item-action">
          + Add Result
        </button>
      </div>
    </details>

    <%# ── Observations ── %>
    <details class="sparc-enrich-section sparc-enrich-section--tight">
      <summary class="sparc-enrich-section-header sparc-enrich-section-header--alt">
        Observations (<%= @observations.count %>)
      </summary>
      <div class="sparc-p-1r-125r" id="observations-container" data-sar-enrich-target="observationsContainer">
        <% @observations.each_with_index do |obs, idx| %>
          <div class="observation-entry sparc-enrich-item-card">
            <input type="hidden" name="sar_document[observations][][id]" value="<%= obs.id %>">
            <input type="hidden" name="sar_document[observations][][sar_result_id]" value="<%= obs.sar_result_id %>">
            <div class="sparc-field-grid-2">
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-observation-<%= idx %>-title">Title</label>
                <input type="text" id="sar-observation-<%= idx %>-title" name="sar_document[observations][][title]" value="<%= obs.title %>" class="form-control sparc-fs-085" aria-label="Observation Title">
              </div>
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-observation-<%= idx %>-collected">Collected</label>
                <input type="datetime-local" id="sar-observation-<%= idx %>-collected" name="sar_document[observations][][collected]" value="<%= obs.collected&.strftime('%Y-%m-%dT%H:%M') %>" class="form-control sparc-fs-085" aria-label="Observation Collected">
              </div>
              <div class="form-group sparc-field-grid-span">
                <label class="sparc-fs-075" for="sar-observation-<%= idx %>-description">Description</label>
                <input type="text" id="sar-observation-<%= idx %>-description" name="sar_document[observations][][description]" value="<%= obs.description %>" class="form-control sparc-fs-085" aria-label="Observation Description">
              </div>
            </div>
          </div>
        <% end %>
        <template data-sar-enrich-target="observationTemplate">
          <div class="observation-entry sparc-enrich-item-card">
            <div class="sparc-field-grid-2">
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Title</span>
                <input type="text" name="sar_document[observations][][title]" class="form-control sparc-fs-085" placeholder="Observation title" aria-label="Observation Title">
              </div>
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Collected</span>
                <input type="datetime-local" name="sar_document[observations][][collected]" class="form-control sparc-fs-085" aria-label="Observation Collected">
              </div>
              <div class="form-group sparc-field-grid-span">
                <span class="sparc-enrich-grid-label">Description</span>
                <input type="text" name="sar_document[observations][][description]" class="form-control sparc-fs-085" placeholder="What was observed" aria-label="Observation Description">
              </div>
            </div>
          </div>
        </template>
        <button type="button" data-action="sar-enrich#addObservation" class="sparc-action sparc-action--positive sparc-action--solid sparc-enrich-item-action">
          + Add Observation
        </button>
      </div>
    </details>

    <%# ── Findings ── %>
    <details class="sparc-enrich-section sparc-enrich-section--tight">
      <summary class="sparc-enrich-section-header sparc-enrich-section-header--alt">
        Findings (<%= @findings.count %>)
      </summary>
      <div class="sparc-p-1r-125r" id="findings-container" data-sar-enrich-target="findingsContainer">
        <% @findings.each_with_index do |finding, idx| %>
          <div class="finding-entry sparc-enrich-item-card">
            <input type="hidden" name="sar_document[findings][][id]" value="<%= finding.id %>">
            <input type="hidden" name="sar_document[findings][][sar_result_id]" value="<%= finding.sar_result_id %>">
            <% if finding.ssp_control_statement_id.present? %>
              <% linked_stmt = finding.ssp_control_statement %>
              <div class="sparc-enrich-field-caption">
                <span class="badge sparc-enrich-ref-chip">
                  Linked SSP Statement: <code class="sparc-code-plain"><%= linked_stmt.label.presence || linked_stmt.statement_id %></code>
                </span>
              </div>
            <% end %>
            <div class="sparc-field-grid-2">
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-finding-<%= idx %>-title">Title</label>
                <input type="text" id="sar-finding-<%= idx %>-title" name="sar_document[findings][][title]" value="<%= finding.title %>" class="form-control sparc-fs-085" aria-label="Finding Title">
              </div>
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-finding-<%= idx %>-target-control-id">Target Control ID</label>
                <input type="text" id="sar-finding-<%= idx %>-target-control-id" name="sar_document[findings][][target_control_id]" value="<%= finding.target_data&.dig('target-id') %>" class="form-control sparc-fs-085" placeholder="e.g., ac-2" aria-label="Finding Target Control ID">
              </div>
              <div class="form-group sparc-mb-0">
                <label class="sparc-fs-075" for="sar-finding-<%= idx %>-status">Status</label>
                <select id="sar-finding-<%= idx %>-status" name="sar_document[findings][][target_status]" class="form-control sparc-fs-085" aria-label="Finding Status">
                  <option value="satisfied" <%= 'selected' if finding.target_data&.dig('status', 'state') == 'satisfied' %>>Satisfied</option>
                  <option value="not-satisfied" <%= 'selected' if finding.target_data&.dig('status', 'state') == 'not-satisfied' %>>Not Satisfied</option>
                </select>
              </div>
              <div class="form-group sparc-mb-0">
                <label class="sparc-fs-075" for="sar-finding-<%= idx %>-description">Description</label>
                <input type="text" id="sar-finding-<%= idx %>-description" name="sar_document[findings][][description]" value="<%= finding.description %>" class="form-control sparc-fs-085" aria-label="Finding Description">
              </div>
            </div>
          </div>
        <% end %>
        <template data-sar-enrich-target="findingTemplate">
          <div class="finding-entry sparc-enrich-item-card">
            <div class="sparc-field-grid-2">
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Title</span>
                <input type="text" name="sar_document[findings][][title]" class="form-control sparc-fs-085" placeholder="Finding title" aria-label="Finding Title">
              </div>
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Target Control ID</span>
                <input type="text" name="sar_document[findings][][target_control_id]" class="form-control sparc-fs-085" placeholder="e.g., ac-2" aria-label="Finding Target Control ID">
              </div>
              <div class="form-group sparc-mb-0">
                <span class="sparc-enrich-grid-label">Status</span>
                <select name="sar_document[findings][][target_status]" class="form-control sparc-fs-085" aria-label="Finding Status">
                  <option value="satisfied">Satisfied</option>
                  <option value="not-satisfied" selected>Not Satisfied</option>
                </select>
              </div>
              <div class="form-group sparc-mb-0">
                <span class="sparc-enrich-grid-label">Description</span>
                <input type="text" name="sar_document[findings][][description]" class="form-control sparc-fs-085" placeholder="Finding description" aria-label="Finding Description">
              </div>
            </div>
          </div>
        </template>
        <button type="button" data-action="sar-enrich#addFinding" class="sparc-action sparc-action--positive sparc-action--solid sparc-enrich-item-action">
          + Add Finding
        </button>
      </div>
    </details>

    <%# ── Risks ── %>
    <details class="sparc-enrich-section sparc-enrich-section--tight">
      <summary class="sparc-enrich-section-header sparc-enrich-section-header--alt">
        Risks (<%= @risks.count %>)
      </summary>
      <div class="sparc-p-1r-125r" id="risks-container" data-sar-enrich-target="risksContainer">
        <% @risks.each_with_index do |risk, idx| %>
          <div class="risk-entry sparc-enrich-item-card">
            <input type="hidden" name="sar_document[risks][][id]" value="<%= risk.id %>">
            <input type="hidden" name="sar_document[risks][][sar_result_id]" value="<%= risk.sar_result_id %>">
            <div class="sparc-field-grid-2">
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-risk-<%= idx %>-title">Title</label>
                <input type="text" id="sar-risk-<%= idx %>-title" name="sar_document[risks][][title]" value="<%= risk.title %>" class="form-control sparc-fs-085" aria-label="Risk Title">
              </div>
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-risk-<%= idx %>-status">Status</label>
                <select id="sar-risk-<%= idx %>-status" name="sar_document[risks][][status]" class="form-control sparc-fs-085" aria-label="Risk Status">
                  <% SarRisk::STATUSES.each do |s| %>
                    <option value="<%= s %>" <%= 'selected' if risk.status == s %>><%= s.titleize %></option>
                  <% end %>
                </select>
              </div>
              <div class="form-group sparc-field-grid-span">
                <label class="sparc-fs-075" for="sar-risk-<%= idx %>-description">Description</label>
                <input type="text" id="sar-risk-<%= idx %>-description" name="sar_document[risks][][description]" value="<%= risk.description %>" class="form-control sparc-fs-085" aria-label="Risk Description">
              </div>
              <%# #1090 — OSCAL requires a statement on a risk, and the rating is what
                  an assessor actually reads. Neither could be entered here before: the
                  form offered title, description and status only, so `impact` and
                  `likelihood` sat blank on every SAR risk in the estate. %>
              <div class="form-group sparc-field-grid-span">
                <label class="sparc-fs-075" for="sar-risk-<%= idx %>-statement">Statement</label>
                <input type="text" id="sar-risk-<%= idx %>-statement" name="sar_document[risks][][statement]" value="<%= risk.statement %>" class="form-control sparc-fs-085" aria-label="Risk Statement" placeholder="What could happen, and to what">
              </div>
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-risk-<%= idx %>-impact">Impact</label>
                <select id="sar-risk-<%= idx %>-impact" name="sar_document[risks][][impact]" class="form-control sparc-fs-085" aria-label="Risk Impact">
                  <option value="">&mdash; Select &mdash;</option>
                  <% RiskRating::LEVEL_OPTIONS.each do |level_label, level_value| %>
                    <option value="<%= level_value %>" <%= 'selected' if risk.impact == level_value %>><%= level_label %></option>
                  <% end %>
                </select>
              </div>
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="sar-risk-<%= idx %>-likelihood">Likelihood</label>
                <select id="sar-risk-<%= idx %>-likelihood" name="sar_document[risks][][likelihood]" class="form-control sparc-fs-085" aria-label="Risk Likelihood">
                  <option value="">&mdash; Select &mdash;</option>
                  <% RiskRating::LEVEL_OPTIONS.each do |level_label, level_value| %>
                    <option value="<%= level_value %>" <%= 'selected' if risk.likelihood == level_value %>><%= level_label %></option>
                  <% end %>
                </select>
              </div>
            </div>
            <%= render "shared/risk_oscal_collections",
                  param_base: "sar_document[risks][]", risk: risk %>
          </div>
        <% end %>
        <template data-sar-enrich-target="riskTemplate">
          <div class="risk-entry sparc-enrich-item-card">
            <div class="sparc-field-grid-2">
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Title</span>
                <input type="text" name="sar_document[risks][][title]" class="form-control sparc-fs-085" placeholder="Risk title" aria-label="Risk Title">
              </div>
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Status</span>
                <select name="sar_document[risks][][status]" class="form-control sparc-fs-085" aria-label="Risk Status">
                  <option value="open" selected>Open</option>
                  <option value="investigating">Investigating</option>
                  <option value="remediating">Remediating</option>
                  <option value="deviation-requested">Deviation Requested</option>
                  <option value="deviation-approved">Deviation Approved</option>
                  <option value="closed">Closed</option>
                </select>
              </div>
              <div class="form-group sparc-field-grid-span">
                <span class="sparc-enrich-grid-label">Description</span>
                <input type="text" name="sar_document[risks][][description]" class="form-control sparc-fs-085" placeholder="Risk description" aria-label="Risk Description">
              </div>
            </div>
            <%= render "shared/risk_oscal_collections",
                  param_base: "sar_document[risks][]", risk: nil %>
          </div>
        </template>
        <button type="button" data-action="sar-enrich#addRisk" class="sparc-action sparc-action--positive sparc-action--solid sparc-enrich-item-action">
          + Add Risk
        </button>
      </div>
    </details>

    <%# ── Auto-generate OSCAL entities from imported controls ── %>
    <% if @sar_document.sar_controls.any? && @results.empty? %>
      <div class="sparc-enrich-notice sparc-enrich-notice--tight">
        <div class="sparc-enrich-notice-body">
          <span class="sparc-enrich-notice-icon">&#x2728;</span>
          <div class="sparc-flex-1">
            <div class="sparc-enrich-notice-title">Auto-generate OSCAL entities from imported controls</div>
            <div class="sparc-enrich-notice-detail">
              Create a result with observations and findings from your <%= @sar_document.sar_controls.count %> imported controls.
              Pass results become "satisfied" findings, Failed become "not-satisfied".
            </div>
          </div>
          <label class="sparc-enrich-inline-check">
            <input type="checkbox" name="sar_document[auto_generate]" value="1">
            Auto-generate on save
          </label>
        </div>
      </div>
    <% end %>

    <%# ── Submit ── %>
    <div class="sparc-enrich-actions">
      <%= f.submit "Save Enrichment Data", class: "sparc-action sparc-action--primary sparc-action--solid" %>
      <%= link_to "Cancel", sar_document_path(@sar_document), class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>

  <% end %>
</div>
