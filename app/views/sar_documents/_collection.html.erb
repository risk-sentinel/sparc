<%# #948 — how a SET of sar documents renders, extracted so the flat list and each
    boundary tier draw from one definition rather than a second copy that can
    drift.

    Locals:
      records       — the documents to draw (a page, or one tier's slice)
      view_mode     — :card or :list

    No boundary column here, unlike evidences/_collection. These types are
    per-system by definition, so the column would be either redundant (inside a
    tier, where the heading already names the system) or constant (untiered,
    which by definition means at most one boundary is in view). Evidence is
    different: it is the high-volume artefact gathered across systems, and #948
    asked for the column there specifically.
%>

<% if view_mode == :card %>
    <div class="sparc-card-grid">
      <% records.each do |doc| %>
        <%= render "shared/item_card", **document_card_slots(
              doc, count: doc.sar_controls.count, count_label: "controls",
              version: doc.sar_version, enriched: doc.enriched?).merge(
              url: sar_document_path(doc),
              badges: (document_card_badges(doc, enriched: doc.enriched?) + [ creation_method_badge(doc) ]).compact,
              actions: render("sar_documents/item_actions", doc: doc, compact: true)) %>
      <% end %>
    </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr>
          <th class="sparc-ws-nowrap">Name</th>
          <th class="sparc-ws-nowrap">Source</th>
          <th class="sparc-ws-nowrap">Version</th>
          <th class="sparc-ws-nowrap">Status</th>
          <th class="sparc-ws-nowrap">OSCAL</th>
          <th class="sparc-ws-nowrap">Controls</th>
          <th class="sparc-ws-nowrap">Created</th>
          <th class="sparc-ws-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% records.each do |doc| %>
          <tr>
            <td><strong><%= link_to doc.name, sar_document_path(doc), class: "text-primary sparc-td-none" %></strong></td>
            <td>
              <%# #946 — one mapping, in the helper. A second copy here rendered
                  "Import" with spreadsheet styling for profile- and SSP-generated
                  documents, and for any with no recorded origin at all. %>
              <% badge = creation_method_badge(doc) %>
              <% if badge %>
                <span class="<%= badge[:class] %>"><%= badge[:text] %></span>
              <% else %>
                <span class="text-body-tertiary">&mdash;</span>
              <% end %>
            </td>
            <td class="text-body-secondary sparc-fs-085"><%= doc.sar_version.presence || "\u2014" %></td>
            <td class="sparc-ws-nowrap">
              <% if doc.processing? || doc.pending? || doc.failed? %>
                <span class="<%= doc.completed? ? 'badge-ok' : doc.failed? ? 'badge-fail' : 'badge-warn' %> rounded fw-semibold sparc-p-02-06 sparc-fs-085">
                  <%= doc.status %>
                </span>
                <% if doc.processing? && doc.metadata_extra&.dig("processing_message").present? %>
                  <br><span class="text-body-secondary sparc-fs-072 sparc-ws-normal"><%= doc.metadata_extra["processing_message"] %></span>
                <% end %>
              <% else %>
                <span class="<%= doc.lifecycle_badge_class %> rounded fw-semibold sparc-p-02-06 sparc-fs-085">
                  <%= doc.lifecycle_label %>
                </span>
              <% end %>
            </td>
            <td>
              <% if doc.enriched? %>
                <span class="sparc-oscal-enriched">Enriched</span>
              <% else %>
                <span class="sparc-oscal-basic">Basic</span>
              <% end %>
            </td>
            <td><%= doc.sar_controls.count %></td>
            <td class="sparc-ws-nowrap"><%= doc.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <%= render "sar_documents/item_actions", doc: doc %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
