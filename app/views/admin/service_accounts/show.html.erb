<div class="container-fluid py-4">
  <%# #1346 — the shared page header, as every other Settings screen. #1180: the
      UUID sits in the same place on every screen that has one. %>
  <% actions = [ { label: "Edit", look: "primary outline", path: edit_admin_service_account_path(@service_account) } ] %>
  <% if @service_account.disabled? %>
    <% actions << { label: "Enable", look: "positive solid", path: enable_admin_service_account_path(@service_account), method: :patch } %>
  <% else %>
    <% actions << { label: "Disable", look: "danger outline", path: disable_admin_service_account_path(@service_account), method: :patch,
                    confirm: "Disable this service account? It will no longer be able to authenticate." } %>
  <% end %>
  <% actions << { label: "Delete", look: "danger outline", path: admin_service_account_path(@service_account), method: :delete,
                  confirm: "Permanently deactivate this service account?" } %>
  <% actions << { label: "Back", look: "neutral ghost", path: admin_service_accounts_path } %>
  <%= render "shared/page_header", title: @service_account.display_label,
        meta: [ @service_account.email,
                render("shared/uuid_badge", uuid: @service_account.uuid, label: "UUID", name: "service account UUID") ],
        secondary: actions %>

  <%# Show-once token display %>
  <% if flash[:api_token] %>
    <div class="alert alert-warning">
      <h5><i class="bi bi-key"></i> API Token (shown once)</h5>
      <code class="user-select-all d-block p-2 bg-dark text-light rounded" style="word-break: break-all;"><%= flash[:api_token] %></code>
      <small class="text-muted mt-2 d-block"><%= ApiToken::COPY_NOW_WARNING %></small>
    </div>
  <% end %>

  <%# #1338 — the cards stack: Account Details is a compact strip, and API
      Tokens and Recent Activity each take the full width. %>
  <div class="card sparc-card">
    <div class="card-header"><h5 class="mb-0">Account Details</h5></div>
    <div class="card-body">
      <dl class="sparc-detail-strip mb-0">
        <div>
          <dt>Status</dt>
          <dd>
            <% if @service_account.disabled? %>
              <span class="badge bg-danger">Disabled</span>
              <small class="text-muted ms-2">(<%= @service_account.disabled_reason %>)</small>
            <% elsif @service_account.active? %>
              <span class="badge bg-success">Active</span>
            <% else %>
              <span class="badge bg-warning"><%= @service_account.status.titleize %></span>
            <% end %>
          </dd>
        </div>
        <div><dt>Owner</dt><dd><%= @service_account.owner&.display_label || "—" %></dd></div>
        <div><dt>Created</dt><dd><%= @service_account.created_at.strftime("%Y-%m-%d %H:%M UTC") %></dd></div>
        <% if @service_account.disabled_at %>
          <div><dt>Disabled At</dt><dd><%= @service_account.disabled_at.strftime("%Y-%m-%d %H:%M UTC") %></dd></div>
        <% end %>
      </dl>
    </div>
  </div>

  <%# API Tokens %>
  <div class="card sparc-card mt-4">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
      <h5 class="mb-0">API Tokens</h5>
      <%= button_to "Regenerate Token", regenerate_token_admin_service_account_path(@service_account),
            method: :post, class: "sparc-action sparc-action--caution sparc-action--solid sparc-action--sm",
            data: { turbo_confirm: "Regenerate token? Every current token is revoked at once. The new token keeps the newest token's endpoint and CIDR limits and lifetime." } %>
    </div>
    <div class="card-body">
      <% if @tokens.any?(&:never_expires?) %>
        <%# Rendered with the page, not updated live, so no live-region role. %>
        <div class="alert alert-warning small">
          This account holds a token that never expires, issued before service-account tokens
          had to. Renew it to replace it with one that expires
          (<%= ApiToken::DEFAULT_SERVICE_ACCOUNT_DAYS %> days) and keeps its limits.
        </div>
      <% end %>
      <%= render "admin/api_tokens/token_list", owner: @service_account, tokens: @tokens,
                 empty_text: "No tokens generated." %>
    </div>
  </div>

  <%# Recent Audit Events %>
  <div class="card sparc-card mt-4">
    <div class="card-header"><h5 class="mb-0">Recent Activity</h5></div>
    <div class="card-body">
      <% if @audit_events.any? %>
        <table class="table table-sm mb-0">
          <thead><tr><th>Action</th><th>By</th><th>Details</th><th>When</th></tr></thead>
          <tbody>
            <% @audit_events.each do |event| %>
              <tr>
                <td><code><%= event.action %></code></td>
                <td><%= event.user&.display_label || "System" %></td>
                <td><small class="text-muted"><%= event.metadata&.to_json&.truncate(80) %></small></td>
                <td><%= event.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted mb-0">No activity recorded.</p>
      <% end %>
    </div>
  </div>
</div>
