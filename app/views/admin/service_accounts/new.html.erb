<div class="container-fluid py-4">
  <h2>New Service Account</h2>
  <p class="text-muted">Create an API-only account for pipelines, CI/CD, or integrations.</p>

  <%= form_with(model: @service_account, url: admin_service_accounts_path, class: "mt-4") do |f| %>
    <% if @service_account.errors.any? %>
      <div class="alert alert-danger">
        <h6>Please fix the following errors:</h6>
        <ul class="mb-0">
          <% @service_account.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row g-4">
      <%# Left column: Account Details %>
      <div class="col-lg-6">
        <div class="card sparc-card h-100">
          <div class="card-header"><h5 class="mb-0">Account Details</h5></div>
          <div class="card-body">
            <div class="mb-3">
              <%= f.label :display_name, "Name", class: "form-label" %>
              <%= f.text_field :display_name, class: "form-control", placeholder: "e.g., sparc-iac-pipeline", required: true %>
              <div class="form-text">Descriptive name for this service account.</div>
            </div>

            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control", placeholder: "e.g., sparc-iac@service.local", required: true %>
              <div class="form-text">Contact address for this account. It does not identify the account and need not be unique, so a team mailbox can own several.</div>
            </div>

            <div class="mb-3">
              <%= f.label :owner_id, "Owner", class: "form-label" %>
              <%= f.select :owner_id, @human_users.map { |u| [u.display_label, u.id] },
                  { prompt: "Select owner..." }, class: "form-select", required: true %>
              <div class="form-text">Human user accountable for this service account.</div>
            </div>

            <%# Issue #536 — opt-in admin flag for SAs that drive admin-scope automation %>
            <div class="mb-3 form-check">
              <%= f.check_box :admin, class: "form-check-input" %>
              <%= f.label :admin, "Grant admin privileges", class: "form-check-label" %>
              <div class="form-text">
                Only enable for SAs that genuinely need full admin access (e.g.,
                provisioning pipelines, instance-wide automation). Per NIST AC-6,
                prefer scoped roles + endpoint allowlists where possible.
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Right column: Token Settings %>
      <div class="col-lg-6">
        <div class="card sparc-card h-100">
          <div class="card-header"><h5 class="mb-0">Token Settings</h5></div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label" for="expires_in_days">Token Expiry</label>
              <%= select_tag :expires_in_days,
                    options_for_select(token_expiry_options(service_account: true),
                                       params[:expires_in_days].presence&.to_i || ApiToken::DEFAULT_SERVICE_ACCOUNT_DAYS),
                    class: "form-select" %>
              <div class="form-text">
                A service account's token must expire, at most <%= SparcConfig.api_token_max_days %> days out.
                Renew it from the account page before then; the old token keeps working for
                <%= SparcConfig.api_token_renewal_grace_days %> days after a renewal.
              </div>
            </div>

            <%= render "admin/api_tokens/endpoint_picker", field: "allowed_endpoints",
                       selected: @selected_endpoints, id: "sa_endpoints" %>

            <div class="mb-3">
              <label class="form-label" for="allowed_cidrs">Allowed CIDRs <small class="text-muted">(optional)</small></label>
              <textarea name="allowed_cidrs" id="allowed_cidrs" class="form-control" rows="3"
                        placeholder="10.0.0.0/8&#10;192.168.1.0/24"></textarea>
              <div class="form-text">One CIDR per line. Leave empty to allow any IP.</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-4">
      <%= f.submit "Create Service Account & Generate Token", class: "sparc-action sparc-action--positive sparc-action--solid" %>
      <%= link_to "Cancel", admin_service_accounts_path, class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
    </div>
  <% end %>
</div>
