<div class="container-fluid py-4">
  <%# 1.18.0-rf #1303 — the shared header and toolbar. %>
    <%= render "admin/list_header", title: "Service accounts", label: "service accounts", count: @pagy.count,
          subtitle: "API-only accounts for pipelines, CI/CD, and integrations",
          primary: { label: "New service account", look: "positive solid", path: new_admin_service_account_path },
          status_tabs: @status_tabs, placeholder: "Search by name or email…" %>

  <div class="card sparc-list-card sparc-card">
    <div class="table-responsive">
      <table class="table table table-hover mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Owner</th>
            <th>Status</th>
            <th>Token Status</th>
            <th>Last Used</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @service_accounts.each do |sa| %>
            <tr>
              <td>
                <%= link_to sa.display_label, admin_service_account_path(sa), class: "text-decoration-none" %>
                <br><small class="text-muted"><%= sa.email %></small>
              </td>
              <td><%= sa.owner&.display_label || "—" %></td>
              <td>
                <% if sa.disabled? %>
                  <span class="badge bg-danger">Disabled</span>
                <% elsif sa.active? %>
                  <span class="badge bg-success">Active</span>
                <% else %>
                  <span class="badge bg-warning"><%= sa.status.titleize %></span>
                <% end %>
              </td>
              <td>
                <% active_token = sa.api_tokens.active.first %>
                <% if active_token %>
                  <span class="badge bg-success">Active</span>
                  <% if active_token.expires_at %>
                    <br><small class="text-muted">Expires <%= distance_of_time_in_words_to_now(active_token.expires_at) %></small>
                  <% end %>
                <% else %>
                  <span class="badge bg-secondary">No active token</span>
                <% end %>
              </td>
              <td>
                <% last_token = sa.api_tokens.order(last_used_at: :desc).first %>
                <% if last_token&.last_used_at %>
                  <%= time_ago_in_words(last_token.last_used_at) %> ago
                <% else %>
                  Never
                <% end %>
              </td>
              <td>
                <%= link_to "View", admin_service_account_path(sa), class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm" %>
              </td>
            </tr>
          <% end %>
          <% if @service_accounts.empty? %>
            <tr><td colspan="6" class="text-center text-muted py-4">No service accounts found.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%# 1.18.0-rf #1303 — paginated, like the other admin lists. %>
  <%= render "shared/collection_pagination", pagy: @pagy, label: "service accounts" %>
</div>
