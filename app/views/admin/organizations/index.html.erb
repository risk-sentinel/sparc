<%# 1.18.0-rf #1303 — the shared header and toolbar. %>
  <%= render "admin/list_header", title: "Organizations", label: "organizations", count: @pagy.count,
        primary: { label: "New organization", look: "positive solid", path: new_admin_organization_path },
        status_tabs: @status_tabs, placeholder: "Search by name, contact, or email…" %>

<div class="card sparc-list-card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>Name</th>
          <th>Contact</th>
          <th>Members</th>
          <th>Auth Boundaries</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @organizations.each do |org| %>
          <tr>
            <td class="fw-semibold sparc-cell-break"><%= org.name %></td>
            <%# #1349 — the person over the email, and the email breaks after its "@"
                (or anywhere, when one part alone is too long), so a long contact
                cannot push the table past the settings menu. %>
            <td class="small text-body-secondary sparc-cell-email">
              <% if org.contact_person.present? || org.contact_email.present? %>
                <% if org.contact_person.present? %><div><%= org.contact_person %></div><% end %>
                <% if org.contact_email.present? %><div class="sparc-cell-break"><%= collection_email(org.contact_email) %></div><% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td><%= org.organization_memberships.count %></td>
            <td><%= org.authorization_boundaries.count %></td>
            <td>
              <% if org.active? %>
                <span class="badge text-bg-success">Active</span>
              <% else %>
                <span class="badge text-bg-secondary">Inactive</span>
              <% end %>
            </td>
            <td class="text-end">
              <%= link_to "Manage", admin_organization_path(org), class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm" %>
            </td>
          </tr>
        <% end %>
        <% if @organizations.empty? %>
          <tr><td colspan="6" class="text-center text-body-secondary small py-3">No organizations found.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# ── Pagination ──────────────────────────────────────── %>
  <%= render "shared/collection_pagination", pagy: @pagy, label: "organizations" %>
