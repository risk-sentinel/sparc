<div class="row justify-content-center my-4">
  <div class="col-lg-9">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 fw-bold mb-0">New Connection</h1>
      <%= link_to "Cancel", admin_exchange_connections_path, class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" %>
    </div>

    <div class="card">
      <div class="card-body p-4">
        <%= render "form", connection: @connection %>
      </div>
    </div>
  </div>
</div>
