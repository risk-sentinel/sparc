<%# 1.18.0-rf #1303 — the shared header and toolbar. %>
  <%= render "admin/list_header", title: "Users", label: "users", count: @pagy.count,
        primary: { label: "New user", look: "positive solid", path: new_admin_user_path },
        status_tabs: @status_tabs, placeholder: "Search by email or name…" %>

<div class="card sparc-list-card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>Email</th>
          <th>Name</th>
          <th>Status</th>
          <th>Roles</th>
          <th>Sign&#8209;ins</th>
          <th>Last&nbsp;active</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="sparc-cell-email"><%= collection_email(user.email) %></td>
            <td><%= user.display_label %></td>
            <td>
              <% case user.status %>
              <% when "active" %>
                <span class="badge text-bg-success">Active</span>
              <% when "suspended" %>
                <span class="badge text-bg-warning">Suspended</span>
              <% when "deactivated" %>
                <span class="badge text-bg-secondary">Deactivated</span>
              <% end %>
              <%# #1349 — the Admin badge sits with the status: one column fewer. %>
              <% if user.admin? %>
                <span class="badge text-bg-danger">Admin</span>
              <% end %>
            </td>
            <td>
              <% user.roles.each do |role| %>
                <span class="badge text-bg-info"><%= role.display_name %></span>
              <% end %>
            </td>
            <td><%= user.sign_in_count %></td>
            <td><%= user.last_sign_in_at ? collection_timestamp(user.last_sign_in_at) : "Never" %></td>
            <td>
              <%= link_to "View", admin_user_path(user), class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%# ── Pagination ──────────────────────────────────────── %>
  <%= render "shared/collection_pagination", pagy: @pagy, label: "users" %>
