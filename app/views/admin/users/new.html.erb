<div class="row justify-content-center my-4">
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 fw-bold mb-0">New User</h1>
      <%= link_to "Cancel", admin_users_path, class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm" %>
    </div>

    <p class="text-body-secondary small mb-4">
      Admin-initiated account creation. Self-service registration stays disabled;
      use this to provision accounts (e.g. local-login test users for DAST).
      Authorization-boundary roles are assigned after creation from the user's
      <strong>Edit</strong> page.
    </p>

    <div class="card">
      <div class="card-body p-4">
        <%= form_with model: @user, url: admin_users_path, method: :post, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :email, class: "form-label fw-semibold small" %>
            <%= f.email_field :email, class: "form-control", required: true, autocomplete: "off" %>
            <div class="form-text">The identity anchor — cannot be changed after creation.</div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <%= f.label :first_name, class: "form-label fw-semibold small" %>
              <%= f.text_field :first_name, class: "form-control" %>
            </div>
            <div class="col-md-6">
              <%= f.label :last_name, class: "form-label fw-semibold small" %>
              <%= f.text_field :last_name, class: "form-control" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :display_name, class: "form-label fw-semibold small" %>
            <%= f.text_field :display_name, class: "form-control" %>
          </div>

          <%# #877 — the admin no longer chooses the first credential. SPARC
              generates a temporary password on save and shows it once, and the
              user must replace it at first sign-in (IA-5). A password an admin
              picks is one the admin knows, and it used to survive indefinitely
              because nothing forced a change. %>
          <% if SparcConfig.enable_local_login? %>
            <div class="alert alert-info py-2 mb-3">
              <strong>A temporary password will be generated</strong> and shown once after you
              save. Give it to the user over a channel you trust — they must change it the first
              time they sign in.
            </div>
          <% else %>
            <div class="alert alert-secondary py-2 mb-3">
              Local login is disabled, so no password is issued. This user signs in through the
              configured identity provider.
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :status, "Initial status", class: "form-label fw-semibold small" %><%= field_help "Suspended and Deactivated both block sign-in; the difference is intent — Suspended is a reversible hold, Deactivated is the end state for someone who has left. Accounts are never deleted, so past attributions stay accurate." %>
            <%= f.select :status, options_for_select(%w[active suspended deactivated], @user.status || "active"),
                  {}, class: "form-select" %>
          </div>

          <div class="mb-3 form-check">
            <%= f.check_box :admin, class: "form-check-input" %>
            <%= f.label :admin, "Instance Admin", class: "form-check-label fw-semibold" %>
            <div class="form-text">Admins bypass all role checks and can manage users.</div>
          </div>

          <hr>
          <h5 class="fw-semibold mb-3">Instance Roles <span class="text-body-secondary fw-normal small">(optional)</span><%= field_help "Instance roles apply everywhere in SPARC. Access to a particular system is granted separately, on that boundary's roster — the same person can be an editor on one boundary and read-only on another." %></h5>

          <div class="row g-2 mb-4">
            <% @instance_roles.each do |role| %>
              <div class="col-md-6">
                <div class="form-check">
                  <input type="checkbox" name="user[role_ids][]" value="<%= role.id %>"
                         id="role_<%= role.id %>" class="form-check-input">
                  <label for="role_<%= role.id %>" class="form-check-label">
                    <strong><%= role.display_name %></strong>
                    <% if role.description.present? %>
                      <br><small class="text-body-secondary"><%= role.description %></small>
                    <% end %>
                  </label>
                </div>
              </div>
            <% end %>
          </div>

          <div class="d-grid">
            <%= f.submit "Create User", class: "sparc-action sparc-action--positive sparc-action--solid fw-semibold" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
