<div class="card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Review Queue</h2>
    <span class="text-body-secondary"><%= @total_pending %> awaiting your review</span>
  </div>

  <p class="text-body-secondary mb-4">
    Trust-store documents (Control Catalog, Profile, CDEF) submitted for review.
    Approving a document lets it be published; rejecting returns it to the author
    with your reason. You can only act on documents you did not submit (separation
    of duties).
  </p>

  <%= render "shared/collection_toolbar",
        label: "documents awaiting review", placeholder: "Search by name or submitter…",
        view_mode: (@pending.any? ? @view_mode : nil) %>

  <% if @pending.any? && @view_mode == :card %>
    <div class="sparc-card-grid">
      <% @pending.each do |doc| %>
        <% routes = review_queue_routes(doc) %>
        <%= render "shared/item_card",
              title: doc.name,
              url: routes[:show],
              badges: [ { text: routes[:label], class: "badge bg-secondary" } ],
              subtitle: "Submitted by #{doc.submitted_by_user&.email || '\u2014'}",
              description: doc.description,
              empty_note: baseline_review_summary(doc, @baseline_reviews),
              actions: render("review_queue/item_actions", doc: doc,
                              approve_path: routes[:approve], reject_path: routes[:reject]) %>
      <% end %>
    </div>
  <% elsif @pending.any? %>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Type</th>
          <th>Name</th>
          <th>Submitted by</th>
          <th>Details</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @pending.each do |doc| %>
          <%
            routes = review_queue_routes(doc)
            type_label = routes[:label]; show_path = routes[:show]
            approve_path = routes[:approve]; reject_path = routes[:reject]
          %>
          <tr>
            <td><span class="badge bg-secondary"><%= type_label %></span></td>
            <td><strong><%= link_to doc.name, show_path, class: "text-primary", style: "text-decoration: none;" %></strong></td>
            <td class="small text-body-secondary"><%= doc.submitted_by_user&.email || "—" %></td>
            <td class="small text-body-secondary">
              <% if doc.is_a?(ProfileDocument) && (br = @baseline_reviews[doc]) %>
                Baseline <%= br.level || "—" %>:
                <%= br.selected_count %>/<%= br.expected_count %> selected
                <% if br.missing.any? %><span class="text-danger" title="<%= br.missing.join(', ') %>">· <%= br.missing.size %> missing</span><% end %>
                <% if br.extra.any? %><span class="text-warning" title="<%= br.extra.join(', ') %>">· <%= br.extra.size %> extra</span><% end %>
                · ODP <%= br.odp_customized_count %>/<%= br.odp_total_count %> customized
              <% else %>
                &mdash;
              <% end %>
            </td>
            <td style="white-space: nowrap;">
              <%= render "review_queue/item_actions", doc: doc, approve_path: approve_path, reject_path: reject_path %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center p-4 text-body-secondary">Nothing awaiting your review.</p>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "documents awaiting review" %>
</div>
