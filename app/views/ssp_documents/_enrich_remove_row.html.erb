<%# #1340 — an added row (not yet saved) can be taken off the form again;
    before, a row added by mistake could only be cleared by reloading. %>
<div class="mt-2">
  <button type="button" data-action="ssp-enrich#removeRow" data-testid="enrich-remove-row"
          class="sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm">Remove row</button>
</div>
