<%= render "shared/section_summary", tiles: [
  [@total_count, "SSP Documents"],
  [@controls_count, "Total Controls"],
  [@completed_count, "Completed"]
] %>

<% if @ssp_documents.any? { |d| d.processing? || d.pending? } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="10000" hidden></div>
<% end %>

<div class="card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>System Security Plans</h2>
    <div class="d-flex gap-2">
      <%= link_to "Create New SSP", wizard_ssp_documents_path, class: "btn btn-primary", style: "padding: 0.5rem 1rem; font-size: 0.875rem;" %>
      <%= link_to "Upload File", new_ssp_document_path, class: "btn btn-success" %>
    </div>
  </div>

  <%= render "shared/collection_toolbar",
        label: "system security plans", placeholder: "Search SSPs…",
        view_mode: (@view_mode if @ssp_documents.any?) %>

  <% if @ssp_documents.any? && @view_mode == :card %>
    <div class="sparc-card-grid">
      <% @ssp_documents.each do |doc| %>
        <%= render "shared/item_card", **document_card_slots(
              doc, count: doc.ssp_controls.count, count_label: "controls",
              version: doc.ssp_version, enriched: doc.enriched?).merge(
              url: ssp_document_path(doc),
              badges: (document_card_badges(doc, enriched: doc.enriched?) + [ creation_method_badge(doc) ]).compact,
              actions: render("ssp_documents/item_actions", doc: doc, compact: true)) %>
      <% end %>
    </div>
  <% elsif @ssp_documents.any? %>
    <table class="table table-hover">
      <thead>
        <tr>
          <th style="white-space: nowrap;">Name</th>
          <th style="white-space: nowrap;">Source</th>
          <th style="white-space: nowrap;">Version</th>
          <th style="white-space: nowrap;">Status</th>
          <th style="white-space: nowrap;">OSCAL</th>
          <th style="white-space: nowrap;">Controls</th>
          <th style="white-space: nowrap;">Created</th>
          <th style="white-space: nowrap;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @ssp_documents.each do |doc| %>
          <tr>
            <td><strong><%= link_to doc.name, ssp_document_path(doc), class: "text-primary", style: "text-decoration: none;" %></strong></td>
            <td>
              <%# #946 — one mapping, in the helper. A second copy here rendered
                  "Import" with spreadsheet styling for profile- and SSP-generated
                  documents, and for any with no recorded origin at all. %>
              <% badge = creation_method_badge(doc) %>
              <% if badge %>
                <span class="<%= badge[:class] %>"><%= badge[:text] %></span>
              <% else %>
                <span class="text-body-tertiary">&mdash;</span>
              <% end %>
            </td>
            <td class="text-body-secondary" style="font-size: 0.85rem;"><%= doc.ssp_version.presence || "\u2014" %></td>
            <td style="white-space: nowrap;">
              <% if doc.processing? || doc.pending? || doc.failed? %>
                <span class="<%= doc.completed? ? 'badge-ok' : doc.failed? ? 'badge-fail' : 'badge-warn' %> rounded fw-semibold" style="padding: 0.2rem 0.6rem; font-size: 0.85rem;">
                  <%= doc.status %>
                </span>
                <% if doc.processing? && doc.metadata_extra&.dig("processing_message").present? %>
                  <br><span class="text-body-secondary" style="font-size: 0.72rem; white-space: normal;"><%= doc.metadata_extra["processing_message"] %></span>
                <% end %>
              <% else %>
                <span class="<%= doc.lifecycle_badge_class %> rounded fw-semibold" style="padding: 0.2rem 0.6rem; font-size: 0.85rem;">
                  <%= doc.lifecycle_label %>
                </span>
                <%# #627 — flag content-incomplete drafts (distinct from parse status). %>
                <% if !doc.published_lifecycle? && !doc.content_complete? %>
                  <span class="badge-warn rounded fw-semibold" style="padding: 0.2rem 0.6rem; font-size: 0.85rem;"
                        title="<%= doc.content_completeness_gaps.join('; ') %>">
                    Incomplete
                  </span>
                <% end %>
              <% end %>
            </td>
            <td>
              <% if doc.enriched? %>
                <span class="sparc-oscal-enriched">Enriched</span>
              <% else %>
                <span class="sparc-oscal-basic">Basic</span>
              <% end %>
            </td>
            <td><%= doc.ssp_controls.count %></td>
            <td style="white-space: nowrap;"><%= doc.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <div style="max-width: 280px;">
                <%= render "ssp_documents/item_actions", doc: doc %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center p-4 text-body-secondary">No System Security Plan documents found. Upload your first OSCAL file to get started.</p>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "system security plans" %>
</div>
