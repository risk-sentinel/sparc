<% summary = [
  [@total_count, "SSP Documents"],
  [@controls_count, "Total Controls"],
  # #1242 — what is left to write, in the responses each SSP's baseline requires.
  ["#{@responses_done} of #{@responses_required}", "Responses answered"],
  [@completed_count, "Completed"]
] %>

<% if @ssp_documents.any? { |d| d.processing? || d.pending? } %>
  <div data-controller="auto-refresh" data-auto-refresh-interval-value="10000" hidden></div>
<% end %>

<div class="card sparc-list-card">
  <%# 1.18.0-rf #1299/#1298 — the shared page header. %>
  <% header = nil %>
    <% header = capture do %><%= render "shared/page_header", summary: summary, title: "System Security Plans",
            primary: { label: "Create New SSP", look: "positive solid", path: wizard_ssp_documents_path },
            secondary: [ { label: "Upload File", look: "info solid", path: new_ssp_document_path } ] %><% end %>

  <%# 1.18.0-rf #1292 — the Boundary filter beside the list (BoundaryListFilter). %>
  <%= render layout: "shared/boundary_filter_layout", locals: { header: header } do %>
  <%= render "shared/collection_toolbar",
        label: "system security plans", placeholder: "Search SSPs…",
        status_tabs: @status_tabs, facets: @facets, clear_params: @clear_facets,
        view_mode: (@view_mode if @ssp_documents.any?) %>

  <% if @ssp_documents.any? && @tiering&.tiered? %>
    <%# #948 — tiering is AUTOMATIC, appearing only when more than one
        boundary is visible, so a single-system user never meets a tree
        with one branch. Card/list still applies inside each tier. %>
    <%= render "shared/collection_tiers",
          tiering: @tiering,
          records_partial: "ssp_documents/collection",
          records_local: :records,
          view_mode: @view_mode,
          screen: "ssp_documents" %>
  <% elsif @ssp_documents.any? %>
    <%= render "ssp_documents/collection", records: @ssp_documents, view_mode: @view_mode %>
  <% else %>
    <p class="text-center p-4 text-body-secondary">No System Security Plan documents found. Upload your first OSCAL file to get started.</p>
  <% end %>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "system security plans" %>
  <% end %>
</div>
