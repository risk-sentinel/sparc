<%# Per-control implementation statements for the SSP show page (#393, #1100).

    The READ view of a control's answers, item by item, under the control
    language they answer. #1312 — read-only: every item is answered in the
    control's Edit form (_part_responses), all its fields in one Save. Each row
    used to carry its own Edit too, a second place to enter the same answer.

    Locals:
      control      - SspControl instance (must have ssp_control_statements loaded)
      ssp_document - SspDocument instance (for routing)
      requirement  - ControlRequirementText::Text for the control, or nil: the
                     text each row answers, parameter values applied
      progress     - SspResponseProgress for the document, or nil (#1242): which
                     rows are required responses, and the state of each
      determinations - objective id => the SAR's latest determination, or {}
%>
<% requirement = local_assigns[:requirement] %>
<% progress = local_assigns[:progress] %>
<% determinations = local_assigns[:determinations] || {} %>
<% summary = progress&.items_for(control.control_id) %>
<%
  statements = control.ssp_control_statements.sort_by { |s| s.row_order || 0 }
  tally      = progress&.for_control(control.control_id)
  above      = progress ? progress.parent_level_statement_ids : Set.new
  done       = tally ? tally.done : statements.count { |s| s.implementation_prose.present? }
  needed     = tally ? tally.required : statements.size
%>

<% if statements.any? %>
  <div class="sparc-statement-block sparc-statement-block--info sparc-accent--blue sparc-mt-075">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 sparc-mb-04">
      <div class="sparc-statement-label sparc-heading-controls">
        Implementation Statements
        <span class="text-body-secondary sparc-fw-400 sparc-fs-07">
          (<%= pluralize(statements.size, "statement") %>)
        </span>
      </div>
      <%# How much of this control is actually answered. The table showed a
          statement count and nothing about completion, so a control with 22
          parts and one answer looked identical to one that was finished.
          #1242 — counted in required responses, not stored rows. %>
      <span class="sparc-status sparc-status--<%= done.zero? ? 'neutral' : done == needed ? 'success' : 'warning' %> sparc-fs-07"
            title="Required responses that are done: inherited, satisfied or written">
        <%= done %> of <%= needed %> done
      </span>
    </div>
    <% if summary %>
      <div class="sparc-fs-075 sparc-color-secondary sparc-mb-04" data-testid="control-item-summary"><%= summary %></div>
    <% end %>

    <div class="table-responsive">
      <table class="table table-sm table-hover sparc-fs-082 sparc-mb-0">
        <thead>
          <tr class="sparc-th-eyebrow-row">
            <th class="sparc-w-12pct">Statement</th>
            <th>Implementation</th>
            <th class="sparc-w-14pct">Status &amp; origination</th>
            <th class="sparc-w-14pct">Responsible Roles</th>
            <th class="sparc-w-6pct"></th>
          </tr>
        </thead>
        <tbody>
          <% statements.each do |stmt| %>
            <% depth = [ stmt.parent_statement_id.present? ? 1 : 0, 3 ].min %>
            <%# Stored OSCAL-shaped ({"role-id" => "isso"}), but older rows and
                imports may carry bare strings — read both, write the shape. %>
            <% role_ids = Array(stmt.responsible_roles_data)
                            .flat_map { |r| Array(r.is_a?(Hash) ? r["role-id"] : r) }.compact %>
            <tr id="stmt-<%= stmt.id %>" data-statement-id="<%= stmt.statement_id %>">
              <td>
                <code class="sparc-fs-078 sparc-stmt-d<%= depth %>">
                  <%= stmt.label.presence || stmt.statement_id %>
                </code>
                <%# #396 + #398: inheritance source badge %>
                <% case stmt.source_kind
                   when :cdef %>
                  <span class="badge badge-info sparc-fs-065" title="Implementation inherited from a CDEF">CDEF</span>
                <% when :leveraged %>
                  <span class="badge bg-primary sparc-fs-065" title="Inherited via a leveraged authorization">Leveraged</span>
                <% when :hybrid, :overridden_hybrid %>
                  <%# #1242 — NIST's hybrid control: the provider implements part
                      of it and hands the rest back to this system. %>
                  <span class="badge bg-primary sparc-fs-065" title="The leveraged system provides part of this; this system writes the rest">Hybrid</span>
                <% when :responsibility %>
                  <%# #956 — the leveraged system hands this back to us. It is
                      the opposite of an inherited implementation, and the one
                      the reader actually has to act on. %>
                  <span class="badge bg-danger sparc-fs-065" title="The leveraged system requires this system to implement the control itself">Your responsibility</span>
                <% when :overridden_responsibility %>
                  <span class="badge bg-success sparc-fs-065" title="A customer responsibility this system has implemented">Responsibility met</span>
                <% when :overridden_cdef, :overridden_leveraged %>
                  <span class="badge bg-warning text-dark sparc-fs-065" title="Inherited but edited locally">Overridden</span>
                <% end %>
              </td>
              <td class="sparc-stmt-d<%= depth %>">
                <%# What this row answers. Without it a row read "a." or "(b)"
                    and nothing else, and the author could not tell which
                    requirement the box was for. A container part with no
                    prose of its own (ac-1_smt) stands for the control as a whole. %>
                <% part_text = requirement&.for_part(stmt.statement_id) %>
                <div class="sparc-fs-078 sparc-color-body sparc-mb-025" data-statement-requirement>
                  <%= part_text.presence || content_tag(:span, "The control as a whole", class: "text-body-secondary") %>
                </div>
                <%# #1242 — the row's state, when the baseline requires a
                    response from it, and a note when its text sits above the
                    parts that need it. %>
                <% part = progress&.part_for_statement(stmt.id) %>
                <% if part %>
                  <span class="sparc-status sparc-status--<%= SspResponseProgress::OWED.include?(part.state) ? 'warning' : 'success' %> sparc-fs-065"
                        data-response-state="<%= part.state %>">
                    <%= SspResponseProgress::LABELS[part.state] %><%= " · CDEF text not reviewed" if part.cdef_unreviewed %>
                  </span>
                <% elsif above.include?(stmt.id) %>
                  <div class="sparc-fs-072 sparc-text-warning-bold" data-response-state="parent_level_text">
                    Written above its parts, so it answers none of them. Move each part's text into its row below.
                  </div>
                <% end %>
                <%# #1242 — on a hybrid control the provider's part is theirs,
                    shown read-only; the box below is this system's part. %>
                <% if (provider = stmt.hybrid_source) %>
                  <div class="sparc-stmt-note sparc-mt-025" data-testid="hybrid-provider-part">
                    <span class="fw-semibold">Provider's part (read-only):</span>
                    <%= provider.implementation_prose.presence || content_tag(:span, "(the provider wrote nothing)", class: "fst-italic") %>
                  </div>
                <% end %>
                <%# ── Read view ── %>
                <div>
                  <%= stmt.implementation_prose.presence ||
                      content_tag(:span, "(not answered)",
                                  class: "text-body-tertiary fst-italic") %>
                  <% if stmt.remarks.present? %>
                    <div class="text-body-secondary sparc-stmt-note">
                      <%= stmt.remarks %>
                    </div>
                  <% end %>
                </div>

                <%= render "ssp_documents/item_objectives",
                      objectives: requirement&.objectives_for(stmt.statement_id) || [], determinations: determinations %>
              </td>
              <td class="sparc-fs-075" data-item-status="<%= stmt.implementation_status %>">
                <% if stmt.implementation_status %>
                  <span class="sparc-status sparc-status--<%= ssp_item_status_variant(stmt.implementation_status) %> sparc-fs-065"><%= stmt.status_label %></span>
                <% end %>
                <% origination = stmt.effective_origination %>
                <% if origination.any? %>
                  <div class="text-body-secondary"><%= origination.map { SspControlStatement::ORIGINATION_LABELS[_1] }.join(" + ") %></div>
                <% end %>
                <% if stmt.expected_completion %>
                  <div class="text-body-secondary">Expected <%= stmt.expected_completion.iso8601 %></div>
                <% end %>
              </td>
              <td class="text-body-secondary sparc-fs-078">
                <%= role_ids.any? ? role_ids.join(", ") : "—" %>
              </td>
              <td>
                <% cdef_links = stmt.inheritance_links.select { _1.source_type == "CdefControlStatement" && !_1.overridden? } %>
                <% if cdef_links.any? && !cdef_links.all?(&:reviewed?) && stmt.implementation_prose.present? %>
                  <%= button_to "Mark reviewed",
                        mark_statement_reviewed_ssp_document_path(ssp_document, statement_id: stmt.id),
                        method: :post,
                        title: "The CDEF's text is true of this system; keep it as it is",
                        class: "sparc-action sparc-action--positive sparc-action--ghost sparc-action--sm sparc-fs-07 sparc-p-015-045",
                        form: { class: "sparc-d-inline" } %>
                <% elsif cdef_links.any? && cdef_links.all?(&:reviewed?) %>
                  <% reviewed = cdef_links.max_by(&:reviewed_at) %>
                  <div class="sparc-fs-065 text-body-secondary" data-testid="cdef-reviewed">
                    Reviewed <%= reviewed.reviewed_at.utc.strftime("%Y-%m-%d") %><%= " by #{reviewed.reviewed_by_user.display_label}" if reviewed.reviewed_by_user %>
                  </div>
                <% end %>
                <% if %i[overridden_cdef overridden_leveraged].include?(stmt.source_kind) %>
                  <%= button_to "Reset",
                        reset_inherited_statement_ssp_document_path(ssp_document, statement_id: stmt.id),
                        method: :post,
                        class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-action--sm sparc-fs-07 sparc-p-015-045",
                        form: { data: { turbo_confirm: "Discard your override and reset to the source prose?" },
                                class: "sparc-d-inline" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
