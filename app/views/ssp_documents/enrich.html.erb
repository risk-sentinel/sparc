<div class="card">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2>Enrich SSP: <%= @ssp_document.name %></h2>
      <p class="text-body-secondary sparc-m-0">
        Add system characteristics, components, and users to uplift this SSP for OSCAL-compliant export.
      </p>
    </div>
    <%= link_to "Back to SSP", ssp_document_path(@ssp_document), class: "sparc-action sparc-action--neutral sparc-action--ghost sparc-flex-shrink-0" %>
  </div>

  <%# ── #737: import components/users/back matter from canonical SPARC sources ── %>
  <div class="card bg-body-tertiary border-0 mb-3 sparc-enrich-section-body">
    <div class="fw-semibold small text-body-secondary mb-2">Import from canonical sources</div>

    <%# System users from authorization-boundary members %>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
      <% if @boundary_members.any? %>
        <%= button_to "Add #{@boundary_members.size} boundary member(s) as system users",
              import_boundary_users_ssp_document_path(@ssp_document), method: :post,
              class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm", form: { class: "sparc-d-inline" } %>
      <% else %>
        <span class="text-body-tertiary small fst-italic">No authorization-boundary members available to import as users.</span>
      <% end %>
    </div>

    <%# #1134: OSCAL roles, declared from the boundary vocabulary — picked by label, never typed %>
    <details class="mb-1" id="ssp-declared-roles">
      <summary class="small fw-semibold sparc-cursor-pointer">Declared roles (<%= @declared_roles.size %>)</summary>
      <div class="mt-2 ms-2">
        <% if @declared_roles.any? %>
          <ul class="list-unstyled small mb-2" data-testid="ssp-declared-roles-list">
            <% @declared_roles.each do |role| %>
              <li>
                <%= role["title"].presence || OscalRole.humanize(role["id"]) %>
                <code class="text-body-tertiary"><%= role["id"] %></code>
                <% if OscalRole.organization_defined?(role) %><span class="badge text-bg-secondary">organization-defined</span><% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="text-body-tertiary small fst-italic mb-2">This SSP declares no roles.</div>
        <% end %>
        <% if @declarable_membership_roles.any? %>
          <%= form_with url: declare_role_ssp_document_path(@ssp_document), method: :post,
                        class: "d-flex flex-wrap align-items-center gap-2" do %>
            <label for="ssp-declare-role-select" class="small">Declare a boundary role</label>
            <%= select_tag :membership_role,
                  options_for_select(@declarable_membership_roles.map { |c|
                    [ c[:organization_defined] ? "#{c[:label]} (organization-defined)" : c[:label], c[:membership_role] ]
                  }),
                  id: "ssp-declare-role-select", class: "form-control sparc-fs-085 w-auto" %>
            <%= submit_tag "Declare role", class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm" %>
          <% end %>
        <% else %>
          <span class="text-body-tertiary small fst-italic">Every responsibility-bearing boundary role is already declared.</span>
        <% end %>
      </div>
    </details>

    <%# System components from component definitions (boundary first, then org-wide) %>
    <% if @boundary_cdefs.any? || @org_cdefs.any? %>
      <%= form_with url: import_cdef_components_ssp_document_path(@ssp_document), method: :post do %>
        <details<%= " open".html_safe if @ssp_document.ssp_components.where.not(component_type: SspComponent::THIS_SYSTEM).none? %>>
          <summary class="small fw-semibold sparc-cursor-pointer">Import system components from component definitions (<%= @boundary_cdefs.size + @org_cdefs.size %>)</summary>
          <div class="mt-2 ms-2">
            <% if @boundary_cdefs.any? %>
              <div class="small text-body-secondary">Boundary component definitions (suggested)</div>
              <% @boundary_cdefs.each do |cdef| %>
                <% done = @imported_cdef_ids.include?(cdef.id) %>
                <% cb_id = "bcdef_#{cdef.id}" %>
                <div class="d-block small">
                  <%= check_box_tag "cdef_ids[]", cdef.id, !done, id: cb_id, disabled: done %>
                  <label for="<%= cb_id %>"><%= cdef.name %><%= " — already imported".html_safe if done %></label>
                </div>
              <% end %>
            <% end %>
            <% if @org_cdefs.any? %>
              <div class="small text-body-secondary mt-2">Organization-wide component definitions</div>
              <% @org_cdefs.each do |cdef| %>
                <% done = @imported_cdef_ids.include?(cdef.id) %>
                <% cb_id = "ocdef_#{cdef.id}" %>
                <div class="d-block small">
                  <%= check_box_tag "cdef_ids[]", cdef.id, false, id: cb_id, disabled: done %>
                  <label for="<%= cb_id %>"><%= cdef.name %><%= " — already imported".html_safe if done %></label>
                </div>
              <% end %>
            <% end %>
            <%= submit_tag "Import selected components", class: "sparc-action sparc-action--info sparc-action--solid sparc-action--sm mt-2" %>
          </div>
        </details>
      <% end %>
    <% end %>
    <%# Link existing (reusable) back-matter resources onto this SSP %>
    <% if @reusable_back_matter.any? %>
      <%= form_with url: import_back_matter_ssp_document_path(@ssp_document), method: :post do %>
        <details>
          <summary class="small fw-semibold sparc-cursor-pointer">Link existing back matter (<%= @reusable_back_matter.size %> reusable)</summary>
          <div class="mt-2 ms-2">
            <div class="small text-body-secondary">Globally-available / reusable resources</div>
            <% @reusable_back_matter.each do |r| %>
              <% cb_id = "bm_#{r.id}" %>
              <div class="d-block small">
                <%= check_box_tag "back_matter_ids[]", r.id, false, id: cb_id %>
                <label for="<%= cb_id %>"><%= r.title %><% if r.rel.present? %> <span class="text-body-tertiary">(<%= r.rel %>)</span><% end %></label>
              </div>
            <% end %>
            <%= submit_tag "Link selected back matter", class: "sparc-action sparc-action--primary sparc-action--solid sparc-action--sm mt-2" %>
          </div>
        </details>
      <% end %>
    <% end %>
  </div>

  <%# #1340 — the form is redrawn in place on save (this frame), so the author
      keeps their place: their input, scroll position and open sections. A
      refused field is outlined with its message under it, and its section is
      held open (field_errors_controller.js). %>
  <%= turbo_frame_tag "ssp-enrich-form" do %>
  <% if @enrich_saved %>
    <output class="alert alert-success d-block" data-testid="enrich-saved">SSP enrichment data saved.</output>
  <% end %>
  <% if @enrich_errors.present? %>
    <div class="alert alert-danger" role="alert" data-testid="enrich-errors">
      <div class="fw-semibold mb-1">Nothing was saved. Fix the highlighted fields:</div>
      <ul class="mb-0">
        <% @enrich_errors.each do |line| %><li><%= line %></li><% end %>
      </ul>
    </div>
  <% end %>
  <%= form_with model: @ssp_document, url: update_enrich_ssp_document_path(@ssp_document), method: :patch,
                html: { data: { controller: "ssp-enrich field-errors", field_errors_key_value: "ssp-enrich-#{@ssp_document.id}" } } do |f| %>

    <%# ── System Information ── %>
    <details open class="mb-3 sparc-enrich-section" id="enrich-system-information">
      <summary class="bg-body-secondary sparc-enrich-section-header">
        System Information
      </summary>
      <div class="sparc-p-1r-125r">
        <div class="row row-cols-1 row-cols-md-2 g-3 sparc-field-grid-gap-roomy">
          <div class="form-group">
            <%= f.label :description, "Description" %>
            <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "System description..." %>
          </div>
          <div class="form-group">
            <%= f.label :system_name_short, "Short Name" %>
            <%= f.text_field :system_name_short, class: "form-control", placeholder: "e.g., ACME" %>
          </div>
          <div class="form-group">
            <%= f.label :system_id, "System ID" %>
            <%= f.text_field :system_id, class: "form-control", placeholder: "e.g., system-uuid" %>
          </div>
          <div class="form-group">
            <%= f.label :system_status, "System Status" %>
            <%= f.select :system_status,
                  SspDocument::SYSTEM_STATUSES.map { |s| [s.titleize, s] },
                  { include_blank: "-- Select --" },
                  { class: "form-control" } %>
          </div>
          <div class="form-group">
            <%= f.label :date_authorized, "Date Authorized" %>
            <%= f.date_field :date_authorized, class: "form-control" %>
          </div>
        </div>
      </div>
    </details>

    <%# ── Security Levels ── %>
    <details class="mb-3 sparc-enrich-section" id="enrich-security-levels">
      <summary class="bg-body-secondary sparc-enrich-section-header">
        Security Levels
      </summary>
      <div class="sparc-p-1r-125r">
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <div class="form-group">
            <%= f.label :security_sensitivity_level, "Security Sensitivity Level" %>
            <%= f.select :security_sensitivity_level,
                  [["Low", "fips-199-low"], ["Moderate", "fips-199-moderate"], ["High", "fips-199-high"]],
                  { include_blank: "-- Select --" },
                  { class: "form-control" } %>
          </div>
          <div class="form-group">
            <%= f.label :security_objective_confidentiality, "Confidentiality Objective" %>
            <%= f.select :security_objective_confidentiality,
                  [["Low", "fips-199-low"], ["Moderate", "fips-199-moderate"], ["High", "fips-199-high"]],
                  { include_blank: "-- Select --" },
                  { class: "form-control" } %>
          </div>
          <div class="form-group">
            <%= f.label :security_objective_integrity, "Integrity Objective" %>
            <%= f.select :security_objective_integrity,
                  [["Low", "fips-199-low"], ["Moderate", "fips-199-moderate"], ["High", "fips-199-high"]],
                  { include_blank: "-- Select --" },
                  { class: "form-control" } %>
          </div>
          <div class="form-group">
            <%= f.label :security_objective_availability, "Availability Objective" %>
            <%= f.select :security_objective_availability,
                  [["Low", "fips-199-low"], ["Moderate", "fips-199-moderate"], ["High", "fips-199-high"]],
                  { include_blank: "-- Select --" },
                  { class: "form-control" } %>
          </div>
        </div>
      </div>
    </details>

    <%# ── Authorization Boundary ── %>
    <details class="mb-3 sparc-enrich-section" id="enrich-boundaries">
      <summary class="bg-body-secondary sparc-enrich-section-header">
        Boundaries & Architecture
      </summary>
      <div class="sparc-p-1r-125r">
        <div class="form-group">
          <%= f.label :authorization_boundary_description, "Authorization Boundary" %>
          <%= f.text_area :authorization_boundary_description, class: "form-control", rows: 3,
                placeholder: "Describe the authorization boundary..." %>
        </div>
        <div class="form-group">
          <%= f.label :network_architecture_description, "Network Architecture" %>
          <%= f.text_area :network_architecture_description, class: "form-control", rows: 3,
                placeholder: "Describe the network architecture..." %>
        </div>
        <div class="form-group">
          <%= f.label :data_flow_description, "Data Flow" %>
          <%= f.text_area :data_flow_description, class: "form-control", rows: 3,
                placeholder: "Describe the data flow..." %>
        </div>
      </div>
    </details>

    <%# ── Information Types ── %>
    <details class="mb-3 sparc-enrich-section" id="enrich-information-types">
      <summary class="bg-body-secondary sparc-enrich-section-header">
        Information Types (<%= @info_types.count %>)
      </summary>
      <div class="sparc-p-1r-125r" id="info-types-container" data-ssp-enrich-target="infoTypesContainer">
        <% @info_types.each_with_index do |it, idx| %>
          <% it_id = "ssp-info-type-#{idx}" %>
          <div class="info-type-entry sparc-enrich-item-card-alt">
            <% if it.persisted? %><input type="hidden" name="ssp_document[information_types][][id]" value="<%= it.id %>"><% end %>
            <div class="row row-cols-1 row-cols-md-2 g-2">
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="<%= it_id %>-title">Title</label>
                <input type="text" id="<%= it_id %>-title" name="ssp_document[information_types][][title]" value="<%= it.title %>" class="form-control sparc-fs-085<%= field_invalid_class(it, :title) %>" <%= field_invalid_attributes(it, :title, "#{it_id}-title") %>>
                <%= field_error_feedback(it, :title, "#{it_id}-title") %>
              </div>
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="<%= it_id %>-description">Description</label>
                <input type="text" id="<%= it_id %>-description" name="ssp_document[information_types][][description]" value="<%= it.description %>" class="form-control sparc-fs-085<%= field_invalid_class(it, :description) %>" <%= field_invalid_attributes(it, :description, "#{it_id}-description") %>>
                <%= field_error_feedback(it, :description, "#{it_id}-description") %>
              </div>
              <div class="form-group sparc-mb-0">
                <div class="sparc-fs-075">Confidentiality (Base)</div>
                <select name="ssp_document[information_types][][confidentiality_impact_base]" aria-label="Confidentiality (Base)" class="form-control sparc-fs-085">
                  <option value="">--</option>
                  <% %w[fips-199-low fips-199-moderate fips-199-high].each do |v| %>
                    <option value="<%= v %>" <%= "selected" if it.confidentiality_impact_base == v %>><%= fips_impact_label(v) %></option>
                  <% end %>
                </select>
              </div>
              <div class="form-group sparc-mb-0">
                <div class="sparc-fs-075">Integrity (Base)</div>
                <select name="ssp_document[information_types][][integrity_impact_base]" aria-label="Integrity (Base)" class="form-control sparc-fs-085">
                  <option value="">--</option>
                  <% %w[fips-199-low fips-199-moderate fips-199-high].each do |v| %>
                    <option value="<%= v %>" <%= "selected" if it.integrity_impact_base == v %>><%= fips_impact_label(v) %></option>
                  <% end %>
                </select>
              </div>
            </div>
            <% unless it.persisted? %><%= render "ssp_documents/enrich_remove_row" %><% end %>
          </div>
        <% end %>
        <template data-ssp-enrich-target="infoTypeTemplate">
          <div class="info-type-entry sparc-enrich-item-card-alt">
            <div class="row row-cols-1 row-cols-md-2 g-2">
              <div class="form-group sparc-mb-025">
                <div class="sparc-fs-075">Title</div>
                <input type="text" name="ssp_document[information_types][][title]" aria-label="Information Type Title" class="form-control sparc-fs-085" placeholder="Information Type">
              </div>
              <div class="form-group sparc-mb-025">
                <div class="sparc-fs-075">Description</div>
                <input type="text" name="ssp_document[information_types][][description]" aria-label="Information Type Description" class="form-control sparc-fs-085" placeholder="Description">
              </div>
              <div class="form-group sparc-mb-0">
                <div class="sparc-fs-075">Confidentiality (Base)</div>
                <select name="ssp_document[information_types][][confidentiality_impact_base]" aria-label="Confidentiality (Base)" class="form-control sparc-fs-085">
                  <option value="">--</option>
                  <option value="fips-199-low">Low</option>
                  <option value="fips-199-moderate">Moderate</option>
                  <option value="fips-199-high">High</option>
                </select>
              </div>
              <div class="form-group sparc-mb-0">
                <div class="sparc-fs-075">Integrity (Base)</div>
                <select name="ssp_document[information_types][][integrity_impact_base]" aria-label="Integrity (Base)" class="form-control sparc-fs-085">
                  <option value="">--</option>
                  <option value="fips-199-low">Low</option>
                  <option value="fips-199-moderate">Moderate</option>
                  <option value="fips-199-high">High</option>
                </select>
              </div>
            </div>
            <%= render "ssp_documents/enrich_remove_row" %>
          </div>
        </template>
        <button type="button" data-action="ssp-enrich#addInfoType" class="sparc-action sparc-action--positive sparc-action--solid sparc-enrich-item-action">
          + Add Information Type
        </button>
      </div>
    </details>

    <%# ── Components ── %>
    <details class="mb-3 sparc-enrich-section" id="enrich-components">
      <summary class="bg-body-secondary sparc-enrich-section-header">
        Components (<%= @components.count %>)
      </summary>
      <div class="sparc-p-1r-125r" id="components-container" data-ssp-enrich-target="componentsContainer">
        <% @components.reject { |c| c.component_type == SspComponent::THIS_SYSTEM }.each_with_index do |comp, comp_idx| %>
          <% c_id = "ssp-component-#{comp_idx}" %>
          <div class="component-entry sparc-enrich-item-card-alt">
            <% if comp.persisted? %><input type="hidden" name="ssp_document[components][][id]" value="<%= comp.id %>"><% end %>
            <div class="row row-cols-1 row-cols-md-2 g-2">
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="<%= c_id %>-title">Title</label>
                <input type="text" id="<%= c_id %>-title" name="ssp_document[components][][title]" value="<%= comp.title %>" class="form-control sparc-fs-085<%= field_invalid_class(comp, :title) %>" <%= field_invalid_attributes(comp, :title, "#{c_id}-title") %>>
                <%= field_error_feedback(comp, :title, "#{c_id}-title") %>
              </div>
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="<%= c_id %>-type">Type</label>
                <select id="<%= c_id %>-type" name="ssp_document[components][][component_type]" class="form-control sparc-fs-085<%= field_invalid_class(comp, :component_type) %>" <%= field_invalid_attributes(comp, :component_type, "#{c_id}-type") %>>
                  <% SspComponent::COMPONENT_TYPES.reject { |t| t == SspComponent::THIS_SYSTEM }.each do |t| %>
                    <option value="<%= t %>" <%= "selected" if comp.component_type == t %>><%= t.titleize %></option>
                  <% end %>
                </select>
                <%= field_error_feedback(comp, :component_type, "#{c_id}-type") %>
              </div>
              <div class="form-group sparc-field-grid-span">
                <label class="sparc-fs-075" for="<%= c_id %>-description">Description</label>
                <input type="text" id="<%= c_id %>-description" name="ssp_document[components][][description]" value="<%= comp.description %>" class="form-control sparc-fs-085<%= field_invalid_class(comp, :description) %>" <%= field_invalid_attributes(comp, :description, "#{c_id}-description") %>>
                <%= field_error_feedback(comp, :description, "#{c_id}-description") %>
              </div>

              <%# ── #998: what this validation validates ────────────────────
                  OSCAL models third-party product validation as a component
                  PAIR — the product, and a `validation` component carrying the
                  certificate, joined by a link from the product. Shown only on
                  a component already typed `validation`: the fields mean
                  nothing anywhere else, and the model refuses them there. %>
              <% if comp.validation? %>
                <div class="form-group sparc-field-grid-span-divided">
                  <div class="fw-semibold sparc-enrich-field-caption-sm">
                    Validation
                    <span class="text-body-tertiary sparc-fw-400">— the certificate this component asserts, and the product it is about</span>
                  </div>
                  <div class="row row-cols-1 row-cols-md-2 g-2">
                    <div class="form-group">
                      <label class="sparc-fs-075" for="<%= c_id %>-validation-type">Validation type</label>
                      <input type="text" id="<%= c_id %>-validation-type" name="ssp_document[components][][validation_type]" value="<%= comp.validation_type %>" class="form-control sparc-fs-085<%= field_invalid_class(comp, :validation_type) %>" <%= field_invalid_attributes(comp, :validation_type, "#{c_id}-validation-type") %> placeholder="e.g. fips-140-2">
                      <%= field_error_feedback(comp, :validation_type, "#{c_id}-validation-type") %>
                    </div>
                    <div class="form-group">
                      <label class="sparc-fs-075" for="<%= c_id %>-validation-reference">Certificate reference</label>
                      <input type="text" id="<%= c_id %>-validation-reference" name="ssp_document[components][][validation_reference]" value="<%= comp.validation_reference %>" class="form-control sparc-fs-085<%= field_invalid_class(comp, :validation_reference) %>" <%= field_invalid_attributes(comp, :validation_reference, "#{c_id}-validation-reference") %> placeholder="e.g. 4282">
                      <%= field_error_feedback(comp, :validation_reference, "#{c_id}-validation-reference") %>
                    </div>
                    <div class="form-group">
                      <label class="sparc-fs-075" for="<%= c_id %>-validation-details">Authoritative record (URL)</label>
                      <input type="url" id="<%= c_id %>-validation-details" name="ssp_document[components][][validation_details_href]" value="<%= comp.validation_details_href %>" class="form-control sparc-fs-085<%= field_invalid_class(comp, :validation_details_href) %>" <%= field_invalid_attributes(comp, :validation_details_href, "#{c_id}-validation-details") %> placeholder="https://…">
                      <%= field_error_feedback(comp, :validation_details_href, "#{c_id}-validation-details") %>
                    </div>
                    <div class="form-group">
                      <label class="sparc-fs-075" for="<%= c_id %>-validates">Validates which component</label>
                      <select id="<%= c_id %>-validates" name="ssp_document[components][][validates_component_id]" class="form-control sparc-fs-085<%= field_invalid_class(comp, :validates_component_id) %>" <%= field_invalid_attributes(comp, :validates_component_id, "#{c_id}-validates") %>>
                        <option value="">— not linked to a product —</option>
                        <% @components.reject { |other| !other.persisted? || other.id == comp.id || other.validation? }.each do |other| %>
                          <option value="<%= other.id %>" <%= "selected" if comp.validates_component_id == other.id %>><%= other.title %></option>
                        <% end %>
                      </select>
                      <%= field_error_feedback(comp, :validates_component_id, "#{c_id}-validates") %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
            <% unless comp.persisted? %><%= render "ssp_documents/enrich_remove_row" %><% end %>
          </div>
        <% end %>
        <template data-ssp-enrich-target="componentTemplate">
          <div class="component-entry sparc-enrich-item-card-alt">
            <div class="row row-cols-1 row-cols-md-2 g-2">
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Title</span>
                <input type="text" name="ssp_document[components][][title]" class="form-control sparc-fs-085" placeholder="Component name" aria-label="Component Title">
              </div>
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Type</span>
                <select name="ssp_document[components][][component_type]" class="form-control sparc-fs-085" aria-label="Component Type">
                  <option value="software">Software</option>
                  <option value="hardware">Hardware</option>
                  <option value="service">Service</option>
                  <option value="policy">Policy</option>
                  <option value="process-procedure">Process Procedure</option>
                  <option value="plan">Plan</option>
                  <option value="guidance">Guidance</option>
                  <option value="standard">Standard</option>
                  <option value="validation">Validation</option>
                </select>
              </div>
              <div class="form-group sparc-field-grid-span">
                <span class="sparc-enrich-grid-label">Description</span>
                <input type="text" name="ssp_document[components][][description]" class="form-control sparc-fs-085" placeholder="Component description" aria-label="Component Description">
              </div>
            </div>
            <%= render "ssp_documents/enrich_remove_row" %>
          </div>
        </template>
        <button type="button" data-action="ssp-enrich#addComponent" class="sparc-action sparc-action--positive sparc-action--solid sparc-enrich-item-action">
          + Add Component
        </button>
      </div>
    </details>

    <%# ── Users ── %>
    <details class="mb-3 sparc-enrich-section" id="enrich-users">
      <summary class="bg-body-secondary sparc-enrich-section-header">
        System Users (<%= @users.count %>)
      </summary>
      <div class="sparc-p-1r-125r" id="users-container" data-ssp-enrich-target="usersContainer">
        <% @users.each_with_index do |user, user_idx| %>
          <% u_id = "ssp-user-#{user_idx}" %>
          <div class="user-entry sparc-enrich-item-card-alt">
            <% if user.persisted? %><input type="hidden" name="ssp_document[users][][id]" value="<%= user.id %>"><% end %>
            <div class="row row-cols-1 row-cols-md-2 g-2">
              <div class="form-group sparc-mb-025">
                <label class="sparc-fs-075" for="<%= u_id %>-title">Title</label>
                <input type="text" id="<%= u_id %>-title" name="ssp_document[users][][title]" value="<%= user.title %>" class="form-control sparc-fs-085<%= field_invalid_class(user, :title) %>" <%= field_invalid_attributes(user, :title, "#{u_id}-title") %>>
                <%= field_error_feedback(user, :title, "#{u_id}-title") %>
              </div>
              <div class="form-group sparc-mb-0">
                <label class="sparc-fs-075" for="<%= u_id %>-description">Description</label>
                <input type="text" id="<%= u_id %>-description" name="ssp_document[users][][description]" value="<%= user.description %>" class="form-control sparc-fs-085<%= field_invalid_class(user, :description) %>" <%= field_invalid_attributes(user, :description, "#{u_id}-description") %>>
                <%= field_error_feedback(user, :description, "#{u_id}-description") %>
              </div>
            </div>
            <% unless user.persisted? %><%= render "ssp_documents/enrich_remove_row" %><% end %>
          </div>
        <% end %>
        <template data-ssp-enrich-target="userTemplate">
          <div class="user-entry sparc-enrich-item-card-alt">
            <div class="row row-cols-1 row-cols-md-2 g-2">
              <div class="form-group sparc-mb-025">
                <span class="sparc-enrich-grid-label">Title</span>
                <input type="text" name="ssp_document[users][][title]" class="form-control sparc-fs-085" placeholder="User title" aria-label="User Title">
              </div>
              <div class="form-group sparc-mb-0">
                <span class="sparc-enrich-grid-label">Description</span>
                <input type="text" name="ssp_document[users][][description]" class="form-control sparc-fs-085" placeholder="Description" aria-label="User Description">
              </div>
            </div>
            <%= render "ssp_documents/enrich_remove_row" %>
          </div>
        </template>
        <button type="button" data-action="ssp-enrich#addUser" class="sparc-action sparc-action--positive sparc-action--solid sparc-enrich-item-action">
          + Add User
        </button>
      </div>
    </details>

    <%# ── Submit ── %>
    <div class="d-flex gap-3 mt-3">
      <%= f.submit "Save Enrichment Data", class: "sparc-action sparc-action--primary sparc-action--solid" %>
      <%= link_to "Cancel", ssp_document_path(@ssp_document), class: "sparc-action sparc-action--neutral sparc-action--ghost",
                  data: { turbo_frame: "_top" } %>
    </div>

  <% end %>
  <% end %>
</div>
