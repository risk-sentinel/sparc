<%# #1251 — the boundary page says what the boundary IS before what it lacks.

    Order: header (name, status, key ATO facts, description), the multiple-SSP
    warning, Boundary Completeness, Artifact Summary, Environments &
    Components, Personnel Roster, Evidence, Back Matter (#1249), Leveraged
    Authorizations, Metadata sync status. Since 1.18.0-rf (#1301) the
    header and the Artifact Summary are the boundary home above the same
    sections.

    Every section after the warning is a shared/_collapsible_section with a
    count in its header. Defaults: Completeness open while the boundary is
    Draft (and always open then), collapsed otherwise; Artifact Summary open;
    the rest collapsed. collapse-memory remembers a person's choice per
    section across every boundary's page.

    An action appears only to someone its controller would admit (#1247). %>
<% boundary = @authorization_boundary %>
<% may_edit = can_edit_boundary?(boundary) %>
<div data-controller="collapse-memory" data-collapse-memory-key-value="boundary-page">

<%# 1.18.0-rf #1301 — the header and the Artifact
    Summary are the boundary home (authorization_boundaries/_home). %>
  <%= render "authorization_boundaries/home", boundary: boundary, home: @home, readiness: @readiness,
        may_edit: may_edit, personnel: @personnel %>

<% if @linked_ssps.size > 1 %>
  <%# More than one SSP claims this boundary; the SSP tile below shows only
      one of them. Named here so the right one can be kept and the others
      re-linked from their own pages. %>
  <div class="sparc-card mb-3" role="alert" style="padding: 0.65rem 1rem; border-left: 3px solid rgba(243,156,18,0.6);">
    <strong><%= @linked_ssps.size %> system security plans point at this boundary.</strong>
    <span class="text-body-secondary">A boundary has one SSP; the tiles below show only one of them.
      Open each and keep the right one linked:</span>
    <ul class="mb-0 mt-1">
      <% @linked_ssps.each do |ssp| %>
        <li><%= link_to ssp.name, ssp_document_path(ssp) %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# ── Boundary Completeness (#940) ─────────────────────────────── %>
<%= render "readiness", readiness: @readiness, boundary: boundary %>

<%# ── Artifact Summary (the home's document list under the shell) ── %>

<%# ── Environments & Components ────────────────────────────── %>
<%= render layout: "shared/collapsible_section",
           locals: { id: "boundary-environments", title: "Environments & Components", count: @boundaries.size,
                     actions: (link_to("Add Environment", new_authorization_boundary_boundary_path(boundary),
                                       class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm") if may_edit) } do %>
  <% if @boundaries.any? %>
    <% @boundaries.each do |environment| %>
      <div class="card mb-2">
        <div class="card-body py-2">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <strong><%= environment.name %></strong>
              <span class="badge bg-secondary ms-2"><%= environment.environment_label %></span>
              <% if environment.description.present? %>
                <span class="text-body-secondary ms-2"><%= environment.description %></span>
              <% end %>
            </div>
            <% if may_edit %>
              <div class="d-flex gap-1">
                <%= link_to "Edit", edit_authorization_boundary_boundary_path(boundary, environment), class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm" %>
                <%= button_to "Delete", authorization_boundary_boundary_path(boundary, environment), method: :delete,
                      class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm",
                      form: { data: { turbo_confirm: "Delete this environment? This cannot be undone." }, style: "display: inline;" } %>
              </div>
            <% end %>
          </div>
          <% if environment.cdef_documents.any? %>
            <div class="mt-2">
              <% environment.cdef_documents.each do |cdef| %>
                <%= link_to cdef.name, cdef_document_path(cdef), class: "badge badge-info text-decoration-none me-1" %>
              <% end %>
            </div>
          <% else %>
            <small class="text-body-secondary mt-1 d-block">No components assigned</small>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-body-secondary text-center mb-0">No environments defined. Add an environment to associate components.</p>
  <% end %>
<% end %>

<%# ── Personnel Roster ─────────────────────────────────────── %>
<% may_manage_members = boundary_permission?("authorization_boundaries.manage_members", boundary) %>
<%= render layout: "shared/collapsible_section",
           locals: { id: "boundary-personnel", title: "Personnel Roster", count: boundary.people_count,
                     actions: (link_to("Add Member", new_authorization_boundary_membership_path(boundary),
                                       class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm") if may_manage_members) } do %>
  <%# #869 — shared with the add-member screen. %>
  <%= render "authorization_boundaries/roster_table",
        personnel: @personnel, boundary: boundary, actions: may_manage_members %>
<% end %>

<%# ── Evidence ─────────────────────────────────────────────── %>
<%# #770 bug 5 — evidence tied to this boundary; it flows into OSCAL back-matter
    (evidence -> back_matter_resource). #1251 — called "Evidence", as the
    Completeness checklist calls it; "Artifacts" read as the same thing as the
    Artifact Summary above. %>
<%= render layout: "shared/collapsible_section",
           locals: { id: "boundary-evidence", title: "Evidence", count: @evidences.size,
                     actions: (link_to("Add Evidence", new_evidence_path(authorization_boundary_id: boundary.id),
                                       class: "sparc-action sparc-action--positive sparc-action--solid sparc-action--sm") if boundary_permission?("evidence.write", boundary)) } do %>
  <% if @evidences.any? %>
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Status</th>
          <th>File</th>
        </tr>
      </thead>
      <tbody>
        <% @evidences.each do |ev| %>
          <tr>
            <td><%= link_to ev.title, evidence_path(ev) %></td>
            <td><span class="badge bg-secondary"><%= ev.type_label %></span></td>
            <td><span class="badge bg-primary"><%= ev.status_label %></span></td>
            <td class="text-body-secondary">
              <%= ev.file.attached? ? (ev.original_filename.presence || "attached") : "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-body-secondary text-center mb-0">No evidence attached. Add evidence to include it in this boundary's OSCAL back-matter.</p>
  <% end %>
<% end %>

<%# ── Back Matter (#1249) ─────────────────────────────────── %>
<%# The boundary's OWN back-matter (diagrams, inventory, PPSM, CRM), which the
    Completeness row "Back-matter documents" counts and the SSP export carries.
    Editable in any boundary status (owner). %>
<% if can_read_boundary_back_matter?(boundary) %>
  <%= render layout: "shared/collapsible_section",
             locals: { id: "boundary-back-matter", title: "Back Matter",
                       count: boundary.back_matter_resources.count } do %>
    <%= render "shared/oscal_back_matter_section",
          document: boundary, bare: true,
          resources_path: authorization_boundary_back_matter_resources_path(boundary),
          editable: can_write_boundary_back_matter?(boundary) %>
  <% end %>
<% end %>

<%# #396: Leveraged Authorizations %>
<%= render "leveraged_authorizations_card", boundary: boundary %>

<%# #395 P3: per-document metadata sync status (green / yellow / red dots) %>
<%= render "metadata_sync_status", boundary: boundary %>

</div>
