<%= render "shared/section_summary", tiles: [
  [@total_count, "Authorization Boundaries"],
  [@active_count, "Active"],
  [@member_count, "Members"]
] %>

<div class="card sparc-of-hidden">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Authorization Boundaries</h2>
    <% if can_create_boundary? %>
      <%= link_to "New Authorization Boundary", new_authorization_boundary_path, class: "sparc-action sparc-action--positive sparc-action--solid" %>
    <% end %>
  </div>

  <div data-controller="bulk-select">

  <%= render "shared/collection_toolbar",
        label: "authorization boundaries", placeholder: "Search authorization boundaries…",
        view_mode: (@authorization_boundaries.any? ? @view_mode : nil),
        extra: (render("authorization_boundaries/select_all") if can_bulk_delete? && @authorization_boundaries.any? && @view_mode == :card) %>

  <%# #629 — admin-only bulk delete bar; appears when ≥1 row is selected. %>
  <% if can_bulk_delete? && @authorization_boundaries.any? %>
    <div class="mb-2" data-bulk-select-target="bar" hidden>
      <%= form_with url: bulk_destroy_authorization_boundaries_path, method: :delete, id: "abBulkForm" do %>
        <button type="submit" class="sparc-action sparc-action--danger sparc-action--outline sparc-action--sm" data-bulk-select-target="submit"
                data-turbo-confirm="Delete the selected authorization boundaries? This cannot be undone.">
          Delete (<span data-bulk-select-target="count">0</span> selected)
        </button>
      <% end %>
    </div>
  <% end %>

  <% if @authorization_boundaries.any? && @view_mode == :card %>
    <div class="sparc-card-grid">
      <% @authorization_boundaries.each do |authorization_boundary| %>
        <%= render "shared/item_card",
              title: authorization_boundary.name,
              url: authorization_boundary_path(authorization_boundary),
              badges: [ { text: authorization_boundary.status.to_s.titleize,
                          class: "sparc-status sparc-status--#{ab_status_variant(authorization_boundary.status)}" } ],
              description: authorization_boundary.description,
              metrics: [ { value: authorization_boundary.people_count, label: "personnel" },
                         { value: authorization_boundary.boundaries.count, label: "environments" } ],
              footer: "Updated #{authorization_boundary.updated_at.strftime('%Y-%m-%d')}",
              select: (render("authorization_boundaries/bulk_checkbox", boundary: authorization_boundary) if can_bulk_delete?),
              actions: render("authorization_boundaries/item_actions", authorization_boundary: authorization_boundary) %>
      <% end %>
    </div>
  <% elsif @authorization_boundaries.any? %>
    <table class="table table-hover sparc-table-layout-fixed">
      <colgroup>
        <% if can_bulk_delete? %><col class="sparc-w-4pct"><% end %>
        <col class="sparc-w-22pct">
        <col class="sparc-w-30pct">
        <col class="sparc-w-10pct">
        <col class="sparc-w-10pct">
        <col class="sparc-w-10pct">
        <col class="sparc-w-18pct">
      </colgroup>
      <thead>
        <tr>
          <% if can_bulk_delete? %>
            <th><%= render "authorization_boundaries/select_all_box" %></th>
          <% end %>
          <th>Name</th>
          <th>Description</th>
          <th>Status</th>
          <th>Members</th>
          <th>Environments</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @authorization_boundaries.each do |authorization_boundary| %>
          <tr>
            <% if can_bulk_delete? %>
              <td><%= render "authorization_boundaries/bulk_checkbox", boundary: authorization_boundary %></td>
            <% end %>
            <td class="sparc-text-ellipsis" title="<%= authorization_boundary.name %>">
              <%= link_to authorization_boundary.name, authorization_boundary_path(authorization_boundary) %>
            </td>
            <td class="text-body-secondary sparc-text-ellipsis">
              <%= authorization_boundary.description.presence || "—" %>
            </td>
            <td>
              <%# #1247 — one colour per status everywhere: ab_status_variant. %>
              <span class="sparc-status sparc-status--<%= ab_status_variant(authorization_boundary.status) %>">
                <%= authorization_boundary.status.titleize %>
              </span>
            </td>
            <td><%= authorization_boundary.people_count %></td>
            <td><%= authorization_boundary.boundaries.count %></td>
            <td>
              <%= render "authorization_boundaries/item_actions", authorization_boundary: authorization_boundary %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <% if can_create_boundary? %>
      <p class="text-center p-4 text-body-secondary">No authorization boundaries yet. Create your first authorization boundary to organize RMF artifacts and personnel.</p>
    <% else %>
      <p class="text-center p-4 text-body-secondary">You have no role on any authorization boundary yet. An administrator, or a boundary's ISSO or ISSM, can add you.</p>
    <% end %>
  <% end %>
  </div>

  <%= render "shared/collection_pagination", pagy: @pagy, label: "authorization boundaries" %>
</div>
