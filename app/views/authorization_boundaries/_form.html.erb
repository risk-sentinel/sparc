<%= form_with(model: authorization_boundary, class: "mb-4") do |f| %>
  <%# #870 — field help answers the micro-question in place. Full guidance
      stays in the User Guides, reachable from the header ? in a new tab. %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label fw-semibold" %>
    <%= field_help "The system this authorization covers, as it should appear on the ATO package." %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label fw-semibold" %>
    <%= field_help "A short summary of what the system does." %>
    <%= f.text_area :description, class: "form-control", rows: 3 %>
  </div>

  <div class="mb-3">
    <%= f.label :status, class: "form-label fw-semibold" %>
    <%= field_help "Where this system sits in the authorization lifecycle. Only 'authorized' means an ATO is in force." %>
    <%= f.select :status, AuthorizationBoundary::STATUSES.map { |s| [ s.titleize, s ] }, {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :authorization_boundary_description, "Authorization Boundary", class: "form-label fw-semibold" %>
    <%= field_help "What is inside the boundary — e.g. components, data flows and interconnections the authorization covers." %>
    <%= f.text_area :authorization_boundary_description, class: "form-control", rows: 3 %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", authorization_boundaries_path, class: "btn btn-secondary" %>
  </div>
<% end %>
