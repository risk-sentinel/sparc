<%#
  Actions on one authorization boundary, shared by the table row and the card (#888 §4)
  so an action cannot exist in one view and not the other.

  Locals:
    authorization_boundary — the record
%>
<% authorization_boundary = local_assigns[:authorization_boundary] %>

<div class="d-flex flex-wrap gap-1 align-items-center">
  <%= link_to "View", authorization_boundary_path(authorization_boundary), class: "sparc-action sparc-action--neutral sparc-action--outline sparc-action--sm" %>
  <%= link_to "Edit", edit_authorization_boundary_path(authorization_boundary), class: "sparc-action sparc-action--primary sparc-action--outline sparc-action--sm" %>
  <%= button_to "Delete", authorization_boundary_path(authorization_boundary), method: :delete,
        class: "sparc-action sparc-action--danger sparc-action--outline sparc-action--sm",
        form: { data: { turbo_confirm: "Delete '#{authorization_boundary.name}'? This cannot be undone." }, style: "display: inline;" } %>
</div>
