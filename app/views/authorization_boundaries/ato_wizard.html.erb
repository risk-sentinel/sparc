<div class="card">
  <h2>ATO Package Wizard</h2>
  <p class="text-body-secondary mb-4">
    Build a complete Authority to Operate (ATO) package for this authorization boundary.
    Select or create the required artifacts — SSP, SAP, SAR, and POA&M — then assemble them into a single package.
  </p>

  <%= form_with url: create_ato_package_authorization_boundary_path(@authorization_boundary), method: :post, local: true, data: { controller: "ato-wizard" } do |f| %>

    <%# ── Step 1: Confirm Authorization Boundary ── %>
    <details open class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--info sparc-wizard-step-number">1</span>
        Confirm Authorization Boundary
      </summary>
      <div class="sparc-wizard-step-body">
        <div class="mb-2">
          <strong>Name:</strong> <%= @authorization_boundary.name %>
        </div>
        <div class="mb-2">
          <strong>Status:</strong> <%= @authorization_boundary.status %>
        </div>
        <div class="mb-2">
          <strong>Description:</strong> <%= @authorization_boundary.description %>
        </div>
        <div class="mb-2">
          <strong>Members:</strong> <%= @memberships.count %>
        </div>
        <% if @missing_roles.any? %>
          <div class="alert alert-warning mt-3 sparc-fs-088">
            <strong>Missing Roles:</strong> The following roles have not been assigned:
            <ul class="mb-0 mt-1">
              <% @missing_roles.each do |role| %>
                <li><%= role %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </details>

    <%# ── Step 2: Select Baseline / Profile ── %>
    <details open class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--success sparc-wizard-step-number">2</span>
        Baseline / Profile
      </summary>
      <div class="sparc-wizard-step-body">
        <% if @boundary_profile %>
          <%# #1101 — the boundary's baseline is settled: context, not a question. %>
          <%= hidden_field_tag :profile_mode, "select_existing", id: "profile_mode" %>
          <%= hidden_field_tag :profile_document_id, @boundary_profile.id %>
          <p class="sparc-fs-088 mb-1" data-testid="profile-settled">
            <strong>Baseline:</strong> <%= link_to @boundary_profile.name, profile_document_path(@boundary_profile) %>
            <span class="text-body-secondary">&mdash; set on this boundary</span>
          </p>
          <% unless ProfileDocument.ssp_ready.exists?(id: @boundary_profile.id) %>
            <p class="sparc-heading-danger sparc-fs-088 mb-0" data-testid="profile-not-ready">
              This baseline is not published yet. A new SSP or SAP needs a published baseline:
              publish it from its page first.
            </p>
          <% end %>
        <% else %>
        <%= hidden_field_tag :profile_mode, "skip", id: "profile_mode" %>

        <div class="mb-2">
          <label class="d-flex align-items-center gap-2 sparc-cursor-pointer">
            <input type="radio" name="profile_radio" value="select_existing" data-action="ato-wizard#setMode" data-ato-wizard-mode-param="profile" class="sparc-icon-16">
            <span class="fw-semibold sparc-fs-088">Select Existing Profile</span>
          </label>
        </div>
        <div class="mb-2">
          <label class="d-flex align-items-center gap-2 sparc-cursor-pointer">
            <input type="radio" name="profile_radio" value="skip" checked data-action="ato-wizard#setMode" data-ato-wizard-mode-param="profile" class="sparc-icon-16">
            <span class="fw-semibold sparc-fs-088">Skip</span>
          </label>
        </div>

        <div id="profile_select_existing_panel" class="sparc-wizard-step-panel sparc-d-none">
          <% if @profiles.any? %>
            <div class="form-group">
              <label for="profile_document_id">Profile</label>
              <%= select_tag :profile_document_id,
                    options_for_select(@profiles.map { |p| ["#{p.name} (#{p.profile_controls.count} controls)", p.id] }),
                    include_blank: "-- Select a Profile --",
                    class: "form-control" %>
            </div>
          <% else %>
            <p class="sparc-heading-danger sparc-fs-088">
              No published profiles found. Please
              <%= link_to "upload a Profile", new_profile_document_path %> and publish it first.
            </p>
          <% end %>
          <small class="text-body-secondary d-block sparc-wizard-field-note">
            Controls from this profile will feed into SSP, SAP, and SAR creation, and it
            becomes this boundary's baseline.
          </small>
        </div>
        <% end %>
      </div>
    </details>

    <%# ── Step 3: Select Components (CDEFs) ── %>
    <details class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--orange sparc-wizard-step-number">3</span>
        Components (CDEFs)
      </summary>
      <div class="sparc-wizard-step-body">
        <% if @boundary_cdefs.any? %>
          <%# #1101 — already linked to this boundary: shown, not asked again. %>
          <div class="mb-3" data-testid="cdefs-linked">
            <div class="fw-semibold sparc-fs-088 mb-1">Linked to this boundary</div>
            <ul class="sparc-fs-088 mb-0">
              <% @boundary_cdefs.each do |cdef| %>
                <li><%= link_to cdef.name, cdef_document_path(cdef) %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <%= hidden_field_tag :cdef_mode, "skip", id: "cdef_mode" %>

        <div class="mb-2">
          <label class="d-flex align-items-center gap-2 sparc-cursor-pointer">
            <input type="radio" name="cdef_radio" value="select" data-action="ato-wizard#setMode" data-ato-wizard-mode-param="cdef" class="sparc-icon-16">
            <span class="fw-semibold sparc-fs-088"><%= @boundary_cdefs.any? ? "Add Components" : "Select Components" %></span>
          </label>
        </div>
        <div class="mb-2">
          <label class="d-flex align-items-center gap-2 sparc-cursor-pointer">
            <input type="radio" name="cdef_radio" value="skip" checked data-action="ato-wizard#setMode" data-ato-wizard-mode-param="cdef" class="sparc-icon-16">
            <span class="fw-semibold sparc-fs-088"><%= @boundary_cdefs.any? ? "Keep as linked" : "Skip" %></span>
          </label>
        </div>

        <div id="cdef_select_panel" class="sparc-wizard-step-panel sparc-d-none">
          <% if @cdefs.any? %>
            <p class="text-body-secondary sparc-wizard-step-hint">
              Select CDEFs to include as components in the ATO package.
            </p>
            <% @cdefs.each do |cdef| %>
              <label class="d-flex align-items-center gap-2 border rounded-2 bg-body sparc-wizard-option" for="cdef_document_id_<%= cdef.id %>">
                <%= check_box_tag "cdef_document_ids[]", cdef.id, false, id: "cdef_document_id_#{cdef.id}", style: "width: 16px; height: 16px;", "aria-label": "Include component #{cdef.name}" %>
                <div>
                  <div class="fw-semibold sparc-fs-088"><%= cdef.name %></div>
                  <div class="text-body-secondary sparc-fs-075">
                    <%= cdef.cdef_controls.count %> controls
                    <% if cdef.description.present? %>
                      &mdash; <%= truncate(cdef.description, length: 80) %>
                    <% end %>
                  </div>
                </div>
              </label>
            <% end %>
          <% else %>
            <p class="text-body-secondary sparc-fs-088">
              No other completed CDEFs found. You can
              <%= link_to "upload a CDEF", new_cdef_document_path(only: "upload") %> first, or skip this step.
            </p>
          <% end %>
        </div>
      </div>
    </details>

    <%# ── Step 4: System Security Plan (SSP) ── %>
    <details <%= "open" if @step_defaults[:ssp].mode?(AtoWizardStep::SELECT) %> class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--danger sparc-wizard-step-number">4</span>
        System Security Plan (SSP)
      </summary>
      <div class="sparc-wizard-step-body">
        <%= render "ato_step_modes", step: :ssp, noun: "SSP", default: @step_defaults[:ssp] %>

        <div id="ssp_create_new_panel" class="sparc-wizard-step-panel sparc-d-none">
          <div class="form-group">
            <label for="ssp_name">SSP Name <span class="sparc-required">*</span></label>
            <%= text_field_tag :ssp_name, nil, class: "form-control", placeholder: "e.g., My System SSP" %>
          </div>
          <div class="form-group">
            <label for="ssp_description">Description</label>
            <%= text_area_tag :ssp_description, nil, class: "form-control", rows: 3, placeholder: "Brief description of the system..." %>
          </div>
          <div class="row row-cols-1 row-cols-md-2 g-3">
            <div class="form-group">
              <label for="system_status">System Status</label>
              <%= select_tag :system_status,
                    options_for_select(SspDocument::SYSTEM_STATUSES.map { |s| [s.titleize, s] }),
                    include_blank: "-- Select --",
                    class: "form-control" %>
            </div>
            <div class="form-group">
              <label for="security_sensitivity_level">Security Sensitivity Level</label>
              <%= select_tag :security_sensitivity_level,
                    options_for_select([["Low", "fips-199-low"], ["Moderate", "fips-199-moderate"], ["High", "fips-199-high"]]),
                    include_blank: "-- Select --",
                    class: "form-control" %>
            </div>
            <div class="form-group">
              <label for="security_objective_confidentiality">Confidentiality Objective</label>
              <%= select_tag :security_objective_confidentiality,
                    options_for_select([["Low", "fips-199-low"], ["Moderate", "fips-199-moderate"], ["High", "fips-199-high"]]),
                    include_blank: "-- Select --",
                    class: "form-control" %>
            </div>
            <div class="form-group">
              <label for="security_objective_integrity">Integrity Objective</label>
              <%= select_tag :security_objective_integrity,
                    options_for_select([["Low", "fips-199-low"], ["Moderate", "fips-199-moderate"], ["High", "fips-199-high"]]),
                    include_blank: "-- Select --",
                    class: "form-control" %>
            </div>
            <div class="form-group">
              <label for="security_objective_availability">Availability Objective</label>
              <%= select_tag :security_objective_availability,
                    options_for_select([["Low", "fips-199-low"], ["Moderate", "fips-199-moderate"], ["High", "fips-199-high"]]),
                    include_blank: "-- Select --",
                    class: "form-control" %>
            </div>
          </div>
        </div>

        <div id="ssp_select_existing_panel" class="sparc-wizard-step-panel<%= " sparc-d-none" unless @step_defaults[:ssp].mode?(AtoWizardStep::SELECT) %>">
          <div class="form-group">
            <label for="ssp_document_id">Existing SSP</label>
            <%= select_tag :ssp_document_id,
                  options_for_select(@ssps.map { |s| [s.name, s.id] }, @step_defaults[:ssp].selected_id),
                  include_blank: "-- Select an SSP --",
                  class: "form-control" %>
          </div>
        </div>
      </div>
    </details>

    <%# ── Step 5: Security Assessment Plan (SAP) ── %>
    <details <%= "open" if @step_defaults[:sap].mode?(AtoWizardStep::SELECT) %> class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--purple sparc-wizard-step-number">5</span>
        Security Assessment Plan (SAP)
      </summary>
      <div class="sparc-wizard-step-body">
        <%= render "ato_step_modes", step: :sap, noun: "SAP", default: @step_defaults[:sap] %>

        <div id="sap_create_new_panel" class="sparc-wizard-step-panel sparc-d-none">
          <div class="form-group">
            <label for="sap_name">SAP Name <span class="sparc-required">*</span></label>
            <%= text_field_tag :sap_name, nil, class: "form-control", placeholder: "e.g., Annual Security Assessment Plan" %>
          </div>
          <div class="form-group">
            <label for="sap_description">Description</label>
            <%= text_area_tag :sap_description, nil, class: "form-control", rows: 3, placeholder: "Brief description of the assessment plan..." %>
          </div>
          <div class="row row-cols-1 row-cols-md-2 g-3">
            <div class="form-group">
              <label for="assessment_type">Assessment Type</label>
              <%= select_tag :assessment_type,
                    options_for_select([["Initial", "initial"], ["Annual", "annual"], ["Continuous", "continuous"], ["Ad-Hoc", "ad-hoc"]]),
                    include_blank: "-- Select --",
                    class: "form-control" %>
            </div>
            <div class="form-group">
              <label for="assessment_start">Start Date</label>
              <%= date_field_tag :assessment_start, nil, class: "form-control" %>
            </div>
            <div class="form-group">
              <label for="assessment_end">End Date</label>
              <%= date_field_tag :assessment_end, nil, class: "form-control" %>
            </div>
          </div>
        </div>

        <div id="sap_select_existing_panel" class="sparc-wizard-step-panel<%= " sparc-d-none" unless @step_defaults[:sap].mode?(AtoWizardStep::SELECT) %>">
          <div class="form-group">
            <label for="sap_document_id">Existing SAP</label>
            <%= select_tag :sap_document_id,
                  options_for_select(@saps.map { |s| [s.name, s.id] }, @step_defaults[:sap].selected_id),
                  include_blank: "-- Select a SAP --",
                  class: "form-control" %>
          </div>
        </div>
      </div>
    </details>

    <%# ── Step 6: Security Assessment Results (SAR) ── %>
    <details <%= "open" if @step_defaults[:sar].mode?(AtoWizardStep::SELECT) %> class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--info sparc-wizard-step-number">6</span>
        Security Assessment Results (SAR)
      </summary>
      <div class="sparc-wizard-step-body">
        <%= render "ato_step_modes", step: :sar, noun: "SAR", default: @step_defaults[:sar] %>

        <div id="sar_create_new_panel" class="sparc-wizard-step-panel sparc-d-none">
          <div class="form-group">
            <label for="sar_name">SAR Name <span class="sparc-required">*</span></label>
            <%= text_field_tag :sar_name, nil, class: "form-control", placeholder: "e.g., Annual Assessment Results" %>
          </div>
          <div class="form-group">
            <label for="sar_description">Description</label>
            <%= text_area_tag :sar_description, nil, class: "form-control", rows: 3, placeholder: "Brief description of the assessment results..." %>
          </div>
          <div class="row row-cols-1 row-cols-md-2 g-3">
            <div class="form-group">
              <label for="sar_assessment_start">Start Date</label>
              <%= date_field_tag :sar_assessment_start, nil, class: "form-control" %>
            </div>
            <div class="form-group">
              <label for="sar_assessment_end">End Date</label>
              <%= date_field_tag :sar_assessment_end, nil, class: "form-control" %>
            </div>
          </div>
        </div>

        <div id="sar_select_existing_panel" class="sparc-wizard-step-panel<%= " sparc-d-none" unless @step_defaults[:sar].mode?(AtoWizardStep::SELECT) %>">
          <div class="form-group">
            <label for="sar_document_id">Existing SAR</label>
            <%= select_tag :sar_document_id,
                  options_for_select(@sars.map { |s| [s.name, s.id] }, @step_defaults[:sar].selected_id),
                  include_blank: "-- Select a SAR --",
                  class: "form-control" %>
          </div>
        </div>
      </div>
    </details>

    <%# ── Step 7: Plan of Action & Milestones (POA&M) ── %>
    <details <%= "open" if @step_defaults[:poam].mode?(AtoWizardStep::SELECT) %> class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--neutral sparc-wizard-step-number">7</span>
        Plan of Action &amp; Milestones (POA&amp;M)
      </summary>
      <div class="sparc-wizard-step-body">
        <%= render "ato_step_modes", step: :poam, noun: "POA&M", default: @step_defaults[:poam] %>

        <div id="poam_create_new_panel" class="sparc-wizard-step-panel sparc-d-none">
          <div class="form-group">
            <label for="poam_name">POA&amp;M Name <span class="sparc-required">*</span></label>
            <%= text_field_tag :poam_name, nil, class: "form-control", placeholder: "e.g., FY2026 Plan of Action & Milestones" %>
          </div>
          <div class="form-group">
            <label for="poam_description">Description</label>
            <%= text_area_tag :poam_description, nil, class: "form-control", rows: 3, placeholder: "Brief description of the POA&M..." %>
          </div>
        </div>

        <div id="poam_select_existing_panel" class="sparc-wizard-step-panel<%= " sparc-d-none" unless @step_defaults[:poam].mode?(AtoWizardStep::SELECT) %>">
          <div class="form-group">
            <label for="poam_document_id">Existing POA&amp;M</label>
            <%= select_tag :poam_document_id,
                  options_for_select(@poams.map { |p| [p.name, p.id] }, @step_defaults[:poam].selected_id),
                  include_blank: "-- Select a POA&M --",
                  class: "form-control" %>
          </div>
        </div>
      </div>
    </details>

    <%# ── Step 8: Review & Submit ── %>
    <details open class="mb-3 border rounded-3 sparc-wizard-step">
      <summary class="bg-body-secondary fw-semibold d-flex align-items-center gap-2 sparc-wizard-step-summary">
        <span class="sparc-status--purple sparc-wizard-step-number">8</span>
        Review &amp; Submit
      </summary>
      <div class="sparc-wizard-step-body">
        <p class="text-body-secondary mb-3 sparc-fs-088">
          Review your selections above, then click "Build ATO Package" to assemble the Authority to Operate package.
          Selected artifacts will be linked to this authorization boundary. New artifacts will be created with the
          details you provided. You can edit individual artifacts after the package is built.
        </p>
        <div class="d-flex gap-3">
          <%= f.submit "Build ATO Package", class: "sparc-action sparc-action--info sparc-action--outline" %>
          <%= link_to "Cancel", authorization_boundary_path(@authorization_boundary), class: "sparc-action sparc-action--neutral sparc-action--ghost" %>
        </div>
      </div>
    </details>

  <% end %>
</div>
