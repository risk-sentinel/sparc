<%# #869 — the Personnel Roster table, shared by the boundary show page and the
    add-member screen so the two cannot drift apart.

    Locals:
      personnel — the unified roster (AuthorizationBoundary#personnel_roster)
      boundary  — the AuthorizationBoundary
      actions:  — show the Edit/Remove column. The boundary screen manages the
                  roster, so it does; the add-member screen is showing progress
                  while you build the list, where per-row actions are noise and
                  an accidental Remove mid-entry would be costly.

    #770 bug 3 — unified roster. Legacy memberships keep inline edit/remove;
    canonical (admin-assigned) entries are managed on the admin screen and are
    shown read-only here. %>
<% actions = true unless defined?(actions) %>

<% if personnel.any? %>
  <table class="table table-hover mb-0">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <% if actions %><th>Actions</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% personnel.each do |p| %>
        <tr>
          <td><%= p.name %></td>
          <td class="text-body-secondary"><%= p.email.presence || "—" %></td>
          <td>
            <span class="badge bg-primary"><%= p.role_label %></span>
            <% if p.source == :assigned %>
              <span class="badge bg-secondary ms-1" title="Assigned via admin">Admin</span>
            <% end %>
          </td>
          <% if actions %>
            <td>
              <% if p.source == :membership %>
                <div class="d-flex gap-1">
                  <%= link_to "Edit", edit_authorization_boundary_membership_path(boundary, p.membership), class: "btn btn-outline-secondary btn-sm" %>
                  <%= button_to "Remove", authorization_boundary_membership_path(boundary, p.membership), method: :delete,
                        class: "btn btn-outline-danger btn-sm",
                        form: { data: { turbo_confirm: "Remove this member? This cannot be undone." }, style: "display: inline;" } %>
                </div>
              <% else %>
                <span class="text-body-secondary small">Managed in admin</span>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-body-secondary text-center mb-0">No members assigned. Add personnel with RMF roles.</p>
<% end %>
