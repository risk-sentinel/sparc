    "derivation": "uuidv5(urn:uuid:6ba7b811-9dad-11d1-80b4-00c04fd430c8, \"https://sparc.risk-sentinel.org/ns\")",
    "provisional": false,
    "registered": "sparc#1155, owner-decided 2026-09-21"
  },
  "separator": "\u001f",
  "about": [
    "Test vectors AND machine-readable field lists for the UUIDv5 key grammar specified",
    "normatively in sparc-horizon docs/03-data-model.md, section 'Deterministic UUIDs'.",
    "input = grammar-version + separator + fields joined by the separator; uuid = uuidv5(namespace, input).",
    "canonical-fields is that joined list, already normalised, beginning with the grammar version.",
    "field-lists is the declarative source every runtime builds keys from, so the ordering and",
    "the normalisation are not reimplemented per language. Every canonical-fields below is",
    "REGENERATED from field-lists + args, so the two cannot drift apart silently."
  ],
  "provenance": {
    "origin": "risk-sentinel/sparc-horizon, fixtures/key-vectors.v1.json",
    "adopted": "2026-09-21 (sparc#1161) — SPARC is now the source of truth; Horizon consumes this file",
    "namespace-change": "Every uuid here was regenerated under the REGISTERED namespace. The upstream file derived them from the provisional d051648c-1ae1-569e-8569-b679a9aaf142, which came from the placeholder URI https://risk-sentinel.org/ns/sparc. Horizon's own docs anticipated this regeneration."
  },
  "normalisers": {
    "control-id": "SPARC ControlId.canonical — lowercase, unpadded, dot notation. 'AC-2 (1)' -> 'ac-2.1'.",
    "lowercase": "ASCII/Unicode lowercase.",
    "none": "Passed through unchanged (NFC still applies, as it does to every field).",
    "by-vocabulary": "Dispatch on the 'vocabulary' arg via vocabulary-normalisers below."
  },
  "vocabulary-normalisers": {
    "nist-sp800-53": "control-id",
    "opaque": "none"
  },
  "context-args": [
    "vocabulary"
  ],
  "required-context": [
    "vocabulary"
  ],
  "required-context-note": "Required for any object carrying a control identifier, and NOT defaulted. Without a vocabulary there is no way to know whether the identifier may be canonicalised, so the grammar rejects rather than guessing.",
  "types": {
    "uuid": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "control-id": "Under nist-sp800-53 the CANONICALISED value must match ^[a-z]{2,3}-\\d+(\\.\\d+)*$ — which rejects a statement fragment (ac-2_smt.a) and a foreign-vocabulary identifier (ACM.1 canonicalises to acm.1, which validates and names nothing). Under an opaque vocabulary any non-empty value is accepted unchanged.",
    "family-id": "^[a-z]{2,3}$ after lowercasing.",
    "period": "^\\d{4}-(Q[1-4]|(0[1-9]|1[0-2]))$ — 2026-Q3 or 2026-01. 2026-1 is not a spelling of 2026-01, and 2026Q3 is not a quarter.",
    "sha256": "^[0-9a-f]{64}$ after lowercasing.",
    "decision-date": "^\\d{4}-\\d{2}-\\d{2}$ — an AO decision is keyed on the DATE it decides, matching the next-decision-date prop. The normative field table names this field 'period' for every kind, but the accepted value differs: a decision takes a date, everything else takes a reporting period. Only the vectors reveal it.",
    "half": "provider | consumer — there are two halves, and a third would silently create a third object.",
    "horizon-bucket": "today | +7 | +14 | +30 | a YYYY-MM-DD decision date. Only these are materialised; a cell keyed elsewhere is never invalidated."
  },
  "context-args-note": "Present in args, NEVER hashed. 'vocabulary' selects how the control identifier is normalised; it is not itself part of the key. A port that hashes every arg derives different UUIDs for 23 of the 26 vectors below.",
  "unicode": "Every field is NFC-normalised. No trimming, no case folding beyond the normaliser named above.",
